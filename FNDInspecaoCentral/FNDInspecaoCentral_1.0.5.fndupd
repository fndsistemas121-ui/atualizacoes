CREATE TABLE IF NOT EXISTS settings (key TEXT PRIMARY KEY, value TEXT);

CREATE TABLE IF NOT EXISTS users (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  username TEXT NOT NULL UNIQUE COLLATE NOCASE,
  nome TEXT NOT NULL,
  password_hash TEXT NOT NULL,
  role TEXT NOT NULL DEFAULT 'admin',
  created_at TEXT DEFAULT (datetime('now','localtime'))
);

CREATE TABLE IF NOT EXISTS sessions (
  token_hash TEXT PRIMARY KEY,
  user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  expires_at INTEGER NOT NULL
);

CREATE TABLE IF NOT EXISTS auditoria (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  quando TEXT DEFAULT (datetime('now','localtime')),
  usuario TEXT, acao TEXT, alvo TEXT, detalhe TEXT
);

-- modelos de relat\xF3rio (o pr\xF3prio usu\xE1rio cria/edita): estrutura em JSON
CREATE TABLE IF NOT EXISTS modelos (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  nome TEXT NOT NULL,
  descricao TEXT,
  prefixo TEXT NOT NULL DEFAULT 'VST',
  titulo_relatorio TEXT,
  estrutura TEXT NOT NULL,
  ativo INTEGER NOT NULL DEFAULT 1,
  ordem INTEGER NOT NULL DEFAULT 0,
  atualizado_em TEXT DEFAULT (datetime('now','localtime'))
);

CREATE TABLE IF NOT EXISTS clientes (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  nome TEXT NOT NULL,
  documento TEXT, telefone TEXT, email TEXT, endereco TEXT, observacoes TEXT,
  criado_em TEXT DEFAULT (datetime('now','localtime'))
);

-- vistorias / inspe\xE7\xF5es. O modelo \xE9 COPIADO para a vistoria (editar o modelo depois n\xE3o muda relat\xF3rios antigos)
CREATE TABLE IF NOT EXISTS vistorias (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  numero TEXT NOT NULL UNIQUE,
  modelo_id INTEGER REFERENCES modelos(id) ON DELETE SET NULL,
  modelo_nome TEXT NOT NULL,
  modelo TEXT NOT NULL,
  cliente_id INTEGER REFERENCES clientes(id) ON DELETE SET NULL,
  cliente TEXT NOT NULL,
  local_endereco TEXT,
  acompanhante TEXT,
  objetivo TEXT,
  data_vistoria TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT 'rascunho',
  respostas TEXT NOT NULL DEFAULT '{}',
  observacoes TEXT,
  conclusao TEXT,
  assinatura_cliente TEXT,
  cliente_recusou INTEGER NOT NULL DEFAULT 0,
  gps TEXT,
  revisao INTEGER NOT NULL DEFAULT 0,
  pdf_arquivo TEXT,
  destino_pasta TEXT,
  destino_ok INTEGER NOT NULL DEFAULT 0,
  criado_em TEXT DEFAULT (datetime('now','localtime')),
  atualizado_em TEXT DEFAULT (datetime('now','localtime')),
  finalizado_em TEXT
);
CREATE INDEX IF NOT EXISTS ix_vist_status ON vistorias(status, criado_em);

CREATE TABLE IF NOT EXISTS fotos (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  vistoria_id INTEGER NOT NULL REFERENCES vistorias(id) ON DELETE CASCADE,
  ref TEXT NOT NULL DEFAULT 'geral',
  legenda TEXT,
  arquivo TEXT NOT NULL,
  largura INTEGER, altura INTEGER, bytes INTEGER,
  tirada_em TEXT DEFAULT (datetime('now','localtime')),
  destino_ok INTEGER NOT NULL DEFAULT 0,
  destino_arquivo TEXT
);
CREATE INDEX IF NOT EXISTS ix_fotos_vist ON fotos(vistoria_id, ref);
CREATE INDEX IF NOT EXISTS ix_fotos_dest ON fotos(destino_ok);
