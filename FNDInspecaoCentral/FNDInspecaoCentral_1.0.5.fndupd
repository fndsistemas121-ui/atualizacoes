}:root {
  --escuro: #070d1a; --escuro2: #0f1f40; --azul: #1565d8; --azul2: #1e73e8; --azulclaro: #e8f1fd;
  --verde: #16825d; --amarelo: #b7791f; --laranja: #c05621; --vermelho: #c0392b; --cinza: #6b7685;
  --fundo: #f3f5f9; --card: #fff; --texto: #13213a; --sub: #5f6b7c; --borda: #dbe1ea; --raio: 10px;
}
* { box-sizing: border-box; }
html, body { margin: 0; height: 100%; background: var(--fundo); color: var(--texto); font: 15px/1.45 "Segoe UI", system-ui, -apple-system, Roboto, sans-serif; }
a { color: var(--azul); }
h1 { font-size: 22px; margin: 0; } h2 { font-size: 17px; margin: 0 0 10px; } h3 { font-size: 15px; margin: 0 0 8px; }
[hidden] { display: none !important; }

/* ----- estrutura ----- */
#sistema { display: flex; min-height: 100vh; }
.lateral { width: 230px; flex: none; background: linear-gradient(180deg, var(--menu-a, var(--escuro)), var(--menu-b, var(--escuro2))); color: var(--menu-txt, #dfe8f7); transition: width .18s; display: flex; flex-direction: column; position: sticky; top: 0; height: 100vh; }
.marca { display: flex; gap: 10px; align-items: center; padding: 16px 14px; border-bottom: 1px solid rgba(255,255,255,.08); }
.marca img { width: 46px; height: 46px; }
.marca b { display: block; color: var(--menu-txt, #fff); font-size: 16px; } .marca small { color: var(--menu-sub, #9fb2cf); font-size: 12px; }
.marca .txt { flex: 1; min-width: 0; overflow: hidden; }
#recolher { border: 0; background: rgba(255,255,255,.08); color: inherit; width: 28px; height: 28px; border-radius: 7px; cursor: pointer; font-size: 16px; line-height: 1; flex: none; }
#recolher:hover { background: rgba(255,255,255,.18); }
.lateral nav a .ico { display: inline-block; width: 24px; text-align: center; margin-right: 6px; }
/* menu recolhido: s√≥ os √≠cones */
#sistema.recolhido .lateral { width: 64px; }
#sistema.recolhido .lateral .txt, #sistema.recolhido .rodape-lateral { display: none; }
#sistema.recolhido .marca { flex-direction: column; padding: 12px 6px; gap: 8px; }
#sistema.recolhido .marca img { width: 38px; height: 38px; }
#sistema.recolhido #recolher { transform: rotate(180deg); }
#sistema.recolhido .lateral nav a { text-align: center; padding: 10px 0; }
#sistema.recolhido .lateral nav a .ico { margin: 0; font-size: 18px; }
.lateral nav { padding: 10px 8px; display: flex; flex-direction: column; gap: 2px; }
.lateral nav a { color: var(--menu-txt, #cfdbef); text-decoration: none; padding: 10px 12px; border-radius: 8px; white-space: nowrap; overflow: hidden; }
.lateral nav a:hover { background: rgba(255,255,255,.06); }
.lateral nav a.ativo { background: var(--azul2); color: #fff; }
.rodape-lateral { margin-top: auto; padding: 12px 14px; font-size: 12px; color: var(--menu-sub, #8fa3c2); border-top: 1px solid rgba(255,255,255,.08); }
.rodape-lateral button { background: none; border: 0; color: var(--menu-txt, #cfdbef); cursor: pointer; padding: 0; font: inherit; text-decoration: underline; }
main { flex: 1; min-width: 0; }
#app { max-width: 1050px; margin: 0 auto; padding: 22px 24px 60px; }
.aviso-topo { background: #fff4d6; border-bottom: 1px solid #f0d58c; padding: 9px 24px; font-size: 14px; }
.aviso-topo.erro { background: #fde8e6; border-color: #f3b6ae; }

.topo-pagina { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
.topo-pagina .sub { margin-top: 2px; }
.card { background: var(--card); border-radius: var(--raio); padding: 16px 18px; margin-bottom: 12px; box-shadow: 0 1px 2px rgba(19,33,58,.08); border: 1px solid #e7ebf2; }
.sub { color: var(--sub); font-size: 13px; }
.linha { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.entre { justify-content: space-between; }
.grade2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 14px; }
.grade3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0 14px; }
.vazio { text-align: center; color: var(--sub); padding: 30px 0; }

/* ----- formul√°rios ----- */
label.campo { display: block; margin: 10px 0 0; }
label.campo > span { display: block; font-size: 13px; font-weight: 600; color: var(--sub); margin-bottom: 4px; }
input, select, textarea { width: 100%; font: inherit; color: inherit; padding: 8px 10px; border: 1px solid var(--borda); border-radius: 8px; background: #fff; }
input:focus, select:focus, textarea:focus { outline: 2px solid #9cc2f5; border-color: var(--azul2); }
input:disabled, select:disabled, textarea:disabled { background: #f6f8fb; color: #44506a; }
textarea { resize: vertical; min-height: 64px; }
input[type=checkbox], input[type=radio] { width: auto; }
.check { display: inline-flex; gap: 6px; align-items: center; margin: 6px 14px 0 0; font-size: 14px; cursor: pointer; }

.btn { display: inline-flex; align-items: center; gap: 6px; font: inherit; font-weight: 600; padding: 8px 14px; border-radius: 8px; border: 1px solid var(--borda); background: #fff; color: var(--texto); cursor: pointer; text-decoration: none; white-space: nowrap; }
.btn:hover { border-color: #b7c3d6; } .btn:disabled { opacity: .55; cursor: default; }
.btn.prim { background: var(--azul); border-color: var(--azul); color: #fff; } .btn.prim:hover { background: #0f56bd; }
.btn.perigo { color: var(--vermelho); border-color: #efc2bc; }
.btn.peq { padding: 5px 10px; font-size: 13px; }
.btn.link { border: 0; background: none; color: var(--azul); padding: 4px 6px; }
.acoes { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 14px; }

.chip { display: inline-block; font-size: 12px; font-weight: 600; padding: 2px 9px; border-radius: 20px; background: #eef1f5; color: var(--sub); white-space: nowrap; }
.chip.rascunho { background: #fff1d6; color: #8a5a00; } .chip.finalizada { background: #dff5ec; color: #0f6b4b; }
.chip.nuvem { background: var(--azulclaro); color: #144a9c; }

/* ----- lista de vistorias ----- */
.filtros { display: flex; gap: 10px; margin-bottom: 12px; flex-wrap: wrap; }
.filtros input { max-width: 380px; }
.abas { display: inline-flex; background: #e6ebf2; border-radius: 8px; padding: 3px; }
.abas button { border: 0; background: none; font: inherit; padding: 6px 12px; border-radius: 6px; cursor: pointer; color: var(--sub); }
.abas button.ativo { background: #fff; color: var(--texto); font-weight: 600; box-shadow: 0 1px 2px rgba(0,0,0,.08); }
.tabela { width: 100%; border-collapse: collapse; background: #fff; border-radius: var(--raio); overflow: hidden; box-shadow: 0 1px 2px rgba(19,33,58,.08); }
.tabela th { text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: .03em; color: var(--sub); background: #f6f8fb; padding: 9px 12px; }
.tabela td { padding: 10px 12px; border-top: 1px solid #edf0f5; vertical-align: middle; }
.tabela tr.clicavel { cursor: pointer; } .tabela tr.clicavel:hover td { background: #f8fbff; }

/* ----- escolher modelo ----- */
.modelos-grade { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
.opcao-modelo { border: 2px solid var(--borda); border-radius: var(--raio); padding: 12px; cursor: pointer; background: #fff; text-align: left; font: inherit; color: inherit; }
.opcao-modelo.ativo { border-color: var(--azul2); background: var(--azulclaro); }
.opcao-modelo b { display: block; margin-bottom: 4px; }
.lista-sugestoes { border: 1px solid var(--borda); border-radius: 8px; margin-top: 4px; max-height: 210px; overflow: auto; background: #fff; }
.lista-sugestoes button { display: block; width: 100%; text-align: left; border: 0; border-bottom: 1px solid #f0f2f6; background: #fff; padding: 8px 10px; font: inherit; cursor: pointer; }
.lista-sugestoes button:hover { background: var(--azulclaro); }

/* ----- preenchimento ----- */
.barra-vistoria { position: sticky; top: 0; z-index: 5; background: var(--fundo); padding: 8px 0 10px; margin: -8px 0 6px; display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
.salvo { font-size: 13px; color: var(--sub); } .salvo.erro { color: var(--vermelho); }
.secao > h2 { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.bloco { border: 1px solid var(--borda); border-radius: var(--raio); margin: 10px 0; background: #fcfdff; }
.bloco > .cab { display: flex; gap: 8px; align-items: center; padding: 8px 10px; border-bottom: 1px solid var(--borda); background: #f4f7fc; border-radius: var(--raio) var(--raio) 0 0; }
.bloco > .cab input { font-weight: 600; max-width: 340px; }
.bloco > .corpo { padding: 4px 12px 10px; }
.bloco.fechado > .corpo { display: none; }
.item { padding: 10px 0; border-bottom: 1px dashed #e3e8f0; }
.item:last-child { border-bottom: 0; }
.item .rot { font-weight: 600; margin-bottom: 6px; } .item .rot small { font-weight: 400; color: var(--sub); }
.escala { display: flex; flex-wrap: wrap; gap: 6px; }
.escala button { font: inherit; font-size: 14px; padding: 6px 12px; border-radius: 20px; border: 1.5px solid var(--borda); background: #fff; cursor: pointer; color: var(--sub); }
.escala button.ativo { color: #fff; }
.c-verde.ativo { background: var(--verde); border-color: var(--verde); } .c-amarelo.ativo { background: var(--amarelo); border-color: var(--amarelo); }
.c-laranja.ativo { background: var(--laranja); border-color: var(--laranja); } .c-vermelho.ativo { background: var(--vermelho); border-color: var(--vermelho); }
.c-azul.ativo { background: var(--azul); border-color: var(--azul); } .c-cinza.ativo { background: var(--cinza); border-color: var(--cinza); }
.escala button:disabled { cursor: default; }
.obs-item { margin-top: 6px; }
.fotos { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; align-items: center; }
.fotos:empty { display: none; }
.item .rot + .escala + div, .item > div:has(> [data-abreobs]) { display: inline-block; }
.mini { position: relative; width: 84px; height: 84px; border-radius: 8px; overflow: hidden; background: #dde3ea; cursor: zoom-in; }
.mini img { width: 100%; height: 100%; object-fit: cover; display: block; }
.mini .nuvem { position: absolute; bottom: 2px; right: 3px; font-size: 11px; filter: drop-shadow(0 0 2px #fff); }
.add-foto { width: 84px; height: 84px; border: 2px dashed #b9c6da; border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--sub); font-size: 12px; cursor: pointer; background: #fff; }
.add-foto:hover { border-color: var(--azul2); color: var(--azul); }
.add-foto b { font-size: 22px; line-height: 1; }
.sugestoes-bloco { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }

/* ----- editor de modelos ----- */
.ed-secao { border: 1px solid var(--borda); border-radius: var(--raio); margin: 12px 0; background: #fff; }
.ed-secao > .cab { padding: 10px 12px; background: #f4f7fc; border-bottom: 1px solid var(--borda); border-radius: var(--raio) var(--raio) 0 0; }
.ed-secao > .corpo { padding: 6px 12px 12px; }
.ed-item { display: grid; grid-template-columns: 1fr 170px auto; gap: 8px; align-items: start; padding: 8px 0; border-bottom: 1px dashed #e3e8f0; }
.ed-item .extra { grid-column: 1 / -1; }
.ed-ord { display: flex; gap: 2px; }
.ed-ord button { border: 1px solid var(--borda); background: #fff; border-radius: 6px; width: 30px; height: 32px; cursor: pointer; }
.escala-propria { display: flex; flex-direction: column; gap: 4px; }
.escala-propria .linha input { max-width: 220px; } .escala-propria select { max-width: 130px; }

/* ----- modal / foto grande ----- */
.fundo-modal { position: fixed; inset: 0; background: rgba(7,13,26,.6); z-index: 50; display: flex; align-items: center; justify-content: center; padding: 20px; }
.modal { background: #fff; border-radius: 12px; width: min(560px, 100%); max-height: 92vh; overflow: auto; padding: 18px 20px; }
.modal.grande { width: min(1000px, 100%); }
.foto-grande img { width: 100%; max-height: 70vh; object-fit: contain; background: #111; border-radius: 8px; }
canvas.assinatura { width: 100%; height: 150px; border: 2px dashed var(--borda); border-radius: 8px; background: #fff; touch-action: none; display: block; }

/* ----- entrada (login) ----- */
#entrada { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at 30% 20%, #12305e, var(--escuro) 65%); padding: 20px; }
.caixa-entrada { background: #fff; border-radius: 14px; padding: 26px 28px; width: min(420px, 100%); box-shadow: 0 20px 50px rgba(0,0,0,.35); }
.caixa-entrada .logo { text-align: center; } .caixa-entrada .logo img { width: 130px; }
.erro-msg { color: var(--vermelho); font-size: 14px; margin-top: 8px; min-height: 1em; }

.toast { position: fixed; right: 20px; bottom: 20px; background: #1d2a40; color: #fff; padding: 11px 16px; border-radius: 9px; z-index: 80; box-shadow: 0 6px 18px rgba(0,0,0,.25); max-width: 420px; transition: .25s; opacity: 0; transform: translateY(10px); }
.toast.show { opacity: 1; transform: none; } .toast.ok { background: #0f6b4b; } .toast.erro { background: var(--vermelho); }
#carregando { position: fixed; inset: 0; background: rgba(7,13,26,.72); color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 90; gap: 12px; }
.spinner { width: 42px; height: 42px; border: 4px solid rgba(255,255,255,.3); border-top-color: #fff; border-radius: 50%; animation: gira .9s linear infinite; }
@keyframes gira { to { transform: rotate(360deg); } }

/* ----- celular / tela estreita ----- */
@media (max-width: 760px) {
  #sistema { flex-direction: column; }
  .lateral { width: 100%; height: auto; position: sticky; top: 0; z-index: 20; flex-direction: row; align-items: center; }
  .marca { border: 0; padding: 8px 10px; } .marca img { width: 34px; height: 34px; } .marca small { display: none; }
  .lateral nav { flex-direction: row; padding: 4px; overflow-x: auto; margin-left: auto; }
  .lateral nav a { padding: 8px 9px; font-size: 13px; white-space: nowrap; }
  .rodape-lateral, #recolher { display: none; }
  #sistema.recolhido .lateral { width: 100%; } #sistema.recolhido .lateral .txt { display: inline; }
  #app { padding: 14px 12px 60px; }
  .grade2, .grade3 { grid-template-columns: 1fr; }
  .ed-item { grid-template-columns: 1fr; }
  .tabela .opcional { display: none; }
}

/* senha: olhinho e regras */
.senha-wrap { position: relative; display: block; }
.senha-wrap input { padding-right: 42px; }
.senha-wrap .olho { position: absolute; right: 4px; top: 50%; transform: translateY(-50%); border: 0; background: none; cursor: pointer; font-size: 17px; padding: 4px 8px; border-radius: 6px; line-height: 1; }
.senha-wrap .olho:hover { background: #eef2f8; }
ul.regras { list-style: none; margin: 6px 0 0; padding: 0; font-size: 13px; color: var(--sub); display: grid; grid-template-columns: 1fr 1fr; gap: 2px 10px; }
ul.regras li.ok { color: var(--verde); font-weight: 600; }
.link-pequeno { display: block; text-align: center; margin-top: 12px; font-size: 14px; }
.codigo-maquina { font: 600 20px/1.2 Consolas, monospace; letter-spacing: 1px; background: #f2f5fa; border: 1px dashed #b9c6da; padding: 10px; border-radius: 8px; text-align: center; margin: 6px 0; }

/* novidades das atualiza√ß√µes */
.aviso-topo.novo { background: #e6f4ee; border-color: #a7dcc4; }
.novidades { font-size: 14px; line-height: 1.5; }
.novidades ul { margin: 4px 0; padding-left: 20px; } .novidades p { margin: 6px 0; }
.novidades code { background: #eef2f7; padding: 1px 5px; border-radius: 4px; font-size: 13px; }
.bloco-versao { border: 1px solid #cfe3d8; background: #f5fbf8; border-radius: 10px; padding: 10px 14px; margin: 10px 0; }
.bloco-versao h3 { margin: 0 0 4px; color: #0f6b4b; }
details.instalada { margin-top: 10px; } details.instalada summary { cursor: pointer; color: var(--azul); font-weight: 600; }

/* pr√©via do PDF e layout do relat√≥rio */
iframe.visualizador { width: 100%; height: 76vh; border: 1px solid var(--borda); border-radius: 8px; background: #525659; }
.logo-atual { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
.logo-atual .caixa-logo { width: 220px; height: 90px; border: 1px dashed #b9c6da; border-radius: 8px; display: flex; align-items: center; justify-content: center; background: repeating-conic-gradient(#f2f4f7 0% 25%, #fff 0% 50%) 50% / 16px 16px; }
.logo-atual img { max-width: 210px; max-height: 80px; }
.temas { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 4px; }
.tema { border: 2px solid var(--borda); border-radius: 10px; padding: 8px; cursor: pointer; background: #fff; text-align: center; font: inherit; }
.tema.ativo { border-color: var(--azul2); background: var(--azulclaro); }
.tema .mini-pag { height: 58px; border: 1px solid #dfe4ec; border-radius: 4px; background: #fff; position: relative; overflow: hidden; margin-bottom: 6px; }
.tema .mini-pag i { position: absolute; left: 0; right: 0; display: block; }
.cores { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
.cores button { width: 28px; height: 28px; border-radius: 50%; border: 2px solid #fff; box-shadow: 0 0 0 1px var(--borda); cursor: pointer; }
.cores input[type=color] { width: 44px; height: 32px; padding: 2px; }
@media (max-width: 760px) { .temas { grid-template-columns: 1fr; } }
'use strict';
/* FND Inspe√ß√£o ‚Äî painel */
const PRINCIPAL = 'principal';   // id do bloco √∫nico das se√ß√µes que n√£o repetem
let ESTADO = null;               // /api/estado
let saidaPendente = null;        // salvar antes de trocar de tela

/* ================= entrada: primeiro acesso e login ================= */
function telaEntrada(configurado) {
  $('#sistema').hidden = true;
  const el = $('#entrada'); el.hidden = false;
  el.innerHTML = `<form class="caixa-entrada" id="fEntrada">
    <div class="logo"><img src="img/logo-256.png" alt="FND Inspe√ß√£o"></div>
    ${configurado ? `<h2 style="text-align:center;margin-top:6px">Entrar</h2>
      <label class="campo"><span>Usu√°rio</span><input name="usuario" autocomplete="username" required autofocus></label>
      <label class="campo"><span>Senha</span><input name="senha" type="password" autocomplete="current-password" required></label>`
    : `<h2 style="text-align:center;margin-top:6px">Primeiro acesso</h2>
      <p class="sub" style="text-align:center">Crie o seu acesso ao FND Inspe√ß√£o. N√£o existe senha padr√£o.</p>
      <label class="campo"><span>Seu nome *</span><input name="nome" required autofocus maxlength="80" placeholder="Ex.: Carlos Souza"></label>
      <label class="campo"><span>Empresa (aparece no relat√≥rio)</span><input name="empresa" maxlength="120" placeholder="Ex.: CS Engenharia"></label>
      <label class="campo"><span>Usu√°rio *</span><input name="usuario" required maxlength="40" autocomplete="username" placeholder="ex.: carlos"></label>
      <label class="campo"><span>Senha *</span><input name="senha" id="senha1" type="password" required autocomplete="new-password"></label>
      <label class="campo"><span>Repita a senha *</span><input id="senha2" type="password" required autocomplete="new-password"></label>
      <ul class="regras" id="regras"></ul>`}
    <div class="erro-msg" id="erro"></div>
    <button class="btn prim" style="width:100%;justify-content:center;margin-top:10px">${configurado ? 'Entrar' : 'Criar acesso e come√ßar'}</button>
    ${configurado ? '<a href="#" class="link-pequeno" id="esqueci">Esqueci a senha</a>' : ''}
  </form>`;
  U.olhos(el);
  const regrasOk = configurado ? null : U.regrasSenha($('#senha1'), $('#regras'), $('#senha2'));
  $('#fEntrada').oninput = () => { $('#erro').textContent = ''; };
  $('#fEntrada').onsubmit = async (e) => {
    e.preventDefault();
    if (regrasOk && !regrasOk()) { $('#erro').textContent = 'A senha ainda n√£o cumpre todas as regras da lista.'; return; }
    const d = Object.fromEntries(new FormData(e.target));
    try { await U.api('POST', configurado ? '/login' : '/setup', d, { semLogin: true }); iniciar(); }
    catch (err) { $('#erro').textContent = err.message; }
  };
  if (configurado) $('#esqueci').onclick = (e) => { e.preventDefault(); telaRecuperar(); };
}

// "Esqueci a senha": c√≥digo da m√°quina ‚Üí FND gera o c√≥digo de recupera√ß√£o no Gerador de Chaves
async function telaRecuperar() {
  let r = { codigo: '‚Äî', whatsapp: '' };
  try { r = await U.api('GET', '/recuperar', undefined, { semLogin: true }); } catch { /* */ }
  const el = $('#entrada');
  const zap = r.whatsapp ? `https://wa.me/${encodeURIComponent(r.whatsapp)}?text=${encodeURIComponent('Esqueci a senha do FND Inspe√ß√£o. C√≥digo da m√°quina: ' + r.codigo)}` : '';
  el.innerHTML = `<form class="caixa-entrada" id="fRec">
    <div class="logo"><img src="img/logo-128.png" alt=""></div>
    <h2 style="text-align:center;margin-top:6px">Esqueci a senha</h2>
    <p class="sub">1. Mande este <b>c√≥digo da m√°quina</b> para a <b>FND Sistemas</b> e pe√ßa o c√≥digo de recupera√ß√£o:</p>
    <div class="codigo-maquina">${U.esc(r.codigo)}</div>
    <div class="linha" style="justify-content:center"><button type="button" class="btn peq" id="copiar">Copiar c√≥digo</button>
      ${zap ? `<a class="btn peq" target="_blank" rel="noopener" href="${zap}">üí¨ Pedir pelo WhatsApp</a>` : ''}</div>
    <p class="sub" style="margin-top:14px">2. Cole o c√≥digo recebido (vale s√≥ hoje e uma vez s√≥) e crie a senha nova:</p>
    <label class="campo"><span>C√≥digo de recupera√ß√£o</span><textarea name="codigo" rows="3" required spellcheck="false" style="font-family:Consolas,monospace" placeholder="FNDREC-..."></textarea></label>
    <label class="campo"><span>Senha nova</span><input name="senha" id="rs1" type="password" required autocomplete="new-password"></label>
    <label class="campo"><span>Repita a senha nova</span><input id="rs2" type="password" required autocomplete="new-password"></label>
    <ul class="regras" id="regras"></ul>
    <div class="erro-msg" id="erro"></div>
    <button class="btn prim" style="width:100%;justify-content:center;margin-top:10px">Redefinir a senha</button>
    <a href="#" class="link-pequeno" id="voltar">‚Üê Voltar para entrar</a>
  </form>`;
  U.olhos(el);
  const regrasOk = U.regrasSenha($('#rs1'), $('#regras'), $('#rs2'));
  $('#fRec').oninput = () => { $('#erro').textContent = ''; };
  $('#copiar').onclick = () => navigator.clipboard.writeText(r.codigo).then(() => U.toast('C√≥digo copiado'));
  $('#voltar').onclick = (e) => { e.preventDefault(); telaEntrada(true); };
  $('#fRec').onsubmit = async (e) => {
    e.preventDefault();
    if (!regrasOk()) { $('#erro').textContent = 'A senha nova ainda n√£o cumpre todas as regras da lista.'; return; }
    try {
      const x = await U.api('POST', '/recuperar', Object.fromEntries(new FormData(e.target)), { semLogin: true });
      U.toast(`Senha redefinida! Seu usu√°rio √© "${x.usuario}".`, 'ok');
      telaEntrada(true);
      $('[name=usuario]').value = x.usuario; $('[name=senha]').focus();
    } catch (err) { $('#erro').textContent = err.message; }
  };
}

/* ================= rotas ================= */
async function rotear() {
  if (saidaPendente) { try { await saidaPendente(); } catch { /* */ } saidaPendente = null; }
  window.onbeforeunload = null;
  const app = $('#app'); app.onclick = app.oninput = app.onchange = null;   // cada tela liga os seus
  const p = location.hash.replace(/^#\/?/, '').split('/');
  const menu = { '': 'vistorias', nova: 'vistorias', v: 'vistorias', clientes: 'clientes', modelos: 'modelos', config: 'config' }[p[0]] || 'vistorias';
  $$('.lateral nav a').forEach((a) => a.classList.toggle('ativo', a.dataset.menu === menu));
  window.scrollTo(0, 0);
  try {
    if (p[0] === 'nova') return await telaNova();
    if (p[0] === 'v') return await telaVistoria(+p[1]);
    if (p[0] === 'clientes') return await telaClientes();
    if (p[0] === 'modelos' && p[1]) return await Editor.abrir(p[1]);
    if (p[0] === 'modelos') return await telaModelos();
    if (p[0] === 'config') return await telaConfig();
    return await telaLista();
  } catch (e) { $('#app').innerHTML = `<div class="card">‚ö†Ô∏è ${U.esc(e.message)}</div>`; }
}

/* ================= lista de vistorias ================= */
let filtroLista = { busca: '', status: '' };
async function telaLista() {
  $('#app').innerHTML = `
    <div class="topo-pagina"><div><h1>Vistorias</h1><div class="sub">Vistorias e inspe√ß√µes feitas neste computador.</div></div>
      <a class="btn prim" href="#/nova">Ôºã Nova vistoria</a></div>
    <div class="filtros"><input type="search" id="busca" placeholder="Buscar por n√∫mero, cliente, endere√ßo ou modelo" value="${U.esc(filtroLista.busca)}">
      <div class="abas" id="abas">${[['', 'Todas'], ['rascunho', 'Em andamento'], ['finalizada', 'Finalizadas']].map(([v, t]) => `<button data-v="${v}" class="${filtroLista.status === v ? 'ativo' : ''}">${t}</button>`).join('')}</div></div>
    <div id="lista"><p class="vazio">Carregando‚Ä¶</p></div>`;
  const carregar = async () => {
    const q = new URLSearchParams({ busca: filtroLista.busca, ...(filtroLista.status ? { status: filtroLista.status } : {}) });
    const l = await U.api('GET', '/vistorias?' + q);
    if (!$('#lista')) return;   // j√° saiu desta tela
    $('#lista').innerHTML = l.length ? `<table class="tabela"><thead><tr><th>N¬∫</th><th>Cliente / local</th><th class="opcional">Modelo</th><th>Data</th><th>Situa√ß√£o</th></tr></thead><tbody>
      ${l.map((v) => `<tr class="clicavel" data-id="${v.id}"><td><b>${U.esc(v.numero)}</b></td>
        <td>${U.esc(v.cliente)}<div class="sub">${U.esc(v.local_endereco || '')}</div></td>
        <td class="opcional">${U.esc(v.modelo_nome)}<div class="sub">üì∑ ${v.fotos} foto(s)</div></td><td>${U.dataBR(v.data_vistoria)}</td>
        <td><span class="chip ${v.status}">${v.status === 'finalizada' ? 'Finalizada' : 'Em andamento'}</span>
          ${v.status === 'finalizada' && v.destino_ok ? ' <span class="chip nuvem" title="Copiada para a pasta da nuvem">‚òÅÔ∏è</span>' : ''}</td></tr>`).join('')}
      </tbody></table>` : `<div class="card vazio">${filtroLista.busca || filtroLista.status ? 'Nada encontrado.' : 'Nenhuma vistoria ainda. Clique em <b>Nova vistoria</b> para come√ßar.'}</div>`;
    $$('#lista tr[data-id]').forEach((tr) => (tr.onclick = () => (location.hash = `#/v/${tr.dataset.id}`)));
  };
  $('#busca').oninput = U.debounce((e) => { filtroLista.busca = e.target.value; carregar(); }, 250);
  $('#abas').onclick = (e) => { const b = e.target.closest('button'); if (!b) return; filtroLista.status = b.dataset.v; $$('#abas button').forEach((x) => x.classList.toggle('ativo', x === b)); carregar(); };
  await carregar();
}

/* ================= nova vistoria ================= */
async function telaNova() {
  const modelos = await U.api('GET', '/modelos');
  let escolhido = modelos[0] ? modelos[0].id : null, clienteId = null;
  $('#app').innerHTML = `
    <div class="topo-pagina"><h1>Nova vistoria</h1><a class="btn" href="#/">Cancelar</a></div>
    <div class="card"><h2>1. Modelo de relat√≥rio</h2>
      <div class="modelos-grade" id="mods">${modelos.map((m) => `<button class="opcao-modelo ${m.id === escolhido ? 'ativo' : ''}" data-id="${m.id}"><b>${U.esc(m.nome)}</b><span class="sub">${U.esc(m.descricao || '')}</span></button>`).join('')}</div>
      <p class="sub">N√£o achou o modelo certo? <a href="#/modelos">Crie ou ajuste os modelos</a>.</p></div>
    <form class="card" id="fNova"><h2>2. Cliente e local</h2>
      <label class="campo"><span>Cliente *</span><input name="nome" id="cliNome" required maxlength="120" autocomplete="off" placeholder="Digite para buscar um cliente j√° cadastrado ou um nome novo"></label>
      <div id="sugCli"></div>
      <div class="grade3">
        <label class="campo"><span>CPF / CNPJ</span><input name="documento" maxlength="30"></label>
        <label class="campo"><span>Telefone</span><input name="telefone" maxlength="30" data-tel placeholder="(11) 98888-7777"></label>
        <label class="campo"><span>E-mail</span><input name="email" type="email" maxlength="120"></label>
      </div>
      <label class="campo"><span>Endere√ßo do cliente</span><input name="endereco" maxlength="250"></label>
      <label class="campo"><span>Local da vistoria (se for diferente)</span><input name="local_endereco" maxlength="250" placeholder="Endere√ßo do im√≥vel / obra / estabelecimento"></label>
      <div class="grade3">
        <label class="campo"><span>Data da vistoria</span><input name="data_vistoria" type="date" value="${U.hojeISO()}"></label>
        <label class="campo"><span>Acompanhado por</span><input name="acompanhante" maxlength="120"></label>
        <label class="campo"><span>Objetivo</span><input name="objetivo" maxlength="500" placeholder="Ex.: entrega de chaves"></label>
      </div>
      <div class="acoes"><button class="btn prim">Come√ßar vistoria ‚Üí</button></div>
    </form>`;
  $('#mods').onclick = (e) => { const b = e.target.closest('[data-id]'); if (!b) return; e.preventDefault(); escolhido = +b.dataset.id; $$('#mods .opcao-modelo').forEach((x) => x.classList.toggle('ativo', x === b)); };
  const f = $('#fNova');
  f.documento.oninput = (e) => (e.target.value = U.mascaraDoc(e.target.value));
  U.telefones(f);
  $('#cliNome').oninput = U.debounce(async (e) => {
    clienteId = null;
    const q = e.target.value.trim();
    if (q.length < 2 || !$('#sugCli')) { if ($('#sugCli')) $('#sugCli').innerHTML = ''; return; }
    const l = await U.api('GET', '/clientes?busca=' + encodeURIComponent(q));
    if (!$('#sugCli') || clienteId) return;   // j√° saiu da tela ou j√° escolheu
    $('#sugCli').innerHTML = l.length ? `<div class="lista-sugestoes">${l.slice(0, 8).map((c) => `<button type="button" data-id="${c.id}">${U.esc(c.nome)} <span class="sub">${U.esc([c.documento, c.endereco].filter(Boolean).join(' ¬∑ '))}</span></button>`).join('')}</div>` : '';
    $$('#sugCli button').forEach((b) => (b.onclick = () => {
      const c = l.find((x) => x.id === +b.dataset.id); clienteId = c.id;
      for (const k of ['nome', 'documento', 'telefone', 'email', 'endereco']) f[k].value = c[k] || '';
      f.telefone.value = U.mascaraTelefone(f.telefone.value);
      $('#sugCli').innerHTML = '';
    }));
  }, 250);
  f.onsubmit = async (e) => {
    e.preventDefault();
    if (!escolhido) return U.toast('Escolha um modelo de relat√≥rio.', 'erro');
    const d = Object.fromEntries(new FormData(f));
    try {
      const v = await U.api('POST', '/vistorias', {
        modelo_id: escolhido, data_vistoria: d.data_vistoria, local_endereco: d.local_endereco, acompanhante: d.acompanhante, objetivo: d.objetivo,
        cliente: { id: clienteId, nome: d.nome, documento: d.documento, telefone: d.telefone, email: d.email, endereco: d.endereco },
      });
      location.hash = `#/v/${v.id}`;
    } catch (err) { U.toast(err.message, 'erro'); }
  };
}

/* ================= preenchimento da vistoria ================= */
async function telaVistoria(id) {
  let V = await U.api('GET', `/vistorias/${id}`);
  const ro = () => V.status !== 'rascunho';
  // garante um bloco nas se√ß√µes que n√£o repetem
  for (const s of V.modelo.secoes) { if (!V.respostas[s.id] || !V.respostas[s.id].length) V.respostas[s.id] = s.repetir ? [] : [{ id: PRINCIPAL, itens: {} }]; }

  /* --- salvar autom√°tico (um pedido por vez; o que mudar durante o envio vai em seguida) --- */
  let salvando = false, deNovo = false, sujo = false;
  const marca = (t, erro) => { const el = $('#salvo'); if (el) { el.textContent = t; el.classList.toggle('erro', !!erro); } };
  async function salvar() {
    if (ro() || !sujo) return;
    if (salvando) { deNovo = true; return; }
    salvando = true; sujo = false; marca('Salvando‚Ä¶');
    try {
      await U.api('PUT', `/vistorias/${V.id}`, { respostas: V.respostas, observacoes: V.observacoes || '', local_endereco: V.local_endereco || '', acompanhante: V.acompanhante || '', objetivo: V.objetivo || '', data_vistoria: V.data_vistoria });
      marca('‚úî Salvo √†s ' + new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }));
    } catch (e) { sujo = true; marca('‚ö†Ô∏è N√£o salvou: ' + e.message, true); setTimeout(salvar, 5000); }
    finally { salvando = false; if (deNovo) { deNovo = false; salvar(); } }
  }
  const agendar = U.debounce(salvar, 700);
  const mudou = () => { sujo = true; marca('Altera√ß√µes n√£o salvas‚Ä¶'); agendar(); };
  saidaPendente = async () => { agendar.agora(); for (let i = 0; i < 40 && (salvando || sujo); i++) { await new Promise((r) => setTimeout(r, 100)); if (!salvando && sujo) await salvar(); } };
  window.onbeforeunload = () => (sujo || salvando ? true : undefined);

  const fotosDe = (ref) => V.fotos.filter((f) => f.ref === ref);
  const htmlFotos = (ref, pode = true) => `<div class="fotos" data-ref="${ref}">${fotosDe(ref).map((f) => `<div class="mini" data-foto="${f.id}"><img src="/api/fotos/${f.id}" loading="lazy" alt="">${f.destino_ok ? '<span class="nuvem" title="Copiada para a nuvem">‚òÅÔ∏è</span>' : ''}</div>`).join('')}
    ${pode && !ro() ? (fotosDe(ref).length
      ? `<label class="add-foto" title="Adicionar fotos"><b>Ôºã</b>foto<input type="file" accept="image/*" multiple hidden data-addfoto="${ref}"></label>`
      : `<label class="btn link peq" title="Adicionar fotos">üì∑ foto<input type="file" accept="image/*" multiple hidden data-addfoto="${ref}"></label>`) : ''}</div>`;

  const htmlItem = (s, inst, it) => {
    const a = inst.itens[it.id] || {};
    const k = `data-s="${s.id}" data-b="${inst.id}" data-it="${it.id}"`;
    const dis = ro() ? 'disabled' : '';
    let campo = '';
    switch (it.tipo) {
      case 'avaliacao': campo = `<div class="escala">${opcoesAvaliacao(it).map((o) => `<button type="button" class="c-${o.c} ${a.v === o.t ? 'ativo' : ''}" ${k} data-val="${U.esc(o.t)}" ${dis}>${U.esc(o.t)}</button>`).join('')}</div>`; break;
      case 'texto_longo': campo = `<textarea ${k} data-campo rows="3" maxlength="5000" ${dis}>${U.esc(a.v || '')}</textarea>`; break;
      case 'numero': campo = `<div class="linha"><input ${k} data-campo inputmode="decimal" style="max-width:180px" value="${U.esc(a.v ?? '')}" ${dis}> <span class="sub">${U.esc(it.unidade || '')}</span></div>`; break;
      case 'data': campo = `<input ${k} data-campo type="date" style="max-width:200px" value="${U.esc(a.v || '')}" ${dis}>`; break;
      case 'sim_nao': campo = `<div class="escala">${[[true, 'Sim', 'verde'], [false, 'N√£o', 'vermelho']].map(([val, t, c]) => `<button type="button" class="c-${c} ${a.v === val ? 'ativo' : ''}" ${k} data-val="${val}" data-bool ${dis}>${t}</button>`).join('')}</div>`; break;
      case 'opcoes': campo = `<select ${k} data-campo style="max-width:420px" ${dis}><option value="">‚Äî escolha ‚Äî</option>${it.opcoes.map((o) => `<option ${a.v === o ? 'selected' : ''}>${U.esc(o)}</option>`).join('')}</select>`; break;
      case 'multipla': campo = `<div>${it.opcoes.map((o) => `<label class="check"><input type="checkbox" ${k} data-multi value="${U.esc(o)}" ${(a.v || []).includes(o) ? 'checked' : ''} ${dis}> ${U.esc(o)}</label>`).join('')}</div>`; break;
      default: campo = `<input ${k} data-campo maxlength="300" value="${U.esc(a.v || '')}" ${dis}>`;
    }
    const temObs = it.obs && (a.obs || !ro());
    return `<div class="item"><div class="rot">${U.esc(it.rotulo)}${it.ajuda ? ` <small>${U.esc(it.ajuda)}</small>` : ''}</div>${campo}
      ${temObs ? (a.obs ? `<textarea class="obs-item" ${k} data-obs rows="2" maxlength="2000" placeholder="Observa√ß√£o" ${dis}>${U.esc(a.obs)}</textarea>` : `<div><button type="button" class="btn link peq" ${k} data-abreobs>Ôºã observa√ß√£o</button></div>`) : ''}
      ${it.fotos && (!ro() || fotosDe(`${s.id}/${inst.id}/${it.id}`).length) ? htmlFotos(`${s.id}/${inst.id}/${it.id}`) : ''}</div>`;
  };

  const htmlSecao = (s) => {
    const insts = V.respostas[s.id];
    if (!s.repetir) {
      const inst = insts[0];
      return `<div class="card secao"><h2>${U.esc(s.titulo)}</h2>${s.itens.map((it) => htmlItem(s, inst, it)).join('')}
        ${s.fotos ? `<div class="sub" style="margin-top:8px">Fotos da se√ß√£o</div>${htmlFotos(`${s.id}/${inst.id}`)}` : ''}</div>`;
    }
    const usados = new Set(insts.map((i) => (i.nome || '').toLowerCase()));
    return `<div class="card secao"><h2>${U.esc(s.titulo)} <span class="sub">${insts.length} ${U.esc(s.rotulo.toLowerCase())}(s)</span></h2>
      ${insts.map((inst, n) => `<div class="bloco" data-bloco="${inst.id}">
        <div class="cab"><b>${n + 1}.</b><input data-nome="${s.id}" data-b="${inst.id}" value="${U.esc(inst.nome || '')}" maxlength="80" placeholder="${U.esc(s.rotulo)}" ${ro() ? 'disabled' : ''}>
          <span style="margin-left:auto" class="linha"><button type="button" class="btn link peq" data-dobra>recolher</button>
          ${ro() ? '' : `<button type="button" class="btn link peq" style="color:var(--vermelho)" data-remove="${s.id}" data-b="${inst.id}">remover</button>`}</span></div>
        <div class="corpo">${s.itens.map((it) => htmlItem(s, inst, it)).join('')}
          ${s.fotos ? `<div class="sub" style="margin-top:8px">Fotos de ${U.esc(inst.nome || s.rotulo)}</div>${htmlFotos(`${s.id}/${inst.id}`)}` : ''}</div></div>`).join('')}
      ${ro() ? (insts.length ? '' : '<p class="sub">Nenhum registro.</p>') : `<div class="sugestoes-bloco"><button type="button" class="btn peq prim" data-add="${s.id}">Ôºã ${U.esc(s.rotulo)}</button>
        ${(s.sugestoes || []).map((x) => `<button type="button" class="btn peq ${usados.has(x.toLowerCase()) ? '' : ''}" data-add="${s.id}" data-nomebloco="${U.esc(x)}">Ôºã ${U.esc(x)}</button>`).join('')}</div>`}
    </div>`;
  };

  function desenhar() {
    const c = V.cliente || {};
    $('#app').innerHTML = `
      <div class="barra-vistoria"><div><h1>${U.esc(V.numero)} <span class="chip ${V.status}">${V.status === 'finalizada' ? 'Finalizada' : 'Em andamento'}</span></h1>
        <div class="sub">${U.esc(V.modelo_nome)} ¬∑ ${U.esc(c.nome || '')}</div></div>
        <div class="linha">${ro() ? '' : '<span class="salvo" id="salvo"></span>'}<a class="btn" href="#/">‚Üê Lista</a>
          ${ro() ? `${V.tem_pdf ? '<button class="btn prim" id="abrirPdf">üìÑ Ver relat√≥rio</button>' : '<button class="btn prim" id="gerarPdf">üìÑ Gerar relat√≥rio</button>'}` : '<button class="btn" id="previa">üëÅ Pr√©-visualizar</button><button class="btn prim" id="finalizar">‚úî Finalizar e gerar relat√≥rio</button>'}</div></div>
      ${ro() ? `<div class="card"><div class="linha entre"><div><b>Relat√≥rio ${V.tem_pdf ? 'pronto' : 'ainda n√£o gerado'}</b>
          <div class="sub">${V.destino_ok ? 'üìÇ Copiado para a pasta de destino' : V.tem_pdf ? 'Aguardando c√≥pia para a pasta de destino (veja Configura√ß√µes)' : ''}${V.destino_pasta ? `<br>${U.esc(V.destino_pasta)}` : ''}</div></div>
          <div class="linha">${V.tem_pdf ? `<a class="btn" href="/api/vistorias/${V.id}/pdf?baixar=1">‚¨áÔ∏è Baixar PDF</a><button class="btn" id="gerarPdf">üîÑ Gerar de novo</button>` : ''}
          <button class="btn" id="reabrir">‚úèÔ∏è Reabrir para editar</button><button class="btn perigo" id="excluir">Excluir</button></div></div></div>` : ''}
      <div class="card"><h2>Dados da vistoria</h2>
        <div class="grade2">
          <div><div class="sub">Cliente</div><b>${U.esc(c.nome || '')}</b><div class="sub">${U.esc([c.documento, c.telefone, c.email].filter(Boolean).join(' ¬∑ '))}</div></div>
          <label class="campo" style="margin:0"><span>Data</span><input type="date" data-cab="data_vistoria" value="${U.esc(V.data_vistoria)}" ${ro() ? 'disabled' : ''}></label>
        </div>
        <label class="campo"><span>Local vistoriado</span><input data-cab="local_endereco" maxlength="250" value="${U.esc(V.local_endereco || '')}" ${ro() ? 'disabled' : ''}></label>
        <div class="grade2"><label class="campo"><span>Acompanhado por</span><input data-cab="acompanhante" maxlength="120" value="${U.esc(V.acompanhante || '')}" ${ro() ? 'disabled' : ''}></label>
          <label class="campo"><span>Objetivo</span><input data-cab="objetivo" maxlength="500" value="${U.esc(V.objetivo || '')}" ${ro() ? 'disabled' : ''}></label></div>
      </div>
      ${V.modelo.secoes.map(htmlSecao).join('')}
      <div class="card"><h2>Registro fotogr√°fico geral</h2>${htmlFotos('geral')}</div>
      <div class="card"><h2>Observa√ß√µes gerais</h2><textarea data-cab="observacoes" rows="4" maxlength="10000" ${ro() ? 'disabled' : ''}>${U.esc(V.observacoes || '')}</textarea></div>
      ${ro() && V.conclusao ? `<div class="card"><h2>Conclus√£o</h2><p style="white-space:pre-line;margin:0">${U.esc(V.conclusao)}</p></div>` : ''}`;
    ligar();
  }

  const resposta = (sid, bid, it) => {
    const inst = V.respostas[sid].find((x) => x.id === bid);
    return (inst.itens[it] = inst.itens[it] || {});
  };

  function ligar() {
    const app = $('#app');
    app.oninput = (e) => {
      const t = e.target;
      if (t.dataset.cab) { V[t.dataset.cab] = t.value; return mudou(); }
      if (t.dataset.nome) { V.respostas[t.dataset.nome].find((x) => x.id === t.dataset.b).nome = t.value; return mudou(); }
      if (t.hasAttribute('data-campo')) { resposta(t.dataset.s, t.dataset.b, t.dataset.it).v = t.value; return mudou(); }
      if (t.hasAttribute('data-obs')) { resposta(t.dataset.s, t.dataset.b, t.dataset.it).obs = t.value; return mudou(); }
    };
    app.onchange = async (e) => {
      const t = e.target;
      if (t.hasAttribute('data-multi')) {
        const a = resposta(t.dataset.s, t.dataset.b, t.dataset.it);
        a.v = $$(`input[data-multi][data-s="${t.dataset.s}"][data-b="${t.dataset.b}"][data-it="${t.dataset.it}"]:checked`).map((x) => x.value);
        return mudou();
      }
      if (t.dataset.addfoto) { const arqs = [...t.files]; t.value = ''; await enviarFotos(t.dataset.addfoto, arqs); }
    };
    app.onclick = async (e) => {
      const b = e.target.closest('button, .mini'); if (!b) return;
      if (b.dataset.val !== undefined && !ro()) {
        const a = resposta(b.dataset.s, b.dataset.b, b.dataset.it);
        const val = b.hasAttribute('data-bool') ? b.dataset.val === 'true' : b.dataset.val;
        a.v = a.v === val ? (b.hasAttribute('data-bool') ? null : '') : val;   // clicar de novo desmarca
        $$('button', b.parentElement).forEach((x) => x.classList.toggle('ativo', x === b && a.v === val));
        return mudou();
      }
      if (b.hasAttribute('data-abreobs')) {
        const ta = document.createElement('textarea');
        Object.assign(ta, { className: 'obs-item', rows: 2, maxLength: 2000, placeholder: 'Observa√ß√£o' });
        for (const k of ['s', 'b', 'it']) ta.dataset[k] = b.dataset[k];
        ta.setAttribute('data-obs', ''); b.parentElement.replaceWith(ta); ta.focus(); return;
      }
      if (b.dataset.add) {
        const s = V.modelo.secoes.find((x) => x.id === b.dataset.add);
        V.respostas[s.id].push({ id: U.id(), nome: b.dataset.nomebloco || '', itens: {} });
        mudou(); desenhar();
        const blocos = $$(`.bloco`); const ult = V.respostas[s.id][V.respostas[s.id].length - 1];
        const el = $(`.bloco[data-bloco="${ult.id}"]`); if (el) { el.scrollIntoView({ behavior: 'smooth', block: 'start' }); if (!ult.nome) $('input', el).focus(); }
        return blocos;
      }
      if (b.dataset.remove) {
        const lista = V.respostas[b.dataset.remove], inst = lista.find((x) => x.id === b.dataset.b);
        const ref = `${b.dataset.remove}/${inst.id}`, nf = V.fotos.filter((f) => f.ref === ref || f.ref.startsWith(ref + '/')).length;
        if (!(await U.confirmar(`Remover "${inst.nome || 'este bloco'}"${nf ? ` e as ${nf} foto(s) dele` : ''}?`, { ok: 'Remover', perigo: true }))) return;
        try { await U.api('POST', `/vistorias/${V.id}/remover-bloco`, { ref }); } catch (err) { return U.toast(err.message, 'erro'); }
        V.fotos = V.fotos.filter((f) => !(f.ref === ref || f.ref.startsWith(ref + '/')));
        lista.splice(lista.indexOf(inst), 1); mudou(); desenhar(); return;
      }
      if (b.hasAttribute('data-dobra')) { const bl = b.closest('.bloco'); bl.classList.toggle('fechado'); b.textContent = bl.classList.contains('fechado') ? 'abrir' : 'recolher'; return; }
      if (b.dataset.foto) return verFoto(+b.dataset.foto);
      if (b.id === 'finalizar') return finalizar();
      if (b.id === 'gerarPdf') return gerarPdf();
      if (b.id === 'abrirPdf') return verRelatorio();
      if (b.id === 'previa') return previa();
      if (b.id === 'reabrir') {
        if (!(await U.confirmar('Reabrir para editar? Ao finalizar de novo, sai um relat√≥rio novo (revis√£o).'))) return;
        V = await U.api('POST', `/vistorias/${V.id}/reabrir`); prepararBlocos(); return desenhar();
      }
      if (b.id === 'excluir') {
        if (!(await U.confirmar(`Excluir a vistoria ${V.numero} com todas as fotos?\nO que j√° foi copiado para a pasta da nuvem n√£o √© apagado.`, { ok: 'Excluir', perigo: true }))) return;
        await U.api('DELETE', `/vistorias/${V.id}`); saidaPendente = null; U.toast('Vistoria exclu√≠da'); location.hash = '#/';
      }
    };
  }
  const prepararBlocos = () => { for (const s of V.modelo.secoes) if (!V.respostas[s.id] || !V.respostas[s.id].length) V.respostas[s.id] = s.repetir ? [] : [{ id: PRINCIPAL, itens: {} }]; };

  async function enviarFotos(ref, arqs) {
    if (!arqs.length) return;
    // o bloco/item precisa existir na Central antes da foto
    agendar.agora();
    let ok = 0;
    for (let i = 0; i < arqs.length; i++) {
      U.carregando(`Enviando foto ${i + 1} de ${arqs.length}‚Ä¶`);
      try {
        const { blob, largura, altura } = await U.comprimirFoto(arqs[i]);
        const q = new URLSearchParams({ ref, largura, altura, tirada_em: U.agoraLocal() });
        V.fotos.push(await U.api('POST', `/vistorias/${V.id}/fotos?${q}`, blob, { tipo: 'image/jpeg' }));
        ok++;
      } catch (e) { U.toast(`Foto ${arqs[i].name}: ${e.message}`, 'erro'); }
    }
    U.carregando();
    const el = $(`.fotos[data-ref="${ref}"]`);
    if (el) el.outerHTML = htmlFotos(ref);
    if (ok) U.toast(`${ok} foto(s) adicionada(s)`, 'ok');
  }

  function verFoto(fid) {
    const f = V.fotos.find((x) => x.id === fid); if (!f) return;
    const m = U.modal(`<div class="foto-grande"><img src="/api/fotos/${f.id}" alt=""></div>
      <label class="campo"><span>Legenda (aparece no relat√≥rio)</span><input id="leg" maxlength="200" value="${U.esc(f.legenda || '')}" ${ro() ? 'disabled' : ''}></label>
      <div class="sub" style="margin-top:6px">Tirada em ${U.dataHoraBR(f.tirada_em)} ${f.destino_ok ? '¬∑ ‚òÅÔ∏è copiada para a nuvem' : ''}</div>
      <div class="acoes" style="justify-content:space-between">${ro() ? '<span></span>' : '<button class="btn perigo" id="delFoto">Excluir foto</button>'}
        <div class="linha">${ro() ? '' : '<button class="btn prim" id="salvarLeg">Salvar legenda</button>'}<button class="btn" id="fechar">Fechar</button></div></div>`, { grande: true });
    $('#fechar', m.el).onclick = m.fechar;
    if (ro()) return;
    $('#salvarLeg', m.el).onclick = async () => { try { await U.api('PUT', `/fotos/${f.id}`, { legenda: $('#leg', m.el).value }); f.legenda = $('#leg', m.el).value; m.fechar(); } catch (e) { U.toast(e.message, 'erro'); } };
    $('#delFoto', m.el).onclick = async () => {
      if (!(await U.confirmar('Excluir esta foto?', { ok: 'Excluir', perigo: true }))) return;
      try { await U.api('DELETE', `/fotos/${f.id}`); V.fotos = V.fotos.filter((x) => x.id !== f.id); m.fechar(); const el = $(`.fotos[data-ref="${f.ref}"]`); if (el) el.outerHTML = htmlFotos(f.ref); } catch (e) { U.toast(e.message, 'erro'); }
    };
  }

  async function finalizar() {
    await saidaPendente();
    const cfg = await U.api('GET', '/config');
    const m = U.modal(`<h2>Finalizar ${U.esc(V.numero)}</h2>
      <label class="campo"><span>Conclus√£o / parecer (vai no fim do relat√≥rio)</span><textarea id="concl" rows="5" maxlength="10000">${U.esc(V.conclusao || '')}</textarea></label>
      <label class="campo"><span>Assinatura do cliente / acompanhante${V.acompanhante ? ` (${U.esc(V.acompanhante)})` : ''}</span><canvas class="assinatura" id="assin"></canvas></label>
      <div class="linha entre"><button class="btn link peq" id="limpar">limpar assinatura</button><label class="check"><input type="checkbox" id="recusou"> Recusou-se a assinar</label></div>
      ${cfg.prof_nome && cfg.assinatura ? '' : '<p class="sub">‚ö†Ô∏è Sua assinatura e seus dados profissionais ainda n√£o est√£o em Configura√ß√µes: o relat√≥rio sai sem eles.</p>'}
      <div class="acoes" style="justify-content:flex-end"><button class="btn" id="canc">Voltar</button><button class="btn" id="verPrev">üëÅ Pr√©-visualizar</button><button class="btn prim" id="ok">‚úî Finalizar e gerar relat√≥rio</button></div>`);
    const assin = new Assinatura($('#assin', m.el));
    $('#limpar', m.el).onclick = () => assin.limpar();
    $('#canc', m.el).onclick = m.fechar;
    $('#verPrev', m.el).onclick = () => previa({ conclusao: $('#concl', m.el).value, assinatura_cliente: $('#recusou', m.el).checked ? null : assin.valor(), cliente_recusou: $('#recusou', m.el).checked });
    $('#ok', m.el).onclick = async () => {
      try {
        U.carregando('Finalizando‚Ä¶');
        V = await U.api('POST', `/vistorias/${V.id}/finalizar`, { conclusao: $('#concl', m.el).value, assinatura_cliente: $('#recusou', m.el).checked ? null : assin.valor(), cliente_recusou: $('#recusou', m.el).checked });
        m.fechar(); prepararBlocos();
        await gerarPdf(cfg);
      } catch (e) { U.carregando(); U.toast(e.message, 'erro'); }
    };
  }

  // pr√©via do relat√≥rio com o que j√° foi preenchido (marca "PR√âVIA"; nada √© salvo como relat√≥rio)
  async function previa(extra = {}) {
    try {
      await saidaPendente();
      U.carregando('Montando a pr√©via‚Ä¶');
      const pdf = await Relatorio.gerar({ ...V, ...extra }, await U.api('GET', '/config'), { previa: true });
      U.carregando(); U.verPDF(pdf, `Pr√©via ‚Äî ${V.numero}`, { previa: true });
    } catch (e) { U.carregando(); U.toast('Pr√©via: ' + e.message, 'erro'); }
  }
  async function verRelatorio() {
    try {
      const pdf = await U.api('GET', `/vistorias/${V.id}/pdf`, undefined, { blob: true });
      U.verPDF(pdf, `Relat√≥rio ${V.numero}`, { nomeArquivo: `${V.numero} - ${(V.cliente || {}).nome || ''}.pdf` });
    } catch (e) { U.toast(e.message, 'erro'); }
  }

  async function gerarPdf(cfg) {
    try {
      U.carregando('Montando o relat√≥rio‚Ä¶');
      cfg = cfg || await U.api('GET', '/config');
      const pdf = await Relatorio.gerar(V, cfg);
      await U.api('PUT', `/vistorias/${V.id}/pdf`, pdf, { tipo: 'application/pdf' });
      V = await U.api('GET', `/vistorias/${V.id}`); prepararBlocos();
      U.carregando(); desenhar();
      U.toast('Relat√≥rio gerado. Ele vai para a pasta da nuvem automaticamente.', 'ok');
      verRelatorio();
    } catch (e) { U.carregando(); U.toast('Relat√≥rio: ' + e.message, 'erro'); desenhar(); }
  }

  desenhar();
}

/* ================= clientes ================= */
async function telaClientes() {
  $('#app').innerHTML = `<div class="topo-pagina"><div><h1>Clientes</h1><div class="sub">Cadastrados automaticamente ao criar vistorias. Voc√™ tamb√©m pode cadastrar aqui.</div></div>
    <button class="btn prim" id="novo">Ôºã Novo cliente</button></div>
    <div class="filtros"><input type="search" id="busca" placeholder="Buscar por nome, documento ou endere√ßo"></div><div id="lista"></div>`;
  const carregar = async (q = '') => {
    const l = await U.api('GET', '/clientes?busca=' + encodeURIComponent(q));
    if (!$('#lista')) return;
    $('#lista').innerHTML = l.length ? `<table class="tabela"><thead><tr><th>Nome</th><th class="opcional">Documento</th><th class="opcional">Contato</th><th>Vistorias</th></tr></thead><tbody>
      ${l.map((c) => `<tr class="clicavel" data-id="${c.id}"><td><b>${U.esc(c.nome)}</b><div class="sub">${U.esc(c.endereco || '')}</div></td><td class="opcional">${U.esc(c.documento || '')}</td>
        <td class="opcional">${U.esc([c.telefone, c.email].filter(Boolean).join(' ¬∑ '))}</td><td>${c.vistorias}</td></tr>`).join('')}</tbody></table>` : '<div class="card vazio">Nenhum cliente.</div>';
    $$('#lista tr[data-id]').forEach((tr) => (tr.onclick = () => editar(l.find((c) => c.id === +tr.dataset.id))));
  };
  const editar = (c = {}) => {
    const m = U.modal(`<h2>${c.id ? 'Editar cliente' : 'Novo cliente'}</h2><form id="fc">
      <label class="campo"><span>Nome *</span><input name="nome" required maxlength="120" value="${U.esc(c.nome || '')}"></label>
      <div class="grade2"><label class="campo"><span>CPF / CNPJ</span><input name="documento" maxlength="30" value="${U.esc(c.documento || '')}"></label>
      <label class="campo"><span>Telefone</span><input name="telefone" maxlength="30" data-tel placeholder="(11) 98888-7777" value="${U.esc(c.telefone || '')}"></label></div>
      <label class="campo"><span>E-mail</span><input name="email" type="email" maxlength="120" value="${U.esc(c.email || '')}"></label>
      <label class="campo"><span>Endere√ßo</span><input name="endereco" maxlength="250" value="${U.esc(c.endereco || '')}"></label>
      <label class="campo"><span>Observa√ß√µes</span><textarea name="observacoes" maxlength="500">${U.esc(c.observacoes || '')}</textarea></label>
      <div class="acoes" style="justify-content:space-between">${c.id ? '<button type="button" class="btn perigo" id="del">Excluir</button>' : '<span></span>'}
        <div class="linha"><button type="button" class="btn" id="canc">Cancelar</button><button class="btn prim">Salvar</button></div></div></form>`);
    $('#fc', m.el).documento.oninput = (e) => (e.target.value = U.mascaraDoc(e.target.value));
    U.telefones(m.el);
    $('#canc', m.el).onclick = m.fechar;
    $('#fc', m.el).onsubmit = async (e) => {
      e.preventDefault();
      try { await U.api(c.id ? 'PUT' : 'POST', c.id ? `/clientes/${c.id}` : '/clientes', Object.fromEntries(new FormData(e.target))); m.fechar(); carregar($('#busca').value); } catch (err) { U.toast(err.message, 'erro'); }
    };
    if (c.id) $('#del', m.el).onclick = async () => {
      if (!(await U.confirmar(`Excluir ${c.nome} do cadastro?${c.vistorias ? '\nAs vistorias dele continuam guardadas.' : ''}`, { ok: 'Excluir', perigo: true }))) return;
      await U.api('DELETE', `/clientes/${c.id}`); m.fechar(); carregar($('#busca').value);
    };
  };
  $('#novo').onclick = () => editar();
  $('#busca').oninput = U.debounce((e) => carregar(e.target.value), 250);
  await carregar();
}

/* ================= modelos ================= */
async function telaModelos() {
  const l = await U.api('GET', '/modelos');
  $('#app').innerHTML = `<div class="topo-pagina"><div><h1>Modelos de relat√≥rio</h1><div class="sub">Cada modelo define as se√ß√µes e os itens da vistoria. Crie quantos quiser.</div></div>
    <a class="btn prim" href="#/modelos/novo">Ôºã Novo modelo</a></div>
    ${l.map((m) => `<div class="card"><div class="linha entre"><div><h2 style="margin:0">${U.esc(m.nome)}</h2>
      <div class="sub">${U.esc(m.descricao || '')}</div>
      <div class="sub">${m.estrutura.secoes.length} se√ß√£o(√µes) ¬∑ ${m.estrutura.secoes.reduce((a, s) => a + s.itens.length, 0)} item(ns) ¬∑ numera√ß√£o ${U.esc(m.prefixo)}-AAAA-0001${m.em_uso ? ` ¬∑ usado em ${m.em_uso} vistoria(s)` : ''}</div></div>
      <div class="linha"><a class="btn peq" href="#/modelos/${m.id}">‚úèÔ∏è Editar</a><button class="btn peq" data-dup="${m.id}">Duplicar</button><button class="btn peq perigo" data-del="${m.id}">Excluir</button></div></div></div>`).join('') || '<div class="card vazio">Nenhum modelo.</div>'}`;
  $('#app').onclick = async (e) => {
    const b = e.target.closest('button'); if (!b) return;
    if (b.dataset.dup) { const n = await U.api('POST', `/modelos/${b.dataset.dup}/duplicar`); location.hash = `#/modelos/${n.id}`; }
    if (b.dataset.del) {
      const m = l.find((x) => x.id === +b.dataset.del);
      if (!(await U.confirmar(`Excluir o modelo "${m.nome}"?${m.em_uso ? '\nAs vistorias j√° feitas com ele continuam iguais.' : ''}`, { ok: 'Excluir', perigo: true }))) return;
      await U.api('DELETE', `/modelos/${m.id}`); telaModelos();
    }
  };
}

/* ================= configura√ß√µes ================= */
async function telaConfig() {
  const [cfg, dest, lic, atu] = await Promise.all([U.api('GET', '/config'), U.api('GET', '/destino'), U.api('GET', '/licenca'), U.api('GET', '/atualizacao')]);
  const v = lic.venda || {};
  const LAYcfg = layoutRelatorio(cfg);
  $('#app').innerHTML = `<div class="topo-pagina"><h1>Configura√ß√µes</h1></div>
    <form class="card" id="fp"><h2>üë∑ Seus dados (aparecem no relat√≥rio)</h2>
      <div class="grade2">
        <label class="campo"><span>Nome completo</span><input name="prof_nome" maxlength="80" value="${U.esc(cfg.prof_nome)}"></label>
        <label class="campo"><span>T√≠tulo / profiss√£o</span><input name="prof_titulo" maxlength="80" value="${U.esc(cfg.prof_titulo)}" placeholder="Ex.: Engenheiro Civil"></label>
        <label class="campo"><span>Registro profissional</span><input name="prof_registro" maxlength="40" value="${U.esc(cfg.prof_registro)}" placeholder="Ex.: CREA-SP 5061234567"></label>
        <label class="campo"><span>Empresa</span><input name="empresa" maxlength="120" value="${U.esc(cfg.empresa)}"></label>
        <label class="campo"><span>Telefone / WhatsApp</span><input name="prof_telefone" maxlength="30" data-tel placeholder="(11) 98888-7777" value="${U.esc(cfg.prof_telefone)}"></label>
        <label class="campo"><span>E-mail</span><input name="prof_email" maxlength="120" value="${U.esc(cfg.prof_email)}"></label>
        <label class="campo"><span>Cidade (para "S√£o Paulo, 24/11/2026")</span><input name="prof_cidade" maxlength="80" value="${U.esc(cfg.prof_cidade)}"></label>
        <label class="campo"><span>Rodap√© do relat√≥rio (opcional)</span><input name="rodape" maxlength="200" value="${U.esc(cfg.rodape)}"></label>
      </div>
      <label class="campo"><span>Sua assinatura (desenhe com o mouse)</span><canvas class="assinatura" id="assin"></canvas></label>
      <div class="acoes"><button type="button" class="btn" id="limpar">Limpar assinatura</button><button class="btn prim">üíæ Salvar dados</button></div></form>

    <div class="card" id="cardRel"><h2>üé® Logo e layout do relat√≥rio</h2>
      <div class="logo-atual"><div class="caixa-logo">${cfg.logo ? `<img src="${cfg.logo}" alt="">` : '<span class="sub">sem logo</span>'}</div>
        <div><label class="btn">üìÅ Escolher a logo da empresa<input type="file" id="arqLogo" accept="image/png,image/jpeg,image/webp" hidden></label>
          ${cfg.logo ? '<button class="btn link" id="tirarLogo">remover</button>' : ''}<div class="sub" style="margin-top:4px">PNG (de prefer√™ncia com fundo transparente) ou JPG.</div></div></div>
      <label class="campo"><span>Logo no relat√≥rio</span><select id="relLogo" style="max-width:340px">
        ${[['propria', 'A logo da empresa (acima)'], ['fnd', 'A logo do FND Inspe√ß√£o'], ['nenhuma', 'Sem logo']].map(([k, t]) => `<option value="${k}" ${LAYcfg.logo === k ? 'selected' : ''}>${t}</option>`).join('')}</select></label>
      <label class="campo"><span>Estilo do cabe√ßalho</span></label>
      <div class="temas" id="temas">${[['escuro', 'Escuro', '<i style="top:0;height:16px;background:#0b1830"></i><i style="top:16px;height:2px;background:var(--cor-rel)"></i>'], ['claro', 'Claro', '<i style="top:18px;height:2px;background:var(--cor-rel);left:6px;right:6px"></i><i style="top:6px;height:5px;width:40%;left:6px;background:#cfd6e2"></i>'], ['minimalista', 'Minimalista', '<i style="top:6px;height:4px;width:35%;left:6px;background:#c8ced8"></i><i style="top:15px;height:1px;left:6px;right:6px;background:#d5dae2"></i>']]
        .map(([k, t, desenho]) => `<button type="button" class="tema ${LAYcfg.tema === k ? 'ativo' : ''}" data-tema="${k}"><div class="mini-pag">${desenho}</div>${t}</button>`).join('')}</div>
      <div class="grade2">
        <label class="campo"><span>Cor de destaque</span><div class="cores" id="cores">${['#1e73e8', '#0f6b4b', '#b7312c', '#c05621', '#6b3fa0', '#37474f'].map((c) => `<button type="button" style="background:${c}" data-cor="${c}" title="${c}"></button>`).join('')}<input type="color" id="corRel" value="${U.esc(cfg.rel_cor || '#1e73e8')}"></div></label>
        <label class="campo"><span>Fotos por linha</span><select id="fotosLinha">${[1, 2, 3].map((n) => `<option ${LAYcfg.fotosLinha === n ? 'selected' : ''}>${n}</option>`).join('')}</select></label>
      </div>
      <label class="check"><input type="checkbox" id="relResumo" ${LAYcfg.resumo ? 'checked' : ''}> Mostrar o resumo das avalia√ß√µes</label>
      <label class="check"><input type="checkbox" id="relAssin" ${LAYcfg.assinCliente ? 'checked' : ''}> Assinatura do cliente no fim</label>
      <div class="acoes"><button class="btn" id="previaExemplo">üëÅ Visualizar com um exemplo</button><button class="btn prim" id="salvarRel">üíæ Salvar layout</button></div></div>

    <div class="card"><h2>üñ•Ô∏è Apar√™ncia do sistema</h2>
      <label class="campo" style="margin-top:0"><span>Cor do menu lateral</span><div class="cores" id="coresMenu">${CORES_MENU.map((c) => `<button type="button" style="background:${c}" data-cormenu="${c}" title="${c}"></button>`).join('')}<input type="color" id="corMenu" value="${U.esc(ESTADO.ui_cor_menu || '#0f1f40')}"></div></label>
      <p class="sub">O menu tamb√©m pode ser recolhido pelo bot√£o <b>¬´</b> no topo dele.</p>
      <div class="acoes"><button class="btn" id="menuPadrao">Voltar ao padr√£o</button></div></div>

    <div class="card"><h2>üìÇ Onde salvar as fotos e os relat√≥rios</h2>
      <p class="sub" style="margin-top:0">Pode ser uma pasta da <b>nuvem</b> (OneDrive, Google Drive: quem envia para a internet √© o pr√≥prio programa da nuvem) ou uma pasta <b>deste computador</b> (Documentos, outro disco, pendrive, rede).<br>
        Destino atual: <b>${U.esc(dest.base ? dest.pasta : '(nenhum ‚Äî escolha a pasta)')}</b></p>
      ${dest.base ? `<pre class="sub" style="background:#f6f8fb;border-radius:8px;padding:8px 10px;margin:6px 0;white-space:pre-wrap">FND Inspe√ß√£o\\
  2026\\VST-2026-0001 - Cliente\\
      Fotos\\          (as fotos de cada vistoria)
      Relat√≥rios\\     (o PDF da vistoria)
  Todos os relat√≥rios\\2026\\   (todos os PDFs juntos)</pre>` : ''}
      ${dest.base ? `<p>${dest.erro ? `‚ö†Ô∏è ${U.esc(dest.erro)}` : '‚úî Funcionando.'} Pendentes: ${dest.pendentes.fotos} foto(s), ${dest.pendentes.relatorios} relat√≥rio(s).</p>` : ''}
      ${dest.sugestoes.length ? `<div class="sub">Encontradas neste PC:</div><div class="sugestoes-bloco">${dest.sugestoes.map((s) => `<button class="btn peq" data-pasta="${U.esc(s.caminho)}">${U.esc(s.tipo)}: ${U.esc(s.caminho)}</button>`).join('')}</div>` : ''}
      <label class="campo"><span>Pasta</span><div class="linha" style="flex-wrap:nowrap"><input id="pasta" value="${U.esc(dest.base)}" placeholder="Ex.: C:\\Users\\Nome\\OneDrive  ou  D:\\Vistorias"><button type="button" class="btn" id="procurarPasta">üìÅ Procurar pasta‚Ä¶</button></div></label>
      <div class="acoes"><button class="btn prim" id="salvarPasta">Usar esta pasta</button>${dest.base ? '<button class="btn" id="sinc">Copiar pendentes agora</button><button class="btn" id="desligar">Parar de copiar</button>' : ''}</div></div>

    <div class="card"><h2>üîë Licen√ßa</h2>
      <p style="margin-top:0"><b>${U.esc(lic.nomePlano || lic.status)}</b> ${lic.aviso ? '‚Äî ' + U.esc(lic.aviso) : ''}${lic.mensagem ? `<br>‚ö†Ô∏è ${U.esc(lic.mensagem)}` : ''}${lic.venceBR ? `<br>V√°lida at√© ${U.esc(lic.venceBR)}` : ''}</p>
      <p>C√≥digo da m√°quina: <b id="codigo">${U.esc(lic.codigo)}</b> <button class="btn peq" id="copiar">Copiar</button></p>
      ${lic.status !== 'ativa' || lic.plano !== 'vitalicio' ? `<label class="campo"><span>Chave de ativa√ß√£o</span><input id="chave" placeholder="Cole a chave recebida"></label>
        <div class="acoes"><button class="btn prim" id="ativar">Ativar</button>${v.whatsapp ? `<a class="btn" target="_blank" rel="noopener" href="https://wa.me/${U.esc(v.whatsapp)}?text=${encodeURIComponent((v.mensagem || 'Quero comprar o FND Inspe√ß√£o.') + ' C√≥digo da m√°quina: ' + lic.codigo)}">üí¨ Comprar pelo WhatsApp</a>` : ''}</div>
        ${Object.keys(v.planos || {}).length ? `<div class="sub" style="margin-top:8px">${Object.entries(v.planos).map(([p, x]) => `${U.esc(x.titulo || p)}: ${U.esc(x.preco || 'consulte')}`).join(' ¬∑ ')}</div>` : ''}` : ''}</div>

    <div class="card" id="cardAtu"><h2>‚¨ÜÔ∏è Atualiza√ß√£o</h2>
      <p style="margin-top:0">Vers√£o instalada: <b>${U.esc(atu.versao)}</b>${atu.disponivel ? ` ¬∑ vers√£o nova <b>${U.esc(atu.disponivel.versao)}</b> pronta para instalar` : ''}${atu.erro ? `<br><span class="sub">${U.esc(atu.erro)}</span>` : ''}${atu.verificado_em ? `<br><span class="sub">Verificado em ${new Date(atu.verificado_em).toLocaleString('pt-BR')}</span>` : ''}</p>
      ${atu.disponivel ? `<div class="sub">O que vem na vers√£o nova:</div>${(atu.disponivel.novidades || []).length ? atu.disponivel.novidades.map((n) => `<div class="bloco-versao"><h3>üÜï Vers√£o ${U.esc(n.versao)}</h3><div class="novidades">${U.novidadesHTML(n.texto)}</div></div>`).join('') : `<div class="bloco-versao"><h3>üÜï Vers√£o ${U.esc(atu.disponivel.versao)}</h3><div class="novidades"><p>Melhorias e corre√ß√µes.</p></div></div>`}` : ''}
      ${atu.novidadesInstalada ? `<details class="instalada"><summary>O que mudou na vers√£o instalada (${U.esc(atu.novidadesInstalada.versao)})</summary><div class="novidades">${U.novidadesHTML(atu.novidadesInstalada.texto)}</div></details>` : ''}
      <div class="linha"><select id="prefAtu" style="max-width:320px">${[['auto', 'Atualizar sozinho (recomendado)'], ['avisar', 'S√≥ avisar'], ['desligado', 'Desligado']].map(([k, t]) => `<option value="${k}" ${atu.pref === k ? 'selected' : ''}>${t}</option>`).join('')}</select>
        <button class="btn" id="verificar">Verificar agora</button>${atu.disponivel ? '<button class="btn prim" id="instalar">Instalar agora</button>' : ''}</div></div>

    <form class="card" id="fs"><h2>üîí Trocar minha senha</h2>
      <p class="sub" style="margin-top:0">Seu usu√°rio: <b>${U.esc(ESTADO.usuario ? ESTADO.usuario.usuario : '')}</b></p><div class="grade3">
      <label class="campo"><span>Senha atual</span><input name="atual" type="password" autocomplete="current-password" required></label>
      <label class="campo"><span>Nova senha</span><input name="nova" id="ns1" type="password" autocomplete="new-password" required></label>
      <label class="campo"><span>Repita a nova senha</span><input id="ns2" type="password" autocomplete="new-password" required></label></div>
      <ul class="regras" id="regrasNova" style="max-width:520px"></ul>
      <div class="acoes"><button class="btn">Trocar senha</button></div></form>`;

  const assin = new Assinatura($('#assin')); assin.carregar(cfg.assinatura);
  U.telefones($('#fp'));

  // ---- logo e layout do relat√≥rio ----
  let temaSel = LAYcfg.tema;
  $('#cardRel').style.setProperty('--cor-rel', $('#corRel').value);
  $('#temas').onclick = (e) => { const b = e.target.closest('[data-tema]'); if (!b) return; temaSel = b.dataset.tema; $$('#temas .tema').forEach((x) => x.classList.toggle('ativo', x === b)); };
  $('#cores').onclick = (e) => { const b = e.target.closest('[data-cor]'); if (b) { $('#corRel').value = b.dataset.cor; $('#cardRel').style.setProperty('--cor-rel', b.dataset.cor); } };
  $('#corRel').oninput = (e) => $('#cardRel').style.setProperty('--cor-rel', e.target.value);
  const layoutTela = () => ({ rel_tema: temaSel, rel_cor: $('#corRel').value, rel_fotos_linha: $('#fotosLinha').value, rel_resumo: $('#relResumo').checked ? '1' : '0', rel_assin_cliente: $('#relAssin').checked ? '1' : '0', rel_logo: $('#relLogo').value });
  $('#salvarRel').onclick = async () => { try { await U.api('PUT', '/config', layoutTela()); U.toast('Layout do relat√≥rio salvo', 'ok'); } catch (e) { U.toast(e.message, 'erro'); } };
  $('#previaExemplo').onclick = async () => {
    try {
      U.carregando('Montando o exemplo‚Ä¶');
      const atual = await U.api('GET', '/config');
      const pdf = await Relatorio.gerar(await vistoriaExemplo(), { ...atual, ...layoutTela() }, { previa: true });
      U.carregando(); U.verPDF(pdf, 'Exemplo do relat√≥rio com este layout', { previa: false });
    } catch (e) { U.carregando(); U.toast(e.message, 'erro'); }
  };
  $('#arqLogo').onchange = async (e) => {
    const f = e.target.files[0]; if (!f) return;
    try { const logo = await U.reduzirLogo(f); await U.api('PUT', '/config', { logo, rel_logo: 'propria' }); U.toast('Logo salva', 'ok'); telaConfig(); } catch (err) { U.toast(err.message, 'erro'); }
  };
  if ($('#tirarLogo')) $('#tirarLogo').onclick = async () => { if (await U.confirmar('Remover a logo da empresa?')) { await U.api('PUT', '/config', { logo: '', rel_logo: 'fnd' }); telaConfig(); } };

  // ---- cor do menu (vale para este computador e fica salva na Central) ----
  const salvarCorMenu = async (c) => { aplicarCorMenu(c); try { await U.api('PUT', '/config', { ui_cor_menu: c }); ESTADO.ui_cor_menu = c; } catch (e) { U.toast(e.message, 'erro'); } };
  $('#coresMenu').onclick = (e) => { const b = e.target.closest('[data-cormenu]'); if (b) { $('#corMenu').value = b.dataset.cormenu; salvarCorMenu(b.dataset.cormenu); } };
  $('#corMenu').onchange = (e) => salvarCorMenu(e.target.value);
  $('#corMenu').oninput = (e) => aplicarCorMenu(e.target.value);
  $('#menuPadrao').onclick = () => { $('#corMenu').value = '#0f1f40'; salvarCorMenu(''); };
  $('#limpar').onclick = () => assin.limpar();
  $('#fp').onsubmit = async (e) => { e.preventDefault(); try { await U.api('PUT', '/config', { ...Object.fromEntries(new FormData(e.target)), assinatura: assin.valor() }); U.toast('Dados salvos', 'ok'); carregarEstado(); } catch (err) { U.toast(err.message, 'erro'); } };
  $$('[data-pasta]').forEach((b) => (b.onclick = () => { $('#pasta').value = b.dataset.pasta; }));
  $('#procurarPasta').onclick = async () => {
    U.carregando('Escolha a pasta na janela que abriu‚Ä¶');
    try { const r = await U.api('POST', '/destino/escolher'); if (r.caminho) { $('#pasta').value = r.caminho; U.toast('Pasta escolhida. Clique em "Usar esta pasta" para salvar.'); } }
    catch (e) { U.toast(e.message, 'erro'); } finally { U.carregando(); }
  };
  $('#salvarPasta').onclick = async () => { try { const r = await U.api('PUT', '/destino', { caminho: $('#pasta').value }); U.toast(r.desligado ? 'C√≥pia para a pasta desligada' : 'Pasta definida: ' + r.pasta, 'ok'); telaConfig(); } catch (e) { U.toast(e.message, 'erro'); } };
  if ($('#sinc')) $('#sinc').onclick = async () => { const r = await U.api('POST', '/destino/sincronizar'); U.toast(r.erro ? r.erro : `Copiadas ${r.fotos} foto(s) e ${r.relatorios} relat√≥rio(s)`, r.erro ? 'erro' : 'ok'); telaConfig(); };
  if ($('#desligar')) $('#desligar').onclick = async () => { if (await U.confirmar('Parar de copiar para a pasta? O que j√° foi copiado continua l√°.')) { await U.api('PUT', '/destino', { caminho: '' }); telaConfig(); } };
  $('#copiar').onclick = () => { navigator.clipboard.writeText(lic.codigo).then(() => U.toast('C√≥digo copiado')); };
  if ($('#ativar')) $('#ativar').onclick = async () => { try { await U.api('POST', '/licenca/ativar', { chave: $('#chave').value }); U.toast('Licen√ßa ativada!', 'ok'); carregarEstado(); telaConfig(); } catch (e) { U.toast(e.message, 'erro'); } };
  $('#prefAtu').onchange = async (e) => { try { await U.api('PUT', '/atualizacao/pref', { pref: e.target.value }); U.toast('Prefer√™ncia salva', 'ok'); } catch (err) { U.toast(err.message, 'erro'); } };
  $('#verificar').onclick = async () => { U.carregando('Procurando atualiza√ß√£o‚Ä¶'); await U.api('POST', '/atualizacao/verificar').catch(() => {}); U.carregando(); telaConfig(); };
  if ($('#instalar')) $('#instalar').onclick = async () => {
    if (!(await U.confirmar('Instalar a vers√£o nova agora? A Central reinicia em alguns segundos.'))) return;
    try { await U.api('POST', '/atualizacao/instalar'); U.carregando('Instalando‚Ä¶ a tela volta sozinha.'); setTimeout(() => location.reload(), 12000); } catch (e) { U.toast(e.message, 'erro'); }
  };
  U.olhos($('#fs'));
  const novaOk = U.regrasSenha($('#ns1'), $('#regrasNova'), $('#ns2'));
  $('#fs').onsubmit = async (e) => { e.preventDefault(); if (!novaOk()) return U.toast('A senha nova ainda n√£o cumpre todas as regras.', 'erro'); try { await U.api('POST', '/conta/senha', Object.fromEntries(new FormData(e.target))); U.toast('Senha trocada', 'ok'); e.target.reset(); $$('#regrasNova li').forEach((li) => li.classList.remove('ok')); } catch (err) { U.toast(err.message, 'erro'); } };
}

/* ================= menu lateral: recolher e cor ================= */
const CORES_MENU = ['#0f1f40', '#111827', '#0f3d2e', '#4a1020', '#3b2a5c', '#1f3a4d', '#e9eef5'];
function aplicarCorMenu(hex) {
  const m = /^#([0-9a-f]{6})$/i.exec(hex || '');
  const st = document.documentElement.style;
  if (!m) { ['--menu-a', '--menu-b', '--menu-txt', '--menu-sub'].forEach((k) => st.removeProperty(k)); return; }
  const n = parseInt(m[1], 16), rgb = [n >> 16, (n >> 8) & 255, n & 255];
  const escuro = rgb.map((x) => Math.round(x * 0.55));
  const claro = (0.299 * rgb[0] + 0.587 * rgb[1] + 0.114 * rgb[2]) > 160;   // menu claro: texto escuro
  st.setProperty('--menu-a', claro ? `rgb(${rgb})` : `rgb(${escuro})`);
  st.setProperty('--menu-b', `rgb(${rgb})`);
  st.setProperty('--menu-txt', claro ? '#13213a' : '#dfe8f7');
  st.setProperty('--menu-sub', claro ? '#5f6b7c' : '#9fb2cf');
}
function ligarMenu() {
  let rec = false; try { rec = localStorage.getItem('fndi_menu_recolhido') === '1'; } catch { /* */ }
  $('#sistema').classList.toggle('recolhido', rec);
  $('#recolher').onclick = () => {
    const r = !$('#sistema').classList.contains('recolhido');
    $('#sistema').classList.toggle('recolhido', r);
    try { localStorage.setItem('fndi_menu_recolhido', r ? '1' : '0'); } catch { /* */ }
  };
}

/* ================= vistoria de exemplo (para ver o layout do relat√≥rio) ================= */
async function vistoriaExemplo() {
  const foto = (cor, txt, w = 1200, h = 900) => { const c = document.createElement('canvas'); c.width = w; c.height = h; const x = c.getContext('2d');
    const g = x.createLinearGradient(0, 0, w, h); g.addColorStop(0, cor); g.addColorStop(1, '#ffffff'); x.fillStyle = g; x.fillRect(0, 0, w, h);
    x.fillStyle = 'rgba(0,0,0,.45)'; x.font = 'bold 64px sans-serif'; x.textAlign = 'center'; x.fillText(txt, w / 2, h / 2); return { dataURL: c.toDataURL('image/jpeg', 0.7), largura: w, altura: h }; };
  const f = (id, ref, cor, txt, leg) => ({ id, ref, legenda: leg, tirada_em: U.agoraLocal(), ...foto(cor, txt) });
  return {
    numero: 'VST-2026-0001', revisao: 1, modelo_nome: 'Vistoria de im√≥vel', data_vistoria: U.hojeISO(), status: 'rascunho',
    cliente: { nome: 'Maria Aparecida Lima', documento: '123.456.789-00', telefone: '(11) 97777-1234', email: 'maria@email.com' },
    local_endereco: 'Rua Augusta, 1500 ‚Äî ap. 42 ‚Äî S√£o Paulo/SP', acompanhante: 'Maria Aparecida Lima', objetivo: 'Vistoria de entrada para loca√ß√£o',
    modelo: { titulo: 'Laudo de Vistoria de Im√≥vel', secoes: [
      { id: 'g', titulo: 'Informa√ß√µes gerais', itens: [{ id: 't', rotulo: 'Tipo de im√≥vel', tipo: 'opcoes', opcoes: ['Apartamento'] }, { id: 'a', rotulo: '√Årea aproximada', tipo: 'numero', unidade: 'm¬≤' }, { id: 'e', rotulo: 'Estado geral', tipo: 'avaliacao', escala: 'estado' }] },
      { id: 'amb', titulo: 'Ambientes', repetir: true, rotulo: 'Ambiente', itens: [{ id: 'p', rotulo: 'Piso', tipo: 'avaliacao', escala: 'estado', fotos: true }, { id: 'pa', rotulo: 'Paredes', tipo: 'avaliacao', escala: 'estado', fotos: true, obs: true }, { id: 'el', rotulo: 'Instala√ß√µes el√©tricas', tipo: 'avaliacao', escala: 'estado' }] },
    ] },
    respostas: {
      g: [{ id: 'principal', itens: { t: { v: 'Apartamento' }, a: { v: '68,5' }, e: { v: 'Bom' } } }],
      amb: [{ id: 's', nome: 'Sala', itens: { p: { v: 'Bom' }, pa: { v: 'Regular', obs: 'Pequenas marcas de m√≥veis.' }, el: { v: 'Bom' } } },
        { id: 'c', nome: 'Cozinha', itens: { p: { v: 'Bom' }, pa: { v: 'Ruim', obs: 'Mancha de infiltra√ß√£o acima da pia.' }, el: { v: 'Regular' } } }],
    },
    fotos: [f(-1, 'amb/s/pa', '#9bb7d4', 'Sala', 'Parede da sala'), f(-2, 'amb/c/pa', '#c98f8f', 'Cozinha', 'Infiltra√ß√£o'), f(-3, 'amb/c/pa', '#b9a77a', 'Cozinha 2', ''), f(-4, 'geral', '#8fbf9f', 'Fachada', 'Fachada do pr√©dio')],
    observacoes: 'Im√≥vel entregue limpo. Chaves: 3 c√≥pias.', conclusao: 'O im√≥vel encontra-se em bom estado geral, com as ressalvas registradas.',
    assinatura_cliente: null, cliente_recusou: false,
  };
}

/* ================= in√≠cio ================= */
async function carregarEstado() {
  ESTADO = await U.api('GET', '/estado', undefined, { semLogin: true });
  aplicarCorMenu(ESTADO.ui_cor_menu);
  $('#empresaNome').textContent = ESTADO.empresa || '';
  const L = ESTADO.licenca, av = $('#avisoLicenca');
  av.hidden = !(L.mensagem || L.aviso);
  av.className = 'aviso-topo' + (L.liberado ? '' : ' erro');
  av.innerHTML = L.mensagem || L.aviso ? `${U.esc(L.mensagem || L.aviso)} <a href="#/config">Licen√ßa</a>` : '';
  // vers√£o nova baixada: aviso no topo (com as novidades em Configura√ß√µes ‚Üí Atualiza√ß√£o)
  const A = ESTADO.atualizacao, aa = $('#avisoAtualizacao');
  aa.hidden = !(A && A.disponivel);
  aa.innerHTML = A && A.disponivel ? `üÜï A vers√£o <b>${U.esc(A.disponivel)}</b> do FND Inspe√ß√£o est√° pronta para instalar. <a href="#/config" data-irAtu>Ver as novidades e instalar</a>` : '';
  const ir = $('[data-irAtu]', aa); if (ir) ir.onclick = () => setTimeout(() => { const c = $('#cardAtu'); if (c) c.scrollIntoView({ behavior: 'smooth' }); }, 400);
  $('#rodapeLateral').innerHTML = `${U.esc(ESTADO.usuario ? ESTADO.usuario.nome : '')}<br>vers√£o ${U.esc(ESTADO.versao)} ¬∑ <button id="sair">sair</button>`;
  $('#sair').onclick = async () => { await U.api('POST', '/logout').catch(() => {}); iniciar(); };
}

async function iniciar() {
  try { await carregarEstado(); } catch (e) { document.body.innerHTML = `<div class="card" style="margin:40px">‚ö†Ô∏è ${U.esc(e.message)}</div>`; return; }
  if (!ESTADO.usuario) return telaEntrada(ESTADO.configurado);
  $('#entrada').hidden = true; $('#entrada').innerHTML = ''; $('#sistema').hidden = false;
  ligarMenu();
  rotear();
  mostrarNovidadesSeAtualizou();
}

// depois de atualizar: mostra uma vez "o que mudou nesta vers√£o"
async function mostrarNovidadesSeAtualizou() {
  let vista = null;
  try { vista = localStorage.getItem('fndi_versao_vista'); localStorage.setItem('fndi_versao_vista', ESTADO.versao); } catch { return; }
  if (!vista || vista === ESTADO.versao) return;   // primeira vez neste PC, ou nada mudou
  try {
    const a = await U.api('GET', '/atualizacao');
    if (!a.novidadesInstalada) return;
    const m = U.modal(`<h2>üéâ FND Inspe√ß√£o atualizado para a vers√£o ${U.esc(a.novidadesInstalada.versao)}</h2>
      <div class="novidades">${U.novidadesHTML(a.novidadesInstalada.texto)}</div>
      <div class="acoes" style="justify-content:flex-end"><button class="btn prim" id="okNov">Entendi</button></div>`);
    $('#okNov', m.el).onclick = m.fechar;
  } catch { /* */ }
}

window.addEventListener('hashchange', rotear);
window.addEventListener('fnd-sair', () => iniciar());
// a Central avisa a janela do programa que continua aberta (para o atalho reabrir sem atraso)
setInterval(() => { if (!document.hidden) fetch('/__fnd/ping', { cache: 'no-store' }).catch(() => {}); }, 60000);
iniciar();
'use strict';
/* Editor de modelos de relat√≥rio */
const TIPOS = [
  ['avaliacao', 'Avalia√ß√£o (Bom/Regular/Ruim‚Ä¶)'], ['texto', 'Texto curto'], ['texto_longo', 'Texto longo'], ['numero', 'N√∫mero'],
  ['data', 'Data'], ['sim_nao', 'Sim / N√£o'], ['opcoes', 'Lista (escolhe 1)'], ['multipla', 'Lista (marca v√°rias)'],
];
const NOMES_ESCALA = { estado: 'Bom / Regular / Ruim', conformidade: 'Conforme / N√£o conforme', gravidade: 'Gravidade: Baixa / M√©dia / Alta', propria: 'Minha pr√≥pria escala' };
const CORES = [['verde', 'Verde'], ['amarelo', 'Amarelo'], ['laranja', 'Laranja'], ['vermelho', 'Vermelho'], ['azul', 'Azul'], ['cinza', 'Cinza']];

const Editor = {
  async abrir(id) {
    let m;
    if (id === 'novo') m = { nome: '', prefixo: 'VST', titulo_relatorio: '', descricao: '', estrutura: { secoes: [{ id: U.id(), titulo: 'Itens vistoriados', repetir: false, itens: [{ id: U.id(), rotulo: '', tipo: 'avaliacao', escala: 'estado', fotos: true, obs: true }] }] } };
    else m = await U.api('GET', `/modelos/${id}`);
    const est = structuredClone(m.estrutura);
    const app = $('#app');
    const desenhar = () => {
      app.innerHTML = `
        <div class="topo-pagina"><div><h1>${id === 'novo' ? 'Novo modelo' : 'Editar modelo'}</h1>
          <div class="sub">${m.em_uso ? `Usado em ${m.em_uso} vistoria(s). As que j√° existem n√£o mudam: cada uma guarda a vers√£o do modelo da √©poca.` : 'Monte as se√ß√µes e os itens que v√£o aparecer na vistoria e no relat√≥rio.'}</div></div>
          <div class="linha"><a class="btn" href="#/modelos">Cancelar</a><button class="btn prim" id="salvar">üíæ Salvar modelo</button></div></div>
        <div class="card"><div class="grade2">
          <label class="campo"><span>Nome do modelo *</span><input id="m_nome" value="${U.esc(m.nome)}" maxlength="100" placeholder="Ex.: Vistoria de entrega de chaves"></label>
          <label class="campo"><span>T√≠tulo no relat√≥rio</span><input id="m_titulo" value="${U.esc(m.titulo_relatorio || '')}" maxlength="120" placeholder="Ex.: Laudo de Vistoria"></label>
          <label class="campo"><span>Prefixo da numera√ß√£o</span><input id="m_prefixo" value="${U.esc(m.prefixo)}" maxlength="6" placeholder="VST"><small class="sub">Ex.: VST ‚Üí VST-2026-0001</small></label>
          <label class="campo"><span>Descri√ß√£o</span><input id="m_desc" value="${U.esc(m.descricao || '')}" maxlength="300"></label>
        </div></div>
        <div id="secoes"></div>
        <button class="btn" id="addSecao">Ôºã Adicionar se√ß√£o</button>`;
      $('#secoes').innerHTML = est.secoes.map((s, i) => htmlSecao(s, i)).join('');
      ligar();
    };
    const htmlSecao = (s, i) => `
      <div class="ed-secao" data-s="${i}">
        <div class="cab">
          <div class="linha entre"><b>Se√ß√£o ${i + 1}</b>
            <div class="ed-ord"><button title="Subir" data-acao="sobeS">‚Üë</button><button title="Descer" data-acao="desceS">‚Üì</button><button title="Excluir se√ß√£o" data-acao="delS">‚úï</button></div></div>
          <div class="grade2">
            <label class="campo"><span>T√≠tulo da se√ß√£o *</span><input data-f="titulo" value="${U.esc(s.titulo)}" maxlength="100"></label>
            <div><label class="check" style="margin-top:30px"><input type="checkbox" data-f="repetir" ${s.repetir ? 'checked' : ''}> Repetir esta se√ß√£o (um bloco por ambiente, produto, ocorr√™ncia‚Ä¶)</label></div>
          </div>
          ${s.repetir ? `<div class="grade2">
            <label class="campo"><span>Nome de cada bloco</span><input data-f="rotulo" value="${U.esc(s.rotulo || '')}" maxlength="40" placeholder="Ex.: Ambiente"></label>
            <label class="campo"><span>Sugest√µes de nomes (separe por v√≠rgula)</span><input data-f="sugestoes" value="${U.esc((s.sugestoes || []).join(', '))}" placeholder="Sala, Cozinha, Quarto"></label>
          </div>` : ''}
          <label class="check"><input type="checkbox" data-f="fotos" ${s.fotos ? 'checked' : ''}> Fotos gerais ${s.repetir ? 'de cada bloco' : 'da se√ß√£o'}</label>
        </div>
        <div class="corpo">${s.itens.map((it, j) => htmlItem(it, j)).join('')}
          <button class="btn peq" data-acao="addItem" style="margin-top:8px">Ôºã Adicionar item</button></div>
      </div>`;
    const htmlItem = (it, j) => `
      <div class="ed-item" data-i="${j}">
        <input data-g="rotulo" value="${U.esc(it.rotulo)}" maxlength="150" placeholder="Nome do item (ex.: Piso, Paredes, Validade)">
        <select data-g="tipo">${TIPOS.map(([v, t]) => `<option value="${v}" ${it.tipo === v ? 'selected' : ''}>${t}</option>`).join('')}</select>
        <div class="ed-ord"><button title="Subir" data-acao="sobeI">‚Üë</button><button title="Descer" data-acao="desceI">‚Üì</button><button title="Excluir item" data-acao="delI">‚úï</button></div>
        <div class="extra">
          ${it.tipo === 'avaliacao' ? `<div class="linha"><span class="sub">Escala:</span><select data-g="escala" style="max-width:280px">${Object.entries(NOMES_ESCALA).map(([v, t]) => `<option value="${v}" ${(it.escala || 'estado') === v ? 'selected' : ''}>${t}</option>`).join('')}</select></div>
            ${it.escala === 'propria' ? `<div class="escala-propria" style="margin-top:6px">${(it.opcoes || []).map((o, k) => `<div class="linha"><input data-op="${k}" value="${U.esc(o.t)}" maxlength="40" placeholder="Op√ß√£o"><select data-cor="${k}">${CORES.map(([c, n]) => `<option value="${c}" ${o.c === c ? 'selected' : ''}>${n}</option>`).join('')}</select><button class="btn peq link" data-acao="delOp" data-k="${k}">remover</button></div>`).join('')}
              <div><button class="btn peq" data-acao="addOp">Ôºã op√ß√£o</button></div></div>` : ''}` : ''}
          ${it.tipo === 'opcoes' || it.tipo === 'multipla' ? `<label class="campo"><span>Op√ß√µes (uma por linha)</span><textarea data-g="opcoes" rows="3">${U.esc((it.opcoes || []).join('\n'))}</textarea></label>` : ''}
          ${it.tipo === 'numero' ? `<label class="campo" style="max-width:200px"><span>Unidade</span><input data-g="unidade" value="${U.esc(it.unidade || '')}" maxlength="12" placeholder="m¬≤, ¬∞C, cm"></label>` : ''}
          <label class="check"><input type="checkbox" data-g="fotos" ${it.fotos ? 'checked' : ''}> Permite fotos</label>
          <label class="check"><input type="checkbox" data-g="obs" ${it.obs ? 'checked' : ''}> Permite observa√ß√£o</label>
        </div>
      </div>`;

    // l√™ o que est√° na tela para a estrutura (antes de redesenhar ou salvar)
    const ler = () => {
      m.nome = $('#m_nome').value; m.titulo_relatorio = $('#m_titulo').value; m.prefixo = $('#m_prefixo').value; m.descricao = $('#m_desc').value;
      $$('.ed-secao').forEach((el) => {
        const s = est.secoes[+el.dataset.s];
        s.titulo = $('[data-f=titulo]', el).value;
        s.repetir = $('[data-f=repetir]', el).checked;
        s.fotos = $('[data-f=fotos]', el).checked;
        if ($('[data-f=rotulo]', el)) { s.rotulo = $('[data-f=rotulo]', el).value; s.sugestoes = $('[data-f=sugestoes]', el).value.split(',').map((x) => x.trim()).filter(Boolean); }
        $$('.ed-item', el).forEach((ie) => {
          const it = s.itens[+ie.dataset.i];
          it.rotulo = $('[data-g=rotulo]', ie).value; it.tipo = $('[data-g=tipo]', ie).value;
          it.fotos = $('[data-g=fotos]', ie).checked; it.obs = $('[data-g=obs]', ie).checked;
          if ($('[data-g=escala]', ie)) it.escala = $('[data-g=escala]', ie).value;
          if ($('[data-g=opcoes]', ie)) it.opcoes = $('[data-g=opcoes]', ie).value.split('\n').map((x) => x.trim()).filter(Boolean);
          if ($('[data-g=unidade]', ie)) it.unidade = $('[data-g=unidade]', ie).value;
          if ($('[data-op]', ie)) it.opcoes = $$('[data-op]', ie).map((inp) => ({ t: inp.value, c: $(`[data-cor="${inp.dataset.op}"]`, ie).value }));
        });
      });
    };
    const mover = (lista, i, d) => { const j = i + d; if (j < 0 || j >= lista.length) return; [lista[i], lista[j]] = [lista[j], lista[i]]; };

    const ligar = () => {
      $('#addSecao').onclick = () => { ler(); est.secoes.push({ id: U.id(), titulo: '', repetir: false, itens: [{ id: U.id(), rotulo: '', tipo: 'avaliacao', escala: 'estado', fotos: true, obs: true }] }); desenhar(); };
      $('#secoes').onchange = (e) => {
        // mudar tipo/escala/repetir muda os campos mostrados
        if (e.target.matches('[data-g=tipo], [data-g=escala], [data-f=repetir]')) {
          ler();
          const ie = e.target.closest('.ed-item');
          if (ie) {
            const it = est.secoes[+e.target.closest('.ed-secao').dataset.s].itens[+ie.dataset.i];
            if (it.tipo === 'avaliacao' && !it.escala) it.escala = 'estado';
            if (it.escala === 'propria' && (!Array.isArray(it.opcoes) || typeof it.opcoes[0] !== 'object')) it.opcoes = [{ t: 'Adequado', c: 'verde' }, { t: 'Inadequado', c: 'vermelho' }];
            if ((it.tipo === 'opcoes' || it.tipo === 'multipla') && (!Array.isArray(it.opcoes) || typeof it.opcoes[0] === 'object')) it.opcoes = [];
          }
          desenhar();
        }
      };
      $('#secoes').onclick = (e) => {
        const b = e.target.closest('[data-acao]'); if (!b) return;
        e.preventDefault(); ler();
        const si = +b.closest('.ed-secao').dataset.s, s = est.secoes[si];
        const ie = b.closest('.ed-item'), ii = ie ? +ie.dataset.i : -1;
        switch (b.dataset.acao) {
          case 'sobeS': mover(est.secoes, si, -1); break;
          case 'desceS': mover(est.secoes, si, 1); break;
          case 'delS': if (est.secoes.length > 1 || confirm('Excluir a √∫nica se√ß√£o?')) est.secoes.splice(si, 1); break;
          case 'addItem': s.itens.push({ id: U.id(), rotulo: '', tipo: 'avaliacao', escala: 'estado', fotos: true, obs: true }); break;
          case 'sobeI': mover(s.itens, ii, -1); break;
          case 'desceI': mover(s.itens, ii, 1); break;
          case 'delI': s.itens.splice(ii, 1); break;
          case 'addOp': s.itens[ii].opcoes.push({ t: '', c: 'cinza' }); break;
          case 'delOp': s.itens[ii].opcoes.splice(+b.dataset.k, 1); break;
        }
        desenhar();
      };
      $('#salvar').onclick = async () => {
        ler();
        const corpo = { nome: m.nome, titulo_relatorio: m.titulo_relatorio, prefixo: m.prefixo, descricao: m.descricao, estrutura: est };
        try {
          await U.api(id === 'novo' ? 'POST' : 'PUT', id === 'novo' ? '/modelos' : `/modelos/${id}`, corpo);
          U.toast('Modelo salvo', 'ok'); location.hash = '#/modelos';
        } catch (e) { U.toast(e.message, 'erro'); }
      };
    };
    desenhar();
  },
};
