CREATE TABLE IF NOT EXISTS settings (key TEXT PRIMARY KEY, value TEXT);

CREATE TABLE IF NOT EXISTS users (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  username TEXT NOT NULL UNIQUE COLLATE NOCASE,
  nome TEXT NOT NULL,
  password_hash TEXT NOT NULL,
  role TEXT NOT NULL DEFAULT 'admin',
  created_at TEXT DEFAULT (datetime('now','localtime'))
);

CREATE TABLE IF NOT EXISTS sessions (
  token_hash TEXT PRIMARY KEY,
  user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  expires_at INTEGER NOT NULL
);

CREATE TABLE IF NOT EXISTS auditoria (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  quando TEXT DEFAULT (datetime('now','localtime')),
  usuario TEXT, acao TEXT, alvo TEXT, detalhe TEXT
);

-- modelos de relat\xF3rio (o pr\xF3prio usu\xE1rio cria/edita): estrutura em JSON
CREATE TABLE IF NOT EXISTS modelos (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  nome TEXT NOT NULL,
  descricao TEXT,
  prefixo TEXT NOT NULL DEFAULT 'VST',
  titulo_relatorio TEXT,
  estrutura TEXT NOT NULL,
  ativo INTEGER NOT NULL DEFAULT 1,
  ordem INTEGER NOT NULL DEFAULT 0,
  atualizado_em TEXT DEFAULT (datetime('now','localtime'))
);

CREATE TABLE IF NOT EXISTS clientes (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  nome TEXT NOT NULL,
  documento TEXT, telefone TEXT, email TEXT, endereco TEXT, observacoes TEXT,
  criado_em TEXT DEFAULT (datetime('now','localtime'))
);

-- vistorias / inspe\xE7\xF5es. O modelo \xE9 COPIADO para a vistoria (editar o modelo depois n\xE3o muda relat\xF3rios antigos)
CREATE TABLE IF NOT EXISTS vistorias (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  numero TEXT NOT NULL UNIQUE,
  modelo_id INTEGER REFERENCES modelos(id) ON DELETE SET NULL,
  modelo_nome TEXT NOT NULL,
  modelo TEXT NOT NULL,
  cliente_id INTEGER REFERENCES clientes(id) ON DELETE SET NULL,
  cliente TEXT NOT NULL,
  local_endereco TEXT,
  acompanhante TEXT,
  objetivo TEXT,
  data_vistoria TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT 'rascunho',
  respostas TEXT NOT NULL DEFAULT '{}',
  observacoes TEXT,
  conclusao TEXT,
  assinatura_cliente TEXT,
  cliente_recusou INTEGER NOT NULL DEFAULT 0,
  gps TEXT,
  revisao INTEGER NOT NULL DEFAULT 0,
  pdf_arquivo TEXT,
  destino_pasta TEXT,
  destino_ok INTEGER NOT NULL DEFAULT 0,
  criado_em TEXT DEFAULT (datetime('now','localtime')),
  atualizado_em TEXT DEFAULT (datetime('now','localtime')),
  finalizado_em TEXT
);
CREATE INDEX IF NOT EXISTS ix_vist_status ON vistorias(status, criado_em);
CREATE INDEX IF NOT EXISTS ix_vist_cliente ON vistorias(cliente_id);   -- tela de Clientes (quantas vistorias cada um tem)

CREATE TABLE IF NOT EXISTS aparelhos (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  nome TEXT NOT NULL,
  token_hash TEXT NOT NULL UNIQUE,
  criado_em TEXT DEFAULT (datetime('now','localtime')),
  ultimo_uso TEXT,
  ultimo_ip TEXT
);
CREATE TABLE IF NOT EXISTS convites (
  codigo_hash TEXT PRIMARY KEY,
  expira INTEGER NOT NULL
);
CREATE TABLE IF NOT EXISTS fotos (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  vistoria_id INTEGER NOT NULL REFERENCES vistorias(id) ON DELETE CASCADE,
  ref TEXT NOT NULL DEFAULT 'geral',
  legenda TEXT,
  arquivo TEXT NOT NULL,
  largura INTEGER, altura INTEGER, bytes INTEGER,
  tirada_em TEXT DEFAULT (datetime('now','localtime')),
  destino_ok INTEGER NOT NULL DEFAULT 0,
  destino_arquivo TEXT
);
CREATE INDEX IF NOT EXISTS ix_fotos_vist ON fotos(vistoria_id, ref);
CREATE INDEX IF NOT EXISTS ix_fotos_dest ON fotos(destino_ok);
`);var Po=t=>Z.prepare(`PRAGMA table_info(${t})`).all().map(e=>e.name);Po("sessions").includes("aparelho_id")||Z.exec("ALTER TABLE sessions ADD COLUMN aparelho_id INTEGER");Po("fotos").includes("cliente_uid")||Z.exec("ALTER TABLE fotos ADD COLUMN cliente_uid TEXT");Po("vistorias").includes("cliente_uid")||Z.exec("ALTER TABLE vistorias ADD COLUMN cliente_uid TEXT");Po("vistorias").includes("produtos")||Z.exec("ALTER TABLE vistorias ADD COLUMN produtos TEXT DEFAULT '[]'");Z.exec("CREATE UNIQUE INDEX IF NOT EXISTS ux_fotos_uid ON fotos(vistoria_id, cliente_uid) WHERE cliente_uid IS NOT NULL");Z.exec("CREATE UNIQUE INDEX IF NOT EXISTS ux_vist_uid ON vistorias(cliente_uid) WHERE cliente_uid IS NOT NULL");var jO=Z.prepare("SELECT value FROM settings WHERE key = ?"),qO=Z.prepare("INSERT INTO settings(key, value) VALUES(?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value");function i1(t,e=null){let r=jO.get(t);return r?r.value:e}function a1(t,e){qO.run(t,e==null?null:String(e))}function BO(t){Z.exec("BEGIN IMMEDIATE");try{let e=t();return Z.exec("COMMIT"),e}catch(e){throw Z.exec("ROLLBACK"),e}}var gl=xl.join(FO,"backup");function o1(){let t=`central_${new Date().toISOString().slice(0,10)}.db`,e=xl.join(gl,t);try{vl.unlinkSync(e)}catch{}Z.exec(`VACUUM INTO '${e.replace(/'/g,"''")}'`);let r=vl.readdirSync(gl).filter(n=>/^central_\d{4}-\d{2}-\d{2}\.db$/.test(n)).sort();for(let n of r.slice(0,-14))try{vl.unlinkSync(xl.join(gl,n))}catch{}return e}function MO(){let t=()=>{let e=new Date().toISOString().slice(0,10);if(i1("ultimo_backup")!==e)try{o1(),a1("ultimo_backup",e),n1.info("Backup di\xE1rio feito.")}catch(r){n1.error("Backup: "+r.message)}};setTimeout(t,3e4).unref(),setInterval(t,36e5).unref()}function UO(){Z.prepare("DELETE FROM sessions WHERE expires_at < ?").run(Date.now()),Z.prepare("DELETE FROM convites WHERE expira < ?").run(Date.now()),Z.prepare("DELETE FROM auditoria WHERE quando < datetime('now','-365 days')").run()}s1.exports={db:Z,getSetting:i1,setSetting