// FND Relay â€” FND InspeÃ§Ã£o (Cloudflare, plano grÃ¡tis, sem cartÃ£o).
//
// Liga o CELULAR Ã  Central que estÃ¡ no PC do cliente, de qualquer lugar, sem abrir porta nem mexer em roteador:
// a Central faz uma ligaÃ§Ã£o de SAÃDA atÃ© aqui (WebSocket) e o celular abre um endereÃ§o https normal:
//
//   Central  -> wss://<relay>/c/<rede>   (Authorization: Bearer <CHAVE_RELAY>, X-FND-Segredo: <segredo da rede>)
//   Celular  -> https://<relay>/r/<rede>/...   (o painel da prÃ³pria Central, repassado pelo tÃºnel)
//
// Um Relay atende vÃ¡rias Centrais (uma "rede" de 32 letras para cada). A primeira Central que liga numa rede fica
// DONA dela (guarda o hash do segredo): ninguÃ©m mais consegue ocupar a rede, nem quem tiver a chave do Relay.
//
// Quadros binÃ¡rios no tÃºnel: [tipo 1 byte][id do pedido 4 bytes][dados]
//   Relay -> Central: 1 = pedido (JSON)  2 = pedaÃ§o do corpo  3 = fim do corpo  4 = cancelar
//   Central -> Relay: 5 = resposta (JSON) 6 = pedaÃ§o da resposta 7 = fim da resposta 8 = erro
import { DurableObject } from 'cloudflare:workers';

const VERSAO = '1.1.0';   // 1.1: respostas compactadas passam direto (menos dados no 4G); HSTS
const REDE_RE = /^[a-f0-9]{32}$/;
const PEDACO = 256 * 1024;
const TEMPO_MAX = 120000;
// cabeÃ§alhos do celular que vÃ£o para a Central (o resto fica aqui)
const CAB_IDA = ['accept', 'accept-encoding', 'accept-language', 'content-type', 'content-length', 'cookie', 'if-none-match', 'if-modified-since', 'range', 'x-fnd', 'origin', 'user-agent'];

const enc = new TextEncoder(), dec = new TextDecoder();
function quadro(tipo, id, dados) {
  const d = dados ? (typeof dados === 'string' ? enc.encode(dados) : new Uint8Array(dados)) : new Uint8Array(0);
  const b = new Uint8Array(5 + d.length);
  b[0] = tipo; new DataView(b.buffer).setUint32(1, id >>> 0); b.set(d, 5);
  return b;
}
function igual(a, b) {
  const x = enc.encode(String(a || '')), y = enc.encode(String(b || ''));
  if (x.length !== y.length) return false;
  let r = 0; for (let i = 0; i < x.length; i++) r |= x[i] ^ y[i];
  return r === 0;
}
async function sha256(t) { return [...new Uint8Array(await crypto.subtle.digest('SHA-256', enc.encode(t)))].map((x) => x.toString(16).padStart(2, '0')).join(''); }

const PAGINA_DESLIGADO = `<!doctype html><html lang="pt-BR"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>FND InspeÃ§Ã£o</title><body style="font-family:system-ui,sans-serif;background:#070d1a;color:#dfe8f7;display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0;padding:20px;text-align:center">
<div><h2>O computador do FND InspeÃ§Ã£o estÃ¡ desligado ou sem internet</h2><p>Ligue o PC onde o FND InspeÃ§Ã£o estÃ¡ instalado e tente de novo em alguns segundos.</p>
<p style="color:#9fb2cf;font-size:14px">As fotos tiradas no modo "SÃ³ fotos" ficam guardadas no celular e sÃ£o enviadas quando ele voltar.</p>
<button onclick="location.reload()" style="font-size:16px;padding:10px 18px;border-radius:8px;border:0;background:#1e73e8;color:#fff">Tentar de novo</button></div></body></html>`;

export class SalaInspecao extends DurableObject {
  constructor(ctx, env) {
    super(ctx, env);
    this.pendentes = new Map();   // id -> { resolver, escritor, timer }
    this.seq = 0;
    this.ctx.setWebSocketAutoResponse(new WebSocketRequestResponsePair('ping', 'pong'));
  }

  central() { return this.ctx.getWebSockets('c')[0] || null; }

  async fetch(req) {
    const url = new URL(req.url);
    const m = url.pathname.match(/^\/(c|r)\/([a-f0-9]{32})(\/.*)?$/);
    if (!m) return new Response('EndereÃ§o invÃ¡lido.', { status: 404 });

    // ---------- a Central se conecta ----------
    if (m[1] === 'c') {
      if (req.headers.get('Upgrade') !== 'websocket') return new Response('Use WebSocket.', { status: 426 });
      const chave = (req.headers.get('Authorization') || '').replace(/^Bearer\s+/i, '');
      if (!this.env.CHAVE_RELAY || !igual(chave, this.env.CHAVE_RELAY)) return new Response('Chave do Relay incorreta.', { status: 401 });
      const segredo = req.headers.get('X-FND-Segredo') || '';
      if (!/^[a-f0-9]{64}$/.test(segredo)) return new Response('Segredo da rede invÃ¡lido.', { status: 400 });
      const h = await sha256(segredo), dono = await this.ctx.storage.get('dono');
      if (dono && dono !== h) return new Response('Esta rede pertence a outra Central.', { status: 403 });
      if (!dono) await this.ctx.storage.put('dono', h);
      for (const ws of this.ctx.getWebSockets('c')) { try { ws.close(1012, 'Central reconectou'); } catch { /* */ } }
      const [cliente, servidor] = Object.values(new WebSocketPair());
      this.ctx.acceptWebSocket(servidor, ['c']);
      return new Response(null, { status: 101, webSocket: cliente });
    }

    // ---------- o celular pede uma pÃ¡gina / API ----------
    const c = this.central();
    if (!c) {
      const html = (req.headers.get('Accept') || '').includes('text/html');
      return html ? new Response(PAGINA_DESLIGADO, { status: 503, headers: { 'content-type': 'text/html; charset=utf-8', 'cache-control': 'no-store' } })
        : Response.json({ erro: 'O computador do FND InspeÃ§Ã£o estÃ¡ desligado ou sem internet.', desligado: true }, { status: 503 });
    }
    const id = (this.seq = (this.seq % 0xfffffff0) + 1);
    const cab = {};
    for (const k of CAB_IDA) { const v = req.headers.get(k); if (v) cab[k] = v; }
    const pedido = { m: req.method, p: (m[3] || '/') + url.search, h: cab, ip: req.headers.get('CF-Connecting-IP') || '', prefixo: `/r/${m[2]}`, origem: url.origin };

    const resposta = new Promise((resolver, rejeitar) => {
      const timer = setTimeout(() => { this.pendentes.delete(id); rejeitar(new Error('tempo')); }, TEMPO_MAX);
      this.pendentes.set(id, { resolver, rejeitar, timer, escritor: null });
    });
    try {
      c.send(quadro(1, id, JSON.stringify(pedido)));
      if (req.body && !['GET', 'HEAD'].includes(req.method)) {
        const leitor = req.body.getReader();
        for (;;) {
          const { done, value } = await leitor.read();
          if (done) break;
          for (let i = 0; i < value.length; i += PEDACO) c.send(quadro(2, id, value.subarray(i, i + PEDACO)));
        }
      }
      c.send(quadro(3, id));
    } catch {
      this.terminar(id);
      return Response.json({ erro: 'A conexÃ£o com o computador caiu. Tente de novo.' }, { status: 502 });
    }
    try { return await resposta; } catch {
      try { c.send(quadro(4, id)); } catch { /* */ }
      return Response.json({ erro: 'O computador demorou para responder. Tente de novo.' }, { status: 504 });
    }
  }

  terminar(id) { const p = this.pendentes.get(id); if (p) { clearTimeout(p.timer); this.pendentes.delete(id); } return p; }

  webSocketMessage(ws, msg) {
    if (typeof msg === 'string') return;
    const b = new Uint8Array(msg);
    if (b.length < 5) return;
    const tipo = b[0], id = new DataView(b.buffer, b.byteOffset, b.byteLength).getUint32(1), dados = b.subarray(5);
    const p = this.pendentes.get(id);
    if (!p) return;
    if (tipo === 5) {   // comeÃ§o da resposta: status e cabeÃ§alhos
      let r; try { r = JSON.parse(dec.decode(dados)); } catch { return; }
      const { readable, writable } = new TransformStream();
      p.escritor = writable.getWriter();
      const h = new Headers();
      for (const [k, v] of Object.entries(r.h || {})) for (const x of [].concat(v)) h.append(k, x);
      h.set('X-Content-Type-Options', 'nosniff');
      h.set('Referrer-Policy', 'no-referrer');
      h.set('Strict-Transport-Security', 'max-age=31536000');
      clearTimeout(p.timer);
      // jÃ¡ veio compactada da Central (gzip/br): repassa os bytes como estÃ£o (sem compactar de novo)
      const op = { status: r.s, headers: h };
      if (h.get('content-encoding')) op.encodeBody = 'manual';
      p.resolver(new Response([101, 204, 304].includes(r.s) || r.m === 'HEAD' ? null : readable, op));
      if ([204, 304].includes(r.s)) { this.terminar(id); try { p.escritor.close(); } catch { /* */ } }
    } else if (tipo === 6 && p.escritor) {
      p.escritor.write(dados.slice()).catch(() => {});
    } else if (tipo === 7) {
      this.terminar(id);
      if (p.escritor) p.escritor.close().catch(() => {});
    } else if (tipo === 8) {
      this.terminar(id);
      if (p.escritor) p.escritor.abort(new Error('falhou')).catch(() => {});
      else p.resolver(Response.json({ erro: dec.decode(dados) || 'Erro no computador.' }, { status: 502 }));
    }
  }

  fechou() {
    // a Central caiu: tudo que estava esperando resposta termina com erro
    for (const [id, p] of this.pendentes) {
      this.terminar(id);
      if (p.escritor) p.escritor.abort(new Error('Central desconectou')).catch(() => {});
      else p.resolver(Response.json({ erro: 'O computador desconectou. Tente de novo.' }, { status: 502 }));
    }
  }
  webSocketClose(ws, code) { this.fechou(); try { ws.close(code === 1005 || code === 1006 ? 1000 : code, 'fim'); } catch { /* */ } }
  webSocketError() { this.fechou(); }
}

export default {
  async fetch(req, env) {
    const url = new URL(req.url);
    const m = url.pathname.match(/^\/(c|r)\/([a-f0-9]{32})(\/.*)?$/);
    if (!m) {
      if (/^\/r\/[a-f0-9]{32}$/.test(url.pathname)) return Response.redirect(url.origin + url.pathname + '/' + url.search, 301);
      return new Response(`FND Relay (FND InspeÃ§Ã£o) ${VERSAO} â€” funcionando.`, { headers: { 'content-type': 'text/plain; charset=utf-8' } });
    }
    if (!REDE_RE.test(m[2])) return new Response('Rede invÃ¡lida.', { status: 400 });
    return env.SALA.get(env.SALA.idFromName(m[2])).fetch(req);
  },
};
