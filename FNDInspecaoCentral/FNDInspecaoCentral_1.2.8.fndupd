      RelatÃ³rios\\   INS-2026-0001 - Restaurante Bom Sabor.pdf
  Todos os relatÃ³rios\\2026\\   (todos os PDFs juntos)`;
}

/* ================= avisos de fotos do celular (sÃ³ no PC) ================= */
const podeNotificar = () => 'Notification' in window && Notification.permission === 'granted';
function mostrarNotificacao(n) {
  U.toast(`${n.titulo} â€” ${n.texto}`, n.alerta ? 'erro' : 'ok');
  if (!podeNotificar() || (!document.hidden && document.hasFocus())) return;
  try {
    const w = new Notification(n.titulo, { body: n.texto, tag: n.alerta ? 'fndi-alerta-' + Date.now() : 'fndi-fotos-' + n.vid, icon: 'img/app-192.png', requireInteraction: !!n.alerta });
    w.onclick = () => { window.focus(); location.hash = n.ir || '#/v/' + n.vid; w.close(); };
  } catch { /* navegador sem suporte */ }
}
let ouvindoNotif = false;
function ouvirNotificacoes() {
  if (U.CELULAR || ouvindoNotif) return;
  ouvindoNotif = true;
  U.aoVivo((l) => l.filter((x) => x.tipo === 'notificacao').forEach(mostrarNotificacao));
}
function cartaoNotificacoes() {
  const perm = $('#notifPermissao'); if (!perm) return;
  const desenhar = () => {
    if (!('Notification' in window)) perm.innerHTML = '<span class="sub">Este navegador nÃ£o mostra avisos do Windows (o aviso aparece sÃ³ dentro do painel).</span>';
    else if (Notification.permission === 'granted') perm.innerHTML = '<span class="sub">âœ… Avisos do Windows permitidos</span>';
    else if (Notification.permission === 'denied') perm.innerHTML = '<span class="sub">âš ï¸ Os avisos estÃ£o bloqueados nesta janela. Libere em â‹® â†’ ConfiguraÃ§Ãµes do site â†’ NotificaÃ§Ãµes.</span>';
    else { perm.innerHTML = '<button class="btn prim" id="notifPedir">Permitir avisos do Windows</button>'; $('#notifPedir').onclick = async () => { await Notification.requestPermission(); U.reabrirAoVivo(); desenhar(); }; }
  };
  desenhar();
  $('#notifLigado').onchange = async (e) => {
    try {
      const r = await U.api('PUT', '/notificacoes', { ligado: e.target.checked }); ESTADO.notif_pc = r.ligado;
      if (r.ligado && 'Notification' in window && Notification.permission === 'default') { await Notification.requestPermission(); U.reabrirAoVivo(); desenhar(); }
      U.toast(r.ligado ? 'Avisos de fotos ligados' : 'Avisos de fotos desligados', 'ok');
    } catch (err) { U.toast(err.message, 'erro'); }
  };
  $('#notifTestar').onclick = async () => {
    if ('Notification' in window && Notification.permission === 'default') { await Notification.requestPermission(); U.reabrirAoVivo(); desenhar(); }
    const n = { vid: 0, titulo: 'ðŸ“· 3 fotos novas do celular', texto: 'Exemplo Â· teste de aviso' };
    U.toast(`${n.titulo} â€” ${n.texto}`, 'ok');
    if (podeNotificar()) { try { new Notification(n.titulo, { body: n.texto, tag: 'fndi-teste', icon: 'img/app-192.png' }); } catch { /* */ } }
  };
}

/* ================= celular: FND Relay e pareamento (cartÃ£o em ConfiguraÃ§Ãµes, sÃ³ no PC) ================= */
async function cartaoCelular() {
  const el = $('#cardCel'); if (!el) return;
  let r;
  try { r = await U.api('GET', '/relay'); } catch (e) { el.innerHTML = `<h2>ðŸ“± Celular (FND Relay)</h2><p>âš ï¸ ${U.esc(e.message)}</p>`; return; }
  if (!$('#cardCel')) return;
  const st = !r.configurado ? 'âšª Ainda nÃ£o configurado' : !r.ligado ? 'âšª Desligado' : r.conectado ? 'ðŸŸ¢ Conectado â€” o celular jÃ¡ consegue abrir' : `ðŸ”´ Sem conexÃ£o com o Relay${r.erro ? ` (${U.esc(r.erro)})` : ' (tentandoâ€¦)'}`;
  el.innerHTML = `<h2>ðŸ“± Celular (FND Relay)</h2>
    <p class="sub" style="margin-top:0">O celular abre o FND InspeÃ§Ã£o deste computador de qualquer lugar (4G, outra rede), sem mexer no roteador. Fotos tiradas sem internet ficam guardadas no celular e chegam aqui depois.</p>
    <p><b>${st}</b></p>
    <div class="grade2">
      <label class="campo"><span>EndereÃ§o do Relay</span><input id="relUrl" value="${U.esc(r.url)}" placeholder="https://fnd-inspecao-relay.seu-nome.workers.dev" spellcheck="false"></label>
      <label class="campo"><span>Chave do Relay</span><input id="relChave" type="password" autocomplete="off" spellcheck="false" placeholder="${r.temChave ? 'â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢ (jÃ¡ salva â€” deixe em branco para manter)' : 'a que estÃ¡ no chave_relay.txt'}"></label>
    </div>
    <label class="check"><input type="checkbox" id="relLigado" ${r.ligado || !r.configurado ? 'checked' : ''}> Ligado (deixar o celular acessar este computador)</label>
    ${r.acordado && r.acordado.suportado ? `<label class="check"><input type="checkbox" id="relAcordado" ${r.acordado.ligado ? 'checked' : ''}> NÃ£o deixar este computador dormir (suspensÃ£o) enquanto o celular estiver ligado <span class="sub">â€” a tela ainda pode apagar</span></label>` : ''}
    <div class="acoes"><button class="btn prim" id="relSalvar">Salvar e conectar</button>${r.configurado ? '<button class="btn" id="relReconectar">ðŸ”„ Reconectar</button>' : ''}</div>
    ${r.quedas && r.quedas.length ? `<details class="quedas"><summary>Quedas recentes da conexÃ£o (${r.quedas.length})</summary><ul>${r.quedas.map((q) => `<li>${U.esc(new Date(q.quando).toLocaleString('pt-BR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }))} â€” ${U.esc(q.motivo)}</li>`).join('')}</ul><p class="sub">A Central reconecta sozinha em poucos segundos. Muitas quedas seguidas indicam internet instÃ¡vel neste computador.</p></details>` : ''}
    <h3 style="margin-top:18px">Celulares pareados</h3>
    ${r.aparelhos.length ? `<table class="tabela"><thead><tr><th>Aparelho</th><th class="opcional">Pareado em</th><th>Ãšltimo uso</th><th></th></tr></thead><tbody>
      ${r.aparelhos.map((a) => `<tr><td>ðŸ“± <b>${U.esc(a.nome)}</b><div class="sub">${a.logado ? 'ðŸŸ¢ logado' : 'âšª precisa entrar com a senha'}</div></td><td class="opcional">${U.esc(U.dataHoraBR ? U.dataHoraBR(a.criado_em) : a.criado_em)}</td><td>${U.esc(a.ultimo_uso ? (U.dataHoraBR ? U.dataHoraBR(a.ultimo_uso) : a.ultimo_uso) : 'â€”')}</td>
        <td style="text-align:right;white-space:nowrap">${a.logado ? `<button class="btn peq" data-sairap="${a.id}" data-nome="${U.esc(a.nome)}" title="O celular continua pareado, mas precisa digitar a senha de novo">ðŸ”’ Pedir login de novo</button> ` : ''}<button class="btn peq perigo" data-remap="${a.id}" data-nome="${U.esc(a.nome)}">Remover</button></td></tr>`).join('')}</tbody></table>`
      : '<p class="sub">Nenhum celular pareado ainda.</p>'}
    <label class="campo" style="max-width:600px"><span>Login no celular</span><select id="loginDias">
      ${[['0', 'NÃ£o vence enquanto o celular estiver pareado (recomendado)'], ['90', 'Pedir a senha se ficar 90 dias sem usar'], ['30', 'Pedir a senha se ficar 30 dias sem usar']].map(([k, t]) => `<option value="${k}" ${r.login_dias === k ? 'selected' : ''}>${t}</option>`).join('')}</select></label>
    <p class="sub" style="margin-top:4px">O login se renova sozinho cada vez que o celular usa o app. Para cortar o acesso na hora, use <b>Remover</b> ou <b>Pedir login de novo</b>.</p>
    <div class="acoes"><button class="btn prim" id="parear" ${r.conectado ? '' : 'disabled title="Conecte o Relay primeiro"'}>ðŸ“± Parear um celular</button></div>
    <details class="relay-proprio"${r.configurado ? '' : ' open'}><summary><b>â˜ï¸ Criar meu relay</b> (na sua conta Cloudflare, sem instalar nada)</summary>
      <ol class="passos-parear">
        <li>Crie a sua conta grÃ¡tis em <b>dash.cloudflare.com</b> (ou entre nela).</li>
        <li>Abra <b>dash.cloudflare.com/profile/api-tokens</b> â†’ <b>Create Token</b> â†’ no modelo <b>"Edit Cloudflare Workers"</b> clique em <b>Use template</b>.</li>
        <li>Em <b>Account Resources</b> deixe a sua conta, clique em <b>Continue to summary</b> â†’ <b>Create Token</b> e <b>copie</b> o token.</li>
        <li>Cole aqui embaixo e clique em <b>Criar relay</b>. O token Ã© usado sÃ³ agora e <b>nÃ£o fica guardado</b>.</li>
      </ol>
      <div class="grade2">
        <label class="campo"><span>Token da Cloudflare</span><input id="cfToken" type="password" autocomplete="off" spellcheck="false" placeholder="cole o token aqui"></label>
        <label class="campo"><span>Nome do subdomÃ­nio (opcional)</span><input id="cfSub" maxlength="63" spellcheck="false" placeholder="ex.: minha-empresa"></label>
      </div>
      <p class="sub" style="margin-top:2px">O subdomÃ­nio sÃ³ Ã© usado se a conta ainda nÃ£o tiver um. Fica no endereÃ§o: fnd-inspecao-relay.<b>nome</b>.workers.dev</p>
      <div class="acoes"><button class="btn prim" id="cfCriar">â˜ï¸ Criar relay</button></div>
    </details>`;
  $('#relSalvar').onclick = async () => {
    const corpo = { url: $('#relUrl').value, ligado: $('#relLigado').checked };
    if ($('#relChave').value.trim()) corpo.chave = $('#relChave').value.trim();
    try {
      await U.api('PUT', '/relay', corpo); U.toast('Relay salvo. Conectandoâ€¦', 'ok');
      for (let i = 0; i < 16; i++) { await new Promise((ok) => setTimeout(ok, 500)); const x = await U.api('GET', '/relay'); if (x.conectado || x.erro || !x.ligado) break; }
      cartaoCelular();
    } catch (e) { U.toast(e.message, 'erro'); }
  };
  const ra = $('#relAcordado'); if (ra) ra.onchange = async (e) => { try { await U.api('PUT', '/relay/acordado', { ligado: e.target.checked }); U.toast(e.target.checked ? 'O computador nÃ£o vai mais dormir sozinho' : 'O computador volta a dormir normalmente', 'ok'); } catch (err) { U.toast(err.message, 'erro'); } };
  const rc = $('#relReconectar'); if (rc) rc.onclick = async () => { await U.api('POST', '/relay/reconectar').catch(() => {}); setTimeout(cartaoCelular, 1500); };
  $('#loginDias').onchange = async (e) => { try { await U.api('PUT', '/relay/login', { dias: e.target.value }); U.toast('Prazo do login no celular salvo', 'ok'); } catch (err) { U.toast(err.message, 'erro'); } };
  el.onclick = async (e) => {
    const sa = e.target.closest('[data-sairap]');
    if (sa) {
      if (!(await U.confirmar(`Pedir a senha de novo em "${sa.dataset.nome}"? Ele continua pareado; sÃ³ precisa entrar de novo com usuÃ¡rio e senha.`, { ok: 'Pedir login de novo' }))) return;
      try { await U.api('POST', `/aparelhos/${sa.dataset.sairap}/sair`); U.toast('Pronto: o celular vai pedir a senha', 'ok'); cartaoCelular(); } catch (err) { U.toast(err.message, 'erro'); }
      return;
    }
    const b = e.target.closest('[data-remap]'); if (!b) return;
    if (!(await U.confirmar(`Remover "${b.dataset.nome}"? Ele perde o acesso na hora (as fotos que jÃ¡ chegaram continuam aqui).`, { ok: 'Remover', perigo: true }))) return;
    try { await U.api('DELETE', `/aparelhos/${b.dataset.remap}`); U.toast('Celular removido', 'ok'); cartaoCelular(); } catch (err) { U.toast(err.message, 'erro'); }
  };
  $('#parear').onclick = () => modalParear(r.aparelhos.length);
  $('#cfCriar').onclick = () => criarRelayProprio(false);
}

async function criarRelayProprio(forcar) {
  const token = $('#cfToken').value.trim(), subdominio = $('#cfSub').value.trim();
  if (!token) { U.toast('Cole o token da Cloudflare', 'erro'); $('#cfToken').focus(); return; }
  U.carregando('Criando o relay na Cloudflareâ€¦ (pode levar atÃ© 1 minuto)');
  let r;
  try { r = await U.api('POST', '/relay/proprio', { token, subdominio, forcar }); }
  catch (e) {
    U.carregando();
    if (/jÃ¡ tem um FND Relay/.test(e.message) && !forcar) {
      if (await U.confirmar(e.message + '\n\nSubstituir o relay dessa conta?', { ok: 'Substituir', perigo: true })) return criarRelayProprio(true);
      return;
    }
    U.toast(e.message, 'erro'); return;
  }
  U.carregando();
  $('#cfToken').value = '';
  const c = r.criado;
  const m = U.modal(`<h2>â˜ï¸ Seu relay foi criado</h2>
    <p>${r.conectado ? 'ðŸŸ¢ Esta Central jÃ¡ estÃ¡ <b>conectada</b> nele.' : c.respondeu ? 'â³ Conectandoâ€¦' : 'â³ O endereÃ§o novo pode levar alguns minutos para aparecer na internet. A Central fica tentando sozinha.'}</p>
    <label class="campo"><span>EndereÃ§o</span><input readonly value="${U.esc(c.url)}"></label>
    <label class="campo"><span>Chave (guarde: Ã© a senha deste relay)</span><input readonly id="cfChave" value="${U.esc(c.chave)}" style="font-family:Consolas,monospace"></label>
    <p class="sub">Guarde a chave junto com o endereÃ§o (ex.: no COFRE). Ela sÃ³ Ã© mostrada agora; para ligar outra Central neste mesmo relay vocÃª vai precisar dela.</p>
    <div class="acoes" style="justify-content:flex-end"><button class="btn" id="cfCopiar">Copiar chave</button><button class="btn" id="cfBaixar">â¬‡ï¸ Baixar chave_relay.txt</button><button class="btn prim" id="cfOk">Pronto</button></div>`);
  $('#cfCopiar', m.el).onclick = () => navigator.clipboard.writeText(c.chave).then(() => U.toast('Chave copiada'));
  $('#cfBaixar', m.el).onclick = () => { const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([`EndereÃ§o: ${c.url}\r\nChave: ${c.chave}\r\n`], { type: 'text/plain' })); a.download = 'chave_relay.txt'; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 2000); };
  $('#cfOk', m.el).onclick = () => { m.fechar(); cartaoCelular(); };
}

async function modalParear(qtdAntes) {
  let c;
  try { c = await U.api('POST', '/aparelhos/convite'); } catch (e) { U.toast(e.message, 'erro'); return; }
  const m = U.modal(`<h2>ðŸ“± Parear um celular</h2>
    <div class="qr-parear" data-url="${U.esc(c.url)}">${c.qr}</div>
    <div class="codigo-parear">CÃ³digo: <b id="codParear">${U.esc(c.codigo)}</b></div>
    <div class="abas-sis"><b>Android</b>
    <ol class="passos-parear">
      <li>Aponte a <b>cÃ¢mera</b> para o QR e toque no link.</li>
      <li>Toque em <b>Parear com o computador</b> e entre com o mesmo usuÃ¡rio e senha daqui.</li>
      <li>No Chrome: <b>â‹® â†’ Adicionar Ã  tela inicial</b> (vira um app).</li>
    </ol>
    <b>iPhone</b>
    <ol class="passos-parear">
      <li>Aponte a <b>cÃ¢mera</b> para o QR e toque no link (abre o Safari).</li>
      <li>Toque em <b>Compartilhar â¬†ï¸ â†’ Adicionar Ã  Tela de InÃ­cio</b>.</li>
      <li>Abra o <b>Ã­cone do FND InspeÃ§Ã£o</b> e digite o cÃ³digo acima.</li>
    </ol></div>
    <p class="sub" id="qrValidade"></p>
    <div class="acoes" style="justify-content:flex-end"><button class="btn" id="copiarLink">Copiar link</button><button class="btn prim" id="fecharQr">Fechar</button></div>`);
  const fim = c.expira;
  let vivo = true;
  const fechar = () => { vivo = false; m.fechar(); cartaoCelular(); };
  $('#fecharQr', m.el).onclick = fechar;
  $('#copiarLink', m.el).onclick = () => navigator.clipboard.writeText(c.url).then(() => U.toast('Link copiado (mande pelo WhatsApp para o celular)'));
  // espera o celular parear (ou o QR vencer)
  while (vivo && document.body.contains(m.el)) {
    const falta = Math.max(0, Math.round((fim - Date.now()) / 1000));
    const v = $('#qrValidade', m.el); if (v) v.textContent = falta ? `O QR vale por mais ${Math.floor(falta / 60)}:${String(falta % 60).padStart(2, '0')} e serve para um celular sÃ³.` : 'Este QR venceu. Feche e gere outro.';
    if (!falta) break;
    try { const r = await U.api('GET', '/relay'); if (r.aparelhos.length > qtdAntes) { U.toast(`âœ… ${r.aparelhos[r.aparelhos.length - 1].nome} pareado!`, 'ok'); fechar(); return; } } catch { /* */ }
    await new Promise((ok) => setTimeout(ok, 2000));
  }
}

// pasta de fotos (modo SÃ³ fotos) â†’ vistoria completa com outro modelo
async function transformarEmVistoria(id) {
  if (saidaPendente) { try { await saidaPendente(); } catch { /* */ } }
  let ms;
  try { ms = (await U.api('GET', '/modelos')).filter((x) => x.ativo && x.prefixo !== 'FOT'); } catch (e) { U.toast(e.message, 'erro'); return; }
  const m = U.modal(`<h2>ðŸ“‹ Transformar em vistoria completa</h2>
    <p class="sub">As fotos continuam (como fotos gerais). Escolha o modelo do relatÃ³rio:</p>
    <div class="lista-modelos">${ms.map((x) => `<button class="btn" data-mod="${x.id}" style="width:100%;justify-content:flex-start;margin:4px 0"><b>${U.esc(x.nome)}</b></button>`).join('')}</div>
    <div class="acoes" style="justify-content:flex-end"><button class="btn" id="cancelaMod">Cancelar</button></div>`);
  $('#cancelaMod', m.el).onclick = m.fechar;
  m.el.onclick = async (e) => {
    const b = e.target.closest('[data-mod]'); if (!b) return;
    try { await U.api('POST', `/vistorias/${id}/modelo`, { modelo_id: +b.dataset.mod }); m.fechar(); saidaPendente = null; U.toast('Agora Ã© uma vistoria completa', 'ok');
      if (location.hash === `#/v/${id}`) rotear(); else location.hash = `#/v/${id}`; } catch (err) { U.toast(err.message, 'erro'); }
  };
}
document.addEventListener('click', (e) => { const b = e.target.closest('[data-transformar]'); if (b) transformarEmVistoria(+b.dataset.transformar); });

/* ================= celular: inÃ­cio e modo "SÃ³ fotos" ================= */
function faixaFila(r) {
  if (!r || (!r.fotos && !r.pastas)) return `<div class="fila-ok">${U.ico('ok')} Tudo enviado para o computador</div>`;
  const dias = r.horasEsperando >= 24 ? Math.floor(r.horasEsperando / 24) : 0;
  const velho = dias ? `<div class="fila-velha">${U.ico('alerta')} HÃ¡ fotos esperando hÃ¡ <b>${dias === 1 ? 'mais de 1 dia' : dias + ' dias'}</b>. Elas ainda estÃ£o <b>sÃ³ neste celular</b>: conecte Ã  internet com o computador ligado para enviar.</div>` : '';
  return `<div class="fila-pend">${r.enviando ? U.ico('envio') + ' Enviando' : U.ico('espera') + ' Esperando conexÃ£o para enviar'}: <b>${r.fotos}</b> foto(s)${r.pastas ? ` e ${r.pastas} pasta(s)` : ''}${r.comErro ? ` Â· ${r.comErro} com problema` : ''}
    ${!r.enviando && r.erro ? `<div class="sub">${U.esc(r.erro)}</div>` : ''}
    ${r.fotos && location.hash !== '#/fila' ? '<a class="btn peq" href="#/fila" style="margin-top:8px">Ver as fotos que estÃ£o esperando</a>' : ''}</div>${velho}`;
}
let pararOuvirFila = null;
function ouvirFila(fn) { if (pararOuvirFila) pararOuvirFila(); pararOuvirFila = Fila.ouvir(fn); Fila.resumo().then(fn).catch(() => {}); }

async function telaInicioCelular() {
  $('#app').innerHTML = `<div class="inicio-cel">
    <div class="sub" style="text-align:center">${U.esc(ESTADO.empresa || '')}</div>
    <a class="botao-grande" href="#/fotos"><span>${U.ico('camera')}</span><b>SÃ³ fotos</b><small>Tirar fotos e mandar para o computador, organizadas por pasta</small></a>
    <a class="botao-grande sec" href="#/vistorias"><span>${U.ico('prancheta')}</span><b>Vistoria completa</b><small>Preencher o relatÃ³rio, avaliaÃ§Ãµes, assinatura e PDF</small></a>
    <div id="faixaFila"></div>
    <div class="sub" style="text-align:center;margin-top:6px">FND InspeÃ§Ã£o v${U.esc(ESTADO.versao || '')}</div>
    ${ESTADO.offline ? `<div class="aviso-offline">ðŸ“´ ${ESTADO.semInternet ? '<b>O celular estÃ¡ sem internet.</b>' : '<b>O computador nÃ£o respondeu</b> (desligado, dormindo ou sem internet).'} O modo <b>SÃ³ fotos</b> funciona assim mesmo: as fotos ficam no celular e vÃ£o quando a conexÃ£o voltar.
      <div><button class="btn peq" id="tentarConexao" style="margin-top:8px">ðŸ”„ Tentar agora</button></div></div>` : ''}
    ${ESTADO.offline ? '' : `<button class="btn sair-cel" id="sairCel">${U.ico('sair')} Sair do app</button>`}
  </div>`;
  const tc = $('#tentarConexao'); if (tc) tc.onclick = async () => { tc.disabled = true; tc.textContent = 'Tentandoâ€¦'; if (!(await tentarVoltar())) { tc.disabled = false; tc.textContent = 'ðŸ”„ Tentar agora'; U.toast('Ainda sem conexÃ£o com o computador', 'erro'); } };
  const sc = $('#sairCel'); if (sc) sc.onclick = sairDoCelular;
  ouvirFila((r) => { const f = $('#faixaFila'); if (f) f.innerHTML = faixaFila(r); });
}

// pastas guardadas NO CELULAR (para aparecerem sem internet): a lista do computador + toda pasta criada ou aberta aqui
const CH_PASTAS = () => 'fndi_pastas_' + location.pathname;
const pastasGuardadas = () => { try { return JSON.parse(localStorage.getItem(CH_PASTAS()) || '[]'); } catch { return []; } };
const resumoPasta = (v) => ({ id: v.id, cliente: v.cliente && typeof v.cliente === 'object' ? v.cliente.nome : v.cliente, numero: v.numero, local_endereco: v.local_endereco || '', fotos: Array.isArray(v.fotos) ? v.fotos.length : v.fotos });
function guardarPastas(l) {   // lista que veio do computador (mantÃ©m as abertas aqui que nÃ£o vieram nela)
  const novas = l.map(resumoPasta), ids = new Set(novas.map((x) => x.id));
  try { localStorage.setItem(CH_PASTAS(), JSON.stringify([...novas, ...pastasGuardadas().filter((x) => !ids.has(x.id))].slice(0, 60))); } catch { /* */ }
}
function lembrarPasta(v) {   // pasta criada ou aberta: vai para o topo da lista guardada
  const r = resumoPasta(v);
  try { localStorage.setItem(CH_PASTAS(), JSON.stringify([r, ...pastasGuardadas().filter((x) => x.id !== r.id)].slice(0, 60))); } catch { /* */ }
}

// fotos que estÃ£o sÃ³ no celular (sem internet / PC desligado), separadas por pasta
async function telaFila() {
  $('#app').innerHTML = `<div class="topo-pagina"><div><h1>${U.ico('espera')} Fotos esperando envio</h1>
      <div class="sub">EstÃ£o guardadas neste celular e vÃ£o para o computador sozinhas quando a conexÃ£o voltar.</div></div>
      <a class="btn" href="#/fotos">â† Pastas</a></div><div id="faixaFila"></div>
    <div class="card" id="cardCopia" hidden><div class="linha entre"><div><b>CÃ³pia de seguranÃ§a</b><div class="sub" id="protecao"></div>
      <div class="sub">${/iPhone|iPad|iPod/.test(navigator.userAgent) ? 'No iPhone, toque em <b>Salvar imagens</b> na tela que abrir: as fotos vÃ£o para o app <b>Fotos</b>.' : 'As fotos vÃ£o para o Ã¡lbum <b>Download</b> da sua <b>Galeria</b>.'}</div></div>
      <button class="btn" id="salvarCopia">${U.ico('baixar')} Salvar uma cÃ³pia na galeria</button></div></div>
    <div id="grupos"><p class="vazio">Carregandoâ€¦</p></div>`;
  Fila.proteger().then((ok) => { const p = $('#protecao'); if (p) p.innerHTML = ok ? `${U.ico('ok')} Protegidas: o celular nÃ£o apaga estas fotos sozinho.` : 'Para o celular nÃ£o apagar estas fotos sozinho, instale o app na tela inicial (Chrome: â‹® â†’ Adicionar Ã  tela inicial). Enquanto isso, vocÃª pode salvar uma cÃ³pia na galeria.'; });
  $('#salvarCopia').onclick = () => salvarCopiaFila();
  const urls = [];
  async function desenhar() {
    urls.splice(0).forEach((u) => URL.revokeObjectURL(u));
    const fotos = await Fila.fotosPendentes(), mapa = await Fila.mapaLocal(), guard = pastasGuardadas(), locais = await Fila.pastasPendentes();
    const grupos = new Map();
    for (const f of fotos) { const k = mapa[f.pasta] || f.pasta; if (!grupos.has(k)) grupos.set(k, []); grupos.get(k).push(f); }
    const el = $('#grupos'); if (!el) return;
    const cc = $('#cardCopia'); if (cc) cc.hidden = !grupos.size;
    if (!grupos.size) { el.innerHTML = `<div class="card fila-ok">${U.ico('ok')} Nenhuma foto esperando: tudo jÃ¡ chegou no computador.</div>`; return; }
    el.innerHTML = [...grupos].map(([k, fs]) => {
      const g = guard.find((x) => String(x.id) === k), lp = locais.find((x) => x.local === k);
      const nome = (g && g.cliente) || (lp && lp.nome) || (fs.find((f) => f.pastaNome) || {}).pastaNome || 'Pasta';
      return `<div class="card"><div class="linha entre"><h2 style="margin:0">${U.ico('pasta')} ${U.esc(nome)}</h2><a class="btn peq" href="#/fotos/${U.esc(k)}">Abrir pasta</a></div>
        <div class="sub">${fs.length} foto(s) esperando${lp ? ' Â· pasta criada sem internet' : ''}</div>
        <div class="grade-fotos">${fs.map((f) => { const u = URL.createObjectURL(f.mini || f.blob); urls.push(u); return `<a class="foto-cel pend" href="#/fotos/${U.esc(k)}"><img src="${u}" alt=""><span class="selo">${f.erro ? 'âš ï¸' : 'â³'}</span>${f.legenda ? `<div class="leg">${U.esc(f.legenda)}</div>` : ''}</a>`; }).join('')}</div></div>`;
    }).join('');
  }
  let antes = null;
  ouvirFila((r) => { const f = $('#faixaFila'); if (f) f.innerHTML = faixaFila(r); if (antes !== r.fotos) { antes = r.fotos; desenhar(); } });
}

// copia as fotos que ainda nÃ£o chegaram para os arquivos do celular (Downloads / Fotos do iPhone)
// manda arquivos de foto para a galeria do celular: Android â†’ Ã¡lbum "Download" da Galeria; iPhone â†’ "Salvar imagens" (app Fotos)
const nomeArqSeguro = (t) => String(t || '').replace(/[\\/:*?"<>|\u0000-\u001f]+/g, '-').replace(/\s+/g, ' ').slice(0, 60).trim();
const dataArq = (t) => String(t || '').replace('T', ' ').replace(/:/g, 'h').slice(0, 16);
async function salvarNaGaleria(arqs) {
  if (!arqs.length) return;
  const ios = /iPhone|iPad|iPod/.test(navigator.userAgent);
  if (ios && navigator.canShare && navigator.canShare({ files: arqs })) {
    try { await navigator.share({ files: arqs, title: 'Fotos do FND InspeÃ§Ã£o' }); U.toast('Toque em "Salvar imagens" para mandar para o app Fotos'); return; } catch (e) { if (e.name === 'AbortError') return; }
  }
  // Android/PC: uma por uma (o Chrome pode perguntar se permite vÃ¡rios downloads â†’ Permitir)
  for (const a of arqs) {
    const u = URL.createObjectURL(a), l = document.createElement('a');
    l.href = u; l.download = a.name; document.body.appendChild(l); l.click(); l.remove();
    setTimeout(() => URL.revokeObjectURL(u), 4000);
    await new Promise((ok) => setTimeout(ok, 350));
  }
  U.toast(arqs.length > 1 ? `${arqs.length} fotos salvas na Galeria (Ã¡lbum Download)` : 'Foto salva na Galeria (Ã¡lbum Download)', 'ok');
}

// copia as fotos que ainda nÃ£o chegaram no computador
async function salvarCopiaFila() {
  const fotos = await Fila.fotosPendentes(); if (!fotos.length) return;
  const mapa = await Fila.mapaLocal(), guard = pastasGuardadas();
  const nomeDe = (f) => { const k = mapa[f.pasta] || f.pasta, g = guard.find((x) => String(x.id) === k); return (g && g.cliente) || f.pastaNome || 'Pasta'; };
  U.toast(`Salvando ${fotos.length} foto(s) na galeriaâ€¦`);
  await salvarNaGaleria(fotos.map((f, i) => new File([f.blob], `FND InspeÃ§Ã£o - ${nomeArqSeguro(nomeDe(f))} - ${String(i + 1).padStart(3, '0')} - ${dataArq(f.tirada_em)}.jpg`, { type: 'image/jpeg' })));
}

// fotos de uma pasta (as que jÃ¡ chegaram no computador sÃ£o baixadas dele, em tamanho normal)
async function arquivosDaPasta(nome, enviadas, pendentes, so) {
  const lista = [...enviadas.map((f) => ({ f, env: true })), ...pendentes.map((f) => ({ f, env: false }))].filter((x) => !so || x.f === so);
  const arqs = [];
  for (let i = 0; i < lista.length; i++) {
    const { f, env } = lista[i];
    if (lista.length > 1) U.carregando(`Preparando as fotosâ€¦ ${i + 1} de ${lista.length}`);
    const blob = env ? await U.api('GET', `/fotos/${f.id}`, undefined, { blob: true }) : f.blob;
    const partes = ['FND InspeÃ§Ã£o', nomeArqSeguro(nome), String(i + 1).padStart(3, '0'), f.legenda ? nomeArqSeguro(f.legenda) : '', dataArq(f.tirada_em)].filter(Boolean);
    arqs.push(new File([blob], partes.join(' - ') + '.jpg', { type: 'image/jpeg' }));
  }
  U.carregando();
  return arqs;
}

async function telaPastas() {
  $('#app').innerHTML = `<div class="topo-pagina"><div><h1>${U.ico('camera')} SÃ³ fotos</h1><div class="sub">Escolha a pasta (cliente, obra ou local) ou crie uma nova.</div></div></div>
    <form class="card" id="fPasta"><h2>âž• Nova pasta</h2>
      <label class="campo"><span>Nome (cliente, obra ou local) *</span><input name="nome" required maxlength="120" placeholder="Ex.: Obra Rua das Flores"></label>
      <label class="campo"><span>EndereÃ§o (opcional)</span><input name="endereco" maxlength="250"></label>
      <button class="btn prim" style="width:100%;justify-content:center;margin-top:8px">ðŸ“· Criar e tirar fotos</button></form>
    <div id="faixaFila"></div>
    <h2 style="margin:16px 2px 8px">Pastas recentes</h2><div id="pastas"><p class="vazio">Carregandoâ€¦</p></div>`;
  ouvirFila((r) => { const f = $('#faixaFila'); if (f) f.innerHTML = faixaFila(r); });
  $('#fPasta').onsubmit = async (e) => {
    e.preventDefault();
    const d = Object.fromEntries(new FormData(e.target)); d.nome = d.nome.trim(); if (!d.nome) return;
    try {
      const v = await U.api('POST', '/vistorias', { modelo_id: ESTADO_FILA.modeloFotos(), cliente: { nome: d.nome }, local_endereco: d.endereco });
      lembrarPasta(v);
      location.hash = `#/fotos/${v.id}`;
    } catch (err) {
      if (!err.offline) return U.toast(err.message, 'erro');
      const local = await Fila.novaPasta(d.nome, d.endereco);   // sem conexÃ£o: a pasta Ã© criada no computador depois
      U.toast('Sem conexÃ£o: a pasta fica no celular e Ã© criada no computador depois.');
      location.hash = `#/fotos/${local}`;
    }
  };
  let l = null;
  try { l = await U.api('GET', '/vistorias?status=rascunho&limite=40'); guardarPastas(l); } catch { l = pastasGuardadas(); }
  const pend = await Fila.pastasPendentes().catch(() => []);
  const fotosPend = await Fila.fotosPendentes().catch(() => []);
  const mapa = await Fila.mapaLocal().catch(() => ({}));
  const el = $('#pastas'); if (!el) return;
  // quantas fotos de cada pasta ainda estÃ£o sÃ³ no celular
  const espera = {};
  for (const f of fotosPend) { const k = mapa[f.pasta] || f.pasta; espera[k] = (espera[k] || 0) + 1; }
  const lista = l.map(resumoPasta);
  // pastas que tÃªm foto esperando mas nÃ£o estÃ£o na lista (ex.: nunca abriu a lista com internet)
  for (const k of Object.keys(espera)) {
    if (/^L/.test(k) || lista.some((v) => String(v.id) === k)) continue;
    const f = fotosPend.find((x) => (mapa[x.pasta] || x.pasta) === k);
    lista.unshift({ id: Number(k), cliente: (f && f.pastaNome) || `Pasta nÂº ${k}`, numero: '', local_endereco: '', fotos: '' });
  }
  const itens = [...pend.map((p) => ({ chave: p.local, nome: p.nome, sub: 'ainda nÃ£o chegou no computador', fotos: '', espera: espera[p.local] || 0 })),
    ...lista.map((v) => ({ chave: v.id, nome: v.cliente, sub: [v.numero, v.local_endereco].filter(Boolean).join(' Â· '), fotos: v.fotos, espera: espera[String(v.id)] || 0 }))];
  el.innerHTML = itens.length ? itens.map((x) => `<a class="pasta-item" href="#/fotos/${U.esc(x.chave)}"><span class="ico">${U.ico('pasta')}</span><div><b>${U.esc(x.nome)}</b><div class="sub">${U.esc(x.sub)}</div></div>
      ${x.espera ? `<span class="chip espera">${U.ico('espera')} ${x.espera}</span>` : ''}${x.fotos ? `<span class="chip" title="fotos jÃ¡ no computador">${U.ico('camera')} ${x.fotos}</span>` : ''}</a>`).join('')
    : '<div class="card vazio">Nenhuma pasta ainda. Crie a primeira acima.</div>';
}

async function telaPasta(chave) {
  const local = /^L[a-z0-9]+$/i.test(chave);
  let id = local ? await Fila.idNoComputador(chave) : Number(chave);
  if (local && id) { location.replace(`#/fotos/${id}`); return; }   // a pasta jÃ¡ foi criada no computador
  let V = null;
  if (id) { try { V = await U.api('GET', `/vistorias/${id}`); } catch (e) { if (!e.offline) throw e; } }
  const guardada = !V && !local ? pastasGuardadas().find((x) => x.id === id) : null;
  const pendPasta = local ? (await Fila.pastasPendentes()).find((p) => p.local === chave) : null;
  let nome = V ? (V.cliente || {}).nome : guardada ? guardada.cliente : pendPasta ? pendPasta.nome : '';
  if (!nome) { const fp = (await Fila.fotosDa(local ? chave : id).catch(() => [])).find((f) => f.pastaNome); nome = fp ? fp.pastaNome : 'Pasta'; }
  if (V) lembrarPasta(V);
  const fechada = V && V.status !== 'rascunho';
  $('#app').innerHTML = `<div class="topo-pagina"><div><h1>${U.ico('pasta')} ${U.esc(nome)}</h1><div class="sub">${U.esc(V ? V.numero : guardada ? guardada.numero : 'ainda nÃ£o chegou no computador')}${!V && !local ? ' Â· sem conexÃ£o agora' : ''}</div></div>
      <a class="btn" href="#/fotos">â† Pastas</a></div>
    ${fechada ? '<div class="card">Esta vistoria estÃ¡ finalizada. Reabra no computador para colocar mais fotos.</div>' : `
    <div class="botoes-foto">
      <button type="button" class="botao-grande foto" id="abrirCamera"><span>${U.ico('camera')}</span><b>Tirar fotos</b></button>
      <label class="botao-grande sec foto"><input type="file" accept="image/*" multiple id="galeria" hidden><span>${U.ico('galeria')}</span><b>Da galeria</b></label>
    </div>
    <input type="file" accept="image/*" capture="environment" id="camera" hidden>
    <div class="sub" style="text-align:center;margin-top:2px"><a href="#" id="camNativa">Usar a cÃ¢mera do celular (outro app)</a></div>`}
    <div id="faixaFila"></div>
    <div class="grade-fotos" id="grade"></div>
    <div class="acoes" style="justify-content:center"><button class="btn" id="salvarGaleria" hidden>${U.ico('baixar')} Salvar fotos na galeria</button></div>
    ${V && !fechada && /^FOT-/.test(V.numero) ? `<div class="acoes" style="justify-content:center"><button class="btn" data-transformar="${V.id}">${U.ico('prancheta')} Transformar em vistoria completa</button></div>` : ''}
    ${V && !/^FOT-/.test(V.numero) ? `<div class="acoes" style="justify-content:center"><a class="btn" href="#/v/${V.id}">ðŸ“‹ Abrir a vistoria completa</a></div>` : ''}`;

  const urls = [];
  async function desenharGrade() {
    const g = $('#grade'); if (!g) return;
    urls.splice(0).forEach((u) => URL.revokeObjectURL(u));
    const pend = await Fila.fotosDa(local ? chave : id).catch(() => []);
    const enviadas = V ? V.fotos.slice().reverse() : [];
    const sg = $('#salvarGaleria'); if (sg) sg.hidden = !(enviadas.length + pend.length);
    g.innerHTML = pend.slice().reverse().map((f) => { const u = URL.createObjectURL(f.mini || f.blob); urls.push(u); return `<div class="foto-cel pend" data-pend="${f.id}"><img src="${u}" alt=""><span class="selo">${f.erro ? 'âš ï¸' : 'â³'}</span>${f.legenda ? `<div class="leg">${U.esc(f.legenda)}</div>` : ''}</div>`; }).join('')
      + enviadas.map((f) => `<div class="foto-cel" data-env="${f.id}"><img src="api/fotos/${f.id}?mini=1" loading="lazy" decoding="async" alt=""><span class="selo">${f.destino_ok ? 'â˜ï¸' : 'âœ“'}</span>${f.legenda ? `<div class="leg">${U.esc(f.legenda)}</div>` : ''}</div>`).join('')
      || '<p class="vazio">Nenhuma foto nesta pasta ainda.</p>';
  }
  let antes = -1, enviadasAntes = null;
  ouvirFila(async (r) => {
    const f = $('#faixaFila'); if (!f) return;
    f.innerHTML = faixaFila(r);
    // algo chegou no computador: atualiza a lista (as fotos passam de â³ para âœ“)
    const chegou = enviadasAntes !== null && r.enviadas !== enviadasAntes;
    enviadasAntes = r.enviadas;
    if (chegou && id) { try { V = await U.api('GET', `/vistorias/${id}`); } catch { /* */ } }
    if (chegou || antes !== r.fotos) { antes = r.fotos; desenharGrade(); }
  });
  await desenharGrade();

  async function guardar(arqs, daCamera) {
    for (const a of arqs) {
      try {
        const c = await U.comprimirFoto(a, 1600, 0.8);
        const quando = new Date(daCamera ? Date.now() : (a.lastModified || Date.now()));
        const tirada = new Date(quando.getTime() - quando.getTimezoneOffset() * 60e3).toISOString().slice(0, 19);
        await Fila.novaFoto(local ? chave : id, { ...c, tirada_em: tirada, pastaNome: nome });
      } catch (e) { U.toast('NÃ£o consegui usar uma das fotos: ' + e.message, 'erro'); }
    }
    if (arqs.length) U.toast(arqs.length > 1 ? `${arqs.length} fotos guardadas` : 'Foto guardada', 'ok');
    desenharGrade();
  }
  const cam = $('#camera'), gal = $('#galeria');
  const pastaDaFila = local ? chave : id;
  const camNativa = () => cam && cam.click();
  const bc = $('#abrirCamera');
  if (bc) bc.onclick = async () => {
    if (!Camera.suportada()) return camNativa();
    const n = await Camera.abrir({
      alternativa: camNativa,
      aoFoto: async (f) => {
        const ag = new Date(), tirada = new Date(ag.getTime() - ag.getTimezoneOffset() * 60e3).toISOString().slice(0, 19);
        await Fila.novaFoto(pastaDaFila, { ...f, tirada_em: tirada, pastaNome: nome });   // guardada no celular na hora
      },
    });
    if (n) U.toast(n > 1 ? `${n} fotos guardadas` : 'Foto guardada', 'ok');
    desenharGrade();
  };
  const cn = $('#camNativa'); if (cn) cn.onclick = (e) => { e.preventDefault(); camNativa(); };
  if (cam) cam.onchange = async () => { const a = [...cam.files]; cam.value = ''; await guardar(a, true); };
  if (gal) gal.onchange = async () => { const a = [...gal.files]; gal.value = ''; await guardar(a, false); };

  const sg = $('#salvarGaleria');
  if (sg) sg.onclick = async () => {
    const pend = await Fila.fotosDa(local ? chave : id).catch(() => []), env = V ? V.fotos : [];
    const n = pend.length + env.length; if (!n) return;
    if (env.length && !(await U.confirmar(`Salvar ${n} foto(s) desta pasta na galeria do celular?${env.length ? `\n\nAs que jÃ¡ estÃ£o no computador sÃ£o baixadas dele (cerca de ${Math.max(1, Math.round(env.length * 0.35))} MB).` : ''}`, { ok: 'Salvar na galeria' }))) return;
    try { await salvarNaGaleria(await arquivosDaPasta(nome, env, pend)); } catch (e) { U.carregando(); U.toast('NÃ£o consegui salvar: ' + e.message, 'erro'); }
  };

  // tocar na foto: legenda / apagar / salvar na galeria
  $('#grade').onclick = async (e) => {
    const p = e.target.closest('[data-pend]'), s = e.target.closest('[data-env]');
    if (!p && !s) return;
    const pend = p ? (await Fila.fotosDa(local ? chave : id)).find((f) => f.id === +p.dataset.pend) : null;
    const env = s && V ? V.fotos.find((f) => f.id === +s.dataset.env) : null;
    const leg = (pend || env || {}).legenda || '';
    const m = U.modal(`<h2>Foto</h2>${pend && pend.erro ? `<p class="erro-msg">âš ï¸ ${U.esc(pend.erro)}</p>` : ''}
      <label class="campo"><span>Legenda</span><input id="legFoto" maxlength="200" value="${U.esc(leg)}" placeholder="Ex.: Fachada, trinca na parede da salaâ€¦"></label>
      <div class="acoes"><button class="btn perigo" id="apagarFoto">Apagar</button>${pend && pend.erro ? '<button class="btn" id="tentarFoto">Tentar de novo</button>' : ''}<button class="btn" id="umaGaleria">${U.ico('baixar')} Galeria</button><span style="flex:1"></span><button class="btn" id="cancFoto">Cancelar</button><button class="btn prim" id="salvarLeg">Salvar</button></div>`);
    $('#umaGaleria', m.el).onclick = async () => { try { await salvarNaGaleria(await arquivosDaPasta(nome, env ? [env] : [], pend ? [pend] : [])); } catch (e) { U.carregando(); U.toast('NÃ£o consegui salvar: ' + e.message, 'erro'); } };
    $('#cancFoto', m.el).onclick = m.fechar;
    const tf = $('#tentarFoto', m.el); if (tf) tf.onclick = async () => { m.fechar(); await Fila.reenviarErros(); };
    $('#salvarLeg', m.el).onclick = async () => {
      const v = $('#legFoto', m.el).value.trim();
      try { if (pend) await Fila.alterar(pend.id, { legenda: v }); else { await U.api('PUT', `/fotos/${env.id}`, { legenda: v }); env.legenda = v; } m.fechar(); desenharGrade(); } catch (err) { U.toast(err.message, 'erro'); }
    };
    $('#apagarFoto', m.el).onclick = async () => {
      if (!(await U.confirmar('Apagar esta foto?', { ok: 'Apagar', perigo: true }))) return;
      try { if (pend) await Fila.remover(pend.id); else { await U.api('DELETE', `/fotos/${env.id}`); V.fotos = V.fotos.filter((f) => f !== env); } m.fechar(); desenharGrade(); } catch (err) { U.toast(err.message, 'erro'); }
    };
  };
}

// celular: "Sair do app" â€” fecha o login deste aparelho (continua pareado; na prÃ³xima vez pede a senha)
async function sairDoCelular() {
  let pend = 0; try { pend = (await Fila.resumo()).fotos || 0; } catch { /* */ }
  const msg = pend ? `Sair do app?\n\nHÃ¡ ${pend} foto(s) esperando envio. Elas continuam guardadas neste celular e serÃ£o enviadas quando vocÃª entrar de novo.` : 'Sair do app?\n\nNa prÃ³xima vez que abrir, vai pedir a senha.';
  if (!(await U.confirmar(msg, { ok: 'Sair' }))) return;
  try { await U.api('POST', '/logout'); } catch (e) { U.toast(e.message, 'erro'); return; }
  try { localStorage.removeItem('fndi_estado_' + location.pathname); } catch { /* */ }
  location.hash = '#/';
  iniciar();
}

/* ================= inÃ­cio ================= */
async function carregarEstado() {
  ESTADO = await U.api('GET', '/estado', undefined, { semLogin: true });
  aplicarCorMenu(ESTADO.ui_cor_menu);
  $('#empresaNome').textContent = ESTADO.empresa || '';
  mostrarVersao();
  const L = ESTADO.licenca, av = $('#avisoLicenca');
  av.hidden = !(L.mensagem || L.aviso);
  av.className = 'aviso-topo' + (L.liberado ? '' : ' erro');
  av.innerHTML = L.mensagem || L.aviso ? `${U.esc(L.mensagem || L.aviso)} <a href="#/config">LicenÃ§a</a>` : '';
  // versÃ£o nova baixada: aviso no topo (com as novidades em ConfiguraÃ§Ãµes â†’ AtualizaÃ§Ã£o)
  const A = ESTADO.atualizacao, aa = $('#avisoAtualizacao');
  aa.hidden = !(A && A.disponivel);
  aa.innerHTML = A && A.disponivel ? `ðŸ†• A versÃ£o <b>${U.esc(A.disponivel)}</b> do FND InspeÃ§Ã£o estÃ¡ pronta para instalar. <a href="#/config" data-irAtu>Ver as novidades e instalar</a>` : '';
  const ir = $('[data-irAtu]', aa); if (ir) ir.onclick = () => setTimeout(() => { const c = $('#cardAtu'); if (c) c.scrollIntoView({ behavior: 'smooth' }); }, 400);
  $('#rodapeLateral').innerHTML = `${U.esc(ESTADO.usuario ? ESTADO.usuario.nome : '')} Â· <button id="sair">sair</button>`;   // a versÃ£o fica no topo do menu
  $('#sair').onclick = async () => { await U.api('POST', '/logout').catch(() => {}); iniciar(); };
}

// versÃ£o sempre Ã  vista (topo do menu; no menu recolhido, passando o mouse no logo)
function mostrarVersao() {
  const v = ESTADO && ESTADO.versao ? 'v' + ESTADO.versao : '';
  const el = $('#versaoTopo'); if (el) el.textContent = v;
  const img = $('.marca img'); if (img) img.title = `FND InspeÃ§Ã£o ${v}`;
}

async function iniciar() {
  try { await carregarEstado(); }
  catch (e) {
    // celular sem conexÃ£o (ou PC desligado): abre sÃ³ o modo "SÃ³ fotos", com o que ficou guardado
    let guard = null; try { guard = JSON.parse(localStorage.getItem('fndi_estado_' + location.pathname) || 'null'); } catch { /* */ }
    if (!(U.CELULAR && e.offline && guard)) { document.body.innerHTML = `<div class="card" style="margin:40px">âš ï¸ ${U.esc(e.message)}</div>`; return; }
    ESTADO = { ...guard, offline: true, semInternet: !e.status };
    aplicarCorMenu(ESTADO.ui_cor_menu);
    $('#empresaNome').textContent = ESTADO.empresa || '';
    mostrarVersao();
    $('#rodapeLateral').innerHTML = 'ðŸ“´ sem conexÃ£o';
    setTimeout(() => { if (ESTADO.offline) iniciarDeNovoQuandoVoltar(); }, 0);
  }
  if (!ESTADO.usuario) return telaEntrada(ESTADO.configurado);
  $('#entrada').hidden = true; $('#entrada').innerHTML = ''; $('#sistema').hidden = false;
  document.body.classList.toggle('celular', U.CELULAR);
  document.body.classList.toggle('com-produtos', !!ESTADO.produtos_ligado);
  if (U.CELULAR) {
    try { localStorage.setItem('fndi_estado_' + location.pathname, JSON.stringify({ ...ESTADO, offline: false, atualizacao: null })); if (ESTADO.modelo_fotos) localStorage.setItem('fndi_modelo_fotos', ESTADO.modelo_fotos); } catch { /* */ }
    Fila.iniciar();
    if ('serviceWorker' in navigator) navigator.serviceWorker.register('sw.js').catch(() => {});
  }
  ligarMenu();
  rotear();
  ouvirNotificacoes();
  if (!ESTADO.offline) mostrarNovidadesSeAtualizou();
}
// sem conexÃ£o: quando a conexÃ£o voltar, recarrega o estado e redesenha a tela (sem perder o que estÃ¡ aberto)
async function tentarVoltar() {
  if (!ESTADO.offline) return true;
  let e; try { e = await U.api('GET', '/estado', undefined, { semLogin: true }); } catch (err) { ESTADO.semInternet = !err.status; return false; }
  if (!ESTADO.offline) return true;
  if (!e.usuario) { iniciar(); return true; }
  try { await carregarEstado(); } catch { return false; }
  U.toast('ConexÃ£o com o computador voltou', 'ok');
  if (U.CELULAR) Fila.enviar();
  rotear();
  return true;
}
function iniciarDeNovoQuandoVoltar() {
  const tentar = async () => { if (await tentarVoltar()) { clearInterval(t); window.removeEventListener('online', tentar); document.removeEventListener('visibilitychange', aoVoltar); } };
  const aoVoltar = () => { if (document.visibilityState === 'visible') tentar(); };
  const t = setInterval(tentar, 10000);
  window.addEventListener('online', tentar);
  document.addEventListener('visibilitychange', aoVoltar);   // voltou para o app: tenta na hora
}

// depois de atualizar: mostra uma vez "o que mudou nesta versÃ£o"
async function mostrarNovidadesSeAtualizou() {
  let vista = null;
  try { vista = localStorage.getItem('fndi_versao_vista'); localStorage.setItem('fndi_versao_vista', ESTADO.versao); } catch { return; }
  if (!vista || vista === ESTADO.versao) return;   // primeira vez neste PC, ou nada mudou
  try {
    const a = await U.api('GET', '/atualizacao');
    if (!a.novidadesInstalada) return;
    const m = U.modal(`<h2>ðŸŽ‰ FND InspeÃ§Ã£o atualizado para a versÃ£o ${U.esc(a.novidadesInstalada.versao)}</h2>
      <div class="novidades">${U.novidadesHTML(a.novidadesInstalada.texto)}</div>
      <div class="acoes" style="justify-content:flex-end"><button class="btn prim" id="okNov">Entendi</button></div>`);
    $('#okNov', m.el).onclick = m.fechar;
  } catch { /* */ }
}

window.addEventListener('hashchange', rotear);
window.addEventListener('fnd-sair', () => iniciar());
// a Central avisa a janela do programa que continua aberta (para o atalho reabrir sem atraso)
if (!U.CELULAR) setInterval(() => { if (!document.hidden) fetch('__fnd/ping', { cache: 'no-store' }).catch(() => {}); }, 60000);
iniciar();
'use strict';
/* CÃ¢mera DENTRO do app (modo "SÃ³ fotos").
   Abrir o app de cÃ¢mera do celular por fora (input capture) faz o Android fechar o navegador quando falta memÃ³ria
   ("insuficiÃªncia de memÃ³ria") e a foto se perde. Aqui a cÃ¢mera roda na prÃ³pria pÃ¡gina: tira vÃ¡rias fotos seguidas,
   cada uma jÃ¡ reduzida (mÃ¡x. 1600 px) e entregue na hora para a fila (que guarda no celular). */
const Camera = (() => {
  const MAX = 1600;
  let aberta = null;

  const suportada = () => !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia);

  async function ligar(frente) {
    const pedir = (v) => navigator.mediaDevices.getUserMedia({ audio: false, video: v });
    const base = { facingMode: { ideal: frente ? 'user' : 'environment' } };
    try { return await pedir({ ...base, width: { ideal: 1920 }, height: { ideal: 1440 } }); }
    catch (e) { if (e && (e.name === 'NotAllowedError' || e.name === 'SecurityError')) throw e; return pedir(base); }
  }

  function erroTexto(e) {
    const n = e && e.name;
    if (n === 'NotAllowedError' || n === 'SecurityError') return 'A cÃ¢mera foi bloqueada. Toque no cadeado ao lado do endereÃ§o â†’ PermissÃµes â†’ CÃ¢mera â†’ Permitir.';
    if (n === 'NotFoundError' || n === 'OverconstrainedError') return 'NÃ£o encontrei a cÃ¢mera deste aparelho.';
    if (n === 'NotReadableError') return 'A cÃ¢mera estÃ¡ sendo usada por outro app. Feche o outro app e tente de novo.';
    return 'NÃ£o consegui abrir a cÃ¢mera: ' + ((e && e.message) || e);
  }

  // abre a cÃ¢mera; aoFoto({ blob, largura, altura }) Ã© chamado a cada disparo. Retorna quantas fotos foram tiradas.
  function abrir({ aoFoto, alternativa }) {
    if (aberta) return aberta.promessa;
    let fim;
    const promessa = new Promise((r) => { fim = r; });
    const el = document.createElement('div');
    el.className = 'camera-viva';
    el.innerHTML = `<video playsinline muted autoplay></video><div class="cam-clarao"></div>
      <div class="cam-topo"><button type="button" class="cam-btn" data-c="fechar">${U.ico('fechar')}<span>Concluir</span></button>
        <span class="cam-cont">0 fotos</span>
        <button type="button" class="cam-btn" data-c="modo" hidden></button>
        <button type="button" class="cam-btn redondo" data-c="luz" hidden title="Lanterna">${U.ico('lanterna')}</button>
        <button type="button" class="cam-btn redondo" data-c="virar" title="Trocar cÃ¢mera">${U.ico('virar')}</button></div>
      <div class="cam-msg" hidden></div>
      <div class="cam-base"><div class="cam-mini"></div><button type="button" class="cam-disparo" data-c="foto" aria-label="Tirar foto"><i></i></button><div class="cam-espaco"></div></div>`;
    document.body.appendChild(el);
    document.body.classList.add('com-camera');
    const video = el.querySelector('video'), cont = el.querySelector('.cam-cont'), msg = el.querySelector('.cam-msg');
    let stream = null, frente = false, luz = false, n = 0;

    async function iniciar() {
      parar();
      msg.hidden = true;
      try {
        stream = await ligar(frente);
        video.srcObject = stream;
        await video.play().catch(() => {});
        const tr = stream.getVideoTracks()[0];
        const cap = tr && tr.getCapabilities ? tr.getCapabilities() : {};
        el.querySelector('[data-c=luz]').hidden = !cap.torch;
        luz = false;
      } catch (e) {
        msg.hidden = false;
        msg.innerHTML = `<p>${U.esc(erroTexto(e))}</p>${alternativa ? '<button type="button" class="btn" data-c="alt">Usar a cÃ¢mera do celular</button>' : ''}`;
      }
    }
    function parar() { if (stream) { stream.getTracks().forEach((t) => t.stop()); stream = null; } video.srcObject = null; }

    // ---- disparo ----
    // O botÃ£o fica livre na hora: a foto Ã© preparada por trÃ¡s (atÃ© 3 na fila). Modo âš¡ RÃ¡pida pega o quadro do vÃ­deo
    // (instantÃ¢neo); ðŸ“· Qualidade usa a captura de foto do celular (melhor no escuro, pode pausar a imagem um instante).
    let preparo = Promise.resolve(), capturas = Promise.resolve(), processando = 0, ultimoToque = 0;
    const modoAtual = () => { try { return localStorage.getItem('fndi_cam_modo') === 'qualidade' ? 'qualidade' : 'rapida'; } catch { return 'rapida'; } };
    function quadroDoVideo() {
      const vw = video.videoWidth, vh = video.videoHeight, e = Math.min(1, MAX / Math.max(vw, vh));
      const c = document.createElement('canvas'); c.width = Math.round(vw * e); c.height = Math.round(vh * e);
      c.getContext('2d', { alpha: false }).drawImage(video, 0, 0, c.width, c.height);
      return c;
    }
    async function fotoDeQualidade(tr) {
      const b = await Promise.race([new ImageCapture(tr).takePhoto(), new Promise((_, ko) => setTimeout(() => ko(new Error('tempo')), 5000))]);
      // abre a foto JÃ no tamanho final (nÃ£o monta a imagem de 12+ MP inteira na memÃ³ria)
      const retrato = video.videoHeight > video.videoWidth;
      const bmp = await createImageBitmap(b, { imageOrientation: 'from-image', resizeQuality: 'high', ...(retrato ? { resizeHeight: MAX } : { resizeWidth: MAX }) });
      const e = Math.min(1, MAX / Math.max(bmp.width, bmp.height));
      const c = document.createElement('canvas'); c.width = Math.round(bmp.width * e); c.height = Math.round(bmp.height * e);
      c.getContext('2d', { alpha: false }).drawImage(bmp, 0, 0, c.width, c.height); bmp.close();
      return c;
    }
    function disparar() {
      if (!stream || !video.videoWidth) return;
      const agora = Date.now(); if (agora - ultimoToque < 250) return; ultimoToque = agora;
      if (processando >= 3) { U.toast('Um instante: guardando as fotosâ€¦'); return; }
      el.classList.remove('disparou'); void el.offsetWidth; el.classList.add('disparou');
      if (navigator.vibrate) navigator.vibrate(25);
      const tr = stream.getVideoTracks()[0];
      let captura;
      if (modoAtual() === 'rapida' || frente || !window.ImageCapture || !tr) captura = Promise.resolve(quadroDoVideo());   // instantÃ¢neo
      else captura = capturas = capturas.then(() => fotoDeQualidade(tr)).catch(() => quadroDoVideo());   // uma captura de cada vez
      processando++; n++; cont.textContent = n === 1 ? '1 foto' : `${n} fotos`;
      el.querySelector('.cam-disparo').classList.toggle('ocupado', processando >= 3);
      preparo = preparo.then(async () => {
        try {
          const c = await captura;
          const [blob, mini] = await Promise.all([new Promise((r) => c.toBlob(r, 'image/jpeg', 0.82)), U.miniatura(c)]);
          const w = c.width, h = c.height; c.width = c.height = 0;
          const quadro = el.querySelector('.cam-mini');   // miniatura da Ãºltima foto
          if (quadro) { if (quadro._url) URL.revokeObjectURL(quadro._url); quadro._url = URL.createObjectURL(mini); quadro.style.backgroundImage = `url(${quadro._url})`; }
          await aoFoto({ blob, largura: w, altura: h, mini });
        } catch (err) { n--; cont.textContent = n === 1 ? '1 foto' : `${n} fotos`; U.toast('NÃ£o consegui guardar a foto: ' + err.message, 'erro'); }
        finally { processando--; const bt = el.querySelector('.cam-disparo'); if (bt) bt.classList.toggle('ocupado', processando >= 3); }
      });
    }
    function mostrarModo() {
      const b = el.querySelector('[data-c=modo]'); if (!b) return;
      const q = modoAtual() === 'qualidade';
      b.innerHTML = q ? 'ðŸ“· Qualidade' : 'âš¡ RÃ¡pida';
      b.title = q ? 'Melhor no escuro (pode pausar a imagem um instante)' : 'Disparo instantÃ¢neo';
      b.hidden = !window.ImageCapture || frente;
    }

    async function fechar() {
      if (!aberta) return;
      parar();
      if (processando) { el.querySelector('.cam-cont').textContent = 'Guardandoâ€¦'; await preparo.catch(() => {}); }   // termina de guardar antes de fechar
      const q = el.querySelector('.cam-mini'); if (q && q._url) URL.revokeObjectURL(q._url);
      el.remove(); document.body.classList.remove('com-camera');
      window.removeEventListener('popstate', aoVoltar);
      document.removeEventListener('visibilitychange', aoVisib);
      aberta = null;
      if (typeof Fila !== 'undefined') Fila.pausar(false);   // volta a enviar para o computador
      fim(n);
    }
    // botÃ£o "voltar" do Android fecha a cÃ¢mera (e nÃ£o a tela)
    const aoVoltar = () => fechar();
    history.pushState({ camera: 1 }, '');
    window.addEventListener('popstate', aoVoltar);
    // app foi para segundo plano: solta a cÃ¢mera (economiza bateria/memÃ³ria) e religa ao voltar
    const aoVisib = () => { if (document.hidden) parar(); else if (aberta && !stream) iniciar(); };
    document.addEventListener('visibilitychange', aoVisib);

    el.addEventListener('click', async (e) => {
      const b = e.target.closest('[data-c]'); if (!b) return;
      const c = b.dataset.c;
      if (c === 'foto') disparar();
      else if (c === 'fechar') history.back();
      else if (c === 'virar') { frente = !frente; iniciar(); mostrarModo(); }
      else if (c === 'modo') {
        const novo = modoAtual() === 'qualidade' ? 'rapida' : 'qualidade';
        try { localStorage.setItem('fndi_cam_modo', novo); } catch { /* */ }
        mostrarModo(); U.toast(novo === 'qualidade' ? 'ðŸ“· Qualidade: melhor no escuro' : 'âš¡ RÃ¡pida: disparo instantÃ¢neo');
      }
      else if (c === 'luz') {
        const tr = stream && stream.getVideoTracks()[0]; if (!tr) return;
        try { luz = !luz; await tr.applyConstraints({ advanced: [{ torch: luz }] }); b.classList.toggle('ligado', luz); } catch { /* */ }
      } else if (c === 'alt') { history.back(); setTimeout(alternativa, 300); }
    });
    aberta = { promessa };
    if (typeof Fila !== 'undefined') Fila.pausar(true);   // nÃ£o disputa o celular com a cÃ¢mera: envia quando fechar
    mostrarModo();
    iniciar();
    return promessa;
  }
  // ---------- leitura de CÃ“DIGO DE BARRAS ----------
  // Usa o leitor do prÃ³prio celular (BarcodeDetector: Chrome do Android) e, onde nÃ£o tem (iPhone, Chrome do Windows),
  // o ZXing (WebAssembly, carregado sÃ³ nessa hora, do prÃ³prio sistema â€” nada vem de fora).
  const FORMATOS_NATIVOS = ['ean_13', 'ean_8', 'upc_a', 'upc_e', 'code_128', 'code_39', 'itf', 'qr_code', 'data_matrix', 'codabar'];
  let leitorZx = null;
  function carregarZxing() {
    if (!leitorZx) {
      leitorZx = new Promise((ok, ko) => {
        const sc = document.createElement('script'); sc.src = 'vendor/zxing/zxing-reader.js';
        sc.onload = () => {
          const wasm = new URL('vendor/zxing/zxing_reader.wasm', document.baseURI).href;
          window.ZXingWASM.setZXingModuleOverrides({ locateFile: (arq, prefixo) => (arq.endsWith('.wasm') ? wasm : prefixo + arq) });
          ok(window.ZXingWASM);
        };
        sc.onerror = () => { leitorZx = null; ko(new Error('NÃ£o consegui carregar o leitor de cÃ³digo de barras.')); };
        document.head.appendChild(sc);
      });
    }
    return leitorZx;
  }
  async function criarLeitor() {
    if ('BarcodeDetector' in window) {
      try {
        const sup = await window.BarcodeDetector.getSupportedFormats();
        const f = FORMATOS_NATIVOS.filter((x) => sup.includes(x));
        if (f.length) { const d = new window.BarcodeDetector({ formats: f }); return { nome: 'nativo', ler: async (fonte) => (await d.detect(fonte)).map((x) => x.rawValue) }; }
      } catch { /* usa o ZXing */ }
    }
    const Z = await carregarZxing();
    return { nome: 'zxing', ler: async (canvas) => {
      const img = canvas.getContext('2d', { willReadFrequently: true }).getImageData(0, 0, canvas.width, canvas.height);
      const r = await Z.readBarcodes(img, { tryHarder: true, maxNumberOfSymbols: 1 });
      return r.filter((x) => x.isValid && x.text).map((x) => x.text);
    } };
  }

  // abre a cÃ¢mera apontando para o cÃ³digo. Devolve o texto lido, '' (digitar) ou null (cancelou).
  function escanear({ titulo = 'Aponte para o cÃ³digo de barras' } = {}) {
    return new Promise((fim) => {
      const el = document.createElement('div');
      el.className = 'camera-viva escaner';
      el.innerHTML = `<video playsinline muted autoplay></video>
        <div class="cam-topo"><button type="button" class="cam-btn" data-c="fechar">${U.ico('fechar')}<span>Cancelar</span></button>
          <span class="cam-cont">${U.esc(titulo)}</span>
          <button type="button" class="cam-btn redondo" data-c="luz" hidden title="Lanterna">${U.ico('lanterna')}</button></div>
        <div class="mira"><i></i></div>
        <div class="cam-msg" hidden></div>
        <div class="cam-base so-texto"><button type="button" class="btn" data-c="digitar">âŒ¨ï¸ Digitar o cÃ³digo</button></div>`;
      document.body.appendChild(el); document.body.classList.add('com-camera');
      const video = el.querySelector('video'), msg = el.querySelector('.cam-msg');
      let stream = null, vivo = true, leitor = null, luz = false;
      const c = document.createElement('canvas');
      function sair(r) {
        if (!vivo) return; vivo = false;
        if (stream) stream.getTracks().forEach((t) => t.stop());
        el.remove(); document.body.classList.remove('com-camera');
        window.removeEventListener('popstate', aoVoltar);
        fim(r);
      }
      const aoVoltar = () => sair(null);
      history.pushState({ camera: 1 }, ''); window.addEventListener('popstate', aoVoltar);
      el.addEventListener('click', async (e) => {
        const b = e.target.closest('[data-c]'); if (!b) return;
        if (b.dataset.c === 'fechar') history.back();
        else if (b.dataset.c === 'digitar') { sair(''); history.back(); }
        else if (b.dataset.c === 'luz') { const tr = stream && stream.getVideoTracks()[0]; if (tr) { try { luz = !luz; await tr.applyConstraints({ advanced: [{ torch: luz }] }); b.classList.toggle('ligado', luz); } catch { /* */ } } }
      });
      (async () => {
        try {
          [stream, leitor] = await Promise.all([ligar(false), criarLeitor()]);
          if (!vivo) { stream.getTracks().forEach((t) => t.stop()); return; }
          video.srcObject = stream; await video.play().catch(() => {});
          const tr = stream.getVideoTracks()[0], cap = tr && tr.getCapabilities ? tr.getCapabilities() : {};
          el.querySelector('[data-c=luz]').hidden = !cap.torch;
        } catch (e) { msg.hidden = false; msg.innerHTML = `<p>${U.esc(leitor ? erroTexto(e) : e.message)}</p>`; return; }
        // procura o cÃ³digo ~6x por segundo, na faixa do meio da imagem (mais rÃ¡pido e menos erro)
        while (vivo) {
          await new Promise((ok) => setTimeout(ok, 160));
          if (!vivo || !video.videoWidth || document.hidden) continue;
          const vw = video.videoWidth, vh = video.videoHeight;
          const larg = Math.round(vw * 0.9), alt = Math.round(Math.min(vh, vw) * 0.6);
          const e = Math.min(1, 960 / larg);
          c.width = Math.round(larg * e); c.height = Math.round(alt * e);
          c.getContext('2d', { willReadFrequently: true }).drawImage(video, (vw - larg) / 2, (vh - alt) / 2, larg, alt, 0, 0, c.width, c.height);
          let achou = [];
          try { achou = await leitor.ler(c); } catch { /* quadro ruim */ }
          if (achou.length && vivo) {
            if (navigator.vibrate) navigator.vibrate(60);
            el.classList.add('leu');
            const txt = achou[0];
            setTimeout(() => { sair(txt); history.back(); }, 250);
            return;
          }
        }
      })();
    });
  }

  // GS1 (DataMatrix / GS1-128 de alguns produtos): tira GTIN (01), lote (10), validade (17) e fabricaÃ§Ã£o (11)
  function lerGS1(txt) {
    let s = String(txt || '').replace(/^\]d2|^\]C1|^\]Q3/, '');
    const r = {};
    if (/^\(\d{2}\)/.test(s)) {   // forma com parÃªnteses: (01)07891234567895(17)261231(10)ABC
      for (const m of s.matchAll(/\((\d{2,4})\)([^(]*)/g)) r[m[1]] = m[2];
    } else if (/^01\d{14}/.test(s)) {   // forma crua com separador FNC1 (\x1d)
      const fixos = { '01': 14, '11': 6, '13': 6, '15': 6, '17': 6 };
      while (s.length) {
        const ai = s.slice(0, 2); s = s.slice(2);
        if (fixos[ai]) { r[ai] = s.slice(0, fixos[ai]); s = s.slice(fixos[ai]); }
        else { const i = s.indexOf('\x1d'); r[ai] = i < 0 ? s : s.slice(0, i); s = i < 0 ? '' : s.slice(i + 1); }
        if (s.startsWith('\x1d')) s = s.slice(1);
      }
    } else return null;
    const data = (v) => (/^\d{6}$/.test(v || '') ? `20${v.slice(0, 2)}-${v.slice(2, 4)}-${v.slice(4, 6) === '00' ? '28' : v.slice(4, 6)}` : '');
    if (!r['01']) return null;
    return { codigo: r['01'].replace(/^0(?=\d{13}$)/, ''), lote: r['10'] || '', validade: data(r['17']), fabricacao: data(r['11']) };
  }

  return { abrir, suportada, escanear, lerGS1 };
})();
'use strict';
/* Editor de modelos de relatÃ³rio */
const TIPOS = [
  ['avaliacao', 'AvaliaÃ§Ã£o (Bom/Regular/Ruimâ€¦)'], ['texto', 'Texto curto'], ['texto_longo', 'Texto longo'], ['numero', 'NÃºmero'],
  ['data', 'Data'], ['sim_nao', 'Sim / NÃ£o'], ['opcoes', 'Lista (escolhe 1)'], ['multipla', 'Lista (marca vÃ¡rias)'],
];
const NOMES_ESCALA = { estado: 'Bom / Regular / Ruim', conformidade: 'Conforme / NÃ£o conforme', gravidade: 'Gravidade: Baixa / MÃ©dia / Alta', propria: 'Minha prÃ³pria escala' };
const CORES = [['verde', 'Verde'], ['amarelo', 'Amarelo'], ['laranja', 'Laranja'], ['vermelho', 'Vermelho'], ['azul', 'Azul'], ['cinza', 'Cinza']];

const Editor = {
  async abrir(id) {
    let m;
    if (id === 'novo') m = { nome: '', prefixo: 'VST', titulo_relatorio: '', descricao: '', estrutura: { secoes: [{ id: U.id(), titulo: 'Itens vistoriados', repetir: false, itens: [{ id: U.id(), rotulo: '', tipo: 'avaliacao', escala: 'estado', fotos: true, obs: true }] }] } };
    else m = await U.api('GET', `/modelos/${id}`);
    const est = structuredClone(m.estrutura);
    const app = $('#app');
    const desenhar = () => {
      app.innerHTML = `
        <div class="topo-pagina"><div><h1>${id === 'novo' ? 'Novo modelo' : 'Editar modelo'}</h1>
          <div class="sub">${m.em_uso ? `Usado em ${m.em_uso} vistoria(s). As que jÃ¡ existem nÃ£o mudam: cada uma guarda a versÃ£o do modelo da Ã©poca.` : 'Monte as seÃ§Ãµes e os itens que vÃ£o aparecer na vistoria e no relatÃ³rio.'}</div></div>
          <div class="linha"><a class="btn" href="#/modelos">Cancelar</a><button class="btn prim" id="salvar">ðŸ’¾ Salvar modelo</button></div></div>
        <div class="card"><div class="grade2">
          <label class="campo"><span>Nome do modelo *</span><input id="m_nome" value="${U.esc(m.nome)}" maxlength="100" placeholder="Ex.: Vistoria de entrega de chaves"></label>
          <label class="campo"><span>TÃ­tulo no relatÃ³rio</span><input id="m_titulo" value="${U.esc(m.titulo_relatorio || '')}" maxlength="120" placeholder="Ex.: Laudo de Vistoria"></label>
          <label class="campo"><span>Prefixo da numeraÃ§Ã£o</span><input id="m_prefixo" value="${U.esc(m.prefixo)}" maxlength="6" placeholder="VST"><small class="sub">Ex.: VST â†’ VST-2026-0001</small></label>
          <label class="campo"><span>DescriÃ§Ã£o</span><input id="m_desc" value="${U.esc(m.descricao || '')}" maxlength="300"></label>
        </div></div>
        <div id="secoes"></div>
        <button class="btn" id="addSecao">ï¼‹ Adicionar seÃ§Ã£o</button>`;
      $('#secoes').innerHTML = est.secoes.map((s, i) => htmlSecao(s, i)).join('');
      ligar();
    };
    const htmlSecao = (s, i) => `
      <div class="ed-secao" data-s="${i}">
        <div class="cab">
          <div class="linha entre"><b>SeÃ§Ã£o ${i + 1}</b>
            <div class="ed-ord"><button title="Subir" data-acao="sobeS">â†‘</button><button title="Descer" data-acao="desceS">â†“</button><button title="Excluir seÃ§Ã£o" data-acao="delS">âœ•</button></div></div>
          <div class="grade2">
            <label class="campo"><span>TÃ­tulo da seÃ§Ã£o *</span><input data-f="titulo" value="${U.esc(s.titulo)}" maxlength="100"></label>
            <div><label class="check" style="margin-top:30px"><input type="checkbox" data-f="repetir" ${s.repetir ? 'checked' : ''}> Repetir esta seÃ§Ã£o (um bloco por ambiente, produto, ocorrÃªnciaâ€¦)</label></div>
          </div>
          ${s.repetir ? `<div class="grade2">
            <label class="campo"><span>Nome de cada bloco</span><input data-f="rotulo" value="${U.esc(s.rotulo || '')}" maxlength="40" placeholder="Ex.: Ambiente"></label>
            <label class="campo"><span>SugestÃµes de nomes (separe por vÃ­rgula)</span><input data-f="sugestoes" value="${U.esc((s.sugestoes || []).join(', '))}" placeholder="Sala, Cozinha, Quarto"></label>
          </div>` : ''}
          <label class="check"><input type="checkbox" data-f="fotos" ${s.fotos ? 'checked' : ''}> Fotos gerais ${s.repetir ? 'de cada bloco' : 'da seÃ§Ã£o'}</label>
        </div>
        <div class="corpo">${s.itens.map((it, j) => htmlItem(it, j)).join('')}
          <button class="btn peq" data-acao="addItem" style="margin-top:8px">ï¼‹ Adicionar item</button></div>
      </div>`;
    const htmlItem = (it, j) => `
      <div class="ed-item" data-i="${j}">
        <input data-g="rotulo" value="${U.esc(it.rotulo)}" maxlength="150" placeholder="Nome do item (ex.: Piso, Paredes, Validade)">
        <select data-g="tipo">${TIPOS.map(([v, t]) => `<option value="${v}" ${it.tipo === v ? 'selected' : ''}>${t}</option>`).join('')}</select>
        <div class="ed-ord"><button title="Subir" data-acao="sobeI">â†‘</button><button title="Descer" data-acao="desceI">â†“</button><button title="Excluir item" data-acao="delI">âœ•</button></div>
        <div class="extra">
          ${it.tipo === 'avaliacao' ? `<div class="linha"><span class="sub">Escala:</span><select data-g="escala" style="max-width:280px">${Object.entries(NOMES_ESCALA).map(([v, t]) => `<option value="${v}" ${(it.escala || 'estado') === v ? 'selected' : ''}>${t}</option>`).join('')}</select></div>
            ${it.escala === 'propria' ? `<div class="escala-propria" style="margin-top:6px">${(it.opcoes || []).map((o, k) => `<div class="linha"><input data-op="${k}" value="${U.esc(o.t)}" maxlength="40" placeholder="OpÃ§Ã£o"><select data-cor="${k}">${CORES.map(([c, n]) => `<option value="${c}" ${o.c === c ? 'selected' : ''}>${n}</option>`).join('')}</select><button class="btn peq link" data-acao="delOp" data-k="${k}">remover</button></div>`).join('')}
              <div><button class="btn peq" data-acao="addOp">ï¼‹ opÃ§Ã£o</button></div></div>` : ''}` : ''}
          ${it.tipo === 'opcoes' || it.tipo === 'multipla' ? `<label class="campo"><span>OpÃ§Ãµes (uma por linha)</span><textarea data-g="opcoes" rows="3">${U.esc((it.opcoes || []).join('\n'))}</textarea></label>` : ''}
          ${it.tipo === 'numero' ? `<label class="campo" style="max-width:200px"><span>Unidade</span><input data-g="unidade" value="${U.esc(it.unidade || '')}" maxlength="12" placeholder="mÂ², Â°C, cm"></label>` : ''}
          <label class="check"><input type="checkbox" data-g="fotos" ${it.fotos ? 'checked' : ''}> Permite fotos</label>
          <label class="check"><input type="checkbox" data-g="obs" ${it.obs ? 'checked' : ''}> Permite observaÃ§Ã£o</label>
        </div>
      </div>`;

    // lÃª o que estÃ¡ na tela para a estrutura (antes de redesenhar ou salvar)
    const ler = () => {
      m.nome = $('#m_nome').value; m.titulo_relatorio = $('#m_titulo').value; m.prefixo = $('#m_prefixo').value; m.descricao = $('#m_desc').value;
      $$('.ed-secao').forEach((el) => {
        const s = est.secoes[+el.dataset.s];
        s.titulo = $('[data-f=titulo]', el).value;
        s.repetir = $('[data-f=repetir]', el).checked;
        s.fotos = $('[data-f=fotos]', el).checked;
        if ($('[data-f=rotulo]', el)) { s.rotulo = $('[data-f=rotulo]', el).value; s.sugestoes = $('[data-f=sugestoes]', el).value.split(',').map((x) => x.trim()).filter(Boolean); }
        $$('.ed-item', el).forEach((ie) => {
          const it = s.itens[+ie.dataset.i];
          it.rotulo = $('[data-g=rotulo]', ie).value; it.tipo = $('[data-g=tipo]', ie).value;
          it.fotos = $('[data-g=fotos]', ie).checked; it.obs = $('[data-g=obs]', ie).checked;
          if ($('[data-g=escala]', ie)) it.escala = $('[data-g=escala]', ie).value;
          if ($('[data-g=opcoes]', ie)) it.opcoes = $('[data-g=opcoes]', ie).value.split('\n').map((x) => x.trim()).filter(Boolean);
          if ($('[data-g=unidade]', ie)) it.unidade = $('[data-g=unidade]', ie).value;
          if ($('[data-op]', ie)) it.opcoes = $$('[data-op]', ie).map((inp) => ({ t: inp.value, c: $(`[data-cor="${inp.dataset.op}"]`, ie).value }));
        });
      });
    };
    const mover = (lista, i, d) => { const j = i + d; if (j < 0 || j >= lista.length) return; [lista[i], lista[j]] = [lista[j], lista[i]]; };

    const ligar = () => {
      $('#addSecao').onclick = () => { ler(); est.secoes.push({ id: U.id(), titulo: '', repetir: false, itens: [{ id: U.id(), rotulo: '', tipo: 'avaliacao', escala: 'estado', fotos: true, obs: true }] }); desenhar(); };
      $('#secoes').onchange = (e) => {
        // mudar tipo/escala/repetir muda os campos mostrados
        if (e.target.matches('[data-g=tipo], [data-g=escala], [data-f=repetir]')) {
          ler();
          const ie = e.target.closest('.ed-item');
          if (ie) {
            const it = est.secoes[+e.target.closest('.ed-secao').dataset.s].itens[+ie.dataset.i];
            if (it.tipo === 'avaliacao' && !it.escala) it.escala = 'estado';
            if (it.escala === 'propria' && (!Array.isArray(it.opcoes) || typeof it.opcoes[0] !== 'object')) it.opcoes = [{ t: 'Adequado', c: 'verde' }, { t: 'Inadequado', c: 'vermelho' }];
            if ((it.tipo === 'opcoes' || it.tipo === 'multipla') && (!Array.isArray(it.opcoes) || typeof it.opcoes[0] === 'object')) it.opcoes = [];
          }
          desenhar();
        }
      };
      $('#secoes').onclick = (e) => {
        const b = e.target.closest('[data-acao]'); if (!b) return;
        e.preventDefault(); ler();
        const si = +b.closest('.ed-secao').dataset.s, s = est.secoes[si];
        const ie = b.closest('.ed-item'), ii = ie ? +ie.dataset.i : -1;
        switch (b.dataset.acao) {
          case 'sobeS': mover(est.secoes, si, -1); break;
          case 'desceS': mover(est.secoes, si, 1); break;
          case 'delS': if (est.secoes.length > 1 || confirm('Excluir a Ãºnica seÃ§Ã£o?')) est.secoes.splice(si, 1); break;
          case 'addItem': s.itens.push({ id: U.id(), rotulo: '', tipo: 'avaliacao', escala: 'estado', fotos: true, obs: true }); break;
          case 'sobeI': mover(s.itens, ii, -1); break;
          case 'desceI': mover(s.itens, ii, 1); break;
          case 'delI': s.itens.splice(ii, 1); break;
          case 'addOp': s.itens[ii].opcoes.push({ t: '', c: 'cinza' }); break;
          case 'delOp': s.itens[ii].opcoes.splice(+b.dataset.k, 1); break;
        }
        desenhar();
      };
      $('#salvar').onclick = async () => {
        ler();
        const corpo = { nome: m.nome, titulo_relatorio: m.titulo_relatorio, prefixo: m.prefixo, descricao: m.descricao, estrutura: est };
        try {
          await U.api(id === 'novo' ? 'POST' : 'PUT', id === 'novo' ? '/modelos' : `/modelos/${id}`, corpo);
          U.toast('Modelo salvo', 'ok'); location.hash = '#/modelos';
        } catch (e) { U.toast(e.message, 'erro'); }
      };
    };
    desenhar();
  },
};
'use strict';
/* Fila do celular (modo "SÃ³ fotos"): cada foto fica guardada NO CELULAR (IndexedDB) atÃ© o computador confirmar
   que recebeu. Sem internet, com o PC desligado ou no meio de um envio que caiu, nada se perde: a fila tenta de novo
   sozinha (quando a conexÃ£o volta, a cada 20 s e ao abrir o app). Pastas criadas sem conexÃ£o tambÃ©m entram na fila
   e sÃ£o criadas no computador antes das fotos delas. */
const Fila = (() => {
  const NOME = 'fndi_fila' + location.pathname.replace(/[^a-z0-9]/gi, '_');   // uma fila por Central (endereÃ§o)
  let banco = null, enviando = false, parado = null, ultimoErro = '', enviadas = 0;   // enviadas: contador (as telas sabem quando algo chegou)
  const ouvintes = new Set();

  function abrir() {
    if (banco) return Promise.resolve(banco);
    return new Promise((ok, ko) => {
      const r = indexedDB.open(NOME, 1);
      r.onupgradeneeded = () => {
        const d = r.result;
        d.createObjectStore('itens', { keyPath: 'id', autoIncrement: true });   // pastas e fotos, na ordem
        d.createObjectStore('mapa');                                           // pasta local â†’ id no computador
      };
      r.onsuccess = () => { banco = r.result; ok(banco); };
      r.onerror = () => ko(r.error || new Error('NÃ£o consegui abrir o armazenamento do celular.'));
    });
  }
  async function op(lojas, modo, fn) {
    const d = await abrir();
    return new Promise((ok, ko) => {
      const t = d.transaction(lojas, modo);
      let res;
      t.oncomplete = () => ok(res);
      t.onerror = t.onabort = () => ko(t.error || new Error('Erro no armazenamento do celular.'));
      res = fn(...[].concat(lojas).map((l) => t.objectStore(l)));
    });
  }
  const pedir = (req) => new Promise((ok, ko) => { req.onsuccess = () => ok(req.result); req.onerror = () => ko(req.error); });
  async function todos() { let l = []; await op('itens', 'readonly', (s) => { pedir(s.getAll()).then((x) => { l = x; }); }); return l; }
  async function mapa() { const m = {}; await op('mapa', 'readonly', (s) => { const c = s.openCursor(); c.onsuccess = () => { const k = c.result; if (k) { m[k.key] = k.value; k.continue(); } }; }); return m; }

  // avisa as telas (no mÃ¡ximo ~8x por segundo, para nÃ£o ler o armazenamento Ã  toa)
  let tAvisar = null;
  function avisar() { if (tAvisar) return; tAvisar = setTimeout(() => { tAvisar = null; resumo().then((r) => ouvintes.forEach((f) => { try { f(r); } catch { /* */ } })).catch(() => {}); }, 120); }

  // ---- entrada ----
  const novoUid = () => (crypto.randomUUID ? crypto.randomUUID() : Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 12) + Math.random().toString(36).slice(2, 12));
  async function novaPasta(nome, endereco) {
    const local = 'L' + novoUid().replace(/-/g, '').slice(0, 20);
    await op('itens', 'readwrite', (s) => s.add({ tipo: 'pasta', local, nome, endereco: endereco || '', criado: Date.now() }));
    avisar(); enviar();
    return local;
  }
  async function novaFoto(pasta, f) {
    // pasta: id do computador (nÃºmero) ou id local ("L...") de uma pasta ainda na fila
    let id;
    await op('itens', 'readwrite', (s) => { pedir(s.add({ tipo: 'foto', uid: novoUid(), pasta: String(pasta), pastaNome: f.pastaNome || '', blob: f.blob, mini: f.mini || null, largura: f.largura, altura: f.altura, legenda: f.legenda || '', tirada_em: f.tirada_em, criado: Date.now() })).then((x) => { id = x; }); });
    avisar(); enviar();
    return id;
  }
  async function alterar(id, mud) {
    await op('itens', 'readwrite', (s) => { pedir(s.get(id)).then((it) => { if (it) s.put({ ...it, ...mud }); }); });
    avisar();
  }
  async function remover(id) { await op('itens', 'readwrite', (s) => s.delete(id)); avisar(); }

  // ---- consulta ----
  async function resumo() {
    const l = await todos();
    const fotos = l.filter((x) => x.tipo === 'foto');
    const antiga = fotos.reduce((m, x) => Math.min(m, x.criado || Date.now()), Date.now());
    return { fotos: fotos.length, comErro: fotos.filter((x) => x.erro).length, pastas: l.filter((x) => x.tipo === 'pasta').length, enviando, erro: ultimoErro, enviadas,
      horasEsperando: fotos.length ? (Date.now() - antiga) / 3600e3 : 0, protegido };
  }
  async function fotosDa(pasta) {
    const m = await mapa(), alvo = String(pasta);
    return (await todos()).filter((x) => x.tipo === 'foto' && (x.pasta === alvo || m[x.pasta] === alvo));
  }
  async function fotosPendentes() { return (await todos()).filter((x) => x.tipo === 'foto'); }
  async function pastasPendentes() { return (await todos()).filter((x) => x.tipo === 'pasta'); }
  async function idNoComputador(local) { return (await mapa())[local] || null; }

  // ---- envio (uma coisa por vez, na ordem) ----
  let pausado = false;   // cÃ¢mera aberta: espera para enviar
  function pausar(p) { pausado = !!p; if (!pausado) enviar(); }
  async function enviar() {
    if (enviando || pausado) return;
    enviando = true; avisar();
    try {
      for (;;) {
        const l = (await todos()).filter((x) => !x.erro);
        if (!l.length) { ultimoErro = ''; break; }
        const it = l[0];
        try {
          if (it.tipo === 'pasta') {
            const v = await U.api('POST', '/vistorias', { modelo_id: ESTADO_FILA.modeloFotos(), cliente: { nome: it.nome }, local_endereco: it.endereco, uid: it.local });
            await op(['itens', 'mapa'], 'readwrite', (s, m) => { m.put(String(v.id), it.local); s.delete(it.id); });
            enviadas++;
          } else {
            let pasta = it.pasta;
            if (pasta.startsWith('L')) { pasta = await idNoComputador(pasta); if (!pasta) { await alterar(it.id, { erro: 'A pasta desta foto nÃ£o foi criada.' }); continue; } }
            const q = new URLSearchParams({ ...(it.uid ? { uid: it.uid } : {}), ref: 'geral', legenda: it.legenda || '', largura: it.largura || '', altura: it.altura || '', tirada_em: it.tirada_em || '' });
            const r = await U.api('POST', `/vistorias/${pasta}/fotos?${q}`, it.blob, { tipo: 'image/jpeg' });
            if (!r.repetida) await U.enviarMiniatura(r.id, it.mini);
            enviadas++;
            await remover(it.id);
          }
          ultimoErro = '';
        } catch (e) {
          if (e.offline || e.status === 401 || e.status === 429 || !e.status || e.status >= 500) { ultimoErro = e.message; break; }   // tenta de novo depois
          // recusado pelo computador (ex.: vistoria finalizada): separa para o usuÃ¡rio resolver, segue com as outras
          await alterar(it.id, { erro: e.message });
        }
      }
    } finally { enviando = false; avisar(); }
  }
  // pede ao navegador para NÃƒO apagar as fotos guardadas sozinho (quando o celular fica sem espaÃ§o)
  let protegido = null;
  async function proteger() {
    try {
      if (!navigator.storage || !navigator.storage.persist) { protegido = false; return false; }
      protegido = (await navigator.storage.persisted()) || (await navigator.storage.persist());
    } catch { protegido = false; }
    avisar(); return protegido;
  }
  function iniciar() {
    if (parado) return;
    proteger();
    parado = setInterval(enviar, 20000);
    window.addEventListener('online', enviar);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) enviar(); });
    enviar();
  }
  // tentar de novo as que deram erro
  async function reenviarErros() { for (const it of (await todos()).filter((x) => x.erro)) await alterar(it.id, { erro: null }); enviar(); }

  return { pausar, proteger, fotosPendentes, mapaLocal: mapa, novaPasta, novaFoto, alterar, remover, resumo, fotosDa, pastasPendentes, idNoComputador, enviar, iniciar, reenviarErros, ouvir: (f) => { ouvintes.add(f); return () => ouvintes.delete(f); }, ultimoErro: () => ultimoErro };
})();
// o modelo "Registro fotogrÃ¡fico" vem do /estado (guardado para funcionar sem conexÃ£o)
const ESTADO_FILA = { modeloFotos: () => (typeof ESTADO !== 'undefined' && ESTADO && ESTADO.modelo_fotos) || Number(localStorage.getItem('fndi_modelo_fotos') || 0) };
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
// FND SISTEMAS â€” CADASTRO DE USUÃRIOS (tela). Kit do painel FND Sistemas v2.2.
// Mostra UMA vez (por instalaÃ§Ã£o) a janela "Bem-vindo": Nome obrigatÃ³rio; contato, e-mail, empresa e
// cidade opcionais. O servidor (fnd-cadastro-servidor.js) guarda e envia para a planilha da FND.
// Uso:  FNDCadastro.iniciar({ endpoint: '/api/fnd/cadastro', sistema: 'FND Organiza',
//                             pronto: function () { return true; } /* quando a tela principal jÃ¡ estÃ¡ visÃ­vel */ });
