{
  "_LEIA": "Fallback da tela de ativaÃ§Ã£o. Os preÃ§os oficiais vÃªm do Assinador (seÃ§Ã£o PreÃ§os â†’ FND Remoto), publicados no GitHub e assinados. Plano sem preÃ§o aparece como 'consulte'.",
  "whatsapp": "5511960124439",
  "mensagem": "OlÃ¡! Quero comprar o FND Remoto.",
  "planos": {},
  "observacao": "Sem limite de computadores."
}/* FND Remoto â€” identidade visual (preto/azul do logo FND) */
:root {
  --bg: #070b14;
  --bg2: #0b1220;
  --panel: #0f1829;
  --panel2: #13203a;
  --line: #1d2b47;
  --text: #e8eef9;
  --muted: #8a9bbb;
  --blue: #1f6bff;
  --blue2: #2f8bff;
  --cyan: #3bc9f5;
  --ok: #22c55e;
  --warn: #f5a524;
  --bad: #ef4444;
  --info: #3bc9f5;
  --radius: 12px;
  --shadow: 0 8px 30px rgba(0, 0, 0, .35);
}
* { box-sizing: border-box; }
html, body { margin: 0; height: 100%; }
body {
  font-family: 'Segoe UI', Inter, system-ui, -apple-system, sans-serif;
  background: radial-gradient(1200px 600px at 80% -10%, rgba(31, 107, 255, .12), transparent 60%), var(--bg);
  color: var(--text); font-size: 14px;
}
a { color: var(--cyan); text-decoration: none; }
a:hover { text-decoration: underline; }
h1, h2, h3 { margin: 0 0 12px; font-weight: 600; }
h1 { font-size: 22px; } h2 { font-size: 18px; } h3 { font-size: 15px; color: var(--muted); font-weight: 600; }
.muted { color: var(--muted); }
.small { font-size: 12px; }
.hidden { display: none !important; }
code, pre, .mono { font-family: Consolas, 'Cascadia Mono', monospace; }
pre { background: #050811; border: 1px solid var(--line); border-radius: 8px; padding: 12px; overflow: auto; max-height: 420px; white-space: pre-wrap; word-break: break-word; font-size: 12px; margin: 0; }

/* ---------- layout ---------- */
.layout { display: grid; grid-template-columns: 240px 1fr; min-height: 100vh; }
.sidebar {
  background: linear-gradient(180deg, #060a12, #0a1120); border-right: 1px solid var(--line);
  display: flex; flex-direction: column; position: sticky; top: 0; height: 100vh;
}
.brand { display: flex; align-items: center; gap: 10px; padding: 18px 16px; border-bottom: 1px solid var(--line); }
.brand img { width: 46px; height: 46px; }
.brand b { display: block; font-size: 16px; letter-spacing: .5px; }
.brand span { font-size: 11px; color: var(--muted); }
.nav { padding: 10px 8px; flex: 1; overflow-y: auto; }
.nav a {
  display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 9px; color: var(--muted);
  margin-bottom: 2px; font-weight: 500;
}
.nav a:hover { background: var(--panel); color: var(--text); text-decoration: none; }
.nav a.active { background: linear-gradient(90deg, rgba(31, 107, 255, .25), rgba(31, 107, 255, .05)); color: #fff; box-shadow: inset 3px 0 0 var(--blue2); }
.nav .ico { width: 20px; text-align: center; font-size: 16px; }
.nav .badge { margin-left: auto; }
.nav .sep { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: #50607f; padding: 14px 12px 6px; }
.userbox { padding: 12px 16px; border-top: 1px solid var(--line); font-size: 12px; }
.userbox b { display: block; font-size: 13px; }
.main { padding: 22px 26px 40px; min-width: 0; }
.topbar { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; flex-wrap: wrap; }
.topbar h1 { margin: 0; flex: 1; }
.btn.menu-btn { display: none; }

/* ---------- componentes ---------- */
.card { background: linear-gradient(180deg, var(--panel), var(--bg2)); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px; box-shadow: var(--shadow); }
.card + .card { margin-top: 16px; }
.grid > .card + .card { margin-top: 0; }
.grid { display: grid; gap: 16px; }
.g2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.g3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.kpis { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 14px; margin-bottom: 18px; }
.kpi { background: linear-gradient(160deg, var(--panel2), var(--panel)); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; cursor: pointer; position: relative; overflow: hidden; }
.kpi::after { content: ''; position: absolute; right: -30px; top: -30px; width: 90px; height: 90px; border-radius: 50%; background: rgba(47, 139, 255, .08); }
.kpi:hover { border-color: var(--blue); }
.kpi .v { font-size: 30px; font-weight: 700; margin-top: 6px; }
.kpi .l { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .6px; }
.kpi.ok .v { color: var(--ok); } .kpi.bad .v { color: var(--bad); } .kpi.warn .v { color: var(--warn); } .kpi.blue .v { color: var(--cyan); }

.btn {
  display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--line); background: var(--panel2); color: var(--text);
  padding: 8px 14px; border-radius: 9px; cursor: pointer; font: inherit; font-weight: 500; white-space: nowrap;
}
.btn:hover { border-color: var(--blue2); }
.btn.primary { background: linear-gradient(180deg, var(--blue2), var(--blue)); border-color: var(--blue); color: #fff; }
.btn.danger { background: rgba(239, 68, 68, .12); border-color: rgba(239, 68, 68, .5); color: #ffb4b4; }
.btn.ghost { background: transparent; }
.btn.sm { padding: 5px 10px; font-size: 12px; }
.btn:disabled { opacity: .5; cursor: not-allowed; }
.btns { display: flex; gap: 8px; flex-wrap: wrap; }

input, select, textarea {
  background: #0a1222; border: 1px solid var(--line); color: var(--text); border-radius: 8px; padding: 9px 11px; font: inherit; width: 100%;
}
input:focus, select:focus, textarea:focus { outline: none; border-color: var(--blue2); box-shadow: 0 0 0 3px rgba(47, 139, 255, .18); }
textarea { min-height: 160px; font-family: Consolas, monospace; font-size: 12px; }
label { display: block; font-size: 12px; color: var(--muted); margin: 10px 0 5px; }
input[type=checkbox] { width: auto; }
.row { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
.row > * { flex: 1; min-width: 150px; }
.toolbar { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; align-items: center; }
.toolbar input, .toolbar select { width: auto; min-width: 170px; }
.toolbar .grow { flex: 1; min-width: 220px; }

table { width: 100%; border-collapse: collapse; }
th, td { text-align: left; padding: 10px 10px; border-bottom: 1px solid var(--line); vertical-align: middle; }
th { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: .6px; font-weight: 600; cursor: default; user-select: none; position: sticky; top: 0; background: var(--panel); }
th.sort { cursor: pointer; } th.sort:hover { color: var(--text); }
tbody tr:hover { background: rgba(47, 139, 255, .06); }
tr.click { cursor: pointer; }
.nw { white-space: nowrap; }
.table-wrap { overflow: auto; border-radius: 10px; border: 1px solid var(--line); max-height: 70vh; }
.empty { text-align: center; color: var(--muted); padding: 30px; }

.dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; margin-right: 6px; background: #4b5563; }
.dot.online { background: var(--ok); box-shadow: 0 0 8px var(--ok); }
.dot.offline { background: #6b7280; }
.badge { display: inline-block; padding: 2px 8px; border-radius: 99px; font-size: 11px; font-weight: 600; background: var(--panel2); border: 1px solid var(--line); color: var(--muted); }
.badge.ok { color: var(--ok); border-color: rgba(34, 197, 94, .4); background: rgba(34, 197, 94, .1); }
.badge.bad, .badge.critico, .badge.erro { color: #ff8a8a; border-color: rgba(239, 68, 68, .4); background: rgba(239, 68, 68, .1); }
.badge.warn, .badge.aviso, .badge.pendente { color: var(--warn); border-color: rgba(245, 165, 36, .4); background: rgba(245, 165, 36, .1); }
.badge.info, .badge.executando, .badge.enviada { color: var(--cyan); border-color: rgba(59, 201, 245, .4); background: rgba(59, 201, 245, .1); }
.badge.avisos { color: var(--warn); border-color: rgba(245, 165, 36, .5); background: rgba(245, 165, 36, .12); }
.badge.concluida { color: var(--ok); border-color: rgba(34, 197, 94, .4); background: rgba(34, 197, 94, .1); }
.badge.blue { color: #fff; background: var(--blue); border-color: var(--blue); }

.bar { height: 6px; background: #0a1222; border-radius: 99px; overflow: hidden; min-width: 70px; }
.bar > i { display: block; height: 100%; background: linear-gradient(90deg, var(--blue), var(--cyan)); }
.bar.warn > i { background: var(--warn); } .bar.bad > i { background: var(--bad); }

.tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--line); margin-bottom: 16px; flex-wrap: wrap; }
.tabs a { cursor: pointer; padding: 10px 14px; color: var(--muted); border-bottom: 2px solid transparent; font-weight: 500; }
.tabs a.active { color: #fff; border-color: var(--blue2); }
.tabs a:hover { text-decoration: none; color: var(--text); }

.kv { display: grid; grid-template-columns: 150px 1fr; gap: 7px 12px; font-size: 13px; }
.kv dt { color: var(--muted); } .kv dd { margin: 0; word-break: break-word; }
.list-item { display: flex; gap: 10px; align-items: flex-start; padding: 10px 0; border-bottom: 1px solid var(--line); }
.list-item:last-child { border-bottom: 0; }
.list-item .t { flex: 1; min-width: 0; }
.list-item .when { color: var(--muted); font-size: 12px; white-space: nowrap; }

.code-box { display: flex; align-items: center; gap: 8px; background: #050811; border: 1px dashed var(--blue2); border-radius: 8px; padding: 8px 12px; font-family: Consolas, monospace; font-size: 15px; letter-spacing: 1px; }

/* ---------- modal ---------- */
.modal-bg { position: fixed; inset: 0; background: rgba(2, 5, 12, .72); display: flex; align-items: flex-start; justify-content: center; z-index: 50; padding: 5vh 16px; overflow-y: auto; backdrop-filter: blur(3px); }
.modal { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; width: 100%; max-width: 640px; box-shadow: var(--shadow); }
.modal.wide { max-width: 1000px; }
.modal header { display: flex; align-items: center; padding: 16px 18px; border-bottom: 1px solid var(--line); }
.modal header h2 { margin: 0; flex: 1; }
.modal .body { padding: 18px; }
.modal footer { padding: 14px 18px; border-top: 1px solid var(--line); display: flex; justify-content: flex-end; gap: 8px; }
.x { background: none; border: 0; color: var(--muted); font-size: 22px; cursor: pointer; }

.toast-wrap { position: fixed; right: 18px; bottom: 18px; display: flex; flex-direction: column; gap: 8px; z-index: 80; }
.toast { background: var(--panel2); border: 1px solid var(--line); border-left: 4px solid var(--blue2); padding: 12px 16px; border-radius: 10px; box-shadow: var(--shadow); max-width: 380px; }
.toast.err { border-left-color: var(--bad); } .toast.ok { border-left-color: var(--ok); }

/* ---------- login ---------- */
.plain { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 20px; }
.narrow { width: 100%; max-width: 400px; text-align: center; }
.narrow form { text-align: left; }
.logo-big { width: 150px; height: 150px; margin: -6px auto 6px; display: block; filter: drop-shadow(0 0 25px rgba(47, 139, 255, .35)); }
.narrow .btn { width: 100%; justify-content: center; margin-top: 16px; padding: 11px; }
.err-msg { color: #ff8a8a; font-size: 13px; margin-top: 10px; min-height: 18px; }

/* ---------- relatÃ³rio para impressÃ£o ---------- */
.report { background: #fff; color: #111; padding: 30px; border-radius: 8px; }
.report h1, .report h2, .report h3 { color: #111; }
.report table th { background: #f1f5f9; color: #334155; position: static; }
.report td, .report th { border-color: #e2e8f0; }
.report .head { display: flex; gap: 16px; align-items: center; border-bottom: 3px solid var(--blue); padding-bottom: 12px; margin-bottom: 18px; }
.report .head img { width: 70px; height: 70px; }
@media print {
  body { background: #fff; }
  .sidebar, .topbar, .no-print, .toast-wrap { display: none !important; }
  .layout { display: block; } .main { padding: 0; }
  .report { padding: 0; }
}

/* ---------- celular / telas pequenas ---------- */
@media (max-width: 900px) {
  .layout { grid-template-columns: 1fr; }
  .sidebar { position: fixed; left: -260px; width: 250px; z-index: 60; transition: left .2s; }
  .sidebar.open { left: 0; }
  .btn.menu-btn { display: inline-flex; }
  .main { padding: 16px; }
  .g2, .g3 { grid-template-columns: 1fr; }
  .kv { grid-template-columns: 120px 1fr; }
  .hide-sm { display: none; }
}
button.kpi { font: inherit; color: var(--text); width: 100%; }

/* listas do painel com rolagem prÃ³pria (nÃ£o esticam a pÃ¡gina) */
.scroll-list { max-height: 380px; overflow-y: auto; padding-right: 6px; margin-right: -6px; scrollbar-width: thin; scrollbar-color: var(--line) transparent; }
.scroll-list::-webkit-scrollbar { width: 6px; }
.scroll-list::-webkit-scrollbar-thumb { background: var(--line); border-radius: 6px; }
/* planos da tela de LicenÃ§a (clicÃ¡veis) */
button.card.plano{border:1px solid var(--line);transition:border-color .15s,transform .15s}
button.card.plano:hover{border-color:var(--blue2);transform:translateY(-1px)}
button.card.plano:focus-visible{outline:2px solid var(--blue2);outline-offset:2px}
'use strict';
/* FND Remoto â€” painel administrativo (JavaScript puro, sem dependÃªncias) */

// ================= utilidades =================
const $ = (sel, el = document) => el.querySelector(sel);
const $$ = (sel, el = document) => [...el.querySelectorAll(sel)];
const PAGE = 100; // linhas por pÃ¡gina nas listas grandes
const tempoTela = (m) => (Number(m) >= 60 ? `${Number(m) / 60} h` : `${Number(m)} min`);
const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const app = () => $('#app');

const S = { me: null, actions: [], actionMap: {}, clients: [], groups: [], view: null, sse: null };

async function api(method, url, body) {
  const r = await fetch('/api' + url, {
    method, credentials: 'same-origin',
    headers: { 'content-type': 'application/json', 'x-fnd': '1' },
    body: body !== undefined ? JSON.stringify(body) : undefined,
  });
  let data = null; try { data = await r.json(); } catch { /* */ }
  if (r.status === 401 && !url.startsWith('/login') && S.me) { S.me = null; boot(); throw new Error('SessÃ£o expirada.'); }
  if (r.status === 402 && data && data.licenca) throw new Error(data.error);
  if (!r.ok) throw new Error((data && data.error) || `Erro ${r.status}`);
  return data;
}
const GET = (u) => api('GET', u);
const POST = (u, b = {}) => api('POST', u, b);

function toast(msg, type = '') {
  const t = document.createElement('div');
  t.className = 'toast ' + type; t.textContent = msg;
  $('#toasts').appendChild(t);
  setTimeout(() => t.remove(), type === 'err' ? 7000 : 4000);
}
const fail = (e) => toast(e.message || String(e), 'err');

function when(s) {
  if (!s) return 'â€”';
  const d = new Date(String(s).replace(' ', 'T'));
  if (isNaN(d)) return esc(s);
  const diff = (Date.now() - d.getTime()) / 1000;
  if (diff >= 0 && diff < 60) return 'agora';
  if (diff >= 0 && diff < 3600) return `hÃ¡ ${Math.floor(diff / 60)} min`;
  if (diff >= 0 && diff < 86400) return `hÃ¡ ${Math.floor(diff / 3600)} h`;
  return d.toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' });
}
const dt = (s) => {
  if (!s) return 'â€”';
  const d = new Date(String(s).replace(' ', 'T'));
  if (isNaN(d) || d.getFullYear() < 2000) return 'â€”';
  return esc(d.toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' }));
};
const role = (r) => ({ admin: 'Administrador', tecnico: 'TÃ©cnico', leitura: 'Somente leitura' }[r] || r);
const can = (r) => ({ leitura: 0, tecnico: 1, admin: 2 }[S.me.role] >= { leitura: 0, tecnico: 1, admin: 2 }[r]);
const statusLabel = { pendente: 'Pendente', enviada: 'Enviada', executando: 'Executando', concluida: 'ConcluÃ­da', avisos: 'ConcluÃ­da com avisos', erro: 'Erro', cancelada: 'Cancelada' };
const sevLabel = { critico: 'CrÃ­tico', aviso: 'Aviso', info: 'Info' };
const HEAVY = ['app_atualizar', 'app_atualizar_todos', 'apps_atualizar_lista', 'app_instalar', 'app_desinstalar', 'instalar_pacote', 'windows_update_instalar', 'drivers_instalar', 'reiniciar_pc'];
const waitLabel = (t) => (t.status === 'pendente' && t.respect_window && t.maintenance_window ? `Aguarda horÃ¡rio ${t.maintenance_window}` : null);
const actLabel = (a) => (S.actionMap[a] ? S.actionMap[a].label : a);
const shortOs = (s) => String(s || '').replace(/^Microsoft\s+/i, '').replace(/\s*\(simulado\)/, '');
const shortCpu = (s) => String(s || '').replace(/\((R|TM)\)/gi, '').replace(/\s*CPU\s*@.*$/i, '').replace(/\s+\d+(th|rd|nd|st) Gen\s+/i, ' ').replace(/\s+/g, ' ').trim();
const fmtSize = (b) => (b >= 1073741824 ? (b / 1073741824).toFixed(2) + ' GB' : b >= 1048576 ? (b / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round((b || 0) / 1024)) + ' KB');
const devName = (d) => esc(d.alias || d.hostname || '(sem nome)');

function bar(pct) {
  if (pct === undefined || pct === null || isNaN(pct)) return '<span class="muted">â€”</span>';
  const cls = pct >= 90 ? 'bad' : pct >= 75 ? 'warn' : '';
  return `<div class="bar ${cls}" title="${pct}%"><i style="width:${Math.min(100, Math.max(0, pct))}%"></i></div>`;
}

function copy(text) {
  if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text).then(() => toast('Copiado!', 'ok'), () => fallbackCopy(text));
  else fallbackCopy(text);
}
function fallbackCopy(text) {
  const ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta); ta.select();
  try { document.execCommand('copy'); toast('Copiado!', 'ok'); } catch { prompt('Copie:', text); }
  ta.remove();
}

// ================= modal =================
function modal(title, bodyHtml, { wide = false, footer = '' } = {}) {
  const bg = document.createElement('div');
  bg.className = 'modal-bg';
  bg.innerHTML = `<div class="modal ${wide ? 'wide' : ''}"><header><h2>${esc(title)}</h2><button class="x" data-close>Ã—</button></header>
    <div class="body">${bodyHtml}</div>${footer ? `<footer>${footer}</footer>` : ''}</div>`;
  document.body.appendChild(bg);
  const close = () => { bg.remove(); if (bg.onclose) bg.onclose(); };
  bg.addEventListener('mousedown', (e) => { if (e.target === bg) close(); });
  bg.addEventListener('click', (e) => { if (e.target.closest('[data-close]')) close(); });
  bg.close = close;
  const first = $('input,select,textarea', bg); if (first) setTimeout(() => first.focus(), 30);
  return bg;
}
function confirmBox(title, text, okLabel = 'Confirmar', danger = false) {
  return new Promise((resolve) => {
    const m = modal(title, `<p>${text}</p>`, { footer: `<button class="btn ghost" data-close>Cancelar</button><button class="btn ${danger ? 'danger' : 'primary'}" data-ok>${esc(okLabel)}</button>` });
    let done = false;
    m.onclose = () => { if (!done) resolve(false); };
    $('[data-ok]', m).onclick = () => { done = true; m.close(); resolve(true); };
  });
}
function formData(form) {
  const o = {};
  for (const el of form.elements) {
    if (!el.name) continue;
    o[el.name] = el.type === 'checkbox' ? el.checked : el.value;
  }
  return o;
}

// ================= tabelas automÃ¡ticas para resultados =================
const KEY_LABELS = {
  name: 'Nome', id: 'ID', sizeMB: 'Tamanho (MB)', cpuLoad: 'CPU %', ramPct: 'RAM %', version: 'VersÃ£o', available: 'DisponÃ­vel', source: 'Origem', publisher: 'Fabricante', installDate: 'Instalado em',
  pid: 'PID', memMB: 'MemÃ³ria (MB)', cpuSec: 'CPU (s)', cpu: 'CPU %', user: 'UsuÃ¡rio', title: 'TÃ­tulo', display: 'ExibiÃ§Ã£o', state: 'Estado',
  start: 'InicializaÃ§Ã£o', account: 'Conta', letter: 'Unidade', label: 'RÃ³tulo', fs: 'Sistema', sizeGB: 'Tamanho (GB)', freeGB: 'Livre (GB)', freePct: 'Livre %',
  model: 'Modelo', type: 'Tipo', bus: 'Barramento', health: 'SaÃºde', status: 'Status', temperature: 'Temperatura', wear: 'Desgaste %', readErrors: 'Erros leitura',
  writeErrors: 'Erros escrita', powerOnHours: 'Horas ligado', enabled: 'Ativo', updated: 'Atualizado', command: 'Comando', location: 'Local', kb: 'KB',
  severity: 'Gravidade', downloaded: 'Baixada', mayReboot: 'Pode reiniciar', categories: 'Categoria', result: 'Resultado', hresult: 'CÃ³digo', scope: 'Escopo',
  exitCode: 'CÃ³digo de saÃ­da', message: 'Mensagem', rebootPending: 'ReinÃ­cio pendente', rebootRequired: 'Precisa reiniciar',
};
const fmtVal = (v) => (v === true ? 'Sim' : v === false ? 'NÃ£o' : v === null || v === undefined || v === '' || (typeof v === 'object' && !Array.isArray(v) && !Object.keys(v).length) ? 'â€”' : typeof v === 'object' ? esc(JSON.stringify(v)) : esc(v));

function autoTable(arr, maxRows = 2000) {
  if (!arr.length) return '<p class="muted">Nenhum item.</p>';
  if (typeof arr[0] !== 'object') return `<ul>${arr.map((x) => `<li>${esc(x)}</li>`).join('')}</ul>`;
  const keys = [...new Set(arr.flatMap((o) => Object.keys(o)))].slice(0, 9);
  return `<div class="table-wrap"><table><thead><tr>${keys.map((k) => `<th>${esc(KEY_LABELS[k] || k)}</th>`).join('')}</tr></thead><tbody>
    ${arr.slice(0, maxRows).map((o) => `<tr>${keys.map((k) => `<td>${fmtVal(o[k])}</td>`).join('')}</tr>`).join('')}</tbody></table></div>
    ${arr.length > maxRows ? `<p class="muted small">Mostrando ${maxRows} de ${arr.length}.</p>` : ''}`;
}
function autoRender(data) {
  if (data === null || data === undefined) return '';
  if (Array.isArray(data)) return autoTable(data);
  if (typeof data !== 'object') return `<pre>${esc(data)}</pre>`;
  const simple = Object.entries(data).filter(([, v]) => v === null || typeof v !== 'object');
  const complex = Object.entries(data).filter(([, v]) => v !== null && typeof v === 'object');
  let h = '';
  if (simple.length) h += `<dl class="kv">${simple.map(([k, v]) => `<dt>${esc(KEY_LABELS[k] || k)}</dt><dd>${fmtVal(v)}</dd>`).join('')}</dl>`;
  for (const [k, v] of complex) h += `<h3 style="margin-top:16px">${esc(KEY_LABELS[k] || k)}</h3>${autoRender(v)}`;
  return h;
}

// ================= inicializaÃ§Ã£o =================
async function boot() {
  if (S.sse) { S.sse.close(); S.sse = null; }
  let st;
  try { st = await GET('/state'); } catch (e) { app().innerHTML = `<div class="plain"><div class="card narrow"><h2>Central indisponÃ­vel</h2><p class="muted">${esc(e.message)}</p></div></div>`; return; }
  document.title = st.name || 'FND Remoto';
  if (st.setupNeeded) return renderSetup();
  if (!st.logged) return renderLogin();
  try { S.me = await GET('/me'); } catch { return renderLogin(); }
  try {
    S.actions = await GET('/actions');
    S.actionMap = Object.fromEntries(S.actions.map((a) => [a.key, a]));
  } catch { return renderLogin(); }
  renderLayout();
  connectEvents();
  route();
}

function renderSetup() {
  app().innerHTML = `<div class="plain"><div class="card narrow">
    <img src="/img/logo.png" class="logo-big" alt="FND Remoto">
    <h2>ConfiguraÃ§Ã£o inicial</h2>
    <p class="muted small">Crie o administrador da Central. NÃ£o existe senha padrÃ£o.</p>
    <form id="f">
      <label>Seu nome</label><input name="name" required maxlength="80">
      <label>UsuÃ¡rio</label><input name="username" required maxlength="40" autocomplete="username">
      <label>Senha (mÃ­n. 8, com letras e nÃºmeros)</label><input name="password" type="password" required autocomplete="new-password">
      <label>Repita a senha</label><input name="password2" type="password" required autocomplete="new-password">
      <label>Primeiro cliente / sua empresa</label><input name="company" value="FND Sistemas" maxlength="120">
      <button class="btn primary">Criar e entrar</button>
      <div class="err-msg" id="err"></div>
    </form></div></div>`;
  $('#f').onsubmit = async (e) => {
    e.preventDefault();
    const d = formData(e.target);
    if (d.password !== d.password2) { $('#err').textContent = 'As senhas nÃ£o conferem.'; return; }
    try {
      await POST('/setup', d);
      await POST('/login', { username: d.username, password: d.password });
      boot();
    } catch (err) { $('#err').textContent = err.message; }
  };
}

async function renderRecuperar() {
  let cod = '';
  try { cod = (await GET('/recuperar')).codigo; } catch { /* */ }
  app().innerHTML = `<div class="plain"><div class="card narrow" style="max-width:460px">
    <img src="/img/logo.png" class="logo-big" alt="FND Remoto"><h2>Redefinir a senha do administrador</h2>
    <p class="muted small">Mande este cÃ³digo para a <b>FND Sistemas</b> e peÃ§a o <b>cÃ³digo de recuperaÃ§Ã£o</b>. Ele vale sÃ³ hoje e uma vez sÃ³.</p>
    <div class="code-box" style="margin:10px 0;font-size:1.25em;letter-spacing:2px">${esc(cod)}</div>
    <form id="rf">
      <label>UsuÃ¡rio do administrador</label><input name="usuario" required autocomplete="username">
      <label>CÃ³digo de recuperaÃ§Ã£o (cole inteiro)</label><textarea name="codigo" rows="3" required spellcheck="false" style="font-family:monospace;min-height:70px" placeholder="FNDREC-..."></textarea>
      <label>Senha nova (mÃ­n. 8, com letras e nÃºmeros)</label><input name="senha" type="password" required autocomplete="new-password">
      <button class="btn primary">Redefinir a senha</button>
      <div class="err-msg" id="rerr"></div>
    </form>
    <p class="small" style="margin-top:12px"><a href="#" id="voltar">Voltar para o login</a></p>
    <p class="muted small">Por seguranÃ§a, a verificaÃ§Ã£o em duas etapas (2FA) desse usuÃ¡rio Ã© desligada. Fica no histÃ³rico e, se os avisos estiverem ligados, vocÃª recebe no Telegram/e-mail.</p></div></div>`;
  $('#voltar').onclick = (e) => { e.preventDefault(); renderLogin(); };
  $('#rf').onsubmit = async (e) => {
    e.preventDefault();
    try { await POST('/recuperar', formData(e.target)); toast('Senha redefinida. Entre com a senha nova.', 'ok'); renderLogin(); }
    catch (er) { $('#rerr').textContent = er.message; }
  };
}

function renderLogin() {
  app().innerHTML = `<div class="plain"><div class="card narrow">
    <img src="/img/logo.png" class="logo-big" alt="FND Remoto">
    <form id="f">
      <label>UsuÃ¡rio</label><input name="username" required autocomplete="username">
      <label>Senha</label><input name="password" type="password" required autocomplete="current-password">
      <button class="btn primary">Entrar</button>
      <div class="err-msg" id="err"></div>
    </form>
    <form id="f2" class="hidden">
      <p class="muted">Digite o cÃ³digo de 6 dÃ­gitos do seu aplicativo autenticador.</p>
      <input name="code" inputmode="numeric" maxlength="6" autocomplete="one-time-code" placeholder="000000">
      <button class="btn primary">Confirmar</button>
      <div class="err-msg" id="err2"></div>
    </form>
    <p class="small" style="margin-top:14px"><a href="#" id="esqueci">Esqueci a senha do administrador</a></p>
    <p class="muted small" style="margin-top:10px">FND Sistemas</p></div></div>`;
  $('#esqueci').onclick = (e) => { e.preventDefault(); renderRecuperar(); };
  let ticket = null;
  $('#f').onsubmit = async (e) => {
    e.preventDefault();
    try {
      const r = await POST('/login', formData(e.target));
      if (r.need2fa) { ticket = r.ticket; $('#f').classList.add('hidden'); $('#f2').classList.remove('hidden'); $('#f2 input').focus(); return; }
      boot();
    } catch (err) { $('#err').textContent = err.message; }
  };
  $('#f2').onsubmit = async (e) => {
    e.preventDefault();
    try { await POST('/login/2fa', { ticket, code: e.target.code.value }); boot(); } catch (err) { $('#err2').textContent = err.message; }
  };
}

// ================= layout =================
const NAV = [
  ['dashboard', 'â—§', 'Painel'],
  ['computadores', 'ðŸ–¥', 'Computadores'],
  ['equipamentos', 'ðŸ—„', 'Equipamentos'],
  ['tarefas', 'âš™', 'Tarefas'],
  ['agendamentos', 'ðŸ—“', 'Agendamentos', 'tecnico'],
  ['alertas', 'ðŸ””', 'Alertas'],
  ['clientes', 'ðŸ¢', 'Clientes'],
  ['relatorios', 'ðŸ“„', 'RelatÃ³rios'],
  ['atividades', 'ðŸ•‘', 'HistÃ³rico de atividades'],
  ['sep', '', 'AdministraÃ§Ã£o'],
  ['instaladores', 'ðŸ“¦', 'Meus instaladores', 'tecnico'],
  ['scripts', 'ðŸ“œ', 'Scripts', 'admin'],
  ['instalar', 'â¬‡', 'Instalar agente', 'tecnico'],
  ['usuarios', 'ðŸ‘¥', 'UsuÃ¡rios', 'admin'],
  ['config', 'ðŸ› ', 'ConfiguraÃ§Ãµes', 'admin'],
  ['licenca', 'ðŸ”‘', 'LicenÃ§a', 'admin'],
  ['conta', 'ðŸ”’', 'Minha conta'],
];

function renderLayout() {
  const me = S.me;
  app().innerHTML = `<div class="layout">
    <aside class="sidebar" id="sb">
      <div class="brand"><img src="/img/logo.png" alt=""><div><b>${esc(me.centralName)}</b><span>FND Sistemas Â· v${esc(me.version)}</span></div></div>
      <nav class="nav">${NAV.filter((n) => !n[3] || (can(n[3]) && !me.clientId)).map((n) => n[0] === 'sep'
        ? `<div class="sep">${n[2]}</div>`
        : `<a href="#/${n[0]}" data-nav="${n[0]}"><span class="ico">${n[1]}</span>${n[2]}${n[0] === 'alertas' ? '<span class="badge bad hidden" id="nav-alerts"></span>' : ''}</a>`).join('')}
        <a href="#" id="nav-sobre-fnd" class="fndp-esconder" title="Links da FND e os outros sistemas"><span class="ico">â„¹ï¸</span>Sobre / FND Sistemas</a>
      </nav>
      <div class="userbox"><b>${esc(me.name || me.username)}</b><span class="muted">${role(me.role)}${me.clientName ? ' Â· ' + esc(me.clientName) : ''}</span>
        <div style="margin-top:8px"><button class="btn sm ghost" id="logout">Sair</button></div></div>
    </aside>
    <main class="main"><div class="topbar"><button class="btn menu-btn" id="menu">â˜°</button><h1 id="title"></h1><div class="btns" id="top-actions"></div><button class="btn sm ghost fndp-esconder" id="fnd-sist" title="ConheÃ§a a FND Sistemas"><span class="fndp-logo"></span> FND Sistemas</button></div>
      ${licFaixa()}
      <div id="view"></div></main></div>`;
  $('#logout').onclick = async () => { try { await POST('/logout'); } catch { /* */ } S.me = null; boot(); };
  $('#menu').onclick = () => $('#sb').classList.toggle('open');
  // painel "FND Sistemas" (fnd-painel.js): botÃ£o no topo e item no menu
  if (window.FNDPainel) {
    if (!S.fndPainel) { S.fndPainel = true; FNDPainel.iniciar({ endpoint: '/api/fnd/links', botao: false, tema: 'auto' }); }
    // cadastro de usuÃ¡rio (janela "Bem-vindo", uma vez por instalaÃ§Ã£o): sÃ³ para o administrador, com o painel jÃ¡ aberto
    if (window.FNDCadastro && !S.fndCadastro && S.me && S.me.role === 'admin' && !S.me.clientId) {
      S.fndCadastro = true;
      FNDCadastro.iniciar({ endpoint: '/api/fnd/cadastro', sistema: 'FND Remoto', pronto: () => !!document.getElementById('sb') && !document.querySelector('.modal-bg') });
    }
    $('#fnd-sist').onclick = () => FNDPainel.abrir();
    $('#nav-sobre-fnd').onclick = (e) => { e.preventDefault(); $('#sb').classList.remove('open'); FNDPainel.abrir(); };
  } else { $('#fnd-sist').remove(); $('#nav-sobre-fnd').remove(); }
  $('#sb').addEventListener('click', (e) => { if (e.target.closest('a')) $('#sb').classList.remove('open'); });
}

function setTitle(t, actionsHtml = '') { $('#title').textContent = t; $('#top-actions').innerHTML = actionsHtml; document.title = `${t} Â· FND Remoto`; }

// ================= eventos em tempo real =================
let evTimer = null;
function connectEvents() {
  if (S.sse) S.sse.close();
  S.sse = new EventSource('/api/events');
  const onEv = (type, ev) => {
    let data = {}; try { data = JSON.parse(ev.data); } catch { /* */ }
    if (type === 'alert' && data.message && data.severity !== 'info') toast(data.message, 'err');
    // no mÃ¡ximo 1 atualizaÃ§Ã£o a cada 1,5 s, mesmo com muitos PCs mandando eventos sem parar
    S.evLast = { type, data };
    if (evTimer) return;
    evTimer = setTimeout(() => { evTimer = null; const e = S.evLast; if (S.view && S.view.refresh) S.view.refresh(e.type, e.data); updateAlertBadge(); }, 1500);
  };
  ['device', 'task', 'alert', 'equip'].forEach((t) => S.sse.addEventListener(t, (ev) => onEv(t, ev)));
  updateAlertBadge();
}
async function updateAlertBadge() {
  try {
    const d = await GET('/alerts');
    const b = $('#nav-alerts'); if (!b) return;
    b.textContent = d.length; b.classList.toggle('hidden', !d.length);
  } catch { /* */ }
}

// ================= rotas =================
const VIEWS = {};
function route() {
  if (!S.me) return;
  $$('.modal-bg').forEach((m) => m.close ? m.close() : m.remove());
  const [path, query = ''] = (location.hash || '#/dashboard').split('?');
  const [, name = 'dashboard', ...rest] = path.split('/');
  if (query) rest.push('?' + query);
  $$('[data-nav]').forEach((a) => a.classList.toggle('active', a.dataset.nav === name || (name === 'pc' && a.dataset.nav === 'computadores')));
  const v = VIEWS[name] || VIEWS.dashboard;
  S.view = v;
  const el = $('#view');
  el.innerHTML = '<p class="muted">Carregando...</p>';
  Promise.resolve(v.render(el, ...rest.map(decodeURIComponent))).catch(fail);
}
window.addEventListener('hashchange', route);
// "Ver planos e ativar": abre a tela de LicenÃ§a jÃ¡ nos planos (funciona tambÃ©m se jÃ¡ estiver nela)
document.addEventListener('click', (e) => {
  const a = e.target.closest && e.target.closest('[data-licplanos]');
  if (!a) return;
  e.preventDefault();
  S.irPlanos = true;
  if ((location.hash || '').startsWith('#/licenca')) {
    const h = document.getElementById('licplanos');
    if (h) { S.irPlanos = false; h.scrollIntoView({ behavior: 'smooth', block: 'start' }); } else route();
  } else location.hash = '#/licenca';
});

async function loadClients() { S.clients = await GET('/clients'); S.groups = await GET('/groups'); }
const clientOptions = (sel, all = true) => `${all ? '<option value="">Todos os clientes</option>' : ''}${S.clients.map((c) => `<option value="${c.id}" ${String(sel) === String(c.id) ? 'selected' : ''}>${esc(c.name)}</option>`).join('')}`;
const groupOptions = (clientId, sel, all = true) => `${all ? '<option value="">Todos os grupos</option>' : '<option value="">(sem grupo)</option>'}${S.groups.filter((g) => !clientId || String(g.client_id) === String(clientId)).map((g) => `<option value="${g.id}" ${String(sel) === String(g.id) ? 'selected' : ''}>${esc(g.name)}${clientId ? '' : ' Â· ' + esc(g.client_name)}</option>`).join('')}`;

// ================= PAINEL =================
VIEWS.dashboard = {
  async render(el) {
    setTitle('Painel');
    this.el = el;
    await this.refresh();
  },
  async refresh() {
    const d = await GET('/dashboard');
    const el = this.el;
    el.innerHTML = `<div class="kpis">
      <div class="kpi blue" data-go="computadores"><div class="l">Computadores</div><div class="v">${d.total}</div></div>
      <div class="kpi ok" data-go="computadores?status=online"><div class="l">Online</div><div class="v">${d.online}</div></div>
      <div class="kpi" data-go="computadores?status=offline"><div class="l">Offline</div><div class="v">${d.offline}</div></div>
      <div class="kpi" data-go="clientes"><div class="l">Clientes</div><div class="v">${d.clients}</div></div>
      <div class="kpi ${d.needMaint ? 'warn' : ''}" data-go="alertas"><div class="l">Precisam de manutenÃ§Ã£o</div><div class="v">${d.needMaint}</div></div>
      <div class="kpi ${d.updApps + d.updWin ? 'warn' : ''}" data-go="computadores?updates=1"><div class="l">AtualizaÃ§Ãµes pendentes</div><div class="v">${d.updApps + d.updWin}</div><div class="muted small">${d.updApps} apps Â· ${d.updWin} Windows Â· ${d.updDevices} PCs</div></div>
      <div class="kpi ${d.alertCount ? 'bad' : ''}" data-go="alertas"><div class="l">Alertas abertos</div><div class="v">${d.alertCount}</div></div>
      <div class="kpi" data-go="tarefas"><div class="l">Tarefas em andamento</div><div class="v">${d.tasksActive}</div><div class="muted small">${d.tasksErrors} com erro (7 dias)</div></div>
    </div>
    <div class="grid g2">
      <div class="card"><h2>Alertas e notificaÃ§Ãµes</h2><div class="scroll-list">${d.alerts.length ? d.alerts.map((a) => `
        <div class="list-item"><span class="badge ${a.severity}">${sevLabel[a.severity] || a.severity}</span>
        <div class="t">${a.device_id ? `<a href="#/pc/${esc(a.device_id)}">${esc(a.message)}</a>` : esc(a.message)}${(a.acoes || []).length ? `<div class="btns" style="margin-top:6px;gap:6px">${acoesHtml(a)}</div>` : ''}</div><span class="when">${when(a.created_at)}</span></div>`).join('')
        : '<p class="muted">Nenhum alerta aberto. Tudo certo! âœ”</p>'}</div></div>
      <div class="card"><div class="row"><h2>Atividades recentes</h2><a href="#/atividades" class="small">Ver tudo</a></div><div class="scroll-list">${d.activity.length ? d.activity.map((a) => `
        <div class="list-item"><div class="t"><b>${esc(a.action)}</b> ${a.target ? 'Â· ' + esc(a.target) : ''}<div class="muted small">${esc(a.username)}${a.details && a.details.length < 80 ? ' Â· ' + esc(a.details) : ''}</div></div>
        <span class="when">${when(a.ts)}</span></div>`).join('') : '<p class="muted">Sem atividades.</p>'}</div></div>
    </div>`;
    $$('[data-go]', el).forEach((k) => { k.onclick = () => { location.hash = '#/' + k.dataset.go; }; });
    bindAcoes(el);
  },
};

// ================= COMPUTADORES =================
VIEWS.computadores = {
  sort: { k: 'name', dir: 1 },
  selected: new Set(),
  async render(el, query = '') {
    const qs = new URLSearchParams(query.includes('?') ? query.split('?')[1] : (location.hash.split('?')[1] || ''));
    this.el = el;
    await loadClients();
    setTitle('Computadores', can('tecnico') ? '<button class="btn primary" id="bulk" disabled>âš™ Tarefa para selecionados</button>' : '');
    el.innerHTML = `<div class="toolbar">
      <input class="grow" id="q" placeholder="Pesquisar nome, usuÃ¡rio, IP, sistema, processador...">
      ${S.me.clientId ? '' : `<select id="fc">${clientOptions('')}</select>`}
      <select id="fg">${groupOptions('')}</select>
      <select id="fs"><option value="">Todos os status</option><option value="online">Online</option><option value="offline">Offline</option></select>
      <select id="fx"><option value="">Todos</option><option value="updates">Com atualizaÃ§Ãµes</option><option value="alerts">Com alertas</option><option value="revoked">Revogados</option></select>
    </div>
    <div class="card hidden" id="bulkbar" style="margin-bottom:12px;padding:12px"><div class="row" style="align-items:center">
      <div style="flex:0 0 auto"><b id="bulkn"></b></div>
      <div class="btns" style="flex:1">
        <button class="btn sm" data-bulk="inventario">â†» Atualizar dados</button>
        <button class="btn sm" data-bulk="apps_verificar">Verificar apps</button>
        <button class="btn sm primary" data-bulk="app_atualizar_todos">Atualizar todos os apps</button>
        <button class="btn sm" data-bulk="windows_update_verificar">Verificar Windows Update</button>
        <button class="btn sm" data-bulk="instalar_pacote">Instalar meu programa</button>
        <button class="btn sm ghost" data-bulk="limpar">Limpar seleÃ§Ã£o</button></div></div></div>
    <div class="table-wrap" id="tw"></div><p class="muted small" id="cnt"></p>`;
    if (qs.get('status')) $('#fs').value = qs.get('status');
    if (qs.get('updates')) $('#fx').value = 'updates';
    // pesquisa com pequena espera (nÃ£o redesenha a cada tecla) e volta para a 1Âª pÃ¡gina ao filtrar
    let qt = null;
    ['q', 'fc', 'fg', 'fs', 'fx'].forEach((id) => { const i = $('#' + id); if (i) i.addEventListener('input', () => { this.shown = PAGE; clearTimeout(qt); qt = setTimeout(() => this.draw(), id === 'q' ? 180 : 0); }); });
    if ($('#fc')) $('#fc').addEventListener('change', () => { $('#fg').innerHTML = groupOptions($('#fc').value); this.draw(); });
    if ($('#bulk')) $('#bulk').onclick = () => taskDialog([...this.selected]);
    $$('[data-bulk]', el).forEach((b) => {
      b.onclick = async () => {
        const ids = [...this.selected];
        const act = b.dataset.bulk;
        if (act === 'limpar') { this.selected.clear(); this.draw(); return; }
        if (!S.actionMap[act] || !S.actionMap[act].allowed) return toast('Sem permissÃ£o para esta tarefa.', 'err');
        // pesadas abrem o diÃ¡logo (horÃ¡rio de manutenÃ§Ã£o, agendamento); leves vÃ£o direto
        if (HEAVY.includes(act) || act === 'instalar_pacote') return taskDialog(ids, act);
        try { const r = await POST('/tasks', { deviceIds: ids, action: act }); toast(`${r.ids.length} tarefa(s) enviada(s): ${actLabel(act)}`, 'ok'); } catch (e) { fail(e); }
      };
    });
    this.selected.clear();
    await this.refresh();
  },
  shown: 100,
  async refresh() { this.data = await GET('/devices'); this.draw(); },
  draw() {
    const q = ($('#q').value || '').toLowerCase();
    const fc = $('#fc') ? $('#fc').value : '', fg = $('#fg').value, fs = $('#fs').value, fx = $('#fx').value;
    let list = this.data.filter((d) => (fx === 'revoked' ? d.revoked : !d.revoked)
      && (!fc || String(d.clientId) === fc) && (!fg || String(d.groupId) === fg) && (!fs || d.status === fs)
      && (fx !== 'updates' || d.updates > 0) && (fx !== 'alerts' || d.alerts > 0)
      && (!q || [d.alias, d.hostname, d.user, d.ip, d.os, d.cpu, d.clientName, d.groupName].join(' ').toLowerCase().includes(q)));
    const { k, dir } = this.sort;
    const val = (d) => ({ name: (d.alias || d.hostname || '').toLowerCase(), client: d.clientName || '', status: d.status, user: d.user || '', os: d.os || '',
      cpu: d.cpuPct ?? -1, ram: d.ramPct ?? -1, upd: d.updates, alerts: d.alerts, seen: d.lastSeen || '', ver: d.agentVersion || '' }[k]);
    list.sort((a, b) => (val(a) > val(b) ? dir : val(a) < val(b) ? -dir : 0));
    const th = (key, label, cls = '') => `<th class="sort ${cls}" data-sort="${key}">${label}${k === key ? (dir > 0 ? ' â–²' : ' â–¼') : ''}</th>`;
    $('#tw').innerHTML = `<table><thead><tr>${can('tecnico') ? '<th><input type="checkbox" id="all"></th>' : ''}
      ${th('status', 'Status')}${th('name', 'Computador')}${S.me.clientId ? '' : th('client', 'Cliente', 'hide-sm')}${th('user', 'UsuÃ¡rio do Windows', 'hide-sm')}
      ${th('os', 'Sistema', 'hide-sm')}${th('cpu', 'CPU')}${th('ram', 'RAM')}<th class="hide-sm">Armazenamento</th>${th('upd', 'Atualiz.')}${th('alerts', 'Alertas')}${th('seen', 'Ãšltima comunicaÃ§Ã£o', 'hide-sm')}
      </tr></thead><tbody>${list.slice(0, this.shown).map((d) => `<tr class="click" data-id="${esc(d.id)}">
        ${can('tecnico') ? `<td><input type="checkbox" data-sel="${esc(d.id)}" ${this.selected.has(d.id) ? 'checked' : ''}></td>` : ''}
        <td class="nw"><span class="dot ${d.status}"></span>${d.status === 'online' ? 'Online' : 'Offline'}${d.via === 'internet' ? ' <span class="badge" title="Conectado pela internet (fora da rede)">ðŸŒ</span>' : ''}</td>
        <td><b>${devName(d)}</b>${d.alias ? `<div class="muted small">${esc(d.hostname)}</div>` : ''}<div class="muted small">${esc(d.ip || '')}${d.groupName ? ' Â· ' + esc(d.groupName) : ''}</div></td>
        ${S.me.clientId ? '' : `<td class="hide-sm">${esc(d.clientName || 'â€”')}</td>`}
        <td class="hide-sm nw">${esc(d.user || 'â€”')}</td>
        <td class="hide-sm small nw" title="${esc(d.os || '')} Â· ${esc(d.cpu || '')}">${esc(shortOs(d.os) || 'â€”')}<div class="muted small">${esc(shortCpu(d.cpu))}${d.ramGB ? ' Â· ' + esc(d.ramGB) + ' GB' : ''}</div></td>
        <td>${d.status === 'online' ? bar(d.cpuPct) : '<span class="muted">â€”</span>'}</td><td>${d.status === 'online' ? bar(d.ramPct) : '<span class="muted">â€”</span>'}</td>
        <td class="hide-sm small nw" title="${esc(d.storage || '')}">${esc(String(d.storage || 'â€”').split(' Â· ')[0])}</td>
        <td>${d.updates ? `<span class="badge warn">${esc(d.updates)}</span>` : '<span class="muted">0</span>'}</td>
        <td>${d.alerts ? `<span class="badge bad">${d.alerts}</span>` : '<span class="muted">0</span>'}</td>
        <td class="hide-sm small nw">${when(d.lastSeen)}</td></tr>`).join('')
        || `<tr><td colspan="13" class="empty">${this.data.length ? 'Nenhum computador com esses filtros.' : 'Nenhum computador cadastrado ainda. Veja "Instalar agente" no menu.'}</td></tr>`}
      </tbody></table>${list.length > this.shown ? `<div class="btns" style="justify-content:center;margin:12px 0"><button class="btn" id="more">Mostrar mais (${Math.min(PAGE, list.length - this.shown)} de ${list.length - this.shown} restantes)</button></div>` : ''}`;
    if ($('#more')) $('#more').onclick = () => { this.shown += PAGE; this.draw(); };
    $('#cnt').textContent = `${list.length} computador(es) Â· ${list.filter((d) => d.status === 'online').length} online${list.length > this.shown ? ` Â· mostrando ${this.shown}` : ''}`;
    $$('th[data-sort]', this.el).forEach((h) => { h.onclick = () => { this.sort = { k: h.dataset.sort, dir: this.sort.k === h.dataset.sort ? -this.sort.dir : 1 }; this.draw(); }; });
    $$('tr[data-id]', this.el).forEach((tr) => tr.addEventListener('click', (e) => { if (e.target.closest('input')) return; location.hash = '#/pc/' + tr.dataset.id; }));
    $$('[data-sel]', this.el).forEach((c) => { c.onchange = () => { c.checked ? this.selected.add(c.dataset.sel) : this.selected.delete(c.dataset.sel); this.syncBulk(); }; });
    const all = $('#all');
    if (all) all.onchange = () => { list.forEach((d) => (all.checked ? this.selected.add(d.id) : this.selected.delete(d.id))); this.draw(); };
    this.syncBulk();
  },
  syncBulk() {
    const b = $('#bulk'); if (b) { b.disabled = !this.selected.size; b.textContent = `âš™ Tarefa para selecionados${this.selected.size ? ` (${this.selected.size})` : ''}`; }
    const bar = $('#bulkbar'); if (bar) { bar.classList.toggle('hidden', !this.selected.size || !can('tecnico')); $('#bulkn').textContent = `${this.selected.size} selecionado(s):`; }
  },
};

// ================= DETALHE DO COMPUTADOR =================
VIEWS.pc = {
  tab: 'resumo',
  async render(el, id) {
    this.el = el; this.id = id;
    await loadClients();
    await this.refresh();
  },
  async refresh(type, data) {
    if (type === 'device' && data && data.id !== this.id) return;
    // nÃ£o atrapalha quem estÃ¡ digitando / navegando
    if (type && ['config', 'programas', 'remoto'].includes(this.tab)) return;
    let d;
    try { d = await GET('/devices/' + encodeURIComponent(this.id)); } catch (e) { this.el.innerHTML = `<div class="card">${esc(e.message)}</div>`; return; }
    this.d = d;
    setTitle(d.alias || d.hostname || 'Computador', can('tecnico') && !d.revoked
      ? `<button class="btn" data-q="inventario">â†» Atualizar dados</button><button class="btn" data-q="diagnostico">ðŸ©º DiagnÃ³stico</button><button class="btn primary" id="newtask">âš™ Nova tarefa</button>` : '');
    $$('[data-q]').forEach((b) => { b.onclick = () => quickTask(d.id, b.dataset.q); });
    if ($('#newtask')) $('#newtask').onclick = () => taskDialog([d.id]);
    const tabs = [['resumo', 'Resumo'], ['programas', `Programas (${d.software.length})`], ['atualizacoes', `AtualizaÃ§Ãµes${d.updates ? ` (${esc(d.updates)})` : ''}`],
      ['tarefas', 'Tarefas'], ['alertas', `Alertas${d.alertsOpen.length ? ` (${d.alertsOpen.length})` : ''}`],
      ...(S.me.role === 'admin' && !S.me.clientId && !d.revoked ? [['remoto', 'ðŸ–¥ Acesso remoto']] : []), ['config', 'Configurar']];
    this.el.innerHTML = `<div class="card" style="margin-bottom:16px"><div class="row">
        <div><span class="dot ${d.status}"></span><b>${d.status === 'online' ? 'Online' : 'Offline'}</b>${d.via === 'internet' ? ' <span class="badge">ðŸŒ pela internet</span>' : ''} <span class="muted small">Â· Ãºltima comunicaÃ§Ã£o ${when(d.lastSeen)}</span></div>
        <div class="muted">Cliente: <b>${esc(d.clientName || 'â€”')}</b>${d.groupName ? ' Â· ' + esc(d.groupName) : ''}</div>
        <div class="muted">UsuÃ¡rio: <b>${esc(d.user || 'â€”')}</b></div>
        <div class="muted">IP: <b>${esc(d.ip || 'â€”')}</b> Â· Agente ${esc(d.agentVersion || 'â€”')}</div>
        ${d.revoked ? '<span class="badge bad">REVOGADO</span>' : ''}</div></div>
      <div class="tabs">${tabs.map(([k, l]) => `<a role="button" tabindex="0" data-tab="${k}" class="${this.tab === k ? 'active' : ''}">${l}</a>`).join('')}</div>
      <div id="tabc"></div>`;
    $$('[data-tab]', this.el).forEach((a) => { a.onclick = () => { this.tab = a.dataset.tab; this.refresh(); }; });
    this[this.tab]($('#tabc'), d);
  },
  resumo(el, d) {
    const inv = d.inventory || {}; const s = inv.system || {};
    if (!s.hostname) { el.innerHTML = '<div class="card muted">Aguardando o primeiro inventÃ¡rio deste computador...</div>'; return; }
    el.innerHTML = `<div class="grid g2">
      <div class="card"><h2>Sistema</h2><dl class="kv">
        <dt>Nome da mÃ¡quina</dt><dd>${esc(s.hostname)}</dd><dt>Sistema</dt><dd>${esc(s.os)} <span class="muted small">(${esc(s.osBuild || s.osVersion || '')})</span></dd>
        <dt>Processador</dt><dd>${esc(s.cpu)} <span class="muted small">${esc(s.cores || '?')} nÃºcleos / ${esc(s.threads || '?')} threads</span></dd>
        <dt>MemÃ³ria RAM</dt><dd>${esc(s.ramGB)} GB ${(inv.memory || []).length ? `<span class="muted small">(${inv.memory.map((m) => `${esc(m.gb)} GB${m.speed ? ' ' + esc(m.speed) + ' MHz' : ''}`).join(' + ')})</span>` : ''}</dd>
        <dt>Fabricante / modelo</dt><dd>${esc(s.manufacturer)} ${esc(s.model)}</dd><dt>NÂº de sÃ©rie</dt><dd>${esc(s.serial || 'â€”')}</dd>
        <dt>UsuÃ¡rio(s) logado(s)</dt><dd>${esc((d.status === 'online' ? d.user : s.user) || s.user || 'â€” (ninguÃ©m conectado agora)')}</dd><dt>DomÃ­nio</dt><dd>${esc(s.domain || 'â€”')}</dd>
        <dt>Ãšltimo boot</dt><dd>${dt(s.lastBoot)}</dd><dt>Windows instalado em</dt><dd>${dt(s.installDate)}</dd>
        <dt>ReinÃ­cio pendente</dt><dd>${inv.rebootPending ? `<span class="badge warn">Sim</span> ${(() => { const al = (d.alertsOpen || []).find((x) => x.type === 'reinicio'); return al ? `<span class="btns" style="display:inline-flex;gap:6px;margin-left:6px">${acoesHtml(al)}</span>` : ''; })()}` : 'NÃ£o'}</dd></dl></div>
      <div class="card"><h2>Armazenamento</h2>${(inv.volumes || []).map((v) => { const used = v.sizeGB ? Math.round((1 - v.freeGB / v.sizeGB) * 100) : 0;
        return `<div style="margin-bottom:12px"><div class="row"><b>${esc(v.letter)} ${esc(v.label || '')}</b><span class="muted small" style="text-align:right">${esc(v.freeGB)} GB livres de ${esc(v.sizeGB)} GB</span></div>${bar(used)}</div>`; }).join('')}
        <h3 style="margin-top:14px">Discos fÃ­sicos</h3>${(inv.physicalDisks || []).map((p) => `<div class="list-item"><div class="t"><b>${esc(p.model)}</b><div class="muted small">${esc(p.type || '?')} Â· ${esc(p.bus || '')} Â· ${esc(p.sizeGB)} GB</div>${diskSmart(p)}</div>
          <span class="badge ${diskBadge(p)[0]}">${esc(diskBadge(p)[1])}</span></div>`).join('') || '<p class="muted">â€”</p>'}
          ${(inv.smartFailures || []).length ? '<p><span class="badge bad">SMART: falha prevista</span> O prÃ³prio disco avisa que vai falhar. FaÃ§a backup e troque.</p>' : ''}</div>
      <div class="card"><h2>Rede</h2>${(inv.network || []).map((n) => `<dl class="kv"><dt>Adaptador</dt><dd>${esc(n.name)}</dd><dt>IP</dt><dd>${esc(n.ip)}</dd><dt>Gateway</dt><dd>${esc(n.gateway)}</dd><dt>DNS</dt><dd>${esc(n.dns)}</dd><dt>MAC</dt><dd>${esc(n.mac)}</dd></dl>`).join('<hr>') || '<p class="muted">â€”</p>'}</div>
      <div class="card"><h2>SeguranÃ§a</h2>${(() => {
          const avs = inv.antivirus || [];
          const other = avs.some((a) => a.enabled && !/defender/i.test(a.name));
          // com outro antivÃ­rus ativo (ex.: Kaspersky), o Defender fica desligado de propÃ³sito: nÃ£o mostramos os dados dele
          const list = avs.filter((a) => !(other && /defender/i.test(a.name)));
          const html = list.map((a) => `<div class="list-item"><div class="t"><b>${esc(a.name)}</b>${a.running ? '<div class="muted small">Em execuÃ§Ã£o</div>' : ''}</div>
            <span class="badge ${a.enabled ? 'ok' : 'bad'}">${a.enabled ? 'Ativo' : 'Desativado'}</span>${a.enabled ? `<span class="badge ${a.updated ? 'ok' : 'warn'}">${a.updated ? 'Atualizado' : 'Verificar atualizaÃ§Ã£o'}</span>` : ''}</div>`).join('') || '<p class="muted">Nenhum antivÃ­rus informado pelo Windows.</p>';
          const def = inv.defender && !other && inv.defender.signatureAge !== 65535
            ? `<dl class="kv" style="margin-top:10px"><dt>ProteÃ§Ã£o em tempo real</dt><dd>${fmtVal(inv.defender.realtime)}</dd><dt>Idade das definiÃ§Ãµes</dt><dd>${esc(inv.defender.signatureAge)} dia(s)</dd><dt>Ãšltima verificaÃ§Ã£o</dt><dd>${dt(inv.defender.lastScan)}</dd></dl>`
            : (other ? '<p class="muted small" style="margin-top:8px">O Windows Defender fica desligado porque hÃ¡ outro antivÃ­rus ativo (normal).</p>' : '');
          return html + def;
        })()}
        ${(inv.criticalServicesStopped || []).length ? `<p><span class="badge bad">ServiÃ§os importantes parados:</span> ${esc(inv.criticalServicesStopped.join(', '))}</p>` : '<p class="muted small" style="margin-top:12px">ServiÃ§os importantes do Windows: OK</p>'}</div>
    </div>`;
    bindAcoes(el, () => this.refresh && this.refresh());
  },
  programas(el, d) {
    el.innerHTML = `<div class="toolbar"><input class="grow" id="sq" placeholder="Pesquisar programa..."><span class="muted small">InventÃ¡rio de ${when(d.lastSeen)}</span></div><div id="sl"></div>`;
    const draw = () => { const q = $('#sq').value.toLowerCase(); $('#sl').innerHTML = autoTable(d.software.filter((s) => !q || `${s.name} ${s.publisher}`.toLowerCase().includes(q))); };
    $('#sq').oninput = draw; draw();
  },
  atualizacoes(el, d) {
    const u = d.updatesDetail || {};
    const t = can('tecnico') && !d.revoked;
    el.innerHTML = `<div class="card"><div class="row"><h2 style="margin:0">Aplicativos</h2><span class="muted small" style="text-align:right">${u.appsAt ? 'Verificado ' + when(u.appsAt) : 'Ainda nÃ£o verificado'}</span></div>
        <div class="btns" style="margin:12px 0">${t ? '<button class="btn" data-q="apps_verificar">â†» Verificar agora</button><button class="btn" id="install">+ Instalar aplicativo</button>' : ''}</div>
        <div id="appsbox">${(u.apps || []).length ? appsTable(u.apps) : `<p class="muted">${u.appsAt ? 'Todos os aplicativos estÃ£o atualizados. âœ”' : 'Clique em "Verificar agora".'}</p>`}</div>
        <p class="muted small">As atualizaÃ§Ãµes rodam em segundo plano, em modo silencioso. Se o programa estiver aberto, alguns instaladores aguardam ele ser fechado â€” nesse caso, agende para fora do horÃ¡rio de uso.</p></div>
      <div class="card"><div class="row"><h2 style="margin:0">Windows Update</h2><span class="muted small" style="text-align:right">${u.windowsAt ? 'Verificado ' + when(u.windowsAt) : 'Ainda nÃ£o verificado'}</span></div>
        <div class="btns" style="margin:12px 0">${t ? `<button class="btn" data-q="windows_update_verificar">â†» Verificar agora</button>${(u.windows || []).length ? '<button class="btn primary" id="wuinst">Instalar atualizaÃ§Ãµes (sem reiniciar)</button>' : ''}` : ''}
        ${can('admin') && !d.revoked ? '<button class="btn danger" data-q="reiniciar_pc">Reiniciar PC</button><button class="btn" data-q="cancelar_reinicio">Cancelar reinÃ­cio</button>' : ''}</div>
        ${u.rebootPending || (d.inventory || {}).rebootPending ? '<p><span class="badge warn">ReinÃ­cio pendente</span> Este computador precisa reiniciar para concluir atualizaÃ§Ãµes jÃ¡ instaladas.</p>' : ''}
        ${(u.windows || []).length ? autoTable(u.windows.map((w) => ({ title: w.title, kb: w.kb, severity: w.severity, mayReboot: w.mayReboot }))) : `<p class="muted">${u.windowsAt ? 'Nenhuma atualizaÃ§Ã£o pendente. âœ”' : 'Clique em "Verificar agora".'}</p>`}
        <p class="muted small">A instalaÃ§Ã£o nunca reinicia sozinha. O reinÃ­cio Ã© feito depois, conforme a polÃ­tica combinada com o cliente.</p></div>
      <div class="card"><div class="row"><h2 style="margin:0">Drivers</h2><span class="muted small" style="text-align:right">${u.drivers ? 'Verificado ' + when(u.drivers.at) : 'Ainda nÃ£o verificado'}</span></div>
        <div class="btns" style="margin:12px 0">${t ? `<button class="btn" data-q="drivers_verificar">â†» Verificar drivers</button>${u.drivers && u.drivers.updates.length ? '<button class="btn primary" id="drvinst">Instalar drivers do Windows Update (sem reiniciar)</button>' : ''}` : ''}</div>
        ${u.drivers ? driversView(u.drivers) : '<p class="muted">Clique em "Verificar drivers". Mostra os aparelhos com problema, os drivers novos no Windows Update (fonte oficial dos fabricantes) e as versÃµes dos drivers principais.</p>'}</div>`;
    $$('[data-q]', el).forEach((b) => { b.onclick = () => quickTask(d.id, b.dataset.q); });
    if ($('#drvinst', el)) $('#drvinst', el).onclick = () => taskDialog([d.id], 'drivers_instalar');
    bindAppsTable($('#appsbox', el), d.id);
    if ($('#wuinst', el)) $('#wuinst', el).onclick = () => taskDialog([d.id], 'windows_update_instalar');
    if ($('#install', el)) $('#install', el).onclick = () => installChooser([d.id]);
  },
  async tarefas(el, d) {
    el.innerHTML = taskTable(d.tasks.map((t) => ({ ...t, hostname: d.hostname, alias: d.alias })), false);
    bindTaskTable(el);
  },
  alertas(el, d) {
    el.innerHTML = `<div class="card">${d.alertsOpen.length ? d.alertsOpen.map((a) => `<div class="list-item"><span class="badge ${a.severity}">${sevLabel[a.severity]}</span>
      <div class="t">${esc(a.message)}<div class="muted small">${when(a.created_at)}</div>${(a.acoes || []).length ? `<div class="btns" style="margin-top:6px;gap:6px">${acoesHtml(a)}</div>` : ''}</div>${can('tecnico') ? `<button class="btn sm ghost" data-res="${a.id}" title="Some da lista sem fazer nada no PC">Marcar resolvido</button>` : ''}</div>`).join('') : '<p class="muted">Nenhum alerta aberto.</p>'}</div>`;
    $$('[data-res]', el).forEach((b) => { b.onclick = async () => { try { await POST(`/alerts/${b.dataset.res}/resolve`); this.refresh(); } catch (e) { fail(e); } }; });
    bindAcoes(el);
  },
  // ---------- acesso remoto: tela, terminal e arquivos ----------
  async remoto(el, d) {
    const off = d.status !== 'online';
    el.innerHTML = `${off ? '<div class="card" style="margin-bottom:14px;border-color:rgba(245,165,36,.6)">O computador estÃ¡ <b>offline</b>. O acesso remoto funciona sÃ³ com ele ligado e online.</div>' : ''}
      <div class="grid g2">
      <div class="card"><h2>ðŸ–¥ Tela (RustDesk)</h2><div id="scr"><p class="muted">Verificando...</p></div></div>
      <div class="card"><h2>âŒ¨ Terminal</h2><p class="muted">PowerShell do computador direto no painel, em segundo plano (como SYSTEM). Cada comando fica registrado no histÃ³rico, e o usuÃ¡rio Ã© avisado pela bandeja.</p>
        <button class="btn primary" id="term" ${off ? 'disabled' : ''}>Abrir terminal</button></div></div>
      <div class="card" style="margin-top:16px"><h2>ðŸ“ Arquivos</h2>
        <div class="toolbar"><button class="btn sm" id="fup">â¬† Voltar</button><input class="grow mono" id="fpath" placeholder="ex.: C:\\Users"><button class="btn sm" id="fgo">Abrir</button></div>
        <div id="flist"><p class="muted">${off ? 'Computador offline.' : 'Carregando...'}</p></div>
        <div class="row" style="margin-top:12px"><div><label>Enviar arquivo para esta pasta</label><input type="file" id="fsend"></div>
          <div style="flex:0 0 auto"><label style="color:var(--text)"><input type="checkbox" id="fover"> substituir se jÃ¡ existir</label></div>
          <div style="flex:0 0 auto;align-self:flex-end"><button class="btn primary" id="fsendbtn">â¬† Enviar</button></div></div>
        <div id="fprog" class="hidden" style="margin-top:8px"><div class="bar"><i id="fbar" style="width:0%"></i></div><span class="muted small" id="ftxt"></span></div>
        <p class="muted small">Arquivos baixados ficam disponÃ­veis por 1 hora na Central. Toda cÃ³pia Ã© conferida com SHA-256 e registrada no histÃ³rico. O usuÃ¡rio Ã© avisado pela bandeja.</p></div>`;
    if (off) return;
    $('#term', el).onclick = () => openTerminal(d);
    this.screen(d);
    this.files(d, '');
  },
  async screen(d) {
    const box = $('#scr');
    let st = { active: false };
    try { st = await GET(`/devices/${d.id}/screen`); } catch { /* */ }
    const draw = (info) => {
      if (info) {
        box.innerHTML = `<p><span class="badge ok">Acesso liberado</span> ${Number(info.minutes) ? `por atÃ© ${esc(tempoTela(info.minutes))}` : '<b>sem limite de tempo</b> (atÃ© vocÃª clicar em Encerrar)'}, <b>somente do seu computador</b> (${esc(info.techIp)}).</p>
          <p>No <b>RustDesk do seu computador</b>, digite no campo de conexÃ£o:</p>
          ${info.tunnel ? `<div class="code-box" style="margin:6px 0">${esc(info.ip)}:${esc(info.port)} <button class="btn sm ghost" data-copy="${esc(info.ip)}:${esc(info.port)}">Copiar</button></div>
          <p class="muted small">Este PC estÃ¡ <b>fora da sua rede</b>: a tela passa pelo tÃºnel do agente, atravÃ©s da Central. Digite o endereÃ§o com a porta (dois-pontos e o nÃºmero).</p>`
          : `<div class="code-box" style="margin:6px 0">${esc(info.ip)} <button class="btn sm ghost" data-copy="${esc(info.ip)}">Copiar</button></div>`}
          <p style="margin-top:10px">Senha (vale sÃ³ para esta sessÃ£o):</p>
          <div class="code-box" style="margin:6px 0">${esc(info.password)} <button class="btn sm ghost" data-copy="${esc(info.password)}">Copiar</button></div>
          ${info.simulated ? '<p class="muted small">(simulado: este agente nÃ£o estÃ¡ no Windows)</p>' : ''}
          <p class="muted small">O usuÃ¡rio vÃª a janela do RustDesk enquanto vocÃª estiver conectado. Ao terminar, clique em Encerrar: o acesso Ã© desligado e a senha trocada.</p>
          <div class="btns" style="margin-top:10px"><button class="btn danger" id="send">Encerrar acesso</button></div>`;
        $$('[data-copy]', box).forEach((b) => { b.onclick = () => copy(b.dataset.copy); });
        $('#send', box).onclick = async (ev) => {
          const b = ev.currentTarget; b.disabled = true; b.textContent = 'Encerrando...';
          box.querySelector('.badge').className = 'badge warn'; box.querySelector('.badge').textContent = 'Encerrando...';
          try { await POST(`/devices/${d.id}/screen/end`); toast('Acesso Ã  tela encerrado.', 'ok'); } catch (e) { fail(e); }
          this.screen(d);
        };
        return;
      }
      box.innerHTML = `${st.active ? `<p><span class="badge warn">HÃ¡ um acesso liberado</span> por ${esc(st.by)} para ${esc(st.techIp)}${st.expiresAt > Date.now() + 10 * 365 * 864e5 ? ' (sem limite de tempo)' : st.expiresAt ? ` atÃ© ${esc(new Date(st.expiresAt).toLocaleString('pt-BR'))}` : ''}. A senha sÃ³ aparece para quem liberou; libere de novo para gerar outra.</p>` : ''}
        <p class="muted">Libera o RustDesk deste computador <b>sÃ³ para o seu IP</b>, com uma <b>senha nova</b>. Se o RustDesk nÃ£o estiver instalado, ele Ã© instalado na hora com o instalador que vocÃª colocou em <b>Meus instaladores</b> (pode levar alguns minutos).</p>
        <p class="muted small">Uma vez sÃ³: baixe o instalador oficial para Windows (<span class="mono">rustdesk-...-x86_64.exe</span>) em github.com/rustdesk/rustdesk/releases e envie em <b>Meus instaladores</b>. No seu computador vocÃª tambÃ©m precisa do RustDesk.</p>
        <div class="btns"><select id="stempo" title="Por quanto tempo o acesso fica liberado"><option value="60">1 hora</option><option value="120" selected>2 horas</option><option value="240">4 horas</option><option value="480">8 horas</option><option value="0">Sem limite (atÃ© encerrar)</option></select><button class="btn primary" id="sgo">Acessar tela</button>${st.active ? '<button class="btn danger" id="send2">Encerrar acesso</button>' : ''}</div>`;
      $('#sgo', box).onclick = async () => {
        $('#sgo', box).disabled = true; $('#sgo', box).textContent = 'Preparando o RustDesk...';
        const minutes = Number($('#stempo', box).value);
        if (minutes === 0 && !(await confirmBox('Acesso sem limite', 'O acesso Ã  tela vai ficar liberado (sÃ³ para o seu IP, com senha) atÃ© vocÃª clicar em "Encerrar acesso", mesmo se o computador reiniciar. Use sÃ³ quando precisar.', 'Liberar sem limite'))) { this.screen(d); return; }
        try { draw(await POST(`/devices/${d.id}/screen/start`, { minutes })); } catch (e) { fail(e); this.screen(d); }
      };
      if ($('#send2', box)) $('#send2', box).onclick = async () => { try { await POST(`/devices/${d.id}/screen/end`); toast('Acesso Ã  tela encerrado.', 'ok'); this.screen(d); } catch (e) { fail(e); } };
    };
    draw(null);
  },
  async files(d, p) {
    const list = $('#flist');
    if (!list) return;
    list.innerHTML = '<p class="muted">Carregando...</p>';
    let r;
    try { r = await GET(`/devices/${d.id}/fs?path=${encodeURIComponent(p)}`); } catch (e) { list.innerHTML = `<p class="muted">${esc(e.message)}</p>`; return; }
    this.cwd = r.path;
    $('#fpath').value = r.path;
    $('#fup').disabled = r.parent === null;
    $('#fup').onclick = () => this.files(d, r.parent || '');
    $('#fgo').onclick = () => this.files(d, $('#fpath').value.trim());
    $('#fpath').onkeydown = (e) => { if (e.key === 'Enter') this.files(d, $('#fpath').value.trim()); };
    const join = (a, b) => (a ? a.replace(/[\\]+$/, '') + '\\' + b : b);
    list.innerHTML = r.entries.length ? `<div class="table-wrap" style="max-height:50vh"><table><thead><tr><th>Nome</th><th>Tamanho</th><th class="hide-sm">Modificado</th><th></th></tr></thead><tbody>
      ${r.entries.map((e, i) => `<tr class="${e.dir ? 'click' : ''}" data-i="${i}"><td>${e.dir ? 'ðŸ“' : 'ðŸ“„'} ${esc(e.name)}</td><td class="small nw">${e.dir ? '' : fmtSize(e.size || 0)}</td>
        <td class="small hide-sm">${e.mtime ? dt(e.mtime) : ''}</td><td>${e.dir ? '' : `<button class="btn sm" data-dl="${i}">â¬‡ Baixar</button>`}</td></tr>`).join('')}</tbody></table></div>
        ${r.truncated ? '<p class="muted small">Mostrando os primeiros 3000 itens.</p>' : ''}` : '<p class="muted">Pasta vazia.</p>';
    $$('tr[data-i]', list).forEach((tr) => {
      const e = r.entries[+tr.dataset.i];
      if (e.dir) tr.onclick = () => this.files(d, e.drive ? e.name : join(r.path, e.name));
    });
    $$('[data-dl]', list).forEach((b) => {
      b.onclick = async (ev) => {
        ev.stopPropagation();
        const e = r.entries[+b.dataset.dl];
        b.disabled = true; b.textContent = 'Copiando...';
        try {
          const t = await POST(`/devices/${d.id}/files/pull`, { path: join(r.path, e.name) });
          toast(`Pronto: ${t.filename} (${fmtSize(t.size)})`, 'ok');
          const a = document.createElement('a'); a.href = `/api/transfers/${t.id}/download`; a.download = t.filename; document.body.appendChild(a); a.click(); a.remove();
        } catch (er) { fail(er); }
        b.disabled = false; b.textContent = 'â¬‡ Baixar';
      };
    });
    $('#fsendbtn').onclick = () => {
      const f = $('#fsend').files[0];
      if (!f) return toast('Escolha o arquivo.', 'err');
      if (!this.cwd) return toast('Abra uma pasta primeiro.', 'err');
      const xhr = new XMLHttpRequest();
      xhr.open('POST', `/api/devices/${d.id}/files/push`);
      xhr.setRequestHeader('x-fnd', '1'); xhr.setRequestHeader('content-type', 'application/octet-stream');
      xhr.setRequestHeader('x-arquivo', encodeURIComponent(f.name)); xhr.setRequestHeader('x-destino', encodeURIComponent(this.cwd));
      xhr.setRequestHeader('x-sobrescrever', $('#fover').checked ? '1' : '0');
      $('#fprog').classList.remove('hidden'); $('#fsendbtn').disabled = true;
      xhr.upload.onprogress = (e) => { if (e.lengthComputable) { const pc = Math.round(e.loaded / e.total * 100); $('#fbar').style.width = pc + '%'; $('#ftxt').textContent = `Enviando para a Central... ${pc}%${pc === 100 ? ' â€” o computador estÃ¡ baixando e conferindo' : ''}`; } };
      xhr.onload = () => {
        $('#fsendbtn').disabled = false; $('#fprog').classList.add('hidden');
        let data = {}; try { data = JSON.parse(xhr.responseText); } catch { /* */ }
        if (xhr.status >= 200 && xhr.status < 300) { toast(`Arquivo gravado em ${data.path}`, 'ok'); $('#fsend').value = ''; this.files(d, this.cwd); } else toast(data.error || `Erro ${xhr.status}`, 'err');
      };
      xhr.onerror = () => { $('#fsendbtn').disabled = false; toast('Falha no envio.', 'err'); };
      xhr.send(f);
    };
  },
  config(el, d) {
    const t = can('tecnico');
    el.innerHTML = `<div class="grid g2"><div class="card"><h2>IdentificaÃ§Ã£o e organizaÃ§Ã£o</h2><form id="pf">
      <label>Apelido (como aparece no painel)</label><input name="alias" value="${esc(d.alias || '')}" placeholder="${esc(d.hostname)}" ${t ? '' : 'disabled'}>
      ${S.me.clientId ? '' : `<label>Cliente</label><select name="clientId" ${t ? '' : 'disabled'}>${clientOptions(d.clientId, false)}</select>`}
      <label>Grupo / setor / departamento</label><select name="groupId" ${t ? '' : 'disabled'}>${groupOptions(d.clientId, d.groupId, false)}</select>
      <label>ObservaÃ§Ãµes</label><textarea name="notes" style="min-height:90px;font-family:inherit" ${t ? '' : 'disabled'}>${esc(d.notes || '')}</textarea>
      ${t ? '<div class="btns" style="margin-top:12px"><button class="btn primary">Salvar</button></div>' : ''}</form></div>
      <div class="card"><h2>Agente</h2><dl class="kv"><dt>ID do dispositivo</dt><dd class="mono small">${esc(d.id)}</dd><dt>Cadastrado em</dt><dd>${dt(d.enrolledAt)}</dd><dt>VersÃ£o</dt><dd>${esc(d.agentVersion || 'â€”')}</dd></dl>
      ${can('admin') && !S.me.clientId ? `<h3 style="margin-top:18px">Zona de perigo</h3><p class="muted small">Revogar corta o acesso deste agente Ã  Central imediatamente (ele apaga as credenciais). Para voltar, reinstale com o cÃ³digo do cliente.</p>
        <div class="btns">${d.revoked ? '<button class="btn danger" id="del">Excluir do painel</button>' : '<button class="btn" data-q="atualizar_agente">Atualizar agente</button><button class="btn danger" id="rev">Revogar computador</button><button class="btn danger" data-q="remover_agente">Desinstalar agente</button>'}</div>` : ''}</div></div>`;
    const f = $('#pf', el);
    if ($('select[name=clientId]', f)) $('select[name=clientId]', f).onchange = (e) => { $('select[name=groupId]', f).innerHTML = groupOptions(e.target.value, '', false); };
    f.onsubmit = async (e) => { e.preventDefault(); try { await api('PATCH', '/devices/' + d.id, formData(f)); toast('Salvo.', 'ok'); this.refresh(); } catch (er) { fail(er); } };
    if ($('#rev', el)) $('#rev', el).onclick = async () => { if (await confirmBox('Revogar computador', `Revogar <b>${devName(d)}</b>? Ele deixa de se comunicar com a Central.`, 'Revogar', true)) { try { await POST(`/devices/${d.id}/revoke`); toast('Computador revogado.', 'ok'); this.refresh(); } catch (er) { fail(er); } } };
    if ($('#del', el)) $('#del', el).onclick = async () => { if (await confirmBox('Excluir', 'Excluir este computador e todo o histÃ³rico dele?', 'Excluir', true)) { try { await api('DELETE', '/devices/' + d.id); location.hash = '#/computadores'; } catch (er) { fail(er); } } };
    $$('[data-q]', el).forEach((b) => { b.onclick = () => quickTask(d.id, b.dataset.q); });
  },
};

// ================= TERMINAL REMOTO =================
function openTerminal(d) {
  const m = modal(`Terminal Â· ${d.alias || d.hostname}`, `<pre id="tout" style="height:55vh;max-height:none;background:#03060c;color:#d7e3f7;font-size:13px"></pre>
    <form id="tform" class="row" style="margin-top:10px;flex-wrap:nowrap"><span class="mono small" id="tprompt" style="flex:0 0 auto;color:var(--cyan)">PS&gt;</span>
    <input id="tin" class="mono" autocomplete="off" spellcheck="false" placeholder="Digite um comando e Enter (ex.: Get-Service, ipconfig, dir)" style="flex:1"></form>
    <p class="muted small" style="margin-top:8px">Roda como SYSTEM, em segundo plano. Um comando por linha. Comandos que pedem confirmaÃ§Ã£o/digitaÃ§Ã£o nÃ£o funcionam aqui (use -Force / -Confirm:$false). â†‘â†“ para o histÃ³rico.</p>`,
  { wide: true, footer: '<button class="btn" id="trestart">Reiniciar terminal</button><button class="btn" data-close>Fechar</button>' });
  const out = $('#tout', m); const inp = $('#tin', m);
  const write = (txt, cls) => { const span = document.createElement('span'); if (cls) span.style.color = cls; span.textContent = txt; out.appendChild(span); if (out.textContent.length > 400000) out.textContent = out.textContent.slice(-300000); out.scrollTop = out.scrollHeight; };
  const ws = new WebSocket(`wss://${location.host}/api/terminal?device=${encodeURIComponent(d.id)}`);
  const hist = []; let hi = 0;
  write('Conectando ao computador...\n', '#8a9bbb');
  ws.onmessage = (ev) => {
    let msg; try { msg = JSON.parse(ev.data); } catch { return; }
    if (msg.t === 'out') write(msg.data);
    else if (msg.t === 'prompt') { $('#tprompt', m).textContent = `PS ${msg.cwd}>`; inp.disabled = false; inp.focus(); }
    else if (msg.t === 'exit') { write(`\n[${msg.reason}]\n`, '#f5a524'); inp.disabled = true; }
  };
  ws.onclose = () => { inp.disabled = true; write('\n[conexÃ£o encerrada]\n', '#8a9bbb'); };
  ws.onerror = () => write('\n[nÃ£o foi possÃ­vel abrir o terminal: verifique se vocÃª Ã© administrador e se o PC estÃ¡ online]\n', '#ef4444');
  $('#tform', m).onsubmit = (e) => {
    e.preventDefault();
    const v = inp.value; if (!v.trim() || ws.readyState !== 1) return;
    write(`${$('#tprompt', m).textContent} ${v}\n`, '#3bc9f5');
    ws.send(JSON.stringify({ t: 'in', data: v }));
    hist.push(v); hi = hist.length; inp.value = ''; inp.disabled = true;
    setTimeout(() => { inp.disabled = false; inp.focus(); }, 15000); // comandos longos: libera a digitaÃ§Ã£o depois de 15 s
  };
  inp.onkeydown = (e) => {
    if (e.key === 'ArrowUp' && hi > 0) { hi--; inp.value = hist[hi]; e.preventDefault(); }
    if (e.key === 'ArrowDown') { hi = Math.min(hist.length, hi + 1); inp.value = hist[hi] || ''; e.preventDefault(); }
  };
  $('#trestart', m).onclick = () => { if (ws.readyState === 1) { ws.send(JSON.stringify({ t: 'restart' })); write('\n[reiniciando o terminal...]\n', '#8a9bbb'); } };
  m.onclose = () => { try { ws.close(); } catch { /* */ } };
}

// ================= TAREFAS =================
function installChooser(deviceIds) {
  const m = modal('Instalar aplicativo', `<div class="grid g2">
    <button class="card kpi" style="text-align:left" data-w="cat"><div class="l">CatÃ¡logo winget</div><div style="margin-top:8px">Procurar no catÃ¡logo da Microsoft (Chrome, AnyDesk, Acrobat, 7-Zip...)</div></button>
    <button class="card kpi" style="text-align:left" data-w="meus"><div class="l">Meus instaladores</div><div style="margin-top:8px">Um .exe ou .msi seu (sistemas FND, programas da empresa...)</div></button></div>`);
  $('[data-w=cat]', m).onclick = () => { m.close(); taskDialog(deviceIds, 'app_buscar'); };
  $('[data-w=meus]', m).onclick = () => { m.close(); taskDialog(deviceIds, 'instalar_pacote'); };
}

// ---------- botÃ£o "Resolver" dos alertas (cria a tarefa certa na hora) ----------
function acoesHtml(a) {
  return (a.acoes || []).map((o, i) => `<button class="btn sm ${i === 0 ? 'primary' : ''}" data-resolver="${a.id}" data-op="${esc(o.id)}" data-perigo="${esc(o.perigo || '')}" data-label="${esc(o.label)}">${esc(o.label)}</button>`).join('');
}
function bindAcoes(el, depois) {
  $$('[data-resolver]', el).forEach((b) => {
    b.onclick = async (ev) => {
      ev.preventDefault(); ev.stopPropagation();
      const { resolver: id, op, perigo, label } = b.dataset;
      if (perigo && !(await confirmBox(label, esc(perigo), 'Confirmar', /reinici/i.test(label)))) return;
      b.disabled = true;
      try {
        const r = await POST(`/alerts/${id}/resolver`, { opcao: op });
        if (r.teste) toast(r.teste.status === 'online' ? 'O equipamento respondeu.' : 'O equipamento continua sem responder.', r.teste.status === 'online' ? 'ok' : 'err');
        else { toast(`Enviado: ${label}. O alerta some sozinho quando a tarefa concluir.`, 'ok'); if (r.ids && r.ids.length === 1) openTask(r.ids[0]); }
        if (depois) depois();
      } catch (e) { fail(e); b.disabled = false; }
    };
  });
}

async function quickTask(deviceId, action, params = {}) {
  const a = S.actionMap[action];
  if (!a || !a.allowed) return toast('Sem permissÃ£o para esta tarefa.', 'err');
  // tarefas pesadas: se o cliente tem horÃ¡rio de manutenÃ§Ã£o, abre o diÃ¡logo completo para escolher
  if (HEAVY.includes(action) && S.view === VIEWS.pc && VIEWS.pc.d && VIEWS.pc.d.maintenanceWindow) return taskDialog([deviceId], action, params);
  const dangerous = ['reiniciar_pc', 'remover_agente', 'app_atualizar_todos', 'apps_atualizar_lista', 'windows_update_instalar', 'drivers_instalar'].includes(action);
  if (dangerous && !(await confirmBox(a.label, `Confirmar <b>${esc(a.label)}</b>?${action === 'reiniciar_pc' ? '<br><br>Segue a polÃ­tica de reinÃ­cio do cliente: <b>Perguntar</b> (o usuÃ¡rio autoriza pelo Ã­cone da bandeja; se ninguÃ©m estiver usando, reinicia), <b>SÃ³ agendado</b> (no horÃ¡rio de manutenÃ§Ã£o) ou <b>AutomÃ¡tico</b> (aviso de 5 minutos).' : ''}`, 'Confirmar', action !== 'windows_update_instalar'))) return;
  try {
    const r = await POST('/tasks', { deviceIds: [deviceId], action, params });
    toast(`Tarefa enviada: ${a.label}`, 'ok');
    openTask(r.ids[0]);
  } catch (e) { fail(e); }
}

async function taskDialog(deviceIds, preset = '', presetParams = {}) {
  // "atualizar selecionados" sÃ³ aparece quando vem da lista de apps (precisa dos IDs marcados)
  const allowed = S.actions.filter((a) => a.allowed && (a.key !== 'apps_atualizar_lista' || preset === 'apps_atualizar_lista'));
  let packages = [];
  if (S.actionMap.instalar_pacote && S.actionMap.instalar_pacote.allowed) { try { packages = await GET('/packages'); } catch { /* */ } }
  const groups = [...new Set(allowed.map((a) => a.group))];
  const m = modal(`Nova tarefa Â· ${deviceIds.length} computador(es)`, `<form id="tf">
    <label>Tarefa</label><select name="action">${groups.map((g) => `<optgroup label="${esc(g)}">${allowed.filter((a) => a.group === g).map((a) => `<option value="${a.key}" ${a.key === preset ? 'selected' : ''}>${esc(a.label)}</option>`).join('')}</optgroup>`).join('')}</select>
    <div id="pp"></div>
    <label>Quando executar</label>
    <div class="row"><select name="when"><option value="">Agora (em segundo plano)</option><option value="agendar">Agendar data e hora</option></select><input type="datetime-local" name="scheduledFor" class="hidden"></div>
    <label id="rwbox" class="hidden" style="color:var(--text)"><input type="checkbox" name="respectWindow" checked> Respeitar o horÃ¡rio de manutenÃ§Ã£o do cliente (tarefas que podem atrapalhar o usuÃ¡rio)</label>
    <p class="muted small">Se o computador estiver desligado, a tarefa fica na fila e roda quando ele voltar a ficar online.</p></form>`,
  { footer: '<button class="btn ghost" data-close>Cancelar</button><button class="btn primary" id="go">Enviar tarefa</button>' });
  const f = $('#tf', m);
  const drawParams = () => {
    const a = S.actionMap[f.action.value];
    const p = a.params;
    $('#pp', m).innerHTML = (p.includes('pacote') ? (packages.length
        ? `<label>Programa (da sua biblioteca de instaladores)</label><select name="pacote">${packages.map((k) => `<option value="${k.id}" ${String(presetParams.pacote) === String(k.id) ? 'selected' : ''}>${esc(k.name)} Â· ${esc(k.filename)} (${fmtSize(k.size)})</option>`).join('')}</select>
           <p class="muted small" id="pkargs"></p>`
        : '<p class="muted">Nenhum instalador na biblioteca ainda. Adicione em <a href="#/instaladores">Meus instaladores</a>.</p>') : '')
      + (p.includes('id') ? '<label>ID do aplicativo no winget (ex.: Google.Chrome, 7zip.7zip, Adobe.Acrobat.Reader.64-bit)</label><input name="id" required>' : '')
      + (p.includes('termo') ? '<label>Nome do aplicativo para buscar (ex.: chrome, anydesk, acrobat)</label><input name="termo" required>' : '')
      + (p.includes('nome') ? '<label>Nome do serviÃ§o (ex.: Spooler)</label><input name="nome" required>' : '')
      + (p.includes('script') ? '<label>Script PowerShell (roda como SYSTEM, em segundo plano, sem janela). Fica registrado no histÃ³rico.</label><textarea name="script" required spellcheck="false" placeholder="Get-Service | Where-Object Status -eq Stopped"></textarea>' : '')
      + (a.key === 'windows_update_instalar' ? '<p class="muted small">Baixa e instala as atualizaÃ§Ãµes sem reiniciar. Pode levar bastante tempo.</p>' : '')
      + (a.key === 'reiniciar_pc' ? '<p class="muted small">Segue a polÃ­tica de reinÃ­cio do cliente: <b>Perguntar</b> (o usuÃ¡rio autoriza pelo Ã­cone da bandeja; se ninguÃ©m estiver usando, reinicia), <b>SÃ³ agendado</b> (no horÃ¡rio de manutenÃ§Ã£o, com aviso de 5 min) ou <b>AutomÃ¡tico</b> (aviso de 5 min).</p>' : '');
  };
  const showArgs = () => { const sel = f.pacote; const info = $('#pkargs', m); if (!sel || !info) return; const k = packages.find((x) => String(x.id) === sel.value); info.innerHTML = !k ? '' : /\.zip$/i.test(k.filename) ? 'Pacote de driver: os arquivos .inf sÃ£o instalados com o pnputil do Windows (sem reiniciar).' : `InstalaÃ§Ã£o silenciosa com: <span class="mono">${esc(k.args || (/\.msi$/i.test(k.filename) ? '/qn /norestart (automÃ¡tico)' : '(sem parÃ¢metros)'))}</span>`; sel.onchange = showArgs; };
  const syncRw = () => $('#rwbox', m).classList.toggle('hidden', !HEAVY.includes(f.action.value));
  f.action.onchange = () => { drawParams(); showArgs(); syncRw(); }; drawParams(); showArgs(); syncRw();
  for (const [k, v] of Object.entries(presetParams)) if (f[k] && k !== 'pacote') f[k].value = v;
  if (presetParams.ids) $('#pp', m).insertAdjacentHTML('beforeend', `<input type="hidden" name="ids" value="${esc(presetParams.ids)}"><p class="muted small">${presetParams.ids.split(',').length} aplicativo(s) selecionado(s).</p>`);
  f.when.onchange = () => f.scheduledFor.classList.toggle('hidden', f.when.value !== 'agendar');
  $('#go', m).onclick = async () => {
    const d = formData(f);
    const a = S.actionMap[d.action];
    const params = {}; for (const k of a.params) params[k] = d[k] ?? presetParams[k];
    if (a.params.includes('pacote') && !d.pacote) return toast('Adicione um instalador na biblioteca primeiro.', 'err');
    if (d.when === 'agendar' && !d.scheduledFor) return toast('Escolha a data e hora.', 'err');
    try {
      const r = await POST('/tasks', { deviceIds, action: d.action, params, scheduledFor: d.when === 'agendar' ? d.scheduledFor : '', respectWindow: !!d.respectWindow });
      m.close();
      toast(`${r.ids.length} tarefa(s) criada(s).`, 'ok');
      if (r.ids.length === 1 && d.when !== 'agendar') openTask(r.ids[0]);
    } catch (e) { fail(e); }
  };
}

// ---------- saÃºde do disco (SMART) ----------
// nÃºmero de verdade ou null (agentes atÃ© a 0.8.1 mandavam {} quando o disco nÃ£o informava o valor)
const numDisco = (v) => (typeof v === 'number' && Number.isFinite(v) ? v : (typeof v === 'string' && v.trim() !== '' && Number.isFinite(Number(v)) ? Number(v) : null));
function diskBadge(p) {
  const wear = numDisco(p.wear), temp = numDisco(p.temperature), errs = (numDisco(p.readErrors) || 0) + (numDisco(p.writeErrors) || 0), ruins = numDisco(p.setoresRuins) || 0;
  if (/unhealthy/i.test(p.health) || wear >= 90 || temp >= 70 || ruins >= 100) return ['bad', 'Com problema'];
  if (/warning/i.test(p.health) || wear >= 70 || temp >= 60 || errs > 0 || ruins > 0) return ['warn', 'AtenÃ§Ã£o'];
  if (/healthy|ok/i.test(p.health || '')) return ['ok', 'SaudÃ¡vel'];
  return ['', p.health || '?'];
}
function diskSmart(p) {
  const it = [];
  const temp = numDisco(p.temperature), wear = numDisco(p.wear), horas = numDisco(p.powerOnHours);
  if (temp != null && temp > 0) it.push(`ðŸŒ¡ ${esc(temp)} Â°C`);
  if (wear != null) it.push(`vida Ãºtil usada ${esc(wear)}%`);
  if (horas != null && horas > 0) it.push(horas < 48 ? `ligado ${esc(horas)} h no total` : `ligado ${esc(Math.round(horas / 24).toLocaleString('pt-BR'))} dias no total`);
  const errs = (numDisco(p.readErrors) || 0) + (numDisco(p.writeErrors) || 0);
  if (errs) it.push(`<b style="color:var(--warn)">${esc(errs)} erro(s) nÃ£o corrigidos</b>`);
  const ruins = numDisco(p.setoresRuins);
  if (ruins) it.push(`<b style="color:var(--warn)">${esc(ruins)} setor(es) ruim(ns)</b>`);
  if (p.smartFalhou) it.push('<b style="color:var(--bad)">o prÃ³prio disco avisa que vai falhar</b>');
  if (!it.length) return '<div class="muted small">O disco nÃ£o informou temperatura nem horas ligado.</div>';
  return `<div class="muted small">${it.join(' Â· ')}</div>`;
}

// ---------- DRIVERS ----------
// Sites OFICIAIS de suporte (quando o Windows Update nÃ£o tem o driver)
const DRIVER_SITES = [
  [/dell/i, 'Dell', 'https://www.dell.com/support/home/pt-br'],
  [/lenovo/i, 'Lenovo', 'https://pcsupport.lenovo.com/br/pt'],
  [/hewlett|^hp\b/i, 'HP', 'https://support.hp.com/br-pt/drivers'],
  [/acer/i, 'Acer', 'https://www.acer.com/br-pt/support/drivers-and-manuals'],
  [/asus/i, 'ASUS', 'https://www.asus.com/br/support/download-center/'],
];
const CHIP_SITES = [
  [/VEN_8086/i, 'Intel', 'https://www.intel.com.br/content/www/br/pt/support/detect.html'],
  [/VEN_1002|VEN_1022/i, 'AMD', 'https://www.amd.com/pt/support/download/drivers.html'],
  [/VEN_10DE/i, 'NVIDIA', 'https://www.nvidia.com/pt-br/drivers/'],
];
function siteLink([, nome, url]) { return `<a href="${url}" target="_blank" rel="noopener noreferrer">${nome} (site oficial)</a>`; }
function driversView(r) {
  const fab = DRIVER_SITES.find(([re]) => re.test(r.manufacturer || ''));
  const probs = r.problems || [];
  const ups = r.updates || [];
  return `${r.manufacturer || r.model ? `<p class="muted small">Computador: <b>${esc(r.manufacturer || '')} ${esc(r.model || '')}</b>${fab ? ' Â· drivers oficiais: ' + siteLink(fab) : ''}</p>` : ''}
    <h3>Aparelhos com problema</h3>${probs.length ? `<table><thead><tr><th>Aparelho</th><th>Problema</th><th class="hide-sm">CÃ³digo do aparelho</th><th class="hide-sm">Onde achar</th></tr></thead><tbody>${probs.map((p) => {
      const chip = CHIP_SITES.find(([re]) => re.test(p.hardwareId || ''));
      return `<tr><td><b>${esc(p.device)}</b><div class="muted small">${esc(p.class || '')}</div></td><td><span class="badge warn">${esc(p.problem)}</span></td><td class="hide-sm mono small">${esc(p.hardwareId || '')}</td>
        <td class="hide-sm small">${ups.length ? 'Tente primeiro o Windows Update' : ''}${chip ? (ups.length ? ' Â· ' : '') + siteLink(chip) : fab ? (ups.length ? ' Â· ' : '') + siteLink(fab) : ''}</td></tr>`; }).join('')}</tbody></table>`
      : '<p>Nenhum aparelho com problema de driver. âœ”</p>'}
    <h3 style="margin-top:14px">Drivers novos no Windows Update</h3>${r.updatesError ? `<p class="muted">${esc(r.updatesError)}</p>` : ups.length ? autoTable(ups.map((u) => ({ driver: u.title, fabricante: u.manufacturer, data: u.date, tamanho: u.sizeMB + ' MB' }))) : '<p>Nenhum driver novo disponÃ­vel. âœ”</p>'}
    ${(r.main || []).length ? `<details style="margin-top:14px"><summary>Drivers principais instalados (vÃ­deo, rede, som...)</summary>${autoTable(r.main.map((m) => ({ aparelho: m.device, tipo: m.class, fabricante: m.provider, versÃ£o: m.version, data: m.date })))}</details>` : ''}
    <p class="muted small" style="margin-top:10px">Os drivers do Windows Update vÃªm dos prÃ³prios fabricantes e sÃ£o verificados pela Microsoft. Se o driver nÃ£o estiver lÃ¡, baixe sÃ³ do site oficial e envie o .zip (com os arquivos .inf) ou o instalador em <a href="#/instaladores">Meus instaladores</a>. Evite sites de "drivers grÃ¡tis".</p>`;
}

function taskTable(rows, showPc = true) {
  if (!rows.length) return '<div class="card muted">Nenhuma tarefa.</div>';
  return `<div class="table-wrap"><table><thead><tr><th>#</th><th>Tarefa</th>${showPc ? '<th>Computador</th>' : ''}<th>Status</th><th>Por</th><th>Criada</th><th class="hide-sm">Agendada</th><th class="hide-sm">ConcluÃ­da</th><th></th></tr></thead><tbody>
    ${rows.map((t) => { const p = t.params ? JSON.parse(t.params) : {}; const extra = p.id || (t.action === 'instalar_pacote' ? p.arquivo : p.nome) || p.termo || '';
      return `<tr class="click" data-task="${t.id}"><td class="muted">${t.id}</td><td>${esc(actLabel(t.action))}${extra ? ` <span class="mono small muted">${esc(extra)}</span>` : ''}</td>
      ${showPc ? `<td>${devName(t)}${t.client_name ? `<div class="muted small">${esc(t.client_name)}</div>` : ''}</td>` : ''}
      <td><span class="badge ${esc(t.status)}">${esc(statusLabel[t.status] || t.status)}</span>${waitLabel(t) ? `<div class="muted small">${esc(waitLabel(t))}</div>` : ''}</td><td class="small">${esc(t.created_by || '')}</td>
      <td class="small">${when(t.created_at)}</td><td class="small hide-sm">${t.scheduled_for ? dt(t.scheduled_for) : 'â€”'}</td><td class="small hide-sm">${when(t.finished_at)}</td>
      <td>${['pendente', 'enviada', 'executando'].includes(t.status) && can('tecnico') ? `<button class="btn sm${t.status === 'pendente' ? '' : ' danger'}" data-cancel="${t.id}" data-enc="${t.status === 'pendente' ? '' : '1'}">${t.status === 'pendente' ? 'Cancelar' : 'Encerrar'}</button>` : ''}</td></tr>`; }).join('')}</tbody></table></div>`;
}
function bindTaskTable(el) {
  $$('[data-task]', el).forEach((tr) => tr.addEventListener('click', (e) => { if (e.target.closest('button')) return; openTask(tr.dataset.task); }));
  $$('[data-cancel]', el).forEach((b) => { b.onclick = async (ev) => {
    ev.stopPropagation();
    const enc = !!b.dataset.enc;
    if (enc && !(await confirmBox('Encerrar tarefa', `Encerrar a tarefa #${b.dataset.cancel}? Se ela ainda estiver rodando no computador, o processo Ã© finalizado na hora.`, 'Encerrar', true))) return;
    try { await POST(`/tasks/${b.dataset.cancel}/cancel`); toast(enc ? 'Tarefa encerrada.' : 'Tarefa cancelada.', 'ok'); S.view.refresh(); } catch (e) { fail(e); } }; });
}

// tabela de apps desatualizados com caixinhas + "Atualizar selecionados" / "Atualizar todos"
function appsTable(apps) {
  const can2 = S.actionMap.app_atualizar && S.actionMap.app_atualizar.allowed;
  return `${can2 ? `<div class="btns" style="margin-bottom:10px"><button class="btn primary sm" data-upall>Atualizar todos (${apps.length})</button><button class="btn sm" data-upsel disabled>Atualizar selecionados</button></div>` : ''}
    <div class="table-wrap"><table><thead><tr>${can2 ? '<th><input type="checkbox" data-selall></th>' : ''}<th>Aplicativo</th><th>ID</th><th>Instalada</th><th>DisponÃ­vel</th>${can2 ? '<th></th>' : ''}</tr></thead><tbody>
    ${apps.map((a) => `<tr>${can2 ? `<td><input type="checkbox" data-app="${esc(a.id)}"></td>` : ''}<td>${esc(a.name)}</td><td class="mono small">${esc(a.id)}</td><td>${esc(a.version)}</td><td><b>${esc(a.available)}</b></td>
      ${can2 ? `<td><button class="btn sm" data-up="${esc(a.id)}">Atualizar</button></td>` : ''}</tr>`).join('')}</tbody></table></div>`;
}
function bindAppsTable(el, deviceId, onDone) {
  const sel = () => $$('[data-app]:checked', el).map((c) => c.dataset.app);
  const sync = () => { const b = $('[data-upsel]', el); if (b) { const n = sel().length; b.disabled = !n; b.textContent = `Atualizar selecionados${n ? ` (${n})` : ''}`; } };
  $$('[data-app]', el).forEach((c) => { c.onchange = sync; });
  const all = $('[data-selall]', el); if (all) all.onchange = () => { $$('[data-app]', el).forEach((c) => { c.checked = all.checked; }); sync(); };
  $$('[data-up]', el).forEach((b) => { b.onclick = () => quickTask(deviceId, 'app_atualizar', { id: b.dataset.up }); });
  const up = $('[data-upall]', el); if (up) up.onclick = () => { if (onDone) onDone(); quickTask(deviceId, 'app_atualizar_todos'); };
  const us = $('[data-upsel]', el); if (us) us.onclick = () => { const ids = sel(); if (!ids.length) return; if (onDone) onDone(); quickTask(deviceId, 'apps_atualizar_lista', { ids: ids.join(',') }); };
}

// resultado detalhado de atualizaÃ§Ã£o/instalaÃ§Ã£o pelo winget (resumo, falhas, reinÃ­cio)
const APP_STATUS = { ok: ['ok', 'âœ” Atualizado'], falhou: ['bad', 'âœ– Falhou'], reiniciar: ['warn', 'â†» Precisa reiniciar'] };
function updateResult(r, t) {
  if (!r.apps && !r.summary) return `<p><b>${esc(r.message || '')}</b></p>`;
  const c = r.counts || {};
  const head = r.summary ? `<div class="card" style="margin-bottom:14px"><div style="font-size:18px;font-weight:600">${esc(r.summary)}</div>
      <div class="muted small" style="margin-top:6px">CÃ³digo do winget: <span class="mono">${esc(r.codeHex || r.exitCode)}</span> Â· ${esc(r.message || '')}</div>
      ${r.unknownVersions ? `<div class="muted small" style="margin-top:6px">${r.unknownVersions} programa(s) com versÃ£o desconhecida ficaram de fora (o winget nÃ£o atualiza esses no "Atualizar todos", por seguranÃ§a).</div>` : ''}</div>` : `<p><b>${esc(r.message || '')}</b></p>`;
  const failed = (r.apps || []).filter((a) => a.status === 'falhou');
  const reboot = (r.apps || []).filter((a) => a.status === 'reiniciar');
  let box = '';
  if (failed.length) box += `<div class="card" style="margin-bottom:12px;border-color:rgba(239,68,68,.5)"><b>Falharam (${failed.length}):</b><ul style="margin:8px 0 0">${failed.map((a) => `<li><b>${esc(a.name)}</b> <span class="muted small">${esc(a.message || '')}</span></li>`).join('')}</ul>
      <p class="muted small" style="margin:8px 0 0">Dica: tente de novo com o programa fechado ou agende para o horÃ¡rio de manutenÃ§Ã£o.</p></div>`;
  if (r.rebootRequired) {
    const canReboot = S.actionMap.reiniciar_pc && S.actionMap.reiniciar_pc.allowed;
    box += `<div class="card" style="margin-bottom:12px;border-color:rgba(245,165,36,.6)"><b>âš  ReinÃ­cio pendente</b>${reboot.length ? ` para concluir: ${reboot.map((a) => `<b>${esc(a.name)}</b>`).join(', ')}` : ''}
      <div class="btns" style="margin-top:10px">${canReboot ? '<button class="btn danger" data-reboot>Reiniciar PC</button><span class="muted small">Segue a polÃ­tica de reinÃ­cio do cliente (pergunta ao usuÃ¡rio, se for o caso).</span>' : '<span class="muted small">PeÃ§a a um administrador para reiniciar este computador.</span>'}</div></div>`;
  }
  const table = (r.apps || []).length ? `<div class="table-wrap"><table><thead><tr><th>Aplicativo</th><th>ID</th><th>VersÃ£o</th><th>Resultado</th></tr></thead><tbody>
      ${r.apps.map((a) => `<tr><td>${esc(a.name)}</td><td class="mono small">${esc(a.id)}</td><td>${esc(a.version || '')}</td><td><span class="badge ${esc((APP_STATUS[a.status] || ['', a.status])[0])}">${esc((APP_STATUS[a.status] || ['', a.status])[1])}</span>${a.status !== 'ok' && a.message ? `<div class="muted small">${esc(a.message)}</div>` : ''}</td></tr>`).join('')}</tbody></table></div>` : '';
  return head + box + table;
}

function renderTaskResult(t) {
  const r = t.result;
  if (!r) return '';
  if (t.action === 'apps_verificar') {
    if (!r.apps.length) return '<p>Todos os aplicativos estÃ£o atualizados. âœ”</p>';
    return appsTable(r.apps);
  }
  if (/^app_(atualizar|instalar|desinstalar)|apps_atualizar_lista|app_atualizar_todos/.test(t.action)) {
    // agentes antigos (atÃ© 0.2.1) mandavam apps com "ok" em vez de "status"
    if (r.apps && r.apps.length && r.apps[0].status === undefined) r.apps = r.apps.map((a) => ({ name: a.id, id: a.id, status: a.ok ? 'ok' : 'falhou', message: a.message }));
    return updateResult(r, t);
  }
  if (t.action === 'app_buscar') {
    if (!r.found.length) return '<p class="muted">Nada encontrado no catÃ¡logo do winget.</p>';
    return `<table><thead><tr><th>Aplicativo</th><th>ID</th><th>VersÃ£o</th><th></th></tr></thead><tbody>${r.found.map((a) => `<tr><td>${esc(a.name)}</td><td class="mono small">${esc(a.id)}</td><td>${esc(a.version)}</td>
      <td>${S.actionMap.app_instalar.allowed ? `<button class="btn sm primary" data-inst="${esc(a.id)}">Instalar</button>` : ''}</td></tr>`).join('')}</tbody></table>`;
  }
  if (t.action === 'diagnostico') {
    return `<div class="card" style="margin-bottom:14px"><h3>Problemas encontrados</h3>${r.problems && r.problems.length ? `<ul>${r.problems.map((p) => `<li>${esc(p)}</li>`).join('')}</ul>` : '<p>Nenhum problema de desempenho encontrado. âœ”</p>'}</div>
      <dl class="kv"><dt>Uso de CPU</dt><dd>${esc(r.cpuLoad)}%</dd><dt>Uso de RAM</dt><dd>${esc(r.ramPct)}%${r.ramGB ? ` de ${esc(r.ramGB)} GB` : ''}</dd><dt>Ligado hÃ¡</dt><dd>${esc(r.uptimeDays)} dia(s)</dd><dt>Livre no disco do sistema</dt><dd>${esc(r.systemFreePct)}% (${esc(r.systemDiskType || '?')})</dd>
      <dt>Programas na inicializaÃ§Ã£o</dt><dd>${esc(r.startupCount)}</dd><dt>Temp do Windows</dt><dd>${esc(r.windowsTempGB)} GB</dd></dl>
      <div class="grid g2" style="margin-top:14px"><div><h3>Mais CPU agora</h3>${autoTable(r.topCpu || [])}</div><div><h3>Mais memÃ³ria</h3>${autoTable(r.topMem || [])}</div></div>`;
  }
  if (t.action === 'drivers_verificar') return driversView(r);
  if (t.action === 'drivers_instalar') return (r.message ? `<p><b>${esc(r.message)}</b></p>` : '') + ((r.installed || []).length ? autoTable(r.installed) : '') + (r.rebootRequired ? '<p><span class="badge warn">ReinÃ­cio necessÃ¡rio</span> para concluir a instalaÃ§Ã£o dos drivers.</p>' : '');
  if (t.action === 'windows_update_verificar') return r.updates.length ? autoTable(r.updates) : '<p>Nenhuma atualizaÃ§Ã£o do Windows pendente. âœ”</p>';
  if (t.action === 'atualizar_agente') return `<p><b>${esc(r.message || '')}</b></p>`;
  if (t.action === 'instalar_pacote') return `<p><b>${esc(r.message || '')}</b></p><dl class="kv"><dt>Programa</dt><dd>${esc(t.params.nome || '')} Â· ${esc(t.params.arquivo || '')}</dd><dt>CÃ³digo de saÃ­da</dt><dd>${esc(r.exitCode)}</dd><dt>Arquivo conferido</dt><dd>SHA-256 âœ”</dd>${r.rebootRequired ? '<dt>ReinÃ­cio</dt><dd><span class="badge warn">NecessÃ¡rio</span></dd>' : ''}</dl>`;
  return autoRender(r);
}

let openTaskModal = null;
async function openTask(id) {
  if (openTaskModal) openTaskModal.close();
  const m = modal(`Tarefa #${id}`, '<p class="muted">Carregando...</p>', { wide: true, footer: '<button class="btn" data-close>Fechar</button>' });
  openTaskModal = m;
  m.onclose = () => { if (openTaskModal === m) openTaskModal = null; clearInterval(m.timer); };
  const load = async () => {
    let t; try { t = await GET('/tasks/' + id); } catch (e) { $('.body', m).innerHTML = esc(e.message); return; }
    const running = ['pendente', 'enviada', 'executando'].includes(t.status);
    $('.body', m).innerHTML = `<div class="row" style="margin-bottom:14px"><div><b>${esc(actLabel(t.action))}</b><div class="muted small">${devName(t)} Â· criada por ${esc(t.created_by)} ${when(t.created_at)}</div></div>
      <div style="text-align:right"><span class="badge ${esc(t.status)}">${esc(statusLabel[t.status] || t.status)}</span>${running ? ' <span class="muted small">atualiza sozinho...</span>' : ''}</div></div>
      ${t.params && Object.keys(t.params).length ? `<pre style="margin-bottom:12px">${esc(t.params.script || (t.action === 'instalar_pacote' ? `${t.params.arquivo}  ${t.params.args || ''}\nSHA-256: ${t.params.sha256}` : t.params.ids ? 'Aplicativos: ' + t.params.ids.split(',').join(', ') : t.action === 'atualizar_agente' ? `VersÃ£o ${t.params.versao}  Â·  SHA-256 ${t.params.sha256}` : JSON.stringify(t.params)))}</pre>` : ''}
      ${t.status === 'pendente' && t.scheduled_for ? `<p>Agendada para <b>${dt(t.scheduled_for)}</b>.</p>` : ''}
      ${waitLabel(t) ? `<p class="muted">Aguardando o horÃ¡rio de manutenÃ§Ã£o do cliente (<b>${esc(t.maintenance_window)}</b>). Roda sozinha quando chegar a hora.</p>` : ''}
      ${t.status === 'pendente' && !t.scheduled_for && !waitLabel(t) ? '<p class="muted">Aguardando o computador ficar online...</p>' : ''}
      ${t.status === 'executando' ? '<p class="muted">Executando em segundo plano no computador...</p>' : ''}
      ${running && can('tecnico') ? `<div class="btns" style="margin:8px 0 4px"><button class="btn danger sm" data-stop="${t.id}">${t.status === 'pendente' ? 'Cancelar tarefa' : 'Encerrar tarefa'}</button>${t.status !== 'pendente' ? '<span class="muted small" style="align-self:center">Para o que estiver rodando no computador e tira a tarefa da fila.</span>' : ''}</div>` : ''}
      <div id="res">${renderTaskResult(t)}</div>
      ${t.output ? `<h3 style="margin-top:16px">SaÃ­da</h3><pre>${esc(t.output)}</pre>` : ''}`;
    if (t.action === 'apps_verificar') bindAppsTable(m, t.device_id, () => clearInterval(m.timer));
    const rb = $('[data-reboot]', m); if (rb) rb.onclick = () => { clearInterval(m.timer); quickTask(t.device_id, 'reiniciar_pc'); };
    $$('[data-inst]', m).forEach((b) => { b.onclick = () => quickTask(t.device_id, 'app_instalar', { id: b.dataset.inst }); });
    const sb = $('[data-stop]', m);
    if (sb) sb.onclick = async () => {
      const enc = t.status !== 'pendente';
      if (!(await confirmBox(enc ? 'Encerrar tarefa' : 'Cancelar tarefa', enc ? `Encerrar a tarefa #${t.id}? Se ela ainda estiver rodando no computador, o processo Ã© finalizado na hora.` : `Cancelar a tarefa #${t.id}?`, enc ? 'Encerrar' : 'Cancelar tarefa', true))) return;
      try { await POST(`/tasks/${t.id}/cancel`); toast(enc ? 'Tarefa encerrada.' : 'Tarefa cancelada.', 'ok'); load(); if (S.view && S.view.refresh) S.view.refresh(); } catch (e) { fail(e); }
    };
    if (!running) clearInterval(m.timer);
  };
  await load();
  m.timer = setInterval(load, 3000);
}

VIEWS.tarefas = {
  async render(el) {
    this.el = el;
    setTitle('Tarefas');
    el.innerHTML = `<div class="toolbar"><select id="ts"><option value="">Todos os status</option>${Object.entries(statusLabel).map(([k, v]) => `<option value="${k}">${v}</option>`).join('')}</select>
      <input class="grow" id="tq" placeholder="Filtrar por computador ou tarefa..."></div><div id="tl"></div>`;
    $('#ts').onchange = () => this.refresh(); $('#tq').oninput = () => this.draw();
    await this.refresh();
  },
  limit: 200,
  async refresh() { this.rows = await GET(`/tasks?limit=${this.limit}` + ($('#ts').value ? '&status=' + $('#ts').value : '')); this.draw(); },
  draw() {
    const q = $('#tq').value.toLowerCase();
    $('#tl').innerHTML = taskTable(this.rows.filter((t) => !q || `${t.hostname} ${t.alias} ${actLabel(t.action)} ${t.client_name}`.toLowerCase().includes(q)))
      + (this.rows.length >= this.limit && this.limit < 1000 ? '<div class="btns" style="justify-content:center;margin:12px 0"><button class="btn" id="tmore">Carregar tarefas mais antigas</button></div>' : '');
    if ($('#tmore')) $('#tmore').onclick = () => { this.limit = Math.min(this.limit + 200, 1000); this.refresh(); };
    bindTaskTable(this.el);
  },
};

// ================= AGENDAMENTOS RECORRENTES =================
const DIAS = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'SÃ¡b'];
const diasLabel = (d) => { const a = d.split(',').map(Number); if (a.length === 7) return 'Todos os dias'; if (a.join() === '1,2,3,4,5') return 'Seg a Sex'; return a.map((x) => DIAS[x]).join(', '); };
VIEWS.agendamentos = {
  async render(el) {
    this.el = el;
    setTitle('Agendamentos', '<button class="btn primary" id="nsch">+ Novo agendamento</button>');
    $('#nsch').onclick = () => this.edit(null);
    await loadClients();
    await this.refresh();
  },
  async refresh() {
    const rows = await GET('/schedules');
    this.rows = rows;
    this.el.innerHTML = (rows.length ? `<div class="table-wrap"><table><thead><tr><th>Agendamento</th><th>Tarefa</th><th>Computadores</th><th>Quando</th><th class="hide-sm">PrÃ³xima</th><th class="hide-sm">Ãšltima</th><th>Ativo</th><th></th></tr></thead><tbody>
      ${rows.map((r) => `<tr><td><b>${esc(r.name)}</b>${r.respectWindow ? '<div class="muted small">respeita o horÃ¡rio de manutenÃ§Ã£o</div>' : ''}</td><td>${esc(actLabel(r.action))}</td>
        <td>${esc(r.targetLabel)} <span class="muted small">(${r.devices})</span></td><td class="nw">${esc(diasLabel(r.days))} Ã s <b>${esc(r.time)}</b></td>
        <td class="hide-sm small">${r.next ? dt(r.next) : 'â€”'}</td><td class="hide-sm small">${r.lastRun ? esc(r.lastRun.split('-').reverse().join('/')) : 'â€”'}</td>
        <td><label><input type="checkbox" data-act="${r.id}" ${r.active ? 'checked' : ''}></label></td>
        <td><div class="btns"><button class="btn sm" data-run="${r.id}">Executar agora</button><button class="btn sm" data-edit="${r.id}">Editar</button><button class="btn sm danger" data-del="${r.id}">Excluir</button></div></td></tr>`).join('')}</tbody></table></div>`
      : '<div class="card"><p class="muted">Nenhum agendamento ainda.</p><p class="muted small">Exemplos: "Toda sexta 22:00 â€” Atualizar todos os aplicativos â€” Cliente Augusta", "Todo dia 12:00 â€” Atualizar inventÃ¡rio â€” Todos os computadores".</p></div>')
      + '<p class="muted small">Tarefas pesadas (atualizar, instalar, reiniciar) com "respeitar o horÃ¡rio de manutenÃ§Ã£o" ficam na fila atÃ© o horÃ¡rio permitido do cliente. Computadores desligados fazem a tarefa quando voltarem.</p>';
    $$('[data-act]', this.el).forEach((c) => { c.onchange = async () => { try { await api('PATCH', '/schedules/' + c.dataset.act, { active: c.checked }); toast(c.checked ? 'Agendamento ativado.' : 'Agendamento pausado.', 'ok'); this.refresh(); } catch (e) { fail(e); } }; });
    $$('[data-run]', this.el).forEach((b) => { b.onclick = async () => { if (!(await confirmBox('Executar agora', 'Criar as tarefas deste agendamento agora?', 'Executar'))) return; try { const r = await POST(`/schedules/${b.dataset.run}/run`); toast(`${r.count} tarefa(s) criada(s).`, 'ok'); } catch (e) { fail(e); } }; });
    $$('[data-edit]', this.el).forEach((b) => { b.onclick = () => this.edit(this.rows.find((r) => r.id === +b.dataset.edit)); });
    $$('[data-del]', this.el).forEach((b) => { b.onclick = async () => { if (await confirmBox('Excluir agendamento', 'Excluir este agendamento?', 'Excluir', true)) { try { await api('DELETE', '/schedules/' + b.dataset.del); this.refresh(); } catch (e) { fail(e); } } }; });
  },
  async edit(r) {
    r = r || { days: '1,2,3,4,5', time: '22:00', targetType: 'cliente', respectWindow: true, active: true, params: {} };
    const devices = await GET('/devices');
    let packages = []; try { packages = await GET('/packages'); } catch { /* */ }
    const acts = S.actions.filter((a) => a.allowed && !['remover_agente', 'apps_atualizar_lista', 'app_buscar'].includes(a.key));
    const groups = [...new Set(acts.map((a) => a.group))];
    const m = modal(r.id ? 'Editar agendamento' : 'Novo agendamento', `<form id="sf">
      <label>Nome</label><input name="name" value="${esc(r.name || '')}" placeholder="ex.: Atualizar apps toda sexta" required>
      <label>Tarefa</label><select name="action">${groups.map((g) => `<optgroup label="${esc(g)}">${acts.filter((a) => a.group === g).map((a) => `<option value="${a.key}" ${a.key === r.action ? 'selected' : ''}>${esc(a.label)}</option>`).join('')}</optgroup>`).join('')}</select>
      <div id="spp"></div>
      <div class="row"><div><label>Em quais computadores</label><select name="targetType">${[['todos', 'Todos os computadores'], ['cliente', 'Um cliente'], ['grupo', 'Um grupo / setor'], ['pc', 'Um computador']].map(([k, l]) => `<option value="${k}" ${r.targetType === k ? 'selected' : ''}>${l}</option>`).join('')}</select></div>
        <div id="tgt"></div></div>
      <label>Dias da semana</label><div class="btns">${DIAS.map((d, i) => `<label class="badge" style="cursor:pointer;padding:6px 10px"><input type="checkbox" name="d${i}" ${r.days.split(',').includes(String(i)) ? 'checked' : ''}> ${d}</label>`).join('')}</div>
      <div class="row"><div><label>HorÃ¡rio</label><input type="time" name="time" value="${esc(r.time)}" required></div><div></div></div>
      <label style="color:var(--text)"><input type="checkbox" name="respectWindow" ${r.respectWindow ? 'checked' : ''}> Respeitar o horÃ¡rio de manutenÃ§Ã£o do cliente (tarefas pesadas)</label>
      <label style="color:var(--text)"><input type="checkbox" name="active" ${r.active ? 'checked' : ''}> Ativo</label></form>`,
    { wide: true, footer: '<button class="btn ghost" data-close>Cancelar</button><button class="btn primary" id="sv">Salvar</button>' });
    const f = $('#sf', m);
    const drawTarget = () => {
      const t = f.targetType.value;
      $('#tgt', m).innerHTML = t === 'cliente' ? `<label>Cliente</label><select name="targetId">${clientOptions(r.targetId, false)}</select>`
        : t === 'grupo' ? `<label>Grupo / setor</label><select name="targetId">${S.groups.map((g) => `<option value="${g.id}" ${String(r.targetId) === String(g.id) ? 'selected' : ''}>${esc(g.name)} Â· ${esc(g.client_name)}</option>`).join('') || '<option value="">(nenhum grupo cadastrado)</option>'}</select>`
          : t === 'pc' ? `<label>Computador</label><select name="targetId">${devices.filter((d) => !d.revoked).map((d) => `<option value="${esc(d.id)}" ${r.targetId === d.id ? 'selected' : ''}>${devName(d)} Â· ${esc(d.clientName || '')}</option>`).join('')}</select>` : '';
    };
    const drawParams = () => {
      const a = S.actionMap[f.action.value];
      $('#spp', m).innerHTML = (a.params.includes('pacote') ? `<label>Programa</label><select name="pacote">${packages.map((k) => `<option value="${k.id}" ${String(r.params.pacote) === String(k.id) ? 'selected' : ''}>${esc(k.name)} Â· ${esc(k.filename)}</option>`).join('') || '<option value="">(biblioteca vazia)</option>'}</select>` : '')
        + (a.params.includes('id') ? `<label>ID do aplicativo no winget</label><input name="id" value="${esc(r.params.id || '')}">` : '')
        + (a.params.includes('nome') ? `<label>Nome do serviÃ§o</label><input name="nome" value="${esc(r.params.nome || '')}">` : '')
        + (a.params.includes('script') ? `<label>Script PowerShell</label><textarea name="script" spellcheck="false">${esc(r.params.script || '')}</textarea>` : '');
    };
    f.targetType.onchange = drawTarget; f.action.onchange = drawParams; drawTarget(); drawParams();
    $('#sv', m).onclick = async () => {
      const d = formData(f);
      const a = S.actionMap[d.action];
      const params = {}; for (const k of a.params) params[k] = d[k];
      const body = { name: d.name, action: d.action, params, targetType: d.targetType, targetId: d.targetId, days: DIAS.map((_, i) => (d['d' + i] ? i : -1)).filter((i) => i >= 0), time: d.time, respectWindow: d.respectWindow, active: d.active };
      try { r.id ? await api('PATCH', '/schedules/' + r.id, body) : await POST('/schedules', body); m.close(); toast('Agendamento salvo.', 'ok'); this.refresh(); } catch (e) { fail(e); }
    };
  },
};

// ================= ALERTAS =================
VIEWS.alertas = {
  async render(el) { this.el = el; setTitle('Alertas e notificaÃ§Ãµes', '<label class="muted small"><input type="checkbox" id="allal"> Mostrar resolvidos</label>'); $('#allal').onchange = () => this.refresh(); await this.refresh(); },
  async refresh() {
    const rows = await GET('/alerts' + ($('#allal') && $('#allal').checked ? '?all=1' : ''));
    this.el.innerHTML = rows.length ? `<div class="table-wrap"><table><thead><tr><th>Gravidade</th><th>Alerta</th>${S.me.clientId ? '' : '<th>Cliente</th>'}<th>Quando</th><th>SituaÃ§Ã£o</th><th></th></tr></thead><tbody>
      ${rows.map((a) => `<tr><td><span class="badge ${a.severity}">${sevLabel[a.severity] || a.severity}</span></td><td>${a.device_id ? `<a href="#/pc/${esc(a.device_id)}">${esc(a.message)}</a>` : esc(a.message)}</td>
      ${S.me.clientId ? '' : `<td>${esc(a.client_name || 'â€”')}</td>`}<td class="small">${when(a.created_at)}</td><td class="small">${a.resolved_at ? 'Resolvido ' + when(a.resolved_at) : '<b>Aberto</b>'}</td>
      <td><div class="btns" style="gap:6px;flex-wrap:wrap">${!a.resolved_at ? acoesHtml(a) : ''}${!a.resolved_at && can('tecnico') ? `<button class="btn sm ghost" data-res="${a.id}" title="Some da lista sem fazer nada no PC">Marcar resolvido</button>` : ''}</div></td></tr>`).join('')}</tbody></table></div>`
      : '<div class="card"><p class="muted">Nenhum alerta. Tudo certo! âœ”</p></div>';
    $$('[data-res]', this.el).forEach((b) => { b.onclick = async () => { try { await POST(`/alerts/${b.dataset.res}/resolve`); this.refresh(); updateAlertBadge(); } catch (e) { fail(e); } }; });
    bindAcoes(this.el);
  },
};

// ================= CLIENTES =================
VIEWS.clientes = {
  async render(el) {
    this.el = el;
    setTitle('Clientes', can('admin') && !S.me.clientId ? '<button class="btn primary" id="newc">+ Novo cliente</button>' : '');
    if ($('#newc')) $('#newc').onclick = () => this.edit(null);
    await this.refresh();
  },
  async refresh() {
    await loadClients();
    const showCode = S.clients.some((c) => c.enrollCode);
    this.el.innerHTML = `<div class="table-wrap"><table><thead><tr><th>Cliente</th><th class="hide-sm">Contato</th><th>Computadores</th><th class="hide-sm">Janela de manutenÃ§Ã£o</th>${showCode ? '<th>CÃ³digo de cadastro do agente</th>' : ''}<th></th></tr></thead><tbody>
      ${S.clients.map((c) => `<tr><td><b>${esc(c.name)}</b>${c.document ? `<div class="muted small">${esc(c.document)}</div>` : ''}</td>
        <td class="hide-sm small">${esc(c.contactName || '')}<div class="muted">${esc(c.phone || '')} ${esc(c.email || '')}</div></td>
        <td><a href="#/computadores">${c.devices}</a> <span class="muted small">(${c.online} online)</span></td>
        <td class="hide-sm small">${esc(c.maintenanceWindow || 'Qualquer horÃ¡rio')}<div class="muted">ReinÃ­cio: ${esc({ perguntar: 'perguntar antes', agendar: 'sÃ³ agendado', automatico: 'automÃ¡tico' }[c.rebootPolicy] || c.rebootPolicy)}</div></td>
        ${showCode ? `<td>${c.enrollCode ? `<span class="code-box">${esc(c.enrollCode)} <button class="btn sm ghost" data-copy="${esc(c.enrollCode)}">Copiar</button></span>` : ''}</td>` : ''}
        <td><div class="btns">${can('tecnico') ? `<button class="btn sm" data-groups="${c.id}">Grupos</button>` : ''}<button class="btn sm" data-rep="${c.id}">RelatÃ³rio</button>
        ${can('admin') && !S.me.clientId ? `<button class="btn sm" data-edit="${c.id}">Editar</button><button class="btn sm" data-code="${c.id}">Novo cÃ³digo</button><button class="btn sm danger" data-del="${c.id}">Excluir</button>` : ''}</div></td></tr>`).join('')}
      </tbody></table></div>
      <p class="muted small">Cada cliente tem o prÃ³prio cÃ³digo de cadastro. O computador instalado com o cÃ³digo de um cliente fica automaticamente nesse cliente, e um cliente nunca enxerga os computadores de outro.</p>`;
    $$('[data-copy]', this.el).forEach((b) => { b.onclick = () => copy(b.dataset.copy); });
    $$('[data-edit]', this.el).forEach((b) => { b.onclick = () => this.edit(S.clients.find((c) => c.id === +b.dataset.edit)); });
    $$('[data-groups]', this.el).forEach((b) => { b.onclick = () => this.groups(S.clients.find((c) => c.id === +b.dataset.groups)); });
    $$('[data-rep]', this.el).forEach((b) => { b.onclick = () => { location.hash = '#/relatorios/' + b.dataset.rep; }; });
    $$('[data-code]', this.el).forEach((b) => { b.onclick = async () => { if (await confirmBox('Novo cÃ³digo de cadastro', 'Gerar um novo cÃ³digo? O cÃ³digo antigo deixa de funcionar para novas instalaÃ§Ãµes (os computadores jÃ¡ cadastrados continuam normais).', 'Gerar')) { try { await POST(`/clients/${b.dataset.code}/new-code`); this.refresh(); } catch (e) { fail(e); } } }; });
    $$('[data-del]', this.el).forEach((b) => { b.onclick = async () => { if (await confirmBox('Excluir cliente', 'Excluir este cliente?', 'Excluir', true)) { try { await api('DELETE', '/clients/' + b.dataset.del); this.refresh(); } catch (e) { fail(e); } } }; });
  },
  edit(c) {
    c = c || { rebootPolicy: 'perguntar' };
    const m = modal(c.id ? 'Editar cliente' : 'Novo cliente', `<form id="cf">
      <label>Nome / razÃ£o social *</label><input name="name" required value="${esc(c.name || '')}">
      <div class="row"><div><label>CNPJ / CPF</label><input name="document" value="${esc(c.document || '')}"></div><div><label>ResponsÃ¡vel</label><input name="contactName" value="${esc(c.contactName || '')}"></div></div>
      <div class="row"><div><label>Telefone / WhatsApp</label><input name="phone" value="${esc(c.phone || '')}"></div><div><label>E-mail</label><input name="email" value="${esc(c.email || '')}"></div></div>
      <div class="row"><div><label>HorÃ¡rio permitido para manutenÃ§Ã£o</label><input name="maintenanceWindow" placeholder="ex.: 22:00-06:00" value="${esc(c.maintenanceWindow || '')}"></div>
      <div><label>PolÃ­tica de reinÃ­cio</label><select name="rebootPolicy">${[['perguntar', 'Perguntar antes'], ['agendar', 'SÃ³ reinÃ­cio agendado'], ['automatico', 'AutomÃ¡tico com aviso']].map(([k, l]) => `<option value="${k}" ${c.rebootPolicy === k ? 'selected' : ''}>${l}</option>`).join('')}</select></div></div>
      <label>ObservaÃ§Ãµes / acordo com o cliente</label><textarea name="notes" style="min-height:80px;font-family:inherit">${esc(c.notes || '')}</textarea></form>`,
    { footer: '<button class="btn ghost" data-close>Cancelar</button><button class="btn primary" id="sv">Salvar</button>' });
    $('#sv', m).onclick = async () => {
      try { c.id ? await api('PATCH', '/clients/' + c.id, formData($('#cf', m))) : await POST('/clients', formData($('#cf', m))); m.close(); toast('Cliente salvo.', 'ok'); this.refresh(); } catch (e) { fail(e); }
    };
  },
  groups(c) {
    const m = modal(`Grupos, setores e departamentos Â· ${c.name}`, `<div id="gl"></div>
      <form id="gf" class="row" style="margin-top:14px" autocomplete="off"><input name="name" list="gsug" autocomplete="off" placeholder="Nome (ex.: Financeiro) ou escolha da lista" required maxlength="60"><datalist id="gsug">${SETORES.map((x) => `<option value="${esc(x)}">`).join('')}</datalist><select name="kind"><option value="setor">Setor</option><option value="departamento">Departamento</option><option value="grupo">Grupo</option></select><button class="btn primary" style="flex:0">Adicionar</button></form>
      <div style="margin-top:12px"><div class="muted small" style="margin-bottom:6px">Adicionar rÃ¡pido (clique para incluir como setor):</div><div id="gchips" style="display:flex;flex-wrap:wrap;gap:6px"></div></div>`);
    const add = async (body) => { await POST('/groups', { ...body, clientId: c.id }); };
    const draw = async () => {
      await loadClients();
      const gs = S.groups.filter((g) => g.client_id === c.id);
      $('#gl', m).innerHTML = gs.length ? gs.map((g) => `<div class="list-item"><div class="t"><b>${esc(g.name)}</b> <span class="badge">${esc(g.kind)}</span> <span class="muted small">${g.devices} PC(s)</span></div><button class="btn sm danger" data-gdel="${g.id}">Excluir</button></div>`).join('') : '<p class="muted">Nenhum grupo ainda.</p>';
      $$('[data-gdel]', m).forEach((b) => { b.onclick = async () => { try { await api('DELETE', '/groups/' + b.dataset.gdel); draw(); } catch (e) { fail(e); } }; });
      const tem = new Set(gs.map((g) => g.name.toLowerCase()));
      const livres = SETORES.filter((x) => !tem.has(x.toLowerCase()));
      $('#gchips', m).innerHTML = livres.length ? livres.map((x) => `<button type="button" class="btn sm ghost" data-gadd="${esc(x)}">+ ${esc(x)}</button>`).join('') : '<span class="muted small">Todos os setores da lista jÃ¡ foram adicionados.</span>';
      $$('[data-gadd]', m).forEach((b) => { b.onclick = async () => { b.disabled = true; try { await add({ name: b.dataset.gadd, kind: 'setor' }); draw(); } catch (e) { b.disabled = false; fail(e); } }; });
    };
    $('#gf', m).onsubmit = async (e) => { e.preventDefault(); try { await add(formData(e.target)); e.target.reset(); draw(); } catch (er) { fail(er); } };
    draw();
  },
};

// ================= EQUIPAMENTOS =================
const EQ_ICO = { computador: 'ðŸ–¥', notebook: 'ðŸ’»', servidor: 'ðŸ—„', switch: 'ðŸ”€', roteador: 'ðŸ“¡', access_point: 'ðŸ“¶', firewall: 'ðŸ›¡', modem: 'ðŸŒ',
  impressora: 'ðŸ–¨', camera: 'ðŸ“·', nvr: 'ðŸ“¼', nobreak: 'ðŸ”‹', telefone: 'â˜Ž', monitor: 'ðŸ–µ', celular: 'ðŸ“±', relogio_ponto: 'â±', catraca: 'ðŸšª', outro: 'ðŸ”§' };
const eqStatus = (st) => ({ online: '<span class="dot online"></span>Ligado', offline: '<span class="dot" style="background:var(--bad);box-shadow:0 0 8px var(--bad)"></span><b style="color:var(--bad)">Sem resposta</b>',
  revogado: '<span class="dot offline"></span>Revogado' }[st] || '<span class="dot"></span><span class="muted">NÃ£o monitorado</span>');
function garantiaTxt(g) {
  if (!g) return '';
  const dias = Math.round((new Date(g + 'T12:00:00') - new Date()) / 86400000);
  const br = g.split('-').reverse().join('/');
  return dias < 0 ? `<span class="muted">vencida (${br})</span>` : dias <= 60 ? `<span style="color:var(--warn)">atÃ© ${br}</span>` : `atÃ© ${br}`;
}
VIEWS.equipamentos = {
  async render(el) {
    this.el = el;
    await loadClients();
    setTitle('Equipamentos', can('tecnico') ? '<button class="btn primary" id="eqnovo">+ Novo equipamento</button>' : '');
    el.innerHTML = `<div class="toolbar">
      <input class="grow" id="eq-q" placeholder="Pesquisar nome, IP, MAC, marca, modelo, nÂº de sÃ©rie, patrimÃ´nio, local...">
      ${S.me.clientId ? '' : `<select id="eq-c">${clientOptions('')}</select>`}
      <select id="eq-t"><option value="">Todos os tipos</option></select>
      <select id="eq-s"><option value="">Todos</option><option value="online">Ligados</option><option value="offline">Sem resposta / offline</option><option value="garantia">Garantia vencendo (60 dias)</option></select>
      <label class="muted small" style="display:flex;gap:6px;align-items:center;flex:0 0 auto;white-space:nowrap;margin:0"><input type="checkbox" id="eq-pcs" checked style="width:auto;min-width:0;flex:0 0 auto;margin:0"> PCs com agente</label>
      <button class="btn" id="eq-csv">â¬‡ Planilha</button><button class="btn" id="eq-pdf">ðŸ–¨ Imprimir / PDF</button></div>
      <div id="eq-res" class="muted small" style="margin:-4px 0 10px"></div>
      <div class="table-wrap" id="eq-tw"></div>`;
    ['eq-q', 'eq-c', 'eq-t', 'eq-s', 'eq-pcs'].forEach((id) => { const i = $('#' + id, el); if (i) i.addEventListener('input', () => { clearTimeout(this.qt); this.qt = setTimeout(() => this.draw(), id === 'eq-q' ? 180 : 0); }); });
    if ($('#eqnovo')) $('#eqnovo').onclick = () => this.editar(null);
    $('#eq-csv', el).onclick = () => this.csv();
    $('#eq-pdf', el).onclick = () => this.imprimir();
    await this.refresh();
    const t = $('#eq-t', el);
    t.innerHTML = '<option value="">Todos os tipos</option>' + Object.entries(this.data.tipos).map(([k, v]) => `<option value="${k}">${EQ_ICO[k] || ''} ${esc(v)}</option>`).join('');
  },
  async refresh(type) {
    if (type && !['equip', 'device', 'alert'].includes(type)) return;
    if (type && $('.modal-bg')) return; // nÃ£o redesenha com um formulÃ¡rio aberto
    this.data = await GET('/equipamentos');
    this.draw();
  },
  lista() {
    const d = this.data;
    const pcs = $('#eq-pcs', this.el).checked ? d.pcs.map((p) => ({ ...p, pc: true, tipo: /notebook|laptop/i.test(p.modelo || '') ? 'notebook' : 'computador', status: p.status, groupName: p.group_name })) : [];
    return [...d.itens.map((e) => ({ ...e, status: e.monitorar ? e.status : 'nao' })), ...pcs];
  },
  filtrar() {
    const q = ($('#eq-q', this.el).value || '').toLowerCase(), c = $('#eq-c', this.el) ? $('#eq-c', this.el).value : '', t = $('#eq-t', this.el).value, st = $('#eq-s', this.el).value;
    return this.lista().filter((e) => (!c || String(e.client_id) === c) && (!t || e.tipo === t)
      && (!st || (st === 'garantia' ? e.garantia && (new Date(e.garantia + 'T12:00:00') - new Date()) / 86400000 <= 60 : st === 'online' ? e.status === 'online' : ['offline', 'revogado'].includes(e.status)))
      && (!q || [e.nome, e.hostname, e.ip, e.mac, e.marca, e.modelo, e.serie, e.patrimonio, e.local, e.responsavel, e.client_name, e.group_name, e.obs].join(' ').toLowerCase().includes(q)));
  },
  draw() {
    if (!this.data) return;
    const tipos = this.data.tipos;
    const l = this.filtrar();
    const off = l.filter((e) => e.status === 'offline').length;
    const cont = {}; l.forEach((e) => { cont[e.tipo] = (cont[e.tipo] || 0) + 1; });
    $('#eq-res', this.el).innerHTML = `<b>${l.length}</b> equipamento(s)${off ? ` Â· <b style="color:var(--bad)">${off} sem resposta</b>` : ''} Â· ${Object.entries(cont).sort((a, b) => b[1] - a[1]).map(([k, n]) => `${EQ_ICO[k] || ''} ${esc(tipos[k] || k)}: ${n}`).join(' Â· ')}`;
    $('#eq-tw', this.el).innerHTML = l.length ? `<table><thead><tr><th>Status</th><th>Equipamento</th>${S.me.clientId ? '' : '<th class="hide-sm">Cliente</th>'}<th class="hide-sm">Setor / local</th><th>IP</th>
      <th class="hide-sm">Marca / modelo</th><th class="hide-sm">NÂº de sÃ©rie</th><th class="hide-sm">Garantia</th></tr></thead><tbody>${l.slice(0, 1000).map((e) => `
      <tr class="click" ${e.pc ? `data-pc="${esc(e.id)}"` : `data-eq="${e.id}"`}>
        <td class="nw">${eqStatus(e.status)}${e.status === 'online' && e.latencia != null && !e.pc ? ` <span class="muted small">${esc(e.latencia)} ms</span>` : ''}</td>
        <td><b>${EQ_ICO[e.tipo] || ''} ${esc(e.nome || e.hostname || '')}</b><div class="muted small">${esc(tipos[e.tipo] || e.tipo)}${e.pc ? ' Â· com agente' : ''}${e.patrimonio ? ' Â· Pat. ' + esc(e.patrimonio) : ''}${e.monitor_nome ? ` Â· testado por ${esc(e.monitor_nome)}` : ''}</div></td>
        ${S.me.clientId ? '' : `<td class="hide-sm">${esc(e.client_name || 'â€”')}</td>`}
        <td class="hide-sm">${esc([e.group_name, e.local].filter(Boolean).join(' Â· ') || 'â€”')}</td>
        <td class="mono nw">${esc(e.ip || 'â€”')}${e.mac ? `<div class="muted small">${esc(e.mac)}</div>` : ''}</td>
        <td class="hide-sm">${esc([e.marca, e.modelo].filter(Boolean).join(' ') || 'â€”')}</td>
        <td class="hide-sm mono">${esc(e.serie || 'â€”')}</td>
        <td class="hide-sm nw">${garantiaTxt(e.garantia) || 'â€”'}</td></tr>`).join('')}</tbody></table>${l.length > 1000 ? '<p class="muted small">Mostrando 1000. Use a pesquisa para achar os outros.</p>' : ''}`
      : `<div class="empty card" style="padding:28px;text-align:center"><p>Nenhum equipamento${this.data.itens.length || this.data.pcs.length ? ' com esse filtro' : ''}.</p>${can('tecnico') ? '<p class="muted">Cadastre switch, roteador, impressora, cÃ¢mera, nobreak... Os PCs com agente aparecem aqui sozinhos.</p>' : ''}</div>`;
    $$('[data-pc]', this.el).forEach((tr) => { tr.onclick = () => { location.hash = '#/pc/' + tr.dataset.pc; }; });
    $$('[data-eq]', this.el).forEach((tr) => { tr.onclick = () => this.editar(this.data.itens.find((x) => x.id === Number(tr.dataset.eq))); });
  },
  editar(e) {
    const ro = !can('tecnico');
    const tipos = this.data.tipos;
    const cid = e ? e.client_id : (($('#eq-c', this.el) && $('#eq-c', this.el).value) || (S.clients[0] && S.clients[0].id));
    const v = (k) => esc(e && e[k] != null ? e[k] : '');
    const m = modal(e ? `${EQ_ICO[e.tipo] || ''} ${e.nome}` : 'Novo equipamento', `<form id="eqf" autocomplete="off">
      <div class="row">${S.me.clientId ? '' : `<div><label>Cliente</label><select name="clientId" ${e ? 'disabled' : ''}>${clientOptions(cid, false)}</select></div>`}
        <div><label>Tipo</label><select name="tipo">${Object.entries(tipos).filter(([k]) => k !== 'computador' || (e && e.tipo === k)).map(([k, t]) => `<option value="${k}" ${e && e.tipo === k ? 'selected' : ''}>${EQ_ICO[k] || ''} ${esc(t)}</option>`).join('')}</select></div></div>
      <div class="row"><div><label>Nome *</label><input name="nome" required maxlength="80" value="${v('nome')}" placeholder="ex.: Switch do rack, Impressora da recepÃ§Ã£o"></div>
        <div><label>PatrimÃ´nio</label><input name="patrimonio" maxlength="80" value="${v('patrimonio')}"></div></div>
      <div class="row"><div><label>Marca</label><input name="marca" maxlength="80" value="${v('marca')}" placeholder="ex.: TP-Link, Intelbras, HP"></div>
        <div><label>Modelo</label><input name="modelo" maxlength="80" value="${v('modelo')}"></div><div><label>NÂº de sÃ©rie</label><input name="serie" maxlength="80" value="${v('serie')}"></div></div>
      <div class="row"><div><label>IP ou nome na rede</label><input name="ip" maxlength="253" value="${v('ip')}" placeholder="192.168.0.1"></div>
        <div><label>MAC</label><input name="mac" maxlength="20" value="${v('mac')}" placeholder="AA:BB:CC:11:22:33"></div></div>
      <div class="row"><div><label>Setor</label><select name="groupId" id="eq-g"></select></div>
        <div><label>Local</label><input name="local" maxlength="80" value="${v('local')}" placeholder="ex.: Rack do 2Âº andar"></div><div><label>ResponsÃ¡vel</label><input name="responsavel" maxlength="80" value="${v('responsavel')}"></div></div>
      <div class="row"><div><label>Data da compra</label><input type="date" name="compra" value="${v('compra')}"></div><div><label>Garantia atÃ©</label><input type="date" name="garantia" value="${v('garantia')}"></div></div>
      <label>ObservaÃ§Ãµes</label><textarea name="obs" rows="3" maxlength="1000" placeholder="Senha de acesso NÃƒO: use o seu cofre de senhas. Aqui: portas, ramal, contrato...">${v('obs')}</textarea>
      <div class="card" style="margin-top:12px;padding:12px"><label style="color:var(--text);display:flex;gap:8px;align-items:center;margin:0"><input type="checkbox" name="monitorar" ${e && e.monitorar ? 'checked' : ''}> Avisar quando este equipamento parar de responder na rede</label>
        <div class="row" style="margin-top:8px"><div><label>Quem testa</label><select name="monitorPor" id="eq-mp"></select></div></div>
        <p class="muted small" style="margin:6px 0 0">A cada 1 minuto. Equipamento de outro lugar (cliente pela internet): escolha um PC com agente na mesma rede dele.</p>
        ${e && e.monitorar ? `<p class="small" style="margin:6px 0 0">SituaÃ§Ã£o: ${eqStatus(e.status)}${e.ultimo_online ? ` Â· respondeu por Ãºltimo em ${esc(dt(e.ultimo_online))}` : ''}</p>` : ''}</div>
    </form>`, { wide: true, footer: ro ? '<button class="btn ghost" data-close>Fechar</button>' : `${e ? '<button class="btn danger" id="eq-del" style="margin-right:auto">Excluir</button><button class="btn" id="eq-test">Testar agora</button>' : ''}<button class="btn ghost" data-close>Cancelar</button><button class="btn primary" id="eq-ok">Salvar</button>` });
    const f = $('#eqf', m);
    if (ro) $$('input,select,textarea', f).forEach((i) => { i.disabled = true; });
    const vinc = () => {
      const c = S.me.clientId || (f.clientId ? f.clientId.value : cid);
      $('#eq-g', m).innerHTML = groupOptions(c, e && e.group_id, false);
      const pcs = this.data.pcs.filter((p) => String(p.client_id) === String(c) && p.status !== 'revogado');
      $('#eq-mp', m).innerHTML = `<option value="">A Central (equipamento na rede desta Central)</option>${pcs.map((p) => `<option value="${esc(p.id)}" ${e && e.monitor_por === p.id ? 'selected' : ''}>PC ${esc(p.nome)}${p.status === 'online' ? '' : ' (desligado agora)'}</option>`).join('')}`;
    };
    vinc();
    if (f.clientId) f.clientId.onchange = vinc;
    if (ro) return;
    $('#eq-ok', m).onclick = async () => {
      if (!f.reportValidity()) return;
      const b = formData(f);
      try {
        if (e) await api('PATCH', '/equipamentos/' + e.id, b); else await POST('/equipamentos', b);
        m.close(); toast('Equipamento salvo.', 'ok'); this.refresh();
      } catch (er) { fail(er); }
    };
    if ($('#eq-test', m)) $('#eq-test', m).onclick = async (ev) => {
      const b = ev.target; b.disabled = true; b.textContent = 'Testando...';
      try { const r = await POST(`/equipamentos/${e.id}/testar`); toast(r.status === 'online' ? `Respondeu${r.latencia != null ? ` em ${r.latencia} ms` : ''}.` : 'NÃ£o respondeu.', r.status === 'online' ? 'ok' : 'err'); }
      catch (er) { fail(er); }
      b.disabled = false; b.textContent = 'Testar agora';
    };
    if ($('#eq-del', m)) $('#eq-del', m).onclick = async () => {
      if (!await confirmBox('Excluir', `Excluir "${esc(e.nome)}" do inventÃ¡rio?`, 'Excluir', true)) return;
      try { await api('DELETE', '/equipamentos/' + e.id); m.close(); toast('ExcluÃ­do.', 'ok'); this.refresh(); } catch (er) { fail(er); }
    };
  },
  // relatÃ³rio para imprimir ou "Salvar como PDF" (respeita a pesquisa e os filtros da tela)
  imprimir() {
    const tipos = this.data.tipos;
    const lista = this.filtrar().slice().sort((x, y) => String(x.client_name || '').localeCompare(String(y.client_name || ''), 'pt-BR')
      || String(tipos[x.tipo] || x.tipo).localeCompare(String(tipos[y.tipo] || y.tipo), 'pt-BR') || String(x.nome || x.hostname || '').localeCompare(String(y.nome || y.hostname || ''), 'pt-BR'));
    if (!lista.length) return toast('Nenhum equipamento na lista para imprimir.', 'err');
    const ST = { online: 'Ligado', offline: 'Sem resposta', revogado: 'Revogado' };
    const v = (x) => esc(x == null || x === '' ? 'â€”' : x);
    const dt = (x) => (x ? esc(String(x).slice(0, 10).split('-').reverse().join('/')) : 'â€”');
    const cSel = $('#eq-c', this.el), tSel = $('#eq-t', this.el), sSel = $('#eq-s', this.el), q = $('#eq-q', this.el).value.trim();
    const filtros = [
      cSel && cSel.value ? 'Cliente: ' + cSel.selectedOptions[0].textContent.trim() : (S.me.clientId ? '' : 'Todos os clientes'),
      tSel.value ? 'Tipo: ' + (tipos[tSel.value] || tSel.value) : '', sSel.value ? sSel.selectedOptions[0].textContent.trim() : '',
      q ? `Pesquisa: "${q}"` : '', $('#eq-pcs', this.el).checked ? '' : 'Sem os PCs com agente'].filter(Boolean).join(' Â· ');
    const porTipo = {};
    lista.forEach((e) => { const t = tipos[e.tipo] || e.tipo || 'Outro'; porTipo[t] = (porTipo[t] || 0) + 1; });
    const resumo = Object.entries(porTipo).sort((a, b) => b[1] - a[1]).map(([t, n]) => `<span>${esc(t)}: <b>${n}</b></span>`).join('');
    const linhas = lista.map((e) => `<tr>
      <td>${ST[e.status] ? `<span class="st ${esc(e.status)}">${ST[e.status]}</span>` : `<small>${e.monitorar ? 'Aguardando' : 'NÃ£o monitorado'}</small>`}</td>
      <td>${v(tipos[e.tipo] || e.tipo)}</td><td><b>${v(e.nome || e.hostname)}</b>${e.pc ? ' <small>(agente)</small>' : ''}</td>
      <td>${v(e.client_name)}</td><td>${v([e.group_name, e.local].filter(Boolean).join(' Â· '))}</td>
      <td class="mono">${v(e.ip)}</td><td class="mono">${v(e.mac)}</td><td>${v([e.marca, e.modelo].filter(Boolean).join(' '))}</td>
      <td class="mono">${v(e.serie)}</td><td>${v(e.patrimonio)}</td><td>${v(e.responsavel)}</td><td>${dt(e.garantia)}</td></tr>`).join('');
    const agora = new Date().toLocaleString('pt-BR');
    const html = `<!DOCTYPE html><html lang="pt-BR"><head><meta charset="utf-8"><title>InventÃ¡rio de equipamentos - ${esc(agora.slice(0, 10))}</title><style>
      @page { size: A4 landscape; margin: 12mm 10mm; }
      * { box-sizing: border-box; } body { font: 10px/1.35 "Segoe UI", Arial, sans-serif; color: #111; margin: 0; }
      header { display: flex; align-items: center; gap: 14px; border-bottom: 2px solid #0b5cff; padding-bottom: 8px; margin-bottom: 8px; }
      header img { height: 46px; } h1 { font-size: 17px; margin: 0; } .sub { color: #555; margin-top: 2px; }
      .resumo { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 6px 0 10px; color: #333; }
      table { width: 100%; border-collapse: collapse; } thead { display: table-header-group; } tr { page-break-inside: avoid; }
      th { background: #eef3ff; text-align: left; font-size: 9px; text-transform: uppercase; letter-spacing: .3px; padding: 5px 4px; border-bottom: 1px solid #b9c8ee; }
      td { padding: 4px; border-bottom: 1px solid #e3e3e3; vertical-align: top; word-break: break-word; } tr:nth-child(even) td { background: #fafafa; }
      .mono { font-family: Consolas, monospace; font-size: 9px; } small { color: #666; }
      .st { padding: 1px 5px; border-radius: 8px; font-size: 9px; white-space: nowrap; border: 1px solid #ccc; }
      .st.online { background: #e6f7ec; border-color: #9bd8b0; color: #116b34; } .st.offline { background: #fdeaea; border-color: #f0a7a7; color: #a11; }
      footer { margin-top: 10px; color: #777; font-size: 9px; display: flex; justify-content: space-between; }
      </style></head><body>
      <header><img src="/img/logo.png" alt=""><div><h1>InventÃ¡rio de equipamentos</h1>
      <div class="sub">${esc(filtros || 'Todos os equipamentos')} Â· ${lista.length} ${lista.length === 1 ? 'item' : 'itens'}</div></div></header>
      <div class="resumo">${resumo}</div>
      <table><thead><tr><th>Status</th><th>Tipo</th><th>Nome</th><th>Cliente</th><th>Setor / local</th><th>IP</th><th>MAC</th><th>Marca / modelo</th><th>NÂº de sÃ©rie</th><th>PatrimÃ´nio</th><th>ResponsÃ¡vel</th><th>Garantia</th></tr></thead>
      <tbody>${linhas}</tbody></table>
      <footer><span>Gerado pelo FND Remoto Â· FND Sistemas</span><span>${esc(agora)} Â· ${esc(S.me.name || S.me.username || '')}</span></footer>
      </body></html>`;
    // iframe escondido: imprime sÃ³ o relatÃ³rio (funciona tambÃ©m na janela do programa, sem abrir pop-up)
    const old = $('#eq-print'); if (old) old.remove();
    const f = document.createElement('iframe');
    f.id = 'eq-print'; f.setAttribute('aria-hidden', 'true');
    f.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0;visibility:hidden';
    f.onload = () => { try { f.contentWindow.focus(); f.contentWindow.print(); } catch (er) { fail(er); } setTimeout(() => f.remove(), 60000); };
    f.srcdoc = html;
    document.body.appendChild(f);
    toast('Na janela de impressÃ£o, escolha a impressora ou "Salvar como PDF".', 'ok');
  },
  // planilha (abre no Excel: separador ";" e acentos certos)
  csv() {
    const tipos = this.data.tipos;
    const cols = [['Status', (e) => ({ online: 'Ligado', offline: 'Sem resposta', revogado: 'Revogado' }[e.status] || 'NÃ£o monitorado')], ['Tipo', (e) => tipos[e.tipo] || e.tipo],
      ['Nome', (e) => e.nome || e.hostname], ['Cliente', (e) => e.client_name], ['Setor', (e) => e.group_name], ['Local', (e) => e.local], ['IP', (e) => e.ip], ['MAC', (e) => e.mac],
      ['Marca', (e) => e.marca], ['Modelo', (e) => e.modelo], ['NÂº de sÃ©rie', (e) => e.serie], ['PatrimÃ´nio', (e) => e.patrimonio], ['ResponsÃ¡vel', (e) => e.responsavel],
      ['Compra', (e) => e.compra], ['Garantia atÃ©', (e) => e.garantia], ['ObservaÃ§Ãµes', (e) => e.obs], ['Com agente', (e) => (e.pc ? 'Sim' : '')]];
    const cel = (x) => { let t = String(x == null ? '' : x).replace(/\r?\n/g, ' '); if (/^[=+\-@]/.test(t)) t = "'" + t; return /[";]/.test(t) ? `"${t.replace(/"/g, '""')}"` : t; };
    const linhas = [cols.map((c) => c[0]).join(';'), ...this.filtrar().map((e) => cols.map((c) => cel(c[1](e))).join(';'))];
    const blob = new Blob(['\ufeff' + linhas.join('\r\n')], { type: 'text/csv;charset=utf-8' });
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = `equipamentos_${new Date().toISOString().slice(0, 10)}.csv`; document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 5000);
  },
};

// setores e departamentos mais comuns (sugestÃµes ao criar grupos)
const SETORES = ['Administrativo', 'Financeiro', 'Contabilidade', 'RH', 'Departamento Pessoal', 'TI', 'Comercial', 'Vendas', 'Marketing', 'Compras', 'Estoque', 'Almoxarifado', 'LogÃ­stica', 'ExpediÃ§Ã£o', 'ProduÃ§Ã£o', 'Qualidade', 'ManutenÃ§Ã£o', 'Engenharia', 'JurÃ­dico', 'Diretoria', 'GerÃªncia', 'RecepÃ§Ã£o', 'Portaria', 'SeguranÃ§a', 'Atendimento', 'SAC', 'Faturamento', 'Caixa', 'Secretaria', 'Operacional'];

// ================= RELATÃ“RIOS =================
VIEWS.relatorios = {
  async render(el, clientId) {
    this.el = el;
    await loadClients();
    setTitle('RelatÃ³rios');
    const today = new Date().toISOString().slice(0, 10);
    const from = new Date(Date.now() - 30 * 86400000).toISOString().slice(0, 10);
    el.innerHTML = `<div class="toolbar no-print"><select id="rc">${clientOptions(clientId || (S.clients[0] && S.clients[0].id), false)}</select>
      <label class="muted small">De</label><input type="date" id="rf" value="${from}"><label class="muted small">AtÃ©</label><input type="date" id="rt" value="${today}">
      <button class="btn primary" id="rg">Gerar relatÃ³rio</button><button class="btn" id="rp">ðŸ–¨ Imprimir / salvar PDF</button></div><div id="rout"></div>`;
    $('#rg').onclick = () => this.gen();
    $('#rp').onclick = () => window.print();
    if (S.clients.length) this.gen();
  },
  async gen() {
    let r;
    try { r = await GET(`/reports/client/${$('#rc').value}?from=${$('#rf').value}&to=${$('#rt').value}`); } catch (e) { return fail(e); }
    const lab = (a) => r.actions[a] || a;
    const ok = r.tasks.filter((t) => t.status === 'concluida').length;
    $('#rout').innerHTML = `<div class="report">
      <div class="head"><img src="/img/logo.png" alt=""><div><h1 style="margin:0">RelatÃ³rio de manutenÃ§Ã£o</h1><div><b>${esc(r.client.name)}</b>${r.client.document ? ' Â· ' + esc(r.client.document) : ''}</div>
      <div class="small">PerÃ­odo: ${dt(r.from + ' 00:00').split(' ')[0]} a ${dt(r.to + ' 00:00').split(' ')[0]} Â· Gerado em ${dt(r.generatedAt)} Â· FND Sistemas</div></div></div>
      <h2>Resumo</h2><p>${r.devices.length} computador(es) gerenciado(s) Â· ${r.tasks.length} tarefa(s) no perÃ­odo (${ok} concluÃ­da(s)) Â· ${r.alerts.length} alerta(s) registrado(s)</p>
      <h2>Computadores</h2><table><thead><tr><th>Computador</th><th>Setor</th><th>Sistema</th><th>Processador / RAM</th><th>Armazenamento</th><th>AtualizaÃ§Ãµes pendentes</th></tr></thead><tbody>
      ${r.devices.map((d) => `<tr><td>${devName(d)}</td><td>${esc(d.groupName || 'â€”')}</td><td>${esc(d.os || 'â€”')}</td><td>${esc(d.cpu || '')} ${d.ramGB ? 'Â· ' + esc(d.ramGB) + ' GB' : ''}</td><td>${esc(d.storage || '')}</td><td>${d.updates}</td></tr>`).join('')}</tbody></table>
      <h2 style="margin-top:20px">ManutenÃ§Ãµes realizadas</h2>${r.tasks.length ? `<table><thead><tr><th>Data</th><th>Computador</th><th>ServiÃ§o</th><th>TÃ©cnico</th><th>Resultado</th></tr></thead><tbody>
      ${r.tasks.map((t) => `<tr><td>${dt(t.created_at)}</td><td>${devName(t)}</td><td>${esc(lab(t.action))}</td><td>${esc(t.created_by)}</td><td>${statusLabel[t.status]}</td></tr>`).join('')}</tbody></table>` : '<p>Nenhuma tarefa no perÃ­odo.</p>'}
      <h2 style="margin-top:20px">Alertas</h2>${r.alerts.length ? `<table><thead><tr><th>Data</th><th>Alerta</th><th>SituaÃ§Ã£o</th></tr></thead><tbody>
      ${r.alerts.map((a) => `<tr><td>${dt(a.created_at)}</td><td>${esc(a.message)}</td><td>${a.resolved_at ? 'Resolvido em ' + dt(a.resolved_at) : 'Aberto'}</td></tr>`).join('')}</tbody></table>` : '<p>Nenhum alerta no perÃ­odo.</p>'}
    </div>`;
  },
};

// ================= HISTÃ“RICO DE ATIVIDADES =================
VIEWS.atividades = {
  async render(el) {
    this.el = el; setTitle('HistÃ³rico de atividades');
    el.innerHTML = `<div class="toolbar"><input class="grow" id="aq" placeholder="Pesquisar no histÃ³rico...">${can('admin') && !S.me.clientId ? '<button class="btn" id="aver">ðŸ”’ Verificar integridade</button>' : ''}</div><div id="avr"></div><div id="al"></div>`;
    if ($('#aver')) $('#aver').onclick = async () => {
      try {
        const r = await GET('/audit/verify');
        $('#avr').innerHTML = r.ok ? `<div class="card" style="margin-bottom:12px"><span class="badge ok">Ãntegro</span> ${esc(r.checked)} registros conferidos: nenhum foi alterado ou apagado.${r.unsealed ? ` <span class="muted small">(${esc(r.unsealed)} registros antigos, de antes da v0.5, nÃ£o tÃªm selo.)</span>` : ''}</div>`
          : `<div class="card" style="margin-bottom:12px"><span class="badge bad">HistÃ³rico adulterado</span><ul>${r.problems.map((p) => `<li>${esc(p)}</li>`).join('')}</ul></div>`;
      } catch (e) { fail(e); }
    };
    let t; $('#aq').oninput = () => { clearTimeout(t); t = setTimeout(() => this.refresh(), 300); };
    await this.refresh();
  },
  async refresh() {
    this.limit = this.limit || 200;
    const rows = await GET(`/audit?limit=${this.limit}&q=` + encodeURIComponent($('#aq').value));
    $('#al').innerHTML = rows.length ? `<div class="table-wrap"><table><thead><tr><th>Quando</th><th>Quem</th><th>AÃ§Ã£o</th><th>Alvo</th><th class="hide-sm">Detalhes</th><th class="hide-sm">IP</th></tr></thead><tbody>
      ${rows.map((a) => `<tr><td class="small">${dt(a.ts)}</td><td>${esc(a.username)}</td><td>${esc(a.action)}</td><td>${esc(a.target)}</td><td class="hide-sm small"><span class="mono">${esc(String(a.details || '').slice(0, 160))}</span></td><td class="hide-sm small">${esc(a.ip)}</td></tr>`).join('')}</tbody></table></div>
      ${rows.length >= this.limit && this.limit < 2000 ? '<div class="btns" style="justify-content:center;margin:12px 0"><button class="btn" id="amore">Carregar registros mais antigos</button></div>' : ''}`
      : '<div class="card muted">Nada encontrado.</div>';
    if ($('#amore')) $('#amore').onclick = () => { this.limit = Math.min(this.limit + 300, 2000); this.refresh(); };
  },
};

// ================= MEUS INSTALADORES =================
const PRESETS = [
  ['', 'Escolha um tipo comum...'],
  ['/VERYSILENT /SUPPRESSMSGBOXES /NORESTART', 'Inno Setup (ex.: sistemas FND, muitos instaladores)'],
  ['/S', 'NSIS (Nullsoft)'],
  ['/quiet /norestart', 'Instaladores Microsoft / WiX (.exe)'],
  ['/s /v"/qn"', 'InstallShield'],
  ['--silent', 'Electron / Squirrel'],
];
VIEWS.instaladores = {
  async render(el) {
    this.el = el;
    setTitle('Meus instaladores');
    el.innerHTML = `${can('admin') ? `<div class="card" style="margin-bottom:16px"><h2>Adicionar instalador</h2>
      <p class="muted">Escolha um <b>.exe</b> ou <b>.msi</b> do seu computador (ou um <b>.zip de driver</b>, com os arquivos .inf, baixado do site oficial do fabricante). Ele fica guardado na Central e pode ser instalado em qualquer PC com o agente, em segundo plano.</p>
      <form id="upf"><div class="row"><div><label>Arquivo do instalador</label><input type="file" name="file" accept=".exe,.msi,.zip" required></div>
        <div><label>Nome (como aparece no painel)</label><input name="name" placeholder="ex.: FND Organiza 2.5"></div></div>
        <div class="row"><div><label>ParÃ¢metros de instalaÃ§Ã£o silenciosa</label><input name="args" placeholder="ex.: /VERYSILENT /SUPPRESSMSGBOXES /NORESTART"></div>
        <div><label>Tipo de instalador (preenche os parÃ¢metros)</label><select id="preset">${PRESETS.map(([v, l]) => `<option value="${esc(v)}">${esc(l)}</option>`).join('')}</select></div></div>
        <p class="muted small">Para <b>.msi</b> os parÃ¢metros <span class="mono">/qn /norestart</span> jÃ¡ sÃ£o usados automaticamente. Sem os parÃ¢metros certos, o instalador fica esperando um clique que ninguÃ©m vÃª e a tarefa termina por tempo.</p>
        <div id="upprog" class="hidden" style="margin:10px 0"><div class="bar"><i id="upbar" style="width:0%"></i></div><span class="muted small" id="uptxt"></span></div>
        <div class="btns" style="margin-top:10px"><button class="btn primary" id="upbtn">â¬† Enviar para a Central</button></div></form></div>` : ''}
      <div id="pl"></div>`;
    if ($('#upf')) {
      const f = $('#upf');
      $('#preset').onchange = (e) => { if (e.target.value) f.args.value = e.target.value; };
      f.file.onchange = () => { const fl = f.file.files[0]; if (fl && !f.name.value) f.name.value = fl.name.replace(/\.(exe|msi|zip)$/i, ''); };
      f.onsubmit = (e) => { e.preventDefault(); this.upload(f); };
    }
    await this.refresh();
  },
  upload(f) {
    const file = f.file.files[0];
    if (!file) return toast('Escolha o arquivo.', 'err');
    if (!/\.(exe|msi|zip)$/i.test(file.name)) return toast('Envie um arquivo .exe, .msi ou .zip de driver.', 'err');
    const xhr = new XMLHttpRequest();
    xhr.open('POST', '/api/packages');
    xhr.setRequestHeader('x-fnd', '1');
    xhr.setRequestHeader('content-type', 'application/octet-stream');
    xhr.setRequestHeader('x-arquivo', encodeURIComponent(file.name));
    xhr.setRequestHeader('x-nome', encodeURIComponent(f.name.value || ''));
    xhr.setRequestHeader('x-args', encodeURIComponent(f.args.value || ''));
    $('#upprog').classList.remove('hidden'); $('#upbtn').disabled = true;
    xhr.upload.onprogress = (e) => { if (e.lengthComputable) { const p = Math.round(e.loaded / e.total * 100); $('#upbar').style.width = p + '%'; $('#uptxt').textContent = `Enviando... ${p}% (${fmtSize(e.loaded)} de ${fmtSize(e.total)})`; } };
    xhr.onload = () => {
      $('#upbtn').disabled = false; $('#upprog').classList.add('hidden');
      let data = {}; try { data = JSON.parse(xhr.responseText); } catch { /* */ }
      if (xhr.status >= 200 && xhr.status < 300) { toast('Instalador adicionado Ã  biblioteca!', 'ok'); f.reset(); this.refresh(); }
      else toast(data.error || `Erro ${xhr.status}`, 'err');
    };
    xhr.onerror = () => { $('#upbtn').disabled = false; toast('Falha no envio.', 'err'); };
    xhr.send(file);
  },
  async refresh() {
    const rows = await GET('/packages');
    $('#pl', this.el).innerHTML = rows.length ? `<div class="table-wrap"><table><thead><tr><th>Programa</th><th>Arquivo</th><th>Tamanho</th><th class="hide-sm">ParÃ¢metros silenciosos</th><th class="hide-sm">Enviado</th><th></th></tr></thead><tbody>
      ${rows.map((p) => `<tr><td><b>${esc(p.name)}</b></td><td class="small">${esc(p.filename)}<div class="muted mono small" title="SHA-256 ${esc(p.sha256)}">${esc(p.sha256.slice(0, 16))}â€¦</div></td><td class="nw">${fmtSize(p.size)}</td>
        <td class="hide-sm mono small">${/\.zip$/i.test(p.filename) ? '<span class="badge">Driver (.inf)</span>' : esc(p.args || (/\.msi$/i.test(p.filename) ? '/qn /norestart' : 'â€”'))}</td><td class="hide-sm small">${esc(p.createdBy)}<div class="muted">${when(p.createdAt)}</div></td>
        <td><div class="btns"><button class="btn sm primary" data-inst="${p.id}">Instalar em...</button>${can('admin') ? `<button class="btn sm" data-edit="${p.id}">Editar</button><button class="btn sm danger" data-del="${p.id}">Excluir</button>` : ''}</div></td></tr>`).join('')}</tbody></table></div>`
      : '<div class="card muted">Nenhum instalador na biblioteca ainda.</div>';
    $$('[data-inst]', this.el).forEach((b) => { b.onclick = () => this.pickDevices(rows.find((p) => p.id === +b.dataset.inst)); });
    $$('[data-edit]', this.el).forEach((b) => { b.onclick = () => this.edit(rows.find((p) => p.id === +b.dataset.edit)); });
    $$('[data-del]', this.el).forEach((b) => { b.onclick = async () => { if (await confirmBox('Excluir instalador', 'Excluir este instalador da biblioteca?', 'Excluir', true)) { try { await api('DELETE', '/packages/' + b.dataset.del); this.refresh(); } catch (e) { fail(e); } } }; });
  },
  edit(p) {
    const m = modal('Editar instalador', `<form id="ef"><label>Nome</label><input name="name" value="${esc(p.name)}"><label>ParÃ¢metros de instalaÃ§Ã£o silenciosa</label><input name="args" value="${esc(p.args || '')}"><label>ObservaÃ§Ãµes</label><input name="notes" value="${esc(p.notes || '')}"></form>`,
      { footer: '<button class="btn ghost" data-close>Cancelar</button><button class="btn primary" id="sv">Salvar</button>' });
    $('#sv', m).onclick = async () => { try { await api('PATCH', '/packages/' + p.id, formData($('#ef', m))); m.close(); this.refresh(); } catch (e) { fail(e); } };
  },
  async pickDevices(p) {
    const devs = (await GET('/devices')).filter((d) => !d.revoked);
    const m = modal(`Instalar ${p.name}`, `<p class="muted">Escolha os computadores. Os que estiverem desligados instalam quando voltarem a ficar online.</p>
      <div class="toolbar"><input class="grow" id="pq" placeholder="Filtrar..."><label class="muted small"><input type="checkbox" id="pall"> Todos</label></div>
      <div class="table-wrap" style="max-height:45vh"><table><tbody>${devs.map((d) => `<tr data-row="${esc([d.alias, d.hostname, d.clientName, d.groupName].join(' ').toLowerCase())}"><td><input type="checkbox" value="${esc(d.id)}"></td><td><span class="dot ${d.status}"></span><b>${devName(d)}</b></td><td class="small muted">${esc(d.clientName || '')}${d.groupName ? ' Â· ' + esc(d.groupName) : ''}</td></tr>`).join('')}</tbody></table></div>`,
    { wide: true, footer: '<button class="btn ghost" data-close>Cancelar</button><button class="btn primary" id="go">Continuar</button>' });
    $('#pq', m).oninput = (e) => { const q = e.target.value.toLowerCase(); $$('tr[data-row]', m).forEach((tr) => tr.classList.toggle('hidden', !tr.dataset.row.includes(q))); };
    $('#pall', m).onchange = (e) => $$('tr[data-row]:not(.hidden) input', m).forEach((c) => { c.checked = e.target.checked; });
    $('#go', m).onclick = () => {
      const ids = $$('tr[data-row] input:checked', m).map((c) => c.value);
      if (!ids.length) return toast('Selecione ao menos um computador.', 'err');
      m.close(); taskDialog(ids, 'instalar_pacote', { pacote: p.id });
    };
  },
};

// ================= LICENÃ‡A =================
function licFaixa() {
  const L = S.me && S.me.licenca;
  if (!L) return '';
  const adm = S.me.role === 'admin' && !S.me.clientId;
  if (!L.liberado) return `<div class="card" id="licaviso" style="margin-bottom:14px;border-color:var(--bad);padding:10px 14px">ðŸ”’ <b>SÃ³ para consulta.</b> ${esc(L.mensagem || 'A licenÃ§a estÃ¡ inativa.')} ${adm ? '<a href="#/licenca" data-licplanos>Ativar / renovar</a>' : 'Fale com o administrador.'}</div>`;
  if (L.aviso) return `<div class="card" id="licaviso" style="margin-bottom:14px;border-color:var(--warn);padding:10px 14px">ðŸ”‘ ${esc(L.aviso)} ${adm ? '<a href="#/licenca" data-licplanos>Ver planos e ativar</a>' : ''}</div>`;
  return '';
}

function whatsLink(L, plano) {
  const v = L.venda || {};
  if (!v.whatsapp) return '';
  const txt = `${v.mensagem || 'OlÃ¡! Quero comprar o FND Remoto.'}\nPlano: ${plano ? ({ mensal: 'Mensal', anual: 'Anual', vitalicio: 'VitalÃ­cio' }[plano]) : 'a escolher'}\nCÃ³digo da mÃ¡quina: ${L.codigo}`;
  return `https://wa.me/${encodeURIComponent(v.whatsapp)}?text=${encodeURIComponent(txt)}`;
}
// planos com preÃ§o publicado; sem nenhum publicado, mostra os trÃªs como "consulte"
function planosVisiveis(v) {
  const ps = ['mensal', 'anual', 'vitalicio'].filter((p) => v.planos && v.planos[p]);
  return ps.length ? ps : ['mensal', 'anual', 'vitalicio'];
}
function licencaHtml(L) {
  if (L.somenteAdmin) return `<p>${esc(L.mensagem || 'LicenÃ§a ativa.')}</p>`;
  const v = L.venda || {};
  const nomes = { mensal: 'Mensal', anual: 'Anual', vitalicio: 'VitalÃ­cio' };
  const sit = {
    teste: `<span class="badge warn">Teste grÃ¡tis</span> falta(m) <b>${esc(L.diasRestantes)}</b> dia(s) (atÃ© ${esc(L.testeFimBR)})`,
    ativa: `<span class="badge ok">Ativa</span> plano <b>${esc(L.nomePlano)}</b>${L.venceBR ? ` atÃ© <b>${esc(L.venceBR)}</b>` : ' â€” sem vencimento'}`,
    tolerancia: `<span class="badge warn">Vencida</span> plano ${esc(L.nomePlano)} venceu em ${esc(L.venceBR)} (ainda dentro da tolerÃ¢ncia)`,
    vencida: `<span class="badge bad">Vencida</span> plano ${esc(L.nomePlano)} venceu em ${esc(L.venceBR)}`,
    teste_acabou: '<span class="badge bad">Teste encerrado</span>',
    relogio: '<span class="badge bad">RelÃ³gio atrasado</span>',
  }[L.status] || esc(L.status);
  return `<p>${sit}</p>${L.mensagem ? `<p>${esc(L.mensagem)}</p>` : ''}${L.aviso && L.status !== 'teste' ? `<p class="muted">${esc(L.aviso)}</p>` : ''}
    ${L.atualizacoesAteBR ? `<p class="muted small">AtualizaÃ§Ãµes incluÃ­das atÃ© ${esc(L.atualizacoesAteBR)}.</p>` : ''}
    <h3 style="margin-top:16px">CÃ³digo desta mÃ¡quina</h3>
    <div class="code-box" style="font-size:1.3em;letter-spacing:2px">${esc(L.codigo)} <button class="btn sm ghost" type="button" data-copy="${esc(L.codigo)}">Copiar</button></div>
    <p class="muted small">Envie este cÃ³digo para a FND Sistemas para receber a sua chave de ativaÃ§Ã£o.</p>
    <h3 style="margin-top:16px" id="licplanos">Planos</h3>
    <div class="grid g3">${planosVisiveis(v).map((p) => { const x = (v.planos && v.planos[p]) || {}; return `<button type="button" class="card plano" data-plano="${p}" style="padding:14px;text-align:left;cursor:pointer;color:inherit;font:inherit">
      <b>${esc(x.titulo || nomes[p])}</b><div style="font-size:1.35em;font-weight:700;margin:6px 0">${esc(x.preco || 'consulte')}</div>
      ${x.detalhe ? `<div class="muted small">${esc(x.detalhe)}</div>` : ''}<div class="btn sm primary" style="margin-top:10px;display:inline-block">${v.whatsapp ? 'Quero este plano' : 'Como comprar'}</div></button>`; }).join('')}</div>
    ${v.observacao ? `<p class="muted small">${esc(v.observacao)}</p>` : ''}
    <h3 style="margin-top:16px">Ativar</h3>
    <form id="licf"><label>Chave de ativaÃ§Ã£o</label><textarea name="chave" rows="3" spellcheck="false" placeholder="FND3..." style="font-family:monospace;min-height:80px"></textarea>
      <div class="btns" style="margin-top:8px"><button class="btn primary">Ativar</button></div></form>`;
}
function bindLicenca(box, depois, L) {
  $$('[data-copy]', box).forEach((b) => { b.onclick = () => copy(b.dataset.copy); });
  $$('[data-plano]', box).forEach((b) => { b.onclick = () => {
    const link = L && whatsLink(L, b.dataset.plano);
    if (link) { window.open(link, '_blank', 'noopener'); return; }
    const m = modal('Como comprar', `<p>Envie o <b>cÃ³digo desta mÃ¡quina</b> para a FND Sistemas e diga o plano escolhido. VocÃª recebe a chave de ativaÃ§Ã£o para colar aqui.</p>
      <div class="code-box" style="font-size:1.2em;letter-spacing:2px">${esc(L ? L.codigo : '')} <button class="btn sm ghost" type="button" data-copy="${esc(L ? L.codigo : '')}">Copiar</button></div>`);
    $$('[data-copy]', m).forEach((x) => { x.onclick = () => copy(x.dataset.copy); });
  }; });
  const f = $('#licf', box);
  if (f) f.onsubmit = async (e) => {
    e.preventDefault();
    const b = $('button.primary', f); b.disabled = true;
    try { const r = await POST('/licenca/ativar', { chave: f.chave.value }); toast(`LicenÃ§a ativada: plano ${r.nomePlano}${r.venceBR ? ' atÃ© ' + r.venceBR : ''}.`, 'ok'); depois(); }
    catch (er) { fail(er); b.disabled = false; }
  };
}
VIEWS.licenca = {
  async render(el) {
    setTitle('LicenÃ§a');
    const L = await GET('/licenca');
    el.innerHTML = `<div class="card" style="max-width:820px">${licencaHtml(L)}</div>`;
    bindLicenca(el, () => location.reload(), L);
    if (S.irPlanos) { S.irPlanos = false; const h = $('#licplanos', el); if (h) h.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
  },
};

// ================= BIBLIOTECA DE SCRIPTS =================
// escolher computadores (usado pelos scripts)
async function pickDevicesModal(title, onPick) {
  const devs = (await GET('/devices')).filter((d) => !d.revoked);
  const m = modal(title, `<p class="muted">Escolha os computadores. Os que estiverem desligados executam quando voltarem a ficar online.</p>
    <div class="toolbar"><input class="grow" id="pq" placeholder="Filtrar..."><label class="muted small"><input type="checkbox" id="pall"> Todos</label></div>
    <div class="table-wrap" style="max-height:45vh"><table><tbody>${devs.map((d) => `<tr data-row="${esc([d.alias, d.hostname, d.clientName, d.groupName].join(' ').toLowerCase())}"><td><input type="checkbox" value="${esc(d.id)}"></td><td><span class="dot ${d.status}"></span><b>${devName(d)}</b></td><td class="small muted">${esc(d.clientName || '')}${d.groupName ? ' Â· ' + esc(d.groupName) : ''}</td></tr>`).join('')}</tbody></table></div>`,
  { wide: true, footer: '<button class="btn ghost" data-close>Cancelar</button><button class="btn primary" id="go">Continuar</button>' });
  $('#pq', m).oninput = (e) => { const q = e.target.value.toLowerCase(); $$('tr[data-row]', m).forEach((tr) => tr.classList.toggle('hidden', !tr.dataset.row.includes(q))); };
  $('#pall', m).onchange = (e) => $$('tr[data-row]:not(.hidden) input', m).forEach((c) => { c.checked = e.target.checked; });
  $('#go', m).onclick = () => {
    const ids = $$('tr[data-row] input:checked', m).map((c) => c.value);
    if (!ids.length) return toast('Selecione ao menos um computador.', 'err');
    m.close(); onPick(ids);
  };
}

VIEWS.scripts = {
  async render(el) {
    this.el = el;
    setTitle('Biblioteca de scripts', '<button class="btn primary" id="nsc">+ Novo script</button>');
    el.innerHTML = `<p class="muted">Seus comandos PowerShell mais usados, prontos para rodar em um ou vÃ¡rios computadores com um clique. Rodam como <b>SYSTEM</b>, em segundo plano, sem janela para o usuÃ¡rio, e tudo fica no histÃ³rico. Os modelos podem ser editados ou apagados.</p>
      <div class="toolbar"><input class="grow" id="sq" placeholder="Pesquisar script..."></div><div id="sl"></div>`;
    $('#nsc').onclick = () => this.edit(null);
    $('#sq').oninput = () => this.draw();
    await this.refresh();
  },
  async refresh() { this.rows = await GET('/scripts'); this.draw(); },
  draw() {
    const q = ($('#sq').value || '').toLowerCase();
    const rows = this.rows.filter((r) => !q || `${r.name} ${r.description}`.toLowerCase().includes(q));
    $('#sl').innerHTML = rows.length ? `<div class="grid g2">${rows.map((r) => `<div class="card"><div style="display:flex;justify-content:space-between;gap:8px"><h3 style="margin:0">${esc(r.name)}</h3>${/modelo/.test(r.createdBy) ? '<span class="badge">modelo</span>' : ''}</div>
        <p class="muted small" style="min-height:2.4em">${esc(r.description || '')}</p>
        <div class="btns"><button class="btn sm primary" data-run="${r.id}">â–¶ Executar em...</button><button class="btn sm" data-ed="${r.id}">Ver / editar</button><button class="btn sm danger" data-del="${r.id}">Apagar</button></div></div>`).join('')}</div>`
      : '<div class="card muted">Nenhum script.</div>';
    const find = (id) => this.rows.find((r) => r.id === Number(id));
    $$('[data-run]', this.el).forEach((b) => { b.onclick = () => { const r = find(b.dataset.run); pickDevicesModal(`Executar: ${r.name}`, (ids) => taskDialog(ids, 'powershell', { script: r.script })); }; });
    $$('[data-ed]', this.el).forEach((b) => { b.onclick = () => this.edit(find(b.dataset.ed)); });
    $$('[data-del]', this.el).forEach((b) => { b.onclick = async () => { const r = find(b.dataset.del); if (await confirmBox('Apagar script', `Apagar <b>${esc(r.name)}</b> da biblioteca?`, 'Apagar', true)) { try { await api('DELETE', '/scripts/' + r.id); this.refresh(); } catch (e) { fail(e); } } }; });
  },
  edit(r) {
    const m = modal(r ? 'Editar script' : 'Novo script', `<form id="scf"><label>Nome</label><input name="name" required maxlength="100" value="${esc(r ? r.name : '')}">
      <label>Para que serve</label><input name="description" maxlength="500" value="${esc(r ? r.description : '')}">
      <label>Script PowerShell (roda como SYSTEM, sem janela)</label><textarea name="script" required spellcheck="false" style="min-height:300px">${esc(r ? r.script : '')}</textarea></form>`,
    { wide: true, footer: '<button class="btn ghost" data-close>Cancelar</button><button class="btn primary" id="scs">Salvar</button>' });
    $('#scs', m).onclick = async () => {
      const d = formData($('#scf', m));
      try { if (r) await api('PATCH', '/scripts/' + r.id, d); else await POST('/scripts', d); m.close(); toast('Script salvo.', 'ok'); this.refresh(); } catch (e) { fail(e); }
    };
  },
};

// ================= INSTALAR AGENTE =================
VIEWS.instalar = {
  async render(el) {
    setTitle('Instalar o agente nos computadores');
    await loadClients();
    let info = { ips: [], port: location.port || 443 };
    try { info = await GET('/info'); } catch { /* */ }
    const local = /^(localhost|127\.|\[?::1)/.test(location.hostname);
    const hostOnly = local && info.ips.length ? info.ips[0].ip : location.hostname;
    const host = local && info.ips.length ? `${info.ips[0].ip}:${info.port}` : location.host;
    const staff = can('tecnico') && !S.me.clientId;
    const optCli = S.clients.map((c) => `<option value="${c.id}">${esc(c.name)}</option>`).join('');
    const optGrp = (cid) => '<option value="">(sem setor)</option>' + S.groups.filter((g) => String(g.client_id) === String(cid)).map((g) => `<option value="${g.id}">${esc(g.name)}</option>`).join('');
    const topo = staff ? `<div class="grid g2" style="margin-bottom:16px"><div class="card"><h2>â¬‡ Instalador pronto (recomendado)</h2>
      <p>Baixe o instalador <b>jÃ¡ configurado</b> para o cliente: no computador Ã© sÃ³ <b>AvanÃ§ar, AvanÃ§ar, Concluir</b>, sem digitar cÃ³digo nem endereÃ§o.</p>
      <div class="toolbar" style="margin:10px 0"><select id="ip-c">${optCli}</select><select id="ip-g"></select><button class="btn primary" id="ip-b">â¬‡ Baixar instalador</button></div>
      <p class="muted small">Ele jÃ¡ leva o cÃ³digo do cliente, o setor, o nome e os IPs desta Central (e o FND Relay, se estiver ligado) e sÃ³ aceita esta Central (certificado conferido). Pode copiar para um pendrive e usar em vÃ¡rios PCs do mesmo cliente.</p></div>
      <div class="card"><h2>ðŸ” Procurar agentes na rede</h2>
      <p>Instalou o agente <b>sem cÃ³digo</b>? Ele fica aguardando aprovaÃ§Ã£o. Clique em Procurar e aprove aqui.</p>
      <label class="small">Outras faixas de IP (opcional, separadas por vÃ­rgula)</label>
      <div class="toolbar" style="margin:4px 0 8px"><input class="grow" id="pr-f" placeholder="ex.: 172.16.1.x, 192.168.10.0/24, 10.0.0.10-80" autocomplete="off"><button class="btn primary" id="pr-b">ðŸ” Procurar agora</button></div>
      <p class="muted small" id="pr-info">Procura sempre na rede desta Central. Computadores da mesma rede tambÃ©m aparecem sozinhos em atÃ© 1 minuto.</p></div></div>
      <div class="card" id="pr-card" style="margin-bottom:16px"><h2>Aguardando aprovaÃ§Ã£o</h2><div id="pr-lista"><p class="muted">Carregando...</p></div></div>` : '';
    el.innerHTML = topo + `<div class="grid g2"><div class="card"><h2>1. Baixe o instalador</h2>
      <p>Em cada computador da rede, abra no navegador:</p><div class="code-box">https://${esc(host)}/download <button class="btn sm ghost" data-copy="https://${esc(host)}/download">Copiar</button></div>
      <p class="muted small">O navegador vai avisar sobre o certificado: Ã© o certificado prÃ³prio da Central (rede local). Pode prosseguir.</p>
      ${info.ips.length > 1 ? `<p class="muted small">Outros endereÃ§os desta Central: ${info.ips.slice(1).map((x) => `<span class="mono">${esc(x.ip)}</span>`).join(', ')}</p>` : ''}
      <h2 style="margin-top:20px">2. Instale com o cÃ³digo do cliente</h2><p>Durante a instalaÃ§Ã£o, informe o <b>cÃ³digo de cadastro</b> do cliente:</p>
      ${S.clients.map((c) => `<div class="list-item"><div class="t"><b>${esc(c.name)}</b></div>${c.enrollCode ? `<span class="code-box">${esc(c.enrollCode)} <button class="btn sm ghost" data-copy="${esc(c.enrollCode)}">Copiar</button></span>` : ''}</div>`).join('')}
      <p class="muted small">O agente encontra esta Central sozinho na rede. Se ele nÃ£o achar (rede de empresa com vÃ¡rias sub-redes, Wi-Fi separado...), informe em "EndereÃ§o da Central" o <b>nome deste computador</b>: <span class="mono"><b>${esc(info.hostname || '')}</b></span> <button class="btn sm ghost" type="button" data-copy="${esc(info.hostname || '')}">Copiar</button> â€” ou o IP <b>${esc(hostOnly)}</b>. Pelo nome Ã© melhor: continua funcionando mesmo se o IP desta Central mudar.</p></div>
      <div class="card"><h2>InstalaÃ§Ã£o silenciosa (vÃ¡rios PCs)</h2><p class="muted">Para instalar sem perguntas (por script, GPO ou PowerShell remoto):</p>
      <pre>AgenteFND_Remoto_Setup.exe /S /CODIGO=${esc((S.clients[0] || {}).enrollCode || 'FND-XXXX-XXXX-XXXX-XXXX')}</pre>
      <p class="muted small">Opcional: <span class="mono">/CENTRAL=${esc(hostOnly)}</span> para fixar o endereÃ§o Â· <span class="mono">/SEMPOWERSHELL=1</span> para bloquear comandos PowerShell livres naquele computador.</p>
      <h2 style="margin-top:20px">O que o usuÃ¡rio vÃª</h2><p class="muted">O agente roda como serviÃ§o do Windows, sem janela. Ele aparece em "Aplicativos instalados" e em "ServiÃ§os" com o nome <b>Agente FND Remoto</b>, e pode ser removido pelo administrador do computador.</p></div></div>`;
    $$('[data-copy]', el).forEach((b) => { b.onclick = () => copy(b.dataset.copy); });
    if (!staff) return;
    const ic = $('#ip-c', el), ig = $('#ip-g', el);
    ig.innerHTML = optGrp(ic.value); ic.onchange = () => { ig.innerHTML = optGrp(ic.value); };
    $('#ip-b', el).onclick = () => {
      if (!ic.value) return toast('Cadastre um cliente primeiro.', 'err');
      const a = document.createElement('a'); a.href = `/api/agente/instalador?clientId=${encodeURIComponent(ic.value)}&groupId=${encodeURIComponent(ig.value)}`;
      document.body.appendChild(a); a.click(); a.remove();
      toast('Baixando o instalador jÃ¡ configurado...', 'ok');
    };
    this.el = el; this.optCli = optCli; this.optGrp = optGrp; this.escolhas = {}; this.assin = null; this.carregouFaixas = false;
    $('#pr-b', el).onclick = () => this.procurar();
    await this.lista();
    clearInterval(this.timer);
    this.timer = setInterval(() => { if (!document.body.contains(el)) return clearInterval(this.timer); this.lista(); }, 5000);
  },
  async procurar() {
    const b = $('#pr-b', this.el); b.disabled = true; b.textContent = 'Procurando...';
    const faixas = $('#pr-f', this.el).value.split(',').map((x) => x.trim()).filter(Boolean);
    try {
      const r = await POST('/procura', { faixas });
      $('#pr-info', this.el).textContent = `Procurado em ${r.enderecos} endereÃ§o(s) (${r.faixas.join(', ')}): ${r.achados} computador(es) aguardando.`;
      this.desenhar(r.itens);
    } catch (e) { fail(e); }
    b.disabled = false; b.textContent = 'ðŸ” Procurar agora';
  },
  async lista() {
    try {
      const r = await GET('/procura');
      const f = $('#pr-f', this.el);
      if (f && !f.value && !this.carregouFaixas) { f.value = (r.faixasExtras || []).join(', '); this.carregouFaixas = true; }
      this.desenhar(r.itens);
    } catch { /* */ }
  },
  desenhar(itens) {
    const box = $('#pr-lista', this.el); if (!box) return;
    // nÃ£o redesenha com o tÃ©cnico escolhendo o cliente/setor, nem se nada mudou
    const assin = JSON.stringify(itens.map((p) => [p.id, p.status, p.ip, p.user, p.convidado]));
    if (assin === this.assin && box.contains(document.activeElement)) return;
    if (assin === this.assin && box.firstChild) return;
    this.assin = assin;
    // guarda o cliente/setor que o tÃ©cnico jÃ¡ escolheu (a lista Ã© redesenhada a cada 5 s)
    $$('[data-prc]', box).forEach((x) => { this.escolhas[x.dataset.prc] = { c: x.value, g: ($(`[data-prg="${x.dataset.prc}"]`, box) || {}).value }; });
    if (!itens.length) { box.innerHTML = '<p class="muted">Nenhum computador aguardando. Instale o agente sem cÃ³digo e clique em Procurar.</p>'; return; }
    box.innerHTML = `<div class="table-wrap"><table><thead><tr><th>Computador</th><th>IP</th><th>UsuÃ¡rio</th><th>Windows</th><th>Visto</th><th>Cliente / setor</th><th></th></tr></thead><tbody>
      ${itens.map((p) => { const e = this.escolhas[p.id] || {}; return `<tr><td><b>${esc(p.host)}</b><div class="muted small">${esc(p.mac || '')} Â· agente ${esc(p.ver)}</div></td>
      <td class="mono">${esc(p.ip)}</td><td>${esc(p.user || 'â€”')}</td><td class="small">${esc(p.os)}</td><td class="small">${esc(new Date(p.visto).toLocaleTimeString('pt-BR'))}</td>
      <td>${p.status === 'cadastrado' ? '<span class="badge ok">Cadastrado âœ“</span>' : `<div class="btns"><select data-prc="${esc(p.id)}">${this.optCli}</select><select data-prg="${esc(p.id)}"></select></div>`}</td>
      <td>${p.status === 'cadastrado' ? '' : `<div class="btns"><button class="btn sm primary" data-pra="${esc(p.id)}">${p.convidado ? 'Aprovar de novo' : 'Aprovar'}</button><button class="btn sm ghost" data-pri="${esc(p.id)}">Ignorar</button></div>${p.convidado ? '<div class="muted small">Aprovado: cadastrando...</div>' : ''}`}</td></tr>`; }).join('')}</tbody></table></div>`;
    $$('[data-prc]', box).forEach((sel) => {
      const id = sel.dataset.prc, e = this.escolhas[id] || {}, g = $(`[data-prg="${id}"]`, box);
      if (e.c) sel.value = e.c;
      g.innerHTML = this.optGrp(sel.value); if (e.g) g.value = e.g;
      sel.onchange = () => { g.innerHTML = this.optGrp(sel.value); };
    });
    $$('[data-pra]', box).forEach((b) => { b.onclick = async () => {
      const id = b.dataset.pra; b.disabled = true;
      try {
        await POST(`/procura/${encodeURIComponent(id)}/aprovar`, { clientId: $(`[data-prc="${id}"]`, box).value, groupId: $(`[data-prg="${id}"]`, box).value });
        toast('Aprovado. Em alguns segundos o computador aparece em Computadores.', 'ok');
      } catch (e) { fail(e); }
      this.lista();
    }; });
    $$('[data-pri]', box).forEach((b) => { b.onclick = async () => { try { await POST(`/procura/${encodeURIComponent(b.dataset.pri)}/ignorar`); this.lista(); } catch (e) { fail(e); } }; });
  },
};

// ================= USUÃRIOS =================
VIEWS.usuarios = {
  async render(el) { this.el = el; setTitle('UsuÃ¡rios', '<button class="btn primary" id="nu">+ Novo usuÃ¡rio</button>'); $('#nu').onclick = () => this.edit(null); await loadClients(); await this.refresh(); },
  async refresh() {
    this.rows = await GET('/users');
    this.el.innerHTML = `<div class="table-wrap"><table><thead><tr><th>UsuÃ¡rio</th><th>Perfil</th><th>Acesso</th><th>2FA</th><th>Ãšltimo login</th><th>SituaÃ§Ã£o</th><th></th></tr></thead><tbody>
      ${this.rows.map((u) => `<tr><td><b>${esc(u.username)}</b><div class="muted small">${esc(u.name || '')}</div></td><td>${role(u.role)}</td><td>${u.client_name ? 'SÃ³ ' + esc(u.client_name) : 'Todos os clientes'}</td>
      <td>${u.totp_enabled ? '<span class="badge ok">Ativo</span>' : '<span class="badge">NÃ£o</span>'}</td><td class="small">${when(u.last_login)}</td><td>${u.active ? '<span class="badge ok">Ativo</span>' : '<span class="badge bad">Bloqueado</span>'}</td>
      <td><div class="btns"><button class="btn sm" data-ue="${u.id}">Editar</button>${u.username !== S.me.username ? `<button class="btn sm danger" data-ud="${u.id}">Excluir</button>` : ''}</div></td></tr>`).join('')}</tbody></table></div>
      <p class="muted small"><b>Administrador:</b> tudo, inclusive PowerShell livre e revogar PCs. <b>TÃ©cnico:</b> tarefas de manutenÃ§Ã£o do catÃ¡logo. <b>Somente leitura:</b> sÃ³ visualiza (ideal para dar acesso ao cliente, restrito Ã  empresa dele).</p>`;
    $$('[data-ue]', this.el).forEach((b) => { b.onclick = () => this.edit(this.rows.find((u) => u.id === +b.dataset.ue)); });
    $$('[data-ud]', this.el).forEach((b) => { b.onclick = async () => { if (await confirmBox('Excluir usuÃ¡rio', 'Excluir este usuÃ¡rio?', 'Excluir', true)) { try { await api('DELETE', '/users/' + b.dataset.ud); this.refresh(); } catch (e) { fail(e); } } }; });
  },
  edit(u) {
    const isNew = !u; u = u || { role: 'tecnico', active: 1 };
    const m = modal(isNew ? 'Novo usuÃ¡rio' : `Editar ${u.username}`, `<form id="uf">
      ${isNew ? '<label>UsuÃ¡rio *</label><input name="username" required>' : ''}
      <label>Nome</label><input name="name" value="${esc(u.name || '')}">
      <div class="row"><div><label>Perfil</label><select name="role">${['admin', 'tecnico', 'leitura'].map((r) => `<option value="${r}" ${u.role === r ? 'selected' : ''}>${role(r)}</option>`).join('')}</select></div>
      <div><label>Acesso</label><select name="clientId"><option value="">Todos os clientes</option>${S.clients.map((c) => `<option value="${c.id}" ${u.client_id === c.id ? 'selected' : ''}>SÃ³ ${esc(c.name)}</option>`).join('')}</select></div></div>
      <label>${isNew ? 'Senha *' : 'Nova senha (deixe em branco para manter)'}</label><input name="password" type="password" autocomplete="new-password" ${isNew ? 'required' : ''}>
      ${isNew ? '' : `<label><input type="checkbox" name="active" ${u.active ? 'checked' : ''}> UsuÃ¡rio ativo</label>${u.totp_enabled ? '<label><input type="checkbox" name="reset2fa"> Zerar 2FA (perdeu o celular)</label>' : ''}`}</form>`,
    { footer: '<button class="btn ghost" data-close>Cancelar</button><button class="btn primary" id="sv">Salvar</button>' });
    $('#sv', m).onclick = async () => {
      const d = formData($('#uf', m)); if (!d.password) delete d.password;
      try { isNew ? await POST('/users', d) : await api('PATCH', '/users/' + u.id, d); m.close(); toast('UsuÃ¡rio salvo.', 'ok'); this.refresh(); } catch (e) { fail(e); }
    };
  },
};

// ================= MINHA CONTA =================
VIEWS.conta = {
  async render(el) {
    setTitle('Minha conta');
    S.me = await GET('/me');
    el.innerHTML = `<div class="grid g2"><div class="card"><h2>Trocar senha</h2><form id="pw">
      <label>Senha atual</label><input type="password" name="current" required autocomplete="current-password">
      <label>Nova senha</label><input type="password" name="password" required autocomplete="new-password">
      <label>Repita a nova senha</label><input type="password" name="password2" required autocomplete="new-password">
      <div class="btns" style="margin-top:14px"><button class="btn primary">Salvar senha</button></div></form></div>
      <div class="card"><h2>VerificaÃ§Ã£o em duas etapas (2FA)</h2><div id="tfa"></div></div></div>`;
    $('#pw').onsubmit = async (e) => {
      e.preventDefault(); const d = formData(e.target);
      if (d.password !== d.password2) return toast('As senhas nÃ£o conferem.', 'err');
      try { await POST('/me/password', d); e.target.reset(); toast('Senha alterada.', 'ok'); } catch (er) { fail(er); }
    };
    this.draw2fa();
  },
  draw2fa() {
    const box = $('#tfa');
    if (S.me.totp) {
      box.innerHTML = '<p><span class="badge ok">Ativa</span> Seu login pede o cÃ³digo do aplicativo autenticador.</p><form id="dis"><label>Para desativar, digite sua senha</label><input type="password" name="password" required><div class="btns" style="margin-top:10px"><button class="btn danger">Desativar 2FA</button></div></form>';
      $('#dis').onsubmit = async (e) => { e.preventDefault(); try { await POST('/me/2fa/disable', formData(e.target)); S.me.totp = false; this.draw2fa(); } catch (er) { fail(er); } };
    } else {
      box.innerHTML = '<p class="muted">Protege o acesso mesmo se alguÃ©m descobrir sua senha. Use Google Authenticator, Microsoft Authenticator ou similar.</p><button class="btn primary" id="st">Ativar 2FA</button>';
      $('#st').onclick = async () => {
        try {
          const r = await POST('/me/2fa/start');
          box.innerHTML = `<p>1. Escaneie o QR Code no aplicativo autenticador:</p><img src="${esc(r.qr)}" alt="QR Code" style="background:#fff;padding:8px;border-radius:8px">
            <p class="muted small">Ou digite a chave: <span class="mono">${esc(r.secret)}</span></p><form id="en"><label>2. Digite o cÃ³digo de 6 dÃ­gitos</label><input name="code" inputmode="numeric" maxlength="6" required>
            <div class="btns" style="margin-top:10px"><button class="btn primary">Confirmar e ativar</button></div></form>`;
          $('#en').onsubmit = async (e) => { e.preventDefault(); try { await POST('/me/2fa/enable', formData(e.target)); S.me.totp = true; toast('2FA ativado!', 'ok'); this.draw2fa(); } catch (er) { fail(er); } };
        } catch (e) { fail(e); }
      };
    }
  },
};

// ================= CONFIGURAÃ‡Ã•ES =================
VIEWS.config = {
  async render(el) {
    setTitle('ConfiguraÃ§Ãµes');
    const s = await GET('/settings');
    el.innerHTML = `<div class="grid g2"><div class="card"><h2>Central</h2><form id="sf"><label>Nome exibido no painel</label><input name="name" value="${esc(s.name)}">
      <div class="btns" style="margin-top:12px"><button class="btn primary">Salvar</button></div></form>
      <dl class="kv" style="margin-top:18px"><dt>VersÃ£o da Central</dt><dd>${esc(s.version)}</dd><dt>VersÃ£o do agente</dt><dd>${esc(s.agentVersion)}</dd>
      <dt>Porta do painel/agentes</dt><dd>${s.port} (TCP, HTTPS)</dd><dt>Porta de descoberta</dt><dd>${s.discoveryPort} (UDP)</dd>
      <dt>Certificado (impressÃ£o digital)</dt><dd class="mono small">${esc(s.fingerprint)}</dd></dl>
      <h2 style="margin-top:22px">AtualizaÃ§Ã£o dos agentes</h2>
      <label style="color:var(--text)"><input type="checkbox" id="au" ${s.autoUpdate ? 'checked' : ''}> Atualizar os agentes automaticamente para a versÃ£o ${esc(s.agentVersion)}</label>
      <p class="muted small">Quando um agente mais antigo se conecta, ele baixa o instalador novo desta Central, confere o SHA-256 e se atualiza sozinho (mantÃ©m o cadastro). Funciona a partir dos agentes 0.2.0; os anteriores precisam ser reinstalados uma vez.${s.agentInstaller ? '' : ' <b>AtenÃ§Ã£o: o instalador do agente nÃ£o estÃ¡ na pasta downloads.</b>'}</p></div>
      <div class="card"><h2>Backup</h2><p>O banco de dados Ã© copiado automaticamente uma vez por dia (mantÃ©m os 14 mais recentes) na pasta <span class="mono">backup</span> dos dados da Central.</p>
      <p>Ãšltimo backup: <b>${s.lastBackup ? dt(s.lastBackup) : 'ainda nÃ£o feito'}</b></p><button class="btn primary" id="bk">Fazer backup agora</button>
      <h3 style="margin-top:18px">CÃ³pia extra (recomendado)</h3>
      <p class="muted small">Se o PC da Central der problema, o backup que fica nele se perde junto. Escolha outra pasta para receber uma cÃ³pia de cada backup: pendrive, HD externo ou uma pasta sincronizada do Google Drive/OneDrive (ex.: <span class="mono">E:\\Backup FND</span>).</p>
      <form id="bcf"><div class="row"><input name="backupCopyDir" value="${esc(s.backupCopyDir || '')}" placeholder="caminho completo da pasta (em branco = desligado)"><button class="btn" style="flex:0 0 auto">Salvar</button></div></form>
      ${s.backupCopyLast ? `<p class="small" style="margin-top:6px">${s.backupCopyLast.ok ? 'âœ”' : '<span style="color:var(--bad)">âœ–</span>'} ${esc(s.backupCopyLast.msg)} <span class="muted">(${esc(dt(s.backupCopyLast.at))})</span></p>` : ''}
      <h2 style="margin-top:22px">Instaladores disponÃ­veis</h2>${s.downloads.length ? `<ul>${s.downloads.map((f) => `<li><a href="/download/${encodeURIComponent(f)}">${esc(f)}</a></li>`).join('')}</ul>` : '<p class="muted">Nenhum instalador na pasta downloads.</p>'}</div></div>`;
    if (can('admin')) {
      el.insertAdjacentHTML('beforeend', `<div class="card" id="upcard" style="margin-top:16px"></div><div class="card" id="ntcard" style="margin-top:16px"></div><div class="card" id="rlcard" style="margin-top:16px"></div>
      <details class="card" id="netavanc" style="margin-top:16px"><summary style="cursor:pointer"><b>OpÃ§Ãµes avanÃ§adas</b> <span class="muted small">â€” acesso pela internet com porta aberta no roteador</span></summary>
        <p class="muted small" style="margin:10px 0 0"><b>Para que serve:</b> Ã© outro jeito de atender PCs fora da rede, sem passar pelo FND Relay: os agentes ligam <b>direto</b> na sua Central por uma porta aberta no roteador (UPnP ou "redirecionamento de porta").
        A tela fica um pouco mais rÃ¡pida e nÃ£o gasta a cota grÃ¡tis da Cloudflare. <b>SÃ³ use se vocÃª tem acesso ao roteador</b> da rede da Central e IP pÃºblico (sem CGNAT). Se vocÃª jÃ¡ usa o FND Relay, pode deixar desligado.</p>
        <div id="netcard" style="margin-top:12px"></div></details>`);
      this.atualizacao($('#upcard', el)); this.notify($('#ntcard', el)); this.relay($('#rlcard', el)); this.internet($('#netcard', el));
    }
    $('#sf').onsubmit = async (e) => { e.preventDefault(); try { await POST('/settings', formData(e.target)); toast('Salvo. Recarregue a pÃ¡gina para ver o novo nome.', 'ok'); } catch (er) { fail(er); } };
    $('#au').onchange = async (e) => { try { await POST('/settings', { autoUpdate: e.target.checked }); toast(e.target.checked ? 'AtualizaÃ§Ã£o automÃ¡tica ligada.' : 'AtualizaÃ§Ã£o automÃ¡tica desligada.', 'ok'); } catch (er) { fail(er); } };
    $('#bcf').onsubmit = async (e) => { e.preventDefault(); try { await POST('/settings', formData(e.target)); toast('Pasta da cÃ³pia extra salva. Vale a partir do prÃ³ximo backup.', 'ok'); } catch (er) { fail(er); } };
    $('#bk').onclick = async () => { try { const r = await POST('/backup'); toast('Backup criado: ' + r.name, 'ok'); VIEWS.config.render(el); } catch (e) { fail(e); } };
  },
  async atualizacao(box) {
    let st; try { st = await GET('/atualizacao'); } catch { box.remove(); return; }
    const MODO = { agora: 'instalar na hora', madrugada: 'instalar de madrugada (3h Ã s 5h)', avisar: 'sÃ³ avisar' };
    const disp = st.disponivel;
    box.innerHTML = `<div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><h2 style="margin:0">AtualizaÃ§Ã£o da Central pela internet</h2>${disp ? `<span class="badge warn">VersÃ£o ${esc(disp.versao)} disponÃ­vel</span>` : '<span class="badge ok">Em dia</span>'}</div>
      <p class="muted">A Central procura versÃ£o nova sozinha a cada 10 minutos (sÃ³ baixa â€” nada sai daqui). SÃ³ instala pacotes assinados pela FND Sistemas e nunca volta para uma versÃ£o mais velha. Na troca, o painel fica fora do ar por alguns segundos e os agentes se reconectam sozinhos. Se a versÃ£o nova nÃ£o subir, a Central volta para a anterior sozinha.</p>
      <dl class="kv"><dt>VersÃ£o instalada</dt><dd>${esc(st.versao)}</dd>
        <dt>Ãšltima verificaÃ§Ã£o</dt><dd>${st.verificado_em ? esc(dt(st.verificado_em)) : 'ainda nÃ£o verificou'}${st.erro ? ` <span style="color:var(--bad)">â€” ${esc(st.erro)}</span>` : ''}</dd>
        ${st.site ? `<dt>Publicada no site</dt><dd>${esc(st.site.versao)} <span class="muted">(${esc(MODO[st.site.modo] || st.site.modo)})</span></dd>` : ''}
        ${st.ultimaInstalacao ? `<dt>Ãšltima atualizaÃ§Ã£o</dt><dd>${esc(st.ultimaInstalacao.de)} â†’ ${esc(st.ultimaInstalacao.para)} <span class="muted">(${esc(dt(st.ultimaInstalacao.quando))}, ${esc(st.ultimaInstalacao.quem)})</span></dd>` : ''}
        ${st.voltou ? `<dt>Voltou versÃ£o</dt><dd style="color:var(--bad)">A ${esc(st.voltou.de)} nÃ£o subiu; voltou para a ${esc(st.voltou.para)} (${esc(dt(st.voltou.quando))})</dd>` : ''}</dl>
      <label>Quando tiver versÃ£o nova</label>
      <select id="uppref"><option value="auto">Seguir o que a FND escolheu ao publicar (recomendado)</option><option value="avisar">SÃ³ avisar aqui (eu clico em Instalar)</option><option value="desligado">NÃ£o procurar sozinho</option></select>
      <div class="btns" style="margin-top:12px"><button class="btn" id="upver">Procurar agora</button>${disp ? `<button class="btn primary" id="upinst">Instalar a versÃ£o ${esc(disp.versao)} agora</button>` : ''}</div>`;
    $('#uppref', box).value = st.pref;
    $('#uppref', box).onchange = async (e) => { try { await POST('/atualizacao/pref', { pref: e.target.value }); toast('PreferÃªncia salva.', 'ok'); } catch (er) { fail(er); } };
    $('#upver', box).onclick = async (e) => {
      e.target.disabled = true; e.target.textContent = 'Procurando...';
      try { const r = await POST('/atualizacao/verificar'); toast(r.erro ? r.erro : r.disponivel ? 'VersÃ£o ' + r.disponivel.versao + ' disponÃ­vel.' : 'A Central jÃ¡ estÃ¡ na versÃ£o mais nova.', r.erro ? 'err' : 'ok'); } catch (er) { fail(er); }
      this.atualizacao(box);
    };
    if (disp) $('#upinst', box).onclick = async (e) => {
      if (!confirm(`Instalar a versÃ£o ${disp.versao} da Central agora?\n\nO painel fica fora do ar por alguns segundos e volta sozinho.`)) return;
      e.target.disabled = true; e.target.textContent = 'Instalando...';
      try {
        await POST('/atualizacao/instalar'); toast('Instalada! A Central estÃ¡ reiniciando. A pÃ¡gina recarrega sozinha.', 'ok');
        const espera = async () => { try { const s = await GET('/atualizacao'); if (s.versao === disp.versao) return location.reload(); } catch { /* reiniciando */ } setTimeout(espera, 3000); };
        setTimeout(espera, 8000);
      } catch (er) { fail(er); e.target.disabled = false; e.target.textContent = 'Instalar agora'; }
    };
  },
  async notify(box) {
    let st; try { st = await GET('/notify'); } catch { box.remove(); return; }
    const on = st.channels.telegram || st.channels.email;
    const last = st.last ? Object.entries(st.last.result || {}).map(([k, v]) => `${k === 'telegram' ? 'Telegram' : 'E-mail'}: ${v === 'ok' ? 'âœ” enviado' : esc(v)}`).join(' Â· ') : '';
    box.innerHTML = `<div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><h2 style="margin:0">Avisos no Telegram e e-mail</h2>${on ? '<span class="badge ok">Ligado</span>' : '<span class="badge">Desligado</span>'}</div>
      <p class="muted">Receba no celular quando um PC ficar offline, o disco encher ou der sinal de falha, o antivÃ­rus desligar etc. VÃ¡rios alertas seguidos chegam juntos numa mensagem sÃ³ (no mÃ¡ximo 30 por hora).</p>
      <form id="ntf">
        <label>Avisar a partir de</label><select name="minLevel"><option value="critico">SÃ³ crÃ­ticos</option><option value="aviso">Avisos e crÃ­ticos (recomendado)</option><option value="info">Tudo, atÃ© informativos</option></select>
        <div class="grid g2" style="margin-top:12px"><div>
          <h3>Telegram ${st.channels.telegram ? '<span class="badge ok">configurado</span>' : ''}</h3>
          <p class="muted small">1) No Telegram, fale com <b>@BotFather</b>, envie <span class="mono">/newbot</span> e copie o token. 2) Mande um "oi" para o seu bot novo. 3) Cole o token aqui e clique em <b>Descobrir meu chat</b>.</p>
          <label>Token do bot</label><input name="tgToken" type="password" autocomplete="off" placeholder="${st.hasTgToken ? '(jÃ¡ salvo â€” deixe em branco para manter)' : '123456789:ABC...'}">
          <label>Chat</label><div class="row"><input name="tgChat" value="${esc(st.tgChat)}" placeholder="ex.: 123456789"><button class="btn" type="button" id="tgdisc" style="flex:0 0 auto">Descobrir meu chat</button></div>
          <div id="tgchats"></div>
          ${st.hasTgToken ? '<button class="btn sm ghost" type="button" id="tgclear" style="margin-top:6px">Remover Telegram</button>' : ''}
        </div><div>
          <h3>E-mail ${st.channels.email ? '<span class="badge ok">configurado</span>' : ''}</h3>
          <label style="color:var(--text)"><input type="checkbox" name="mailOn" ${st.mailOn ? 'checked' : ''}> Enviar por e-mail</label>
          <div class="row"><div><label>Servidor (SMTP)</label><input name="smtpHost" value="${esc(st.smtpHost)}" placeholder="smtp.gmail.com"></div>
            <div style="flex:0 0 90px"><label>Porta</label><input name="smtpPort" type="number" value="${esc(st.smtpPort)}"></div>
            <div style="flex:0 0 130px"><label>SeguranÃ§a</label><select name="smtpSecure"><option value="starttls">STARTTLS (587)</option><option value="tls">TLS (465)</option><option value="none">Nenhuma</option></select></div></div>
          <div class="row"><div><label>UsuÃ¡rio</label><input name="smtpUser" value="${esc(st.smtpUser)}" autocomplete="off"></div>
            <div><label>Senha</label><input name="smtpPass" type="password" autocomplete="new-password" placeholder="${st.hasSmtpPass ? '(jÃ¡ salva â€” deixe em branco para manter)' : ''}"></div></div>
          <div class="row"><div><label>Remetente</label><input name="smtpFrom" value="${esc(st.smtpFrom)}" placeholder="seuemail@gmail.com"></div>
            <div><label>Enviar para (vÃ­rgula separa)</label><input name="smtpTo" value="${esc(st.smtpTo)}"></div></div>
          <p class="muted small">Gmail: servidor <span class="mono">smtp.gmail.com</span>, porta 465 (TLS) ou 587 (STARTTLS) e uma <b>senha de app</b> (Conta Google â†’ SeguranÃ§a â†’ Senhas de app), nÃ£o a sua senha normal.</p>
        </div></div>
        <div class="btns" style="margin-top:12px"><button class="btn primary">Salvar</button><button class="btn" type="button" id="nttest">Enviar mensagem de teste</button></div>
      </form>
      ${last ? `<p class="muted small" style="margin-top:10px">Ãšltimo envio (${esc(dt(st.last.at))}): ${last}</p>` : ''}`;
    const f = $('#ntf', box);
    f.minLevel.value = st.minLevel; f.smtpSecure.value = st.smtpSecure;
    const save = async () => { const d = formData(f); d.mailOn = f.mailOn.checked; return POST('/notify', d); };
    f.onsubmit = async (e) => { e.preventDefault(); try { await save(); toast('Avisos salvos.', 'ok'); this.notify(box); } catch (er) { fail(er); } };
    $('#nttest', box).onclick = async (e) => {
      e.target.disabled = true; e.target.textContent = 'Enviando...';
      try { await save(); const r = await POST('/notify/test'); const bad = Object.entries(r).filter(([, v]) => v !== 'ok');
        if (bad.length) toast('Falhou: ' + bad.map(([k, v]) => `${k}: ${v}`).join(' | '), 'err'); else toast('Mensagem de teste enviada! Confira o celular/e-mail.', 'ok');
      } catch (er) { fail(er); }
      this.notify(box);
    };
    $('#tgdisc', box).onclick = async () => {
      try {
        const chats = await POST('/notify/chats', { tgToken: f.tgToken.value });
        $('#tgchats', box).innerHTML = chats.length ? `<p class="small">Escolha:</p>${chats.map((c) => `<button type="button" class="btn sm" data-chat="${esc(c.id)}">${esc(c.name)} (${esc(c.id)})</button>`).join(' ')}`
          : '<p class="muted small">Nenhuma conversa encontrada. Mande um "oi" para o seu bot no Telegram e tente de novo.</p>';
        $$('[data-chat]', box).forEach((b) => { b.onclick = () => { f.tgChat.value = b.dataset.chat; toast('Chat escolhido. Clique em Salvar.', 'ok'); }; });
      } catch (er) { fail(er); }
    };
    if ($('#tgclear', box)) $('#tgclear', box).onclick = async () => { try { await POST('/notify', { clearTg: true }); this.notify(box); } catch (er) { fail(er); } };
  },
  // FND Relay (Cloudflare): computadores fora da rede sem mexer em roteador
  async relay(box) {
    let st; try { st = await GET('/internet'); } catch { box.remove(); return; }
    const r = st.relay || {};
    const badge = !r.enabled ? '<span class="badge">Desligado</span>' : r.conectado ? '<span class="badge ok">Conectado</span>' : '<span class="badge erro">Sem conexÃ£o</span>';
    box.innerHTML = `<div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><h2 style="margin:0">FND Relay â€” internet sem mexer no roteador</h2>${badge}</div>
      <p class="muted">Atende computadores <b>em qualquer lugar</b> sem abrir porta em roteador nenhum: a Central e os agentes sÃ³ se ligam ao <b>seu</b> Relay na Cloudflare (grÃ¡tis, sem cartÃ£o). Tudo passa <b>criptografado de ponta a ponta</b>: nem a Cloudflare consegue ler ou mandar comandos.</p>
      <form id="rlf"><label style="color:var(--text)"><input type="checkbox" name="enabled" ${r.enabled ? 'checked' : ''}> Ligar o FND Relay</label>
        <div class="row"><div><label>EndereÃ§o do Relay</label><input name="url" value="${esc(r.url || '')}" placeholder="fnd-relay.seunome.workers.dev"></div>
        <div><label>Chave do Relay</label><input name="chave" type="password" autocomplete="off" placeholder="${r.temChave ? 'â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢ (jÃ¡ salva; preencha sÃ³ para trocar)' : 'cole a chave do PUBLICAR.bat'}"></div></div>
        <div class="btns" style="margin-top:10px"><button class="btn primary">Salvar e conectar</button></div></form>
      ${r.enabled ? `<dl class="kv" style="margin-top:14px">
        <dt>SituaÃ§Ã£o</dt><dd>${r.conectado ? 'Conectado ao Relay' + (r.desde ? ` desde ${esc(when(r.desde))}` : '') : esc(r.erro || 'Conectando...')}</dd>
        ${r.endereco ? `<dt>EndereÃ§o para os agentes</dt><dd class="mono" style="word-break:break-all">${esc(r.endereco)} <button class="btn sm ghost" data-copy="${esc(r.endereco)}">Copiar</button></dd>` : ''}
        <dt>PCs conectados pelo Relay</dt><dd>${esc(r.agentes || 0)}</dd>
        ${r.uso ? `<dt>Cota grÃ¡tis de hoje</dt><dd><span class="${r.uso.pct >= 80 ? 'erro' : ''}">${esc(r.uso.pct)}% usado</span> <span class="muted small">(${esc(r.uso.pedidos.toLocaleString('pt-BR'))} de ${esc(r.uso.cota.toLocaleString('pt-BR'))} pedidos Â· zera Ã s 21h)</span></dd>` : ''}</dl>
        <p class="muted small">PCs jÃ¡ cadastrados aprendem esse endereÃ§o sozinhos na prÃ³xima vez que conectarem (na rede ou pela internet) e passam a usar o Relay quando estiverem fora. Para um PC novo fora da rede: no instalador do agente, informe o cÃ³digo do cliente e cole o endereÃ§o acima em "EndereÃ§o da Central".</p>` : `
        <p class="muted small" style="margin-top:10px"><b>Como criar o seu Relay (uma vez sÃ³):</b> crie a conta grÃ¡tis em dash.cloudflare.com, abra a pasta <b>FND_Relay_Cloudflare</b> que veio com o FND Remoto e dÃª dois cliques em <b>PUBLICAR.bat</b>. No fim ele mostra o <b>endereÃ§o</b> e a <b>chave</b>: cole aqui e ligue.</p>`}`;
    $$('[data-copy]', box).forEach((b) => { b.onclick = () => copy(b.dataset.copy); });
    const f = $('#rlf', box);
    f.onsubmit = async (e) => {
      e.preventDefault();
      const b = $('button.primary', f); b.disabled = true; b.textContent = 'Conectando...';
      const body = { enabled: f.enabled.checked, url: f.url.value };
      if (f.chave.value.trim()) body.chave = f.chave.value.trim();
      try { await POST('/internet/relay', body); toast(body.enabled ? 'FND Relay salvo. Conectando...' : 'FND Relay desligado.', 'ok'); } catch (er) { fail(er); }
      setTimeout(() => this.relay(box), body.enabled ? 2500 : 0);
    };
  },
  async internet(box) {
    let st; try { st = await GET('/internet'); } catch { box.remove(); return; }
    if (st.enabled && $('#netavanc')) $('#netavanc').open = true; // ligado: jÃ¡ mostra aberto
    const badge = !st.enabled ? '<span class="badge">Desligado</span>' : st.error ? '<span class="badge erro">Erro</span>' : st.upnp.ok ? '<span class="badge ok">Funcionando</span>' : '<span class="badge warn">AtenÃ§Ã£o</span>';
    box.innerHTML = `<div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><h2 style="margin:0">Acesso pela internet com porta no roteador (alternativa)</h2>${badge}</div>
      <p class="muted">Para atender computadores <b>fora desta rede</b> (em outra casa ou empresa). Abre uma porta <b>sÃ³ para os agentes</b>: o painel, o login e o terminal continuam sÃ³ na rede local. O agente do cliente sÃ³ faz uma ligaÃ§Ã£o de saÃ­da: <b>nada muda no roteador do cliente</b>.</p>
      <p class="small" style="color:var(--warn)">âš  Use na Central da <b>sua</b> internet. Na rede de uma empresa, sÃ³ ligue com autorizaÃ§Ã£o do responsÃ¡vel pela rede.</p>
      <form id="netf"><label style="color:var(--text)"><input type="checkbox" name="enabled" ${st.enabled ? 'checked' : ''}> Ligar o acesso pela internet</label>
        <div class="row"><div><label>Porta (sÃ³ agentes)</label><input name="port" type="number" min="1024" max="65535" value="${esc(st.port)}"></div>
        <div><label>EndereÃ§o pÃºblico (opcional)</label><input name="manualHost" value="${esc(st.manualHost)}" placeholder="em branco = descobre sozinho pelo roteador"></div></div>
        <div class="btns" style="margin-top:10px"><button class="btn primary">Salvar e aplicar</button>${st.enabled ? '<button class="btn" type="button" id="netretry">â†» Tentar abrir a porta de novo</button>' : ''}</div></form>
      ${st.enabled ? `<dl class="kv" style="margin-top:14px">
        <dt>SituaÃ§Ã£o</dt><dd>${esc(st.error || st.upnp.message)}</dd>
        ${st.address ? `<dt>EndereÃ§o para os agentes</dt><dd class="mono">${esc(st.address)} <button class="btn sm ghost" data-copy="${esc(st.address)}">Copiar</button></dd>` : ''}
        <dt>PCs conectados pela internet</dt><dd>${esc(st.agentsViaInternet)}</dd></dl>
        <p class="muted small">Para um PC novo fora da rede: no instalador do agente, informe o cÃ³digo do cliente e, em "EndereÃ§o da Central", o endereÃ§o acima. PCs jÃ¡ cadastrados aprendem o endereÃ§o sozinhos na prÃ³xima vez que conectarem aqui na rede.</p>
        ${!st.upnp.ok && !st.error && !/CGNAT/.test(st.upnp.message) ? `<div class="card" style="margin-top:12px;padding:12px 14px"><b>Como resolver de graÃ§a (escolha um):</b>
          <ol style="margin:8px 0 0 18px;line-height:1.6">
            <li><b>Ligar o UPnP no roteador:</b> abra <span class="mono">http://${esc(st.rede && st.rede.roteador || '192.168.0.1')}</span> no navegador, entre com a senha do roteador (fica na etiqueta embaixo dele), procure <b>UPnP</b> (Ã s vezes em "Rede", "NAT" ou "AvanÃ§ado"), ligue e salve. Depois clique em <b>Tentar abrir a porta de novo</b>.</li>
            <li><b>Ou abrir a porta Ã  mÃ£o no roteador</b> ("Encaminhamento de portas", "Port Forwarding" ou "Servidor virtual"): porta externa <b>${esc(st.port)}</b>, porta interna <b>${esc(st.port)}</b>, protocolo <b>TCP</b>, IP do computador <b>${esc(st.rede && st.rede.pcs && st.rede.pcs[0] || 'deste PC')}</b>. Depois coloque o seu IP pÃºblico em "EndereÃ§o pÃºblico".</li>
          </ol>
          <p class="muted small" style="margin-top:8px">Se tiver dois aparelhos (modem da operadora + roteador Wi-Fi), a porta precisa ser aberta nos dois, ou o modem precisa estar em modo "bridge". Se o IP de internet do roteador comeÃ§ar com 100.64 a 100.127, a operadora usa CGNAT: aÃ­ Ã© preciso pedir um IP pÃºblico a ela.</p></div>` : ''}` : ''}`;
    $$('[data-copy]', box).forEach((b) => { b.onclick = () => copy(b.dataset.copy); });
    const f = $('#netf', box);
    f.onsubmit = async (e) => {
      e.preventDefault();
      const on = f.enabled.checked;
      if (on && !st.enabled && !(await confirmBox('Ligar acesso pela internet', `A Central vai pedir ao roteador desta rede para abrir a porta <b>${esc(f.port.value)}</b> sÃ³ para os agentes. O painel continua fechado para a internet.<br><br>Esta Ã© a <b>sua</b> rede (ou vocÃª tem autorizaÃ§Ã£o do responsÃ¡vel)?`, 'Sim, ligar'))) return;
      const b = $('button.primary', f); b.disabled = true; b.textContent = 'Aplicando...';
      try { await POST('/internet', { enabled: on, port: Number(f.port.value), manualHost: f.manualHost.value }); toast(on ? 'Acesso pela internet aplicado.' : 'Acesso pela internet desligado.', 'ok'); } catch (er) { fail(er); }
      this.internet(box);
    };
    if ($('#netretry', box)) $('#netretry', box).onclick = async (e) => { e.target.disabled = true; try { await POST('/internet', {}); } catch (er) { fail(er); } this.internet(box); };
  },
};

boot();
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
// FND SISTEMAS â€” CADASTRO DE USUÃRIOS (tela). Kit do painel FND Sistemas v2.2.
// Mostra UMA vez (por instalaÃ§Ã£o) a janela "Bem-vindo": Nome obrigatÃ³rio; contato, e-mail, empresa e
// cidade opcionais. O servidor (fnd-cadastro-servidor.js) guarda e envia para a planilha da FND.
// Uso:  FNDCadastro.iniciar({ endpoint: '/api/fnd/cadastro', sistema: 'FND Organiza',
//                             pronto: function () { return true; } /* quando a tela principal jÃ¡ estÃ¡ visÃ­vel */ });
// Use junto com o fnd-painel.js (a logo vem do CSS dele, classe "fndp-logo").
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
(function () {
  'use strict';
  var opc = { endpoint: '/api/fnd/cadastro', sistema: 'sistema', pronto: null };
  var CSS =
    '.fndc-fundo{position:fixed;inset:0;z-index:2147483000;background:rgba(5,10,20,.72);display:flex;align-items:center;justify-content:center;padding:16px;font-family:Segoe UI,system-ui,Arial,sans-serif}' +
    '.fndc-caixa{width:100%;max-width:440px;max-height:calc(100vh - 32px);overflow:auto;background:#0f172a;color:#e5e7eb;border:1px solid #1e3a5f;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.5);padding:24px}' +
    '.fndc-claro .fndc-caixa{background:#fff;color:#0f172a;border-color:#cbd5e1}' +
    '.fndc-topo{display:flex;align-items:center;gap:12px;margin-bottom:6px}.fndc-topo .fndp-logo{width:46px;height:46px;flex:none}' +
    '.fndc-caixa h2{margin:0;font-size:19px;line-height:1.25}.fndc-sub{margin:4px 0 16px;font-size:13.5px;opacity:.8;line-height:1.45}' +
    '.fndc-caixa label{display:block;font-size:12.5px;margin:10px 0 4px;opacity:.9}.fndc-caixa label b{color:#f87171;font-weight:600}' +
    '.fndc-caixa input{width:100%;box-sizing:border-box;padding:10px 12px;border-radius:9px;border:1px solid #334155;background:#0b1220;color:inherit;font-size:14px;outline:none}' +
    '.fndc-claro .fndc-caixa input{background:#f8fafc;border-color:#cbd5e1}.fndc-caixa input:focus{border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,.25)}' +
    '.fndc-duas{display:grid;grid-template-columns:1fr 1fr;gap:0 10px}@media(max-width:480px){.fndc-duas{grid-template-columns:1fr}}' +
    '.fndc-erro{color:#f87171;font-size:13px;min-height:18px;margin-top:10px}' +
    '.fndc-btn{width:100%;margin-top:6px;padding:12px;border:0;border-radius:10px;background:#16a34a;color:#fff;font-size:15px;font-weight:600;cursor:pointer}.fndc-btn:disabled{opacity:.6;cursor:default}' +
    '.fndc-lgpd{font-size:11.5px;opacity:.65;margin:10px 0 0;line-height:1.4;text-align:center}';

  function tema() {
    try {
      var m = getComputedStyle(document.body).backgroundColor.match(/\d+(\.\d+)?/g);
      if (m && m.length >= 3 && !(m.length > 3 && +m[3] === 0)) return (0.299 * m[0] + 0.587 * m[1] + 0.114 * m[2]) > 150 ? 'claro' : 'escuro';
    } catch (e) { }
    return 'escuro';
  }
  function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }

  function mostrar() {
    if (document.querySelector('.fndc-fundo')) return;
    if (!document.getElementById('fndc-css')) { var st = document.createElement('style'); st.id = 'fndc-css'; st.textContent = CSS; document.head.appendChild(st); }
    var f = document.createElement('div');
    f.className = 'fndc-fundo' + (tema() === 'claro' ? ' fndc-claro' : '');
    f.setAttribute('role', 'dialog'); f.setAttribute('aria-modal', 'true');
    f.innerHTML =
      '<form class="fndc-caixa" autocomplete="on" novalidate>' +
      '<div class="fndc-topo"><span class="fndp-logo"></span><h2>Bem-vindo ao ' + esc(opc.sistema) + '!</h2></div>' +
      '<p class="fndc-sub">Antes de comeÃ§ar, conte pra gente quem estÃ¡ usando. SÃ³ o nome Ã© obrigatÃ³rio.</p>' +
      '<label>Nome <b>*</b></label><input name="nome" maxlength="80" autocomplete="name" required>' +
      '<div class="fndc-duas"><div><label>NÃºmero de contato</label><input name="contato" maxlength="30" inputmode="tel" autocomplete="tel" placeholder="(11) 99999-9999"></div>' +
      '<div><label>E-mail</label><input name="email" maxlength="100" type="email" autocomplete="email"></div></div>' +
      '<div class="fndc-duas"><div><label>Empresa</label><input name="empresa" maxlength="80" autocomplete="organization"></div>' +
      '<div><label>Cidade</label><input name="cidade" maxlength="60" autocomplete="address-level2"></div></div>' +
      '<div class="fndc-erro" aria-live="polite"></div>' +
      '<button class="fndc-btn" type="submit">Continuar</button>' +
      '<p class="fndc-lgpd">Ao continuar, vocÃª concorda em enviar esses dados para a FND Sistemas, para suporte e novidades.</p>' +
      '</form>';
    document.body.appendChild(f);
    var form = f.querySelector('form'), erro = f.querySelector('.fndc-erro'), btn = f.querySelector('.fndc-btn');
    setTimeout(function () { try { form.nome.focus(); } catch (e) { } }, 50);
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var corpo = { nome: form.nome.value, contato: form.contato.value, email: form.email.value, empresa: form.empresa.value, cidade: form.cidade.value };
      if (corpo.nome.trim().length < 2) { erro.textContent = 'Informe o seu nome.'; form.nome.focus(); return; }
      btn.disabled = true; erro.textContent = '';
      fetch(opc.endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(corpo) })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok || r.status === 409, j: j }; }); })
        .then(function (r) { if (r.ok) { f.remove(); } else { erro.textContent = (r.j && r.j.erro) || 'NÃ£o consegui salvar. Tente de novo.'; btn.disabled = false; } })
        .catch(function () { erro.textContent = 'NÃ£o consegui salvar. Tente de novo.'; btn.disabled = false; });
    });
  }

  function iniciar(o) {
    for (var k in (o || {})) opc[k] = o[k];
    fetch(opc.endpoint, { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (d) {
      if (!d || !d.precisa) return;
      var n = 0;
      (function esperar() {   // sÃ³ mostra quando a tela principal do sistema jÃ¡ estÃ¡ aberta (depois do login)
        var ok = true; try { ok = !opc.pronto || !!opc.pronto(); } catch (e) { ok = false; }
        if (ok) return mostrar();
        if (++n < 3600) setTimeout(esperar, 1000);
      })();
    }).catch(function () { });
  }

  window.FNDCadastro = { iniciar: iniciar, mostrar: mostrar };
})();
// ============================================================================
//  FND Sistemas - painel de links (parte da TELA)  -  sem dependencias
//
//  Uso: <script src="fnd-painel.js"></script>
//       <script>FNDPainel.iniciar({ endpoint: '/api/fnd/links', botao: 'flutuante' });</script>
//
//  Opcoes:
//    botao: 'flutuante' (canto inferior direito)  ou  um seletor CSS onde colocar o botao (ex.: '#topo')
//    tema:  'escuro' (padrao), 'claro' ou 'auto' (segue o fundo da tela do sistema)
//  Extras:  FNDPainel.abrir()  -  abre o painel (ex.: num item de menu "Sobre")
//           classe "fndp-esconder" nos seus botoes/itens de menu: somem no plano vitalicio (servidor com oculto)
//           botao: false  -  nao cria botao; use <span class="fndp-logo"></span> num botao seu (a logo vem do CSS)
// ============================================================================
(function () {
  'use strict';
  var LOGO = 'data:image/png;base64,';
  var opc = { endpoint: '/api/fnd/links', botao: 'flutuante', tema: 'escuro' };
  var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
  var ok = function (u) { return /^https:\/\//i.test(String(u || '')); };

  var CSS = '' +
    '.fndp-btn{display:inline-flex;align-items:center;gap:7px;font:600 13px "Segoe UI",system-ui,sans-serif;padding:5px 13px 5px 5px;border-radius:22px;border:1px solid #1e3a8a;background:#0f1a33;color:#e7ebf3;cursor:pointer}' +
    '.fndp-btn:hover{background:#14244a;border-color:#2563eb}.fndp-btn img{width:24px;height:24px;border-radius:50%}' +
    '.fndp-flut{position:fixed;right:18px;bottom:18px;z-index:9998;box-shadow:0 6px 20px rgba(0,0,0,.35)}' +
    '.fndp-fundo{position:fixed;inset:0;background:rgba(3,6,14,.72);display:flex;align-items:center;justify-content:center;z-index:9999;font:14px/1.45 "Segoe UI",system-ui,sans-serif}' +
    '.fndp-caixa{background:#151c2e;color:#e7ebf3;border:1px solid #26314b;border-radius:14px;padding:20px 22px;width:min(760px,94vw);max-height:90vh;overflow:auto;box-shadow:0 20px 50px rgba(0,0,0,.5)}' +
    '.fndp-claro .fndp-caixa{background:#fff;color:#1d2433;border-color:#d9dee8}.fndp-claro .fndp-card{background:#f4f7fb;border-color:#d9dee8}.fndp-claro .fndp-sub{color:#5b6478}' +
    '.fndp-topo{display:flex;gap:14px;align-items:center;margin-bottom:14px}.fndp-topo img{width:58px;height:58px;border-radius:50%;box-shadow:0 0 18px rgba(37,99,235,.45)}' +
    '.fndp-topo h3{margin:0;font-size:17px}.fndp-sub{color:#8d97ae;font-size:12.5px}' +
    '.fndp-x{margin-left:auto;background:transparent;border:1px solid #26314b;color:inherit;border-radius:8px;padding:6px 12px;cursor:pointer;font:inherit}' +
    '.fndp-grade{display:grid;grid-template-columns:1fr 1fr;gap:10px}' +
    '.fndp-card{display:flex;flex-direction:column;align-items:flex-start;gap:2px;text-align:left;padding:12px 14px;border-radius:12px;background:#1b2439;border:1px solid #26314b;color:inherit;cursor:pointer;font:inherit}' +
    '.fndp-card:hover{border-color:#2563eb}.fndp-card .ic{font-size:20px}.fndp-card span{color:#8d97ae;font-size:12px}' +
    '.fndp-dest{grid-column:1/-1;flex-direction:row;align-items:center;gap:12px;background:linear-gradient(135deg,#0f2a44,#11251a);border-color:#1f4a31;color:#e7ebf3}' +
    '.fndp-dest .seta{margin-left:auto;color:#22c55e;font-weight:700}.fndp-dest .tx{display:flex;flex-direction:column}' +
    '.fndp-h{margin:18px 0 8px;font-size:13px}.fndp-sis{cursor:default}.fndp-sis p{margin:4px 0 8px;color:#8d97ae;font-size:12.5px}' +
    '.fndp-sis button{background:#16a34a;border:0;color:#fff;border-radius:8px;padding:6px 12px;cursor:pointer;font:600 12.5px "Segoe UI",sans-serif}' +
    '.fndp-logo{display:inline-block;width:20px;height:20px;border-radius:50%;vertical-align:middle;background:center/cover no-repeat}' +
    '@media(max-width:700px){.fndp-grade{grid-template-columns:1fr}}';

  // tema 'auto': segue a cor de fundo da tela do sistema (tema claro ou escuro escolhido pelo usuario)
  function temaAtual() {
    if (opc.tema !== 'auto') return opc.tema;
    try {
      var m = getComputedStyle(document.body).backgroundColor.match(/\d+(\.\d+)?/g);
      if (m && m.length >= 3 && !(m.length > 3 && +m[3] === 0)) return (0.299 * m[0] + 0.587 * m[1] + 0.114 * m[2]) > 150 ? 'claro' : 'escuro';
    } catch (e) { }
    return 'escuro';
  }

  function abrirLink(u) { if (ok(u)) window.open(u, '_blank', 'noopener'); }

  var abrindo = false;
  function abrir() {
    if (abrindo || document.querySelector('.fndp-fundo')) return;
    abrindo = true;
    fetch(opc.endpoint, { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (d) {
      if (d && d.oculto) { esconder(); return; }   // plano vitalicio: sem painel
      var f = document.createElement('div');
      f.className = 'fndp-fundo' + (temaAtual() === 'claro' ? ' fndp-claro' : '');
      var dst = d.destaque;
      f.innerHTML = '<div class="fndp-caixa"><div class="fndp-topo"><img src="' + LOGO + '" alt=""><div><h3>ConheÃ§a a FND Sistemas</h3><span class="fndp-sub">Sistemas, tutoriais e novidades</span></div><button class="fndp-x">Fechar</button></div>' +
        '<div class="fndp-grade">' +
        (dst ? '<button class="fndp-card fndp-dest" data-u="' + esc(dst.link) + '"><span class="ic">ðŸ”—</span><span class="tx"><b>' + esc(dst.titulo) + '</b><span>' + esc(dst.descricao) + (dst.texto ? ' Â· ' + esc(dst.texto) : '') + '</span></span><span class="seta">Abrir â†’</span></button>' : '') +
        (d.links || []).map(function (l) { return '<button class="fndp-card" data-u="' + esc(l.link) + '"><span class="ic">' + esc(l.icone) + '</span><b>' + esc(l.titulo) + '</b>' + (l.texto ? '<span>' + esc(l.texto) + '</span>' : '') + '<span>' + esc(l.descricao) + '</span></button>'; }).join('') +
        '</div>' +
        ((d.sistemas || []).length ? '<h4 class="fndp-h">Outros sistemas da FND</h4><div class="fndp-grade">' + d.sistemas.map(function (s) { return '<div class="fndp-card fndp-sis"><b>' + esc(s.nome) + '</b><p>' + esc(s.descricao) + '</p>' + (s.link ? '<button data-u="' + esc(s.link) + '">' + esc(s.botao) + '</button>' : '') + '</div>'; }).join('') + '</div>' : '') +
        (d.mensagem ? '<p class="fndp-sub" style="text-align:center;margin:14px 0 0">' + esc(d.mensagem) + '</p>' : '') + '</div>';
      f.addEventListener('click', function (e) {
        if (e.target === f || e.target.classList.contains('fndp-x')) { f.remove(); return; }
        var b = e.target.closest('[data-u]'); if (b) abrirLink(b.getAttribute('data-u'));
      });
      document.addEventListener('keydown', function esc(e) { if (e.key === 'Escape') { f.remove(); document.removeEventListener('keydown', esc); } });
      document.body.appendChild(f);
    }).catch(function () { abrirLink('https://linktr.ee/fndsistemas'); }).then(function () { abrindo = false; });
  }

  // Plano vitalicio (v2.1): o servidor responde { oculto: true } e tudo que tem a classe "fndp-esconder"
  // (o botao do kit e os seus itens de menu) some. Enquanto confere (alguns ms), esses itens ficam escondidos.
  function esconder() { var h = document.documentElement; h.classList.remove('fndp-ok'); h.classList.add('fndp-oculto'); }
  function conferir() {
    fetch(opc.endpoint, { cache: 'no-store' }).then(function (r) { return r.json(); })
      .then(function (d) { if (d && d.oculto) esconder(); else document.documentElement.classList.add('fndp-ok'); })
      .catch(function () { document.documentElement.classList.add('fndp-ok'); });
  }

  function iniciar(o) {
    for (var k in (o || {})) opc[k] = o[k];
    if (!document.getElementById('fndp-css')) { var st = document.createElement('style'); st.id = 'fndp-css'; st.textContent = CSS + '.fndp-logo{background-image:url(' + LOGO + ')}html:not(.fndp-ok) .fndp-esconder{display:none!important}'; document.head.appendChild(st); }
    conferir();
    if (opc.botao === false) return;
    var b = document.createElement('button');
    b.type = 'button'; b.className = 'fndp-btn fndp-esconder'; b.title = 'ConheÃ§a a FND Sistemas';
    b.innerHTML = '<img src="' + LOGO + '" alt=""> FND Sistemas';
    b.onclick = abrir;
    var alvo = opc.botao !== 'flutuante' && document.querySelector(opc.botao);
    if (alvo) alvo.appendChild(b); else { b.classList.add('fndp-flut'); document.body.appendChild(b); }
  }

  window.FNDPainel = { iniciar: iniciar, abrir: abrir };
})();
