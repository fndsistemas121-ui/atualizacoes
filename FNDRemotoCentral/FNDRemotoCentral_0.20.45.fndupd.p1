  for (const g of box.querySelectorAll('.grafico')) {
    const rc = g.getBoundingClientRect();
    if (GRAF_ULT.x >= rc.left && GRAF_ULT.x <= rc.right && GRAF_ULT.y >= rc.top && GRAF_ULT.y <= rc.bottom) grafMover({ target: g, clientX: GRAF_ULT.x, clientY: GRAF_ULT.y });
