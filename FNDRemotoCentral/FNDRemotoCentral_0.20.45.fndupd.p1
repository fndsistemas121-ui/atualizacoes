    ${explica ? `<p class="small" style="margin:6px 0 0">${explica}</p>` : ''}
    <dl class="kv" style="margin-top:10px">
      ${real ? `${real.nucleoMax != null ? `<dt>Parte mais quente do processador</dt><dd>${Math.round(real.nucleoMax)} Â°C</dd>` : ''}
      ${a.tempPlaca != null && !a.placaParada ? `<dt>Placa-mÃ£e</dt><dd>${Math.round(a.tempPlaca)} Â°C</dd>` : ''}` : ''}
      <dt>Processador agora</dt><dd>${usoTxt}</dd>
      <dt>Velocidade</dt><dd>${vel}</dd>
      <dt>Plano de energia do Windows</dt><dd>${esc(a.planoNome || 'â€”')}</dd>
      <dt title="O modo fresco limita o processador para ele esquentar menos">NÃ­vel do processador</dt><dd>${limTxt}</dd></dl>
    ${a.placaParada && !real ? '' : termicoGrafico(termicoPontos(r, a.fonte), lim, a.fonte === 'cpu' ? 'Processador nas Ãºltimas 24 horas' : 'Temperatura nas Ãºltimas 24 horas')}
    ${tec && a.limiteAc != null ? `<div class="muted small" style="margin:12px 0 4px">NÃ­vel do processador (clique para mudar):</div>${niveisHtml}` : ''}
    ${tec ? `<div class="btns" style="margin-top:10px;flex-wrap:wrap">
      ${!real && (!a.driver || ['sem_driver', 'indisponivel'].includes(a.driver)) && S.actionMap.temp_driver_instalar ? '<button class="btn sm primary" data-term="driver" title="Instala o driver PawnIO para ler o sensor de dentro do processador">ðŸ”§ Ativar leitura real</button>' : ''}
      ${a.plano && a.plano !== '381b4222-f694-41f0-9685-ff5bb260df2e' ? '<button class="btn sm ghost" data-term="eq">Plano Equilibrado</button>' : ''}
      <button class="btn sm ghost" data-term="ler" title="LÃª a temperatura agora">â†» Ler agora</button>
      ${real && S.actionMap.temp_driver_remover ? '<button class="btn sm ghost" data-term="semdriver" title="Remove o driver PawnIO (sÃ³ se foi o FND que instalou)">Remover driver</button>' : ''}</div>` : ''}
    <p class="muted small" style="margin-top:10px">O programa sÃ³ ajuda a CPU a esquentar menos. Se esquenta sempre: limpar a poeira do cooler e das saÃ­das de ar, trocar a pasta tÃ©rmica (resseca em 3 a 5 anos) e nÃ£o usar notebook em cima de cama ou almofada.</p>`}`;
  grafReaplicar(box); // o "ao vivo" redesenha a cada segundos: a caixinha continua onde o mouse estÃ¡
  $$('[data-term-tarefa]', box).forEach((l) => { l.onclick = (e) => { e.preventDefault(); openTask(Number(l.dataset.termTarefa)); }; });
  $$('[data-term]', box).forEach((b) => { b.onclick = async () => {
    const v = b.dataset.term;
    if (v === 'eq') return quickTask(d.id, 'plano_equilibrado');
    if (v === 'ler') return quickTask(d.id, 'termico');
    if (v === 'driver') {
      if (!(await confirmBox('Ativar leitura real da temperatura', `Instala no PC o <b>driver PawnIO</b> (gratuito e assinado, o mesmo usado pelo LibreHardwareMonitor e pelo FanControl). Com ele o painel mostra a temperatura de <b>dentro do processador</b>, igual ao HWMonitor.<br><br>
        â€¢ NÃ£o precisa reiniciar e o usuÃ¡rio nÃ£o vÃª nada.<br>â€¢ O driver sÃ³ deixa <b>ler</b> os sensores.<br>
        â€¢ <b>AtenÃ§Ã£o:</b> alguns jogos online com anti-cheat (ex.: Valorant, FACEIT) podem reclamar desse tipo de driver. Em PC de jogo, prefira nÃ£o ativar.`, 'Ativar'))) return;
      return quickTask(d.id, 'temp_driver_instalar');
    }
    if (v === 'semdriver') {
      if (!(await confirmBox('Remover o driver de temperatura', 'Remove o driver PawnIO deste PC (sÃ³ se foi o FND que instalou; se outro programa usa, ele fica). O painel volta a mostrar sÃ³ o sensor da placa-mÃ£e.', 'Remover'))) return;
      return quickTask(d.id, 'temp_driver_remover');
    }
    quickTask(d.id, 'cpu_limite', { limite: v });
  }; });
}

// ðŸ“ escolher um disco ou pasta do PC (navega pelo agente; sÃ³ pastas). Devolve o caminho ou null.
function escolherPasta(d, inicial, titulo, dica) {
  if (!d.central && d.status !== 'online') { toast('O PC precisa estar online para procurar as pastas dele. VocÃª pode digitar o caminho.', 'err'); return Promise.resolve(null); }
  return new Promise((resolve) => {
    const m = modal(titulo, `<p class="muted small" style="margin-top:0">${esc(dica)}</p><div id="ep"></div>`, { footer: '<button class="btn ghost" data-close>Cancelar</button><button class="btn primary" id="ep-ok" disabled>Escolher esta pasta</button>' });
    let atual = '', feito = false;
    m.onclose = () => { if (!feito) resolve(null); };
    const abrir = async (p) => {
      const box = $('#ep', m); box.innerHTML = '<p class="muted">Abrindoâ€¦</p>';
      let r; try { r = await GET(d.central ? `/central/pastas?path=${encodeURIComponent(p)}` : `/devices/${encodeURIComponent(d.id)}/backup/pastas?path=${encodeURIComponent(p)}`); } catch (e) {
        if (p) { box.innerHTML = `<p style="color:var(--warn)">${esc(e.message)}</p>`; setTimeout(() => abrir(''), 1500); } else box.innerHTML = `<p>${esc(e.message)}</p>`; return; }
      atual = r.path || '';
      $('#ep-ok', m).disabled = !atual;
      $('#ep-ok', m).textContent = atual ? `Escolher ${atual.length > 30 ? 'â€¦' + atual.slice(-30) : atual}` : 'Escolha um disco';
      box.innerHTML = `<div class="row" style="flex-wrap:nowrap;gap:8px;margin-bottom:8px"><button class="btn sm" id="ep-up" style="flex:0 0 auto;min-width:0" ${atual ? '' : 'disabled'}>â¬† Voltar</button><div class="mono small" style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${atual ? esc(atual) : 'Este computador'}</div></div>
        <div class="mp-lista">${(r.pastas || []).length ? r.pastas.map((x, i) => `<div class="mp-item" style="cursor:pointer" data-ep="${i}">${x.disco ? 'ðŸ’½' : 'ðŸ“'} <span style="flex:1">${esc(x.nome)}</span><span class="muted small">abrir â€º</span></div>`).join('') : '<p class="muted small">Nenhuma pasta aqui. Clique em "Escolher" para usar esta.</p>'}</div>
        ${atual ? '' : '<p class="muted small" style="margin-top:8px">Pendrive e HD externo aparecem aqui quando estÃ£o ligados no PC. Pasta da rede (\\\\SERVIDOR\\Backup) vocÃª digita direto no campo.</p>'}`;
      $('#ep-up', box).onclick = () => abrir(r.parent || '');
      $$('[data-ep]', box).forEach((it) => { it.onclick = () => { const x = r.pastas[+it.dataset.ep]; const sep = atual.startsWith('/') || x.nome === '/' ? '/' : '\\'; abrir(x.disco ? x.nome : (atual.replace(/[\\/]$/, '') + sep + x.nome)); }; });
    };
    $('#ep-ok', m).onclick = () => { if (!atual) return; feito = true; m.close(); resolve(atual); };
    abrir(/^([A-Za-z]:\\|\/)/.test(inicial || '') ? inicial : '');
  });
}
// â± quanto o Windows demora para ligar (o prÃ³prio Windows mede) e quem atrasa
// 45 s Â· 2 min 2 s Â· 3 min 30 s Â· 4 min
function tempoMin(seg) { seg = Math.round(Number(seg) || 0); if (seg < 60) return `${seg} s`; const m = Math.floor(seg / 60), r = seg % 60; return r ? `${m} min ${r} s` : `${m} min`; }
function bootCard(d) {
  const b = d.boot;
  if (!b) return `<div class="card card-larga"><h2>â± InicializaÃ§Ã£o do Windows</h2><p class="muted small">Ainda sem mediÃ§Ã£o. O Windows anota o tempo a cada inicializaÃ§Ã£o completa (reiniciar); chega no prÃ³ximo inventÃ¡rio.</p></div>`;
  const cor = (x) => (x >= 120 ? 'var(--bad)' : x >= 60 ? 'var(--warn)' : 'var(--ok)');
  const max = Math.max(...b.historico.map((h) => h.s), 1);
  const lento = b.normal != null && b.ultimo > b.normal * 1.5 && b.ultimo - b.normal >= 20;
  // largura toda, em 2 colunas (inicializaÃ§Ã£o | desligamento): antes ficava um cartÃ£o comprido ao lado de um vazio
  return `<div class="card card-larga"><div class="boot-cols${b.desl ? '' : ' um'}"><div><h2>â± InicializaÃ§Ã£o do Windows</h2>
    <div style="display:flex;gap:18px;flex-wrap:wrap;align-items:baseline"><div><div class="muted small">Ãšltima vez</div><div style="font-size:24px;font-weight:700;color:${cor(b.ultimo)}">${esc(tempoMin(b.ultimo))}</div><div class="muted small">${b.quando ? dt(b.quando) : ''}</div></div>
      <div><div class="muted small">Normal deste PC</div><div style="font-size:20px;font-weight:600">${b.normal != null ? '~' + esc(tempoMin(b.normal)) : 'â€”'}</div></div>
      <div><div class="muted small">MÃ©dia</div><div style="font-size:20px;font-weight:600">${esc(tempoMin(b.media))}</div></div></div>
    ${b.fases ? (() => { const f = b.fases, tot = Math.max(1, f.antes + f.depois), pA = Math.round((f.antes / tot) * 100);
      const dica = b.ultimo < 60 ? '' : f.antes >= f.depois * 2 ? 'ðŸ’¡ Quase todo o tempo Ã© <b>antes de aparecer a Ã¡rea de trabalho</b>: nÃ£o Ã© programa. Costuma ser HD (trocar por SSD resolve), driver lento, serviÃ§o do Windows ou configuraÃ§Ã£o da BIOS.'
        : f.depois >= f.antes * 2 ? 'ðŸ’¡ Quase todo o tempo Ã© <b>depois que a Ã¡rea de trabalho aparece</b>: sÃ£o os programas que abrem com o Windows â€” veja "Quem mais atrasou" e desligue o que nÃ£o precisa.'
        : 'ðŸ’¡ O tempo estÃ¡ dividido: vale olhar os dois lados (programas que abrem com o Windows e disco/drivers).';
      return `<div style="margin:10px 0 0"><div class="muted small" style="margin-bottom:4px">Onde foi o tempo da Ãºltima vez:</div>
        <div style="display:flex;height:10px;border-radius:5px;overflow:hidden;background:var(--line)"><div title="AtÃ© a Ã¡rea de trabalho" style="width:${pA}%;background:#5b8def"></div><div title="Depois, atÃ© ficar pronto" style="width:${100 - pA}%;background:#c58af9"></div></div>
        <div class="small" style="display:flex;gap:14px;flex-wrap:wrap;margin-top:4px"><span><span style="color:#5b8def">â– </span> AtÃ© a Ã¡rea de trabalho aparecer (Windows, drivers, serviÃ§os e o login): <b>${esc(tempoMin(f.antes))}</b></span><span><span style="color:#c58af9">â– </span> Depois, atÃ© o PC ficar pronto (programas abrindo): <b>${esc(tempoMin(f.depois))}</b></span></div>
        ${dica ? `<p class="small" style="margin:6px 0 0">${dica}</p>` : ''}</div>`; })() : ''}
    ${lento ? `<p class="small" style="color:var(--warn);margin:8px 0 0">âš  A Ãºltima inicializaÃ§Ã£o foi bem mais lenta que o normal.</p>` : ''}
    ${(() => { const rp = (d.updatesDetail || {}).windowsReparo; return rp && b.quando && String(rp.at).replace('T', ' ') > String(b.quando).replace('T', ' ') ? `<p class="small" style="margin:8px 0 0">ðŸ”§ Windows Update reparado ${esc(when(rp.at))}. <b>Reinicie o PC</b> 1 ou 2 vezes para ver se ficou mais rÃ¡pido (as barrinhas acima sÃ£o de antes do reparo).</p>` : ''; })()}
    <div style="display:flex;align-items:flex-end;gap:4px;height:46px;margin:12px 0 4px" title="Ãšltimas inicializaÃ§Ãµes (a mais nova Ã  direita)">${b.historico.map((h) => `<div title="${esc(dt(h.quando))}: ${esc(tempoMin(h.s))}" style="flex:1;max-width:28px;height:${Math.max(8, Math.round((h.s / max) * 100))}%;background:${cor(h.s)};border-radius:3px 3px 0 0;opacity:.85"></div>`).join('')}</div>
    <div class="muted small">Ãºltimas ${b.historico.length} inicializaÃ§Ãµes Â· atÃ© 1 min Ã© bom, mais de 2 min Ã© lento</div>
    ${b.comData ? (() => { const u = b.lentos.filter((l) => l.naUltima); return `<p class="small" style="margin:10px 0 0"><b>Na Ãºltima vez${b.quando ? ` (${esc(dt(b.quando))})` : ''}:</b> ${u.length ? u.map((l) => `${esc(l.nome)} <span class="nw">+${esc(String(l.atrasoUltima).replace('.', ','))} s</span>`).join(' Â· ') : '<span style="color:var(--ok)">âœ” nenhum programa atrasou</span>'}</p>`; })() : ''}
    ${b.lentos.length ? `<h3 style="margin:12px 0 4px">Quem mais atrasou (Ãºltimos 30 dias)</h3>${b.lentos.map((l) => { const velho = b.comData && !l.naUltima; return `<div class="small" style="display:flex;justify-content:space-between;gap:8px;padding:3px 0;border-bottom:1px solid var(--line)${velho ? ';opacity:.55' : ''}"><span>${esc(l.nome)} <span class="muted">${esc(l.arquivo)}</span>${b.comData ? (l.naUltima ? ' <span class="badge warn">atrasou na Ãºltima vez</span>' : l.ultimaVez ? ` <span class="muted">Â· Ãºltima vez em ${esc(String(l.ultimaVez).slice(8, 10))}/${esc(String(l.ultimaVez).slice(5, 7))}</span>` : '') : ''}${l.windows ? `<div class="muted" style="color:${l.windows.tipo === 'atualizacao' && !velho ? 'var(--warn)' : ''}">â†³ ${l.windows.tipo === 'ferramenta' ? '' : 'peÃ§a do Windows: '}${esc(l.windows.txt)}</div>` : ''}</span><span class="nw">+${esc(String(l.atraso).replace('.', ','))} s${l.vezes > 1 ? ` <span class="muted">(${esc(l.vezes)}x)</span>` : ''}</span></div>`; }).join('')}
      ${can('tecnico') && d.status === 'online' ? `<div class="btns" style="margin-top:8px">${b.lentos.some((l) => l.windows && l.windows.tipo === 'atualizacao' && (!b.comData || l.naUltima)) && !((d.updatesDetail || {}).windowsReparo && String(d.updatesDetail.windowsReparo.at).replace('T', ' ') > String(b.quando).replace('T', ' ')) && S.actionMap.windows_update_reparar && S.actionMap.windows_update_reparar.allowed ? '<button class="btn sm primary" data-q="windows_update_reparar" title="O Windows estÃ¡ terminando atualizaÃ§Ãµes a cada inicializaÃ§Ã£o: conserta os componentes (DISM + SFC)">ðŸ”§ Reparar o Windows Update</button>' : ''}<button class="btn sm" data-q="segundo_plano_listar">Ver programas que iniciam com o Windows</button></div>` : ''}` : ''}
    <p class="muted small" style="margin-top:8px">SÃ³ conta quando o PC <b>reinicia</b> (com a inicializaÃ§Ã£o rÃ¡pida do Windows, "desligar" e ligar nÃ£o mede).</p></div>
    ${b.desl ? `<div class="boot-desl">${desligHtml(d, b.desl)}</div>` : ''}</div></div>`;
}
// â» desligamento / reinÃ­cio: quanto demora na tela "Reiniciando..." e por quÃª
function desligHtml(d, x) {
  if (!x) return '';
  const cor = (v) => (v >= 60 ? 'var(--bad)' : v >= 25 ? 'var(--warn)' : 'var(--ok)');
  const TIPO = { programa: 'programa', servico: 'serviÃ§o', aparelho: 'aparelho/driver' };
  const max = Math.max(...x.historico.map((h) => h.s), 1);
  const lento = x.ultimo != null && (x.ultimo >= 25 || (x.normal != null && x.ultimo > x.normal * 1.5 && x.ultimo - x.normal >= 10));
  const pode = can('tecnico') && d.status === 'online' && S.actionMap.desligamento_rapido && S.actionMap.desligamento_rapido.allowed;
  const u = x.lentos.filter((l) => l.naUltima);
  return `<h2 style="margin:0 0 6px">â» Desligamento / reinÃ­cio <span class="muted small" style="font-weight:400">(tempo na tela "Reiniciando...")</span></h2>
    ${x.ultimo != null ? `<div style="display:flex;gap:18px;flex-wrap:wrap;align-items:baseline"><div><div class="muted small">Ãšltima vez</div><div style="font-size:20px;font-weight:700;color:${cor(x.ultimo)}">${esc(tempoMin(x.ultimo))}</div><div class="muted small">${x.quando ? dt(x.quando) : ''}</div></div>
      <div><div class="muted small">Normal deste PC</div><div style="font-size:18px;font-weight:600">${x.normal != null ? '~' + esc(tempoMin(x.normal)) : 'â€”'}</div></div></div>
      ${x.historico.length > 1 ? `<div style="display:flex;align-items:flex-end;gap:4px;height:34px;margin:10px 0 4px">${x.historico.map((h) => `<div title="${esc(dt(h.quando))}: ${esc(tempoMin(h.s))}" style="flex:1;max-width:28px;height:${Math.max(8, Math.round((h.s / max) * 100))}%;background:${cor(h.s)};border-radius:3px 3px 0 0;opacity:.85"></div>`).join('')}</div><div class="muted small">Ãºltimos ${x.historico.length} desligamentos/reinÃ­cios Â· atÃ© 25 s Ã© bom</div>` : ''}`
    : '<p class="muted small">Ainda sem mediÃ§Ã£o: o Windows anota quando o PC reinicia ou desliga.</p>'}
    ${x.limpaPaginacao ? `<p class="small" style="color:var(--warn);margin:8px 0">âš  <b>"Limpar a memÃ³ria virtual ao desligar" estÃ¡ ligado</b>: o Windows apaga o arquivo de paginaÃ§Ã£o inteiro antes de desligar/reiniciar e fica parado em "Reiniciando..." (pode somar 1 min ou mais). SÃ³ precisa ficar ligado se a empresa exigir por seguranÃ§a.</p>${pode ? '<div class="btns" style="margin:0 0 8px"><button class="btn sm primary" data-q="desligamento_rapido" title="NÃ£o desliga o PC e nÃ£o apaga nada: sÃ³ faz o Windows parar de apagar a memÃ³ria virtual a cada reinÃ­cio">â» Desligar essa opÃ§Ã£o (reinÃ­cio mais rÃ¡pido)</button></div>' : ''}`
      : x.ultimo != null ? `<p class="small muted" style="margin:8px 0">"Limpar a memÃ³ria virtual ao desligar": <b>desligado</b> (reinÃ­cio mais rÃ¡pido). Ligado, o Windows apaga a memÃ³ria virtual do disco a cada desligamento para nÃ£o sobrar nenhum dado dela â€” mais seguro, porÃ©m o reinÃ­cio demora mais. SÃ³ vale ligar se a empresa exigir.</p>${pode && S.actionMap.desligamento_seguro && S.actionMap.desligamento_seguro.allowed ? '<div class="btns" style="margin:0 0 8px"><button class="btn sm" data-q="desligamento_seguro" title="Mais seguro, reinÃ­cio mais lento">ðŸ”’ Religar essa opÃ§Ã£o</button></div>' : ''}` : ''}
    ${x.comData && x.ultimo != null ? `<p class="small" style="margin:8px 0 0"><b>Na Ãºltima vez:</b> ${u.length ? u.map((l) => `${esc(l.nome)} <span class="nw">+${esc(String(l.atrasoUltima).replace('.', ','))} s</span>`).join(' Â· ') : `<span style="color:var(--${lento ? 'muted' : 'ok'})">${lento ? 'o Windows nÃ£o apontou um culpado' + (x.limpaPaginacao ? ' (veja o aviso acima)' : '') : 'âœ” nenhum programa atrasou'}</span>`}</p>` : ''}
    ${x.lentos.length ? `<h4 style="margin:10px 0 4px">Quem atrasou o desligamento (Ãºltimos 30 dias)</h4>${x.lentos.map((l) => { const velho = x.comData && !l.naUltima; return `<div class="small" style="display:flex;justify-content:space-between;gap:8px;padding:3px 0;border-bottom:1px solid var(--line)${velho ? ';opacity:.55' : ''}"><span>${esc(l.nome)} <span class="muted">${esc(TIPO[l.tipo] || '')}${l.arquivo && l.arquivo !== l.nome ? ' Â· ' + esc(l.arquivo) : ''}</span>${l.naUltima ? ' <span class="badge warn">atrasou na Ãºltima vez</span>' : l.ultimaVez ? ` <span class="muted">Â· Ãºltima vez em ${esc(String(l.ultimaVez).slice(8, 10))}/${esc(String(l.ultimaVez).slice(5, 7))}</span>` : ''}${l.windows ? `<div class="muted">â†³ ${l.windows.tipo === 'ferramenta' ? '' : 'peÃ§a do Windows: '}${esc(l.windows.txt)}</div>` : ''}</span><span class="nw">+${esc(String(l.atraso).replace('.', ','))} s${l.vezes > 1 ? ` <span class="muted">(${esc(l.vezes)}x)</span>` : ''}</span></div>`; }).join('')}
      <p class="muted small" style="margin-top:6px">Programa que atrasa o desligamento costuma ser o que fica sincronizando ou salvando ao fechar (Drive, OneDrive, jogos, launchers): feche antes de reiniciar ou tire da inicializaÃ§Ã£o.</p>` : ''}`;
}
function tamanho(b) { b = Number(b) || 0; return b >= 1e9 ? (b / 1e9).toFixed(1) + ' GB' : b >= 1e6 ? (b / 1e6).toFixed(1) + ' MB' : b >= 1e3 ? Math.round(b / 1e3) + ' KB' : b + ' B'; }
// ðŸ“‚ navegar no backup (HD/rede ou Central), escolher a data e restaurar uma pasta/arquivo
function backupNavegar(d, b) {
  const origens = [...(b.local ? [['local', `HD/rede (${b.local.caminho})`]] : []), ...(b.central ? [['central', 'Central']] : [])];
  if (!origens.length) return toast('Configure um destino de backup primeiro.', 'err');
  const m = modal(`Backup de ${d.alias || d.hostname}`, '<div id="bn"></div>', { wide: true });
  const st = { origem: origens[0][0], versao: 'atual', prefixo: '' };
  const pode = S.actionMap.backup_restaurar && S.actionMap.backup_restaurar.allowed && d.status === 'online';
  const restaurar = async (rel) => {
    const nome = rel || 'tudo';
    const m2 = modal('Restaurar', `<p>Restaurar <b>${esc(nome)}</b> ${st.versao === 'atual' ? '(cÃ³pia mais recente)' : `como estava em <b>${esc(st.versao.split('-').reverse().join('/'))}</b>`}:</p>
      <label style="color:var(--text)"><input type="radio" name="para" value="pasta" checked> Numa pasta separada (<span class="mono">C:\\Restaurado pelo FND</span>) â€” mais seguro</label>
      <label style="color:var(--text)"><input type="radio" name="para" value="original"> No lugar original (se o arquivo ainda existir, o restaurado fica ao lado com "(restaurado)" no nome)</label>`,
      { footer: '<button class="btn ghost" data-close>Cancelar</button><button class="btn primary" data-ok>Restaurar</button>' });
    $('[data-ok]', m2).onclick = async () => {
      const para = $('input[name=para]:checked', m2).value; m2.close();
      try { const r = await POST('/tasks', { deviceIds: [d.id], action: 'backup_restaurar', params: { origem: st.origem, rel: rel || '', versao: st.versao, para } }); toast('Restaurandoâ€¦', 'ok'); m.close(); openTask(r.ids[0]); } catch (e) { if (!jaRodando(e)) fail(e); }
    };
  };
  const carregar = async () => {
    const box = $('#bn', m); box.innerHTML = '<p class="muted">Carregandoâ€¦</p>';
    let r; try { r = await GET(`/devices/${encodeURIComponent(d.id)}/backup/navegar?origem=${st.origem}&versao=${encodeURIComponent(st.versao)}&prefixo=${encodeURIComponent(st.prefixo)}`); } catch (e) { box.innerHTML = `<p>${esc(e.message)}</p>`; return; }
    const partes = st.prefixo ? st.prefixo.split('/') : [];
    box.innerHTML = `<div class="row" style="gap:8px;flex-wrap:wrap;justify-content:flex-start">
        ${origens.length > 1 ? `<select id="bn-o">${origens.map(([k, t]) => `<option value="${k}" ${st.origem === k ? 'selected' : ''}>${esc(t)}</option>`).join('')}</select>` : `<b>${esc(origens[0][1])}</b>`}
        <select id="bn-v"><option value="atual">Mais recente</option>${(r.versoes || []).map((v) => `<option value="${esc(v)}" ${st.versao === v ? 'selected' : ''}>Como estava em ${esc(v.split('-').reverse().join('/'))}</option>`).join('')}</select>
        ${r.totalGB != null ? `<span class="muted small">${esc(r.totalGB)} GB guardados Â· ${esc(r.livreGB)} GB livres na Central</span>` : ''}</div>
      <p class="small" style="margin:10px 0"><a role="button" data-ir="">ðŸ“ inÃ­cio</a>${partes.map((x, i) => ` / <a role="button" data-ir="${esc(partes.slice(0, i + 1).join('/'))}">${esc(x)}</a>`).join('')}
        ${pode && st.prefixo ? ` <button class="btn sm" data-rest="${esc(st.prefixo)}">â†© Restaurar esta pasta</button>` : ''}</p>
      ${(r.itens || []).length ? `<table><thead><tr><th>Nome</th><th>Tamanho</th><th>Modificado</th><th></th></tr></thead><tbody>${r.itens.map((x) => { const rel = st.prefixo ? st.prefixo + '/' + x.nome : x.nome; return `<tr>
        <td>${x.pasta ? `<a role="button" data-ir="${esc(rel)}">ðŸ“ ${esc(x.nome)}</a>` : `ðŸ“„ ${esc(x.nome)}`}</td><td class="small">${x.pasta ? '' : esc(tamanho(x.size))}</td><td class="small">${x.mtime ? dt(x.mtime) : ''}</td>
        <td>${pode ? `<button class="btn sm" data-rest="${esc(rel)}">â†© Restaurar</button>` : ''}</td></tr>`; }).join('')}</tbody></table>`
        : `<p class="muted">${st.versao === 'atual' ? 'Nada aqui ainda.' : 'Nada mudou nesta pasta nesse dia (as versÃµes guardam sÃ³ o que foi alterado ou apagado).'}</p>`}
      ${pode ? '' : `<p class="muted small">${d.status === 'online' ? '' : 'O PC precisa estar online para restaurar. '}</p>`}`;
    if ($('#bn-o', box)) $('#bn-o', box).onchange = (e) => { st.origem = e.target.value; st.versao = 'atual'; st.prefixo = ''; carregar(); };
    $('#bn-v', box).onchange = (e) => { st.versao = e.target.value; carregar(); };
    $$('[data-ir]', box).forEach((a) => { a.onclick = () => { st.prefixo = a.dataset.ir; carregar(); }; });
    $$('[data-rest]', box).forEach((a) => { a.onclick = () => restaurar(a.dataset.rest); });
  };
  carregar();
}

async function quickTask(deviceId, action, params = {}) {
  const a = S.actionMap[action];
  if (!a || !a.allowed) return toast('Sem permissÃ£o para esta tarefa.', 'err');
  // tarefas pesadas: se o cliente tem horÃ¡rio de manutenÃ§Ã£o, abre o diÃ¡logo completo para escolher
  if (HEAVY.includes(action) && S.view === VIEWS.pc && VIEWS.pc.d && VIEWS.pc.d.maintenanceWindow) return taskDialog([deviceId], action, params);
  const dangerous = ['reiniciar_pc', 'remover_agente', 'app_atualizar_todos', 'apps_atualizar_lista', 'windows_update_instalar', 'drivers_instalar'].includes(action);
  if (dangerous && !(await confirmBox(a.label, `Confirmar <b>${esc(a.label)}</b>?${action === 'reiniciar_pc' ? '<br><br>Segue a polÃ­tica de reinÃ­cio do cliente: <b>Perguntar</b> (o usuÃ¡rio autoriza pelo Ã­cone da bandeja; se ninguÃ©m estiver usando, reinicia), <b>SÃ³ agendado</b> (no horÃ¡rio de manutenÃ§Ã£o) ou <b>AutomÃ¡tico</b> (aviso de 5 minutos).' : ''}`, 'Confirmar', action !== 'windows_update_instalar'))) return;
  try {
    const r = await POST('/tasks', { deviceIds: [deviceId], action, params });
    tarefaUsou(action);
    toast(`Tarefa enviada: ${a.label}`, 'ok');
    openTask(r.ids[0]);
  } catch (e) { if (!jaRodando(e)) fail(e); }
}

// ---------- ðŸ” escolher a tarefa: pesquisa (sem acento, com palavras parecidas), filtro por grupo e as mais usadas ----------
const TP_SIN = { limpar: ['limpeza', 'lixo', 'espaco', 'temporarios', 'sobras', 'cache'], lixo: ['limpar', 'lixeira'], espaco: ['disco', 'limpar', 'ocupando'], disco: ['espaco', 'hd', 'ssd'],
  virus: ['antivirus', 'ameaca', 'seguranca', 'defender', 'suspeito'], seguranca: ['virus', 'suspeito', 'quarentena', 'antivirus'], antivirus: ['virus', 'defender'],
  temperatura: ['cpu', 'calor', 'termico', 'fresco', 'quente'], calor: ['temperatura'], atualizar: ['update', 'atualizacao', 'atualizacoes'], update: ['atualizar', 'atualizacoes'],
  reiniciar: ['reinicio', 'desligar'], programa: ['app', 'aplicativo', 'aplicativos', 'programas'], app: ['programa', 'aplicativo'], aplicativo: ['programa', 'app'],
  backup: ['copia'], inicializacao: ['iniciam', 'boot', 'startup', 'inicia'], lento: ['desempenho', 'diagnostico', 'processos'], driver: ['drivers'], restaurar: ['restauracao', 'ponto'] };
const tpNorm = (t) => String(t || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
const tarefaUsoLer = () => { try { return JSON.parse(localStorage.getItem('fnd_tarefas_uso') || '{}') || {}; } catch { return {}; } };
function tarefaUsou(k) { try { const u = tarefaUsoLer(); u[k] = (u[k] || 0) + 1; localStorage.setItem('fnd_tarefas_uso', JSON.stringify(u)); } catch { /* sem armazenamento: tudo bem */ } }
function tarefaPicker(sel) {
  if (!sel || sel.dataset.tp) return; sel.dataset.tp = '1';
  const ops = [...sel.querySelectorAll('option')].map((o) => ({ k: o.value, l: o.textContent, g: o.parentElement.tagName === 'OPTGROUP' ? o.parentElement.label : '' }));
  for (const o of ops) o.n = tpNorm(`${o.l} ${o.k.replace(/_/g, ' ')} ${o.g}`);
  const grupos = [...new Set(ops.map((o) => o.g))];
  const box = document.createElement('div'); box.className = 'tp';
  box.innerHTML = `<input class="tp-q" type="search" placeholder="ðŸ” Pesquisar tarefa (ex.: temperatura, vÃ­rus, limpar, atualizar)" autocomplete="off">
    <div class="tp-chips">${['Todas', ...grupos].map((g, i) => `<button type="button" class="tp-chip${i ? '' : ' on'}" data-g="${esc(i ? g : '')}">${esc(g)}</button>`).join('')}</div><div class="tp-lista" role="listbox"></div>`;
  sel.classList.add('hidden'); sel.insertAdjacentElement('afterend', box);
  const q = $('.tp-q', box), lista = $('.tp-lista', box); let grupo = '', marcado = -1, vis = [];
  const casa = (o, termos) => termos.every((t) => o.n.includes(t) || (TP_SIN[t] || []).some((x) => o.n.includes(x)) || Object.entries(TP_SIN).some(([k, v]) => v.includes(t) && o.n.includes(k)));
  const desenhar = () => {
    const termos = tpNorm(q.value).split(/\s+/).filter(Boolean);
    vis = ops.filter((o) => (!grupo || o.g === grupo) && casa(o, termos));
    const uso = tarefaUsoLer();
    const top = !termos.length && !grupo ? ops.filter((o) => uso[o.k] > 0).sort((a, b) => uso[b.k] - uso[a.k]).slice(0, 5) : [];
    const item = (o) => `<div class="tp-it${o.k === sel.value ? ' sel' : ''}" role="option" data-k="${esc(o.k)}">${esc(o.l)}</div>`;
    let h = top.length ? `<div class="tp-g">â­ Mais usadas</div>${top.map(item).join('')}` : '';
    for (const g of grupos) { const it = vis.filter((o) => o.g === g); if (it.length) h += `<div class="tp-g">${esc(g)}</div>${it.map(item).join('')}`; }
    lista.innerHTML = h || '<div class="muted small" style="padding:8px">Nenhuma tarefa com esse nome. Tente outra palavra.</div>';
    vis = [...lista.querySelectorAll('.tp-it')]; marcado = -1;
    const s2 = lista.querySelector('.tp-it.sel'); if (s2 && !termos.length) s2.scrollIntoView({ block: 'nearest' });
  };
  const escolher = (k) => { if (!k || sel.value === k) { desenhar(); return; } sel.value = k; sel.dispatchEvent(new Event('change')); desenhar(); };
  lista.onclick = (e) => { const it = e.target.closest('.tp-it'); if (it) escolher(it.dataset.k); };
  q.oninput = desenhar;
  q.onkeydown = (e) => {
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); if (!vis.length) return; marcado = (marcado + (e.key === 'ArrowDown' ? 1 : vis.length - 1)) % vis.length; vis.forEach((v, i) => v.classList.toggle('foco', i === marcado)); vis[marcado].scrollIntoView({ block: 'nearest' }); }
    else if (e.key === 'Enter') { e.preventDefault(); const it = vis[marcado >= 0 ? marcado : 0]; if (it) escolher(it.dataset.k); }
  };
  $$('.tp-chip', box).forEach((b) => { b.onclick = () => { grupo = b.dataset.g; $$('.tp-chip', box).forEach((x) => x.classList.toggle('on', x === b)); desenhar(); }; });
  desenhar();
}

// ðŸ§¹ o que limpar (Nova tarefa e Agendamento de "Limpar o que pode limpar"); a lixeira vem desmarcada no agendamento
const alvosHtml = (atual, agendado) => {
  const tem = String(atual || '').split(',').filter(Boolean);
  const pad = (k) => (tem.length ? tem.includes(k) : !(agendado && k === 'lixeira'));
  return `<label>O que limpar</label><div class="alvos-grid">${Object.entries(ESP_ALVO).map(([k, l]) => `<label class="chk"><input type="checkbox" name="alvo_${k}" ${pad(k) ? 'checked' : ''}> ${esc(l)}</label>`).join('')}</div>
    <p class="muted small">SÃ³ o que Ã© seguro apagar. O que estiver em uso fica e sai depois de reiniciar.${agendado ? ' A lixeira vem desmarcada: o usuÃ¡rio pode querer recuperar algo dela.' : ''}</p>`;
};
const alvosDe = (d) => Object.keys(ESP_ALVO).filter((k) => d['alvo_' + k]).join(',');
async function taskDialog(deviceIds, preset = '', presetParams = {}) {
  // "atualizar selecionados" sÃ³ aparece quando vem da lista de apps (precisa dos IDs marcados)
  const allowed = S.actions.filter((a) => a.allowed && (!a.tela || a.key === preset) && (a.key !== 'apps_atualizar_lista' || preset === 'apps_atualizar_lista') && (a.key !== 'virus_restaurar' || preset === 'virus_restaurar'));
  let packages = [];
  if (S.actionMap.instalar_pacote && S.actionMap.instalar_pacote.allowed) { try { packages = await GET('/packages'); } catch { /* */ } }
  const groups = [...new Set(allowed.map((a) => a.group))];
  const m = modal(`Nova tarefa Â· ${deviceIds.length} computador(es)`, `<form id="tf">
    <label>Tarefa</label><select name="action">${groups.map((g) => `<optgroup label="${esc(g)}">${allowed.filter((a) => a.group === g).map((a) => `<option value="${a.key}" ${a.key === preset ? 'selected' : ''}>${esc(a.label)}</option>`).join('')}</optgroup>`).join('')}</select>
    <div id="pp"></div>
    <label>Quando executar</label>
    <div class="row"><select name="when"><option value="">Agora (em segundo plano)</option><option value="agendar">Agendar data e hora</option></select><input type="datetime-local" name="scheduledFor" class="hidden"></div>
    <label id="rwbox" class="hidden" style="color:var(--text)"><input type="checkbox" name="respectWindow" checked> Respeitar o horÃ¡rio de manutenÃ§Ã£o do cliente (tarefas que podem atrapalhar o usuÃ¡rio)</label>
    <p class="muted small">Se o computador estiver desligado, a tarefa fica na fila e roda quando ele voltar a ficar online.</p></form>`,
  { footer: '<button class="btn ghost" data-close>Cancelar</button><button class="btn primary" id="go">Enviar tarefa</button>' });
  const f = $('#tf', m);
  tarefaPicker(f.action);
  const drawParams = () => {
    const a = S.actionMap[f.action.value];
    const p = a.params;
    $('#pp', m).innerHTML = (p.includes('alvos') ? alvosHtml(presetParams.alvos, false) : '') + (p.includes('pacote') ? (packages.length
        ? `<label>Programa (da sua biblioteca de instaladores)</label><select name="pacote">${packages.map((k) => `<option value="${k.id}" ${String(presetParams.pacote) === String(k.id) ? 'selected' : ''}>${esc(k.name)} Â· ${esc(k.filename)} (${fmtSize(k.size)})</option>`).join('')}</select>
           <p class="muted small" id="pkargs"></p>`
        : '<p class="muted">Nenhum instalador na biblioteca ainda. Adicione em <a href="#/instaladores">Meus instaladores</a>.</p>') : '')
      + (p.includes('id') ? '<label>ID do aplicativo no winget (ex.: Google.Chrome, 7zip.7zip, Adobe.Acrobat.Reader.64-bit)</label><input name="id" required>' : '')
      + (p.includes('termo') ? '<label>Nome do aplicativo para buscar (ex.: chrome, anydesk, acrobat)</label><input name="termo" required>' : '')
      + (p.includes('nome') && a.key === 'restauracao_criar' ? '<label>Nome do ponto (opcional)</label><input name="nome" placeholder="ex.: Antes da manutenÃ§Ã£o">' : '')
      + (p.includes('nome') && a.key !== 'virus_restaurar' && a.key !== 'restauracao_criar' ? '<label>Nome do serviÃ§o (ex.: Spooler)</label><input name="nome" required>' : '')
      + (p.includes('pasta') ? '<label>Pasta (caminho completo, ex.: C:\\Users\\nome\\Downloads ou E:\\)</label><input name="pasta" class="mono" required>' : '')
      + (p.includes('modo') ? '<label>O que fazer</label><select name="modo"><option value="procurar">SÃ³ procurar (nÃ£o apaga nada)</option><option value="remover">Procurar e remover</option></select>' : '')
      + (p.includes('tipo') ? '<label>VerificaÃ§Ã£o</label><select name="tipo"><option value="rapida">RÃ¡pida</option><option value="completa">Completa (horas)</option></select>' : '')
      + (a.key === 'virus_segunda' ? '<p class="muted small">Baixa o Microsoft Safety Scanner (uns 200 MB), confere a assinatura da Microsoft, roda escondido e apaga no final.</p>' : '')
      + (p.includes('script') ? '<label>Script PowerShell (roda como SYSTEM, em segundo plano, sem janela). Fica registrado no histÃ³rico.</label><textarea name="script" required spellcheck="false" placeholder="Get-Service | Where-Object Status -eq Stopped"></textarea>' : '')
      + (a.key === 'windows_update_instalar' ? '<p class="muted small">Baixa e instala as atualizaÃ§Ãµes sem reiniciar. Pode levar bastante tempo.</p>' : '')

      + (a.key === 'reiniciar_pc' ? '<p class="muted small">Segue a polÃ­tica de reinÃ­cio do cliente: <b>Perguntar</b> (o usuÃ¡rio autoriza pelo Ã­cone da bandeja; se ninguÃ©m estiver usando, reinicia), <b>SÃ³ agendado</b> (no horÃ¡rio de manutenÃ§Ã£o, com aviso de 5 min) ou <b>AutomÃ¡tico</b> (aviso de 5 min).</p>' : '');
  };
  const showArgs = () => { const sel = f.pacote; const info = $('#pkargs', m); if (!sel || !info) return; const k = packages.find((x) => String(x.id) === sel.value); info.innerHTML = !k ? '' : /\.zip$/i.test(k.filename) ? 'Pacote de driver: os arquivos .inf sÃ£o instalados com o pnputil do Windows (sem reiniciar).' : `InstalaÃ§Ã£o silenciosa com: <span class="mono">${esc(k.args || (/\.msi$/i.test(k.filename) ? '/qn /norestart (automÃ¡tico)' : '(sem parÃ¢metros)'))}</span>`; sel.onchange = showArgs; };
  const syncRw = () => $('#rwbox', m).classList.toggle('hidden', !HEAVY.includes(f.action.value));
  f.action.onchange = () => { drawParams(); showArgs(); syncRw(); }; drawParams(); showArgs(); syncRw();
  for (const [k, v] of Object.entries(presetParams)) if (f[k] && k !== 'pacote') { if (f[k].type === 'checkbox') f[k].checked = v === 'sim'; else f[k].value = v; }
  if (presetParams.ids) $('#pp', m).insertAdjacentHTML('beforeend', `<input type="hidden" name="ids" value="${esc(presetParams.ids)}"><p class="muted small">${presetParams.ids.split(',').length} ${preset === 'drivers_instalar' ? 'driver(s)' : 'aplicativo(s)'} selecionado(s).</p>`);
  f.when.onchange = () => f.scheduledFor.classList.toggle('hidden', f.when.value !== 'agendar');
  $('#go', m).onclick = async () => {
    const d = formData(f);
    const a = S.actionMap[d.action];
    const params = {}; for (const k of a.params) params[k] = d[k] ?? presetParams[k];
    if (a.params.includes('alvos')) { params.alvos = alvosDe(d); if (!params.alvos) return toast('Marque pelo menos uma coisa para limpar.', 'err'); }
    if (a.params.includes('pacote') && !d.pacote) return toast('Adicione um instalador na biblioteca primeiro.', 'err');
    if (d.when === 'agendar' && !d.scheduledFor) return toast('Escolha a data e hora.', 'err');
    try {
      tarefaUsou(d.action);
      const r = await POST('/tasks', { deviceIds, action: d.action, params, scheduledFor: d.when === 'agendar' ? d.scheduledFor : '', respectWindow: !!d.respectWindow });
      m.close();
      toast(`${r.ids.length} tarefa(s) criada(s).`, 'ok');
      avisarPulados(r);
      if (r.ids.length === 1 && d.when !== 'agendar') openTask(r.ids[0]);
    } catch (e) { if (jaRodando(e)) m.close(); else fail(e); }
  };
}

// ---------- ðŸ›¡ vigilÃ¢ncia de seguranÃ§a (cartÃ£o SeguranÃ§a do PC) ----------
// o que o antivÃ­rus nÃ£o reconhece, mas o comportamento entrega: nome do Windows fora do lugar, pasta suspeita, exclusÃµes perigosas
const segCurto = (c) => { const t = String(c || ''); return t.length > 60 ? 'â€¦' + t.slice(-58) : t; };
function segHtml(d, inv) {
  const sg = inv.seguranca;
  if (!sg || typeof sg !== 'object') return '<p class="muted small" style="margin-top:12px">ðŸ›¡ VigilÃ¢ncia de seguranÃ§a: chega com o agente 0.17.22.</p>';
  const on = !d.revoked && d.status === 'online', adm = on && can('admin'), tec = on && can('tecnico');
  const ach = Array.isArray(sg.achados) ? sg.achados : [], sus = ach.filter((a) => a.nivel !== 'info'), sobras = ach.filter((a) => a.nivel === 'info');
  const exc = sg.exclusoes || null, per = exc && Array.isArray(exc.perigosas) ? exc.perigosas.filter(Boolean) : [], q = Array.isArray(sg.quarentena) ? sg.quarentena : [];
  const bt = (op, rot, ids, cls = '') => (adm ? `<button class="btn sm ${cls}" data-seg="${op}" data-ids="${esc(ids)}">${rot}</button>` : '');
  let h = `<div class="seg-box"><h3 style="margin:14px 0 6px">ðŸ›¡ VigilÃ¢ncia de seguranÃ§a <span class="muted small" style="font-weight:400">Â· conferido ${dt(String(sg.quando || '').replace('T', ' '))}</span></h3>`;
  if (!sus.length && !per.length) h += '<p class="small"><span class="badge ok">Nada suspeito</span> na inicializaÃ§Ã£o, nas pastas do Windows e nas exclusÃµes do antivÃ­rus.</p>';
  if (sus.length) {
    h += `<p class="small" style="color:var(--bad);margin:6px 0"><b>âš  ${sus.length} item(ns) suspeito(s)</b> â€” o FND achou pelo comportamento (o antivÃ­rus pode nÃ£o reconhecer).</p>
      ${sus.map((a) => `<div class="seg-it"><div class="mono small" style="word-break:break-all" title="${esc(a.caminho)}"><span class="badge ${a.nivel === 'critico' ? 'bad' : 'warn'}" style="margin-right:6px;font-family:inherit">${a.nivel === 'critico' ? 'vÃ­rus?' : 'suspeito'}</span>${esc(a.caminho || a.nome)}</div>
        <div class="muted small" style="margin:3px 0">${esc(a.onde)}${a.nome && a.onde !== 'Arquivo solto' ? ` Â· ${esc(segCurto(a.nome))}` : ''} â€” ${esc(a.motivo)}</div>
        ${adm ? `<div class="btns">${bt('quarentena', 'ðŸ§¹ Quarentena', a.id)} ${bt('apagar', 'ðŸ—‘ Excluir', a.id, 'danger')}</div>` : ''}</div>`).join('')}
      ${sus.length > 1 ? `<div class="btns" style="margin:8px 0">${bt('quarentena', `ðŸ§¹ PÃ´r tudo em quarentena (${sus.length})`, 'tudo', 'primary')}</div>` : ''}`;
  }
  if (sobras.length) h += `<details style="margin:6px 0"><summary class="small">${sobras.length} entrada(s) de inicializaÃ§Ã£o apontando para arquivo suspeito que jÃ¡ nÃ£o existe</summary>
      <div class="small mono" style="margin:6px 0">${sobras.map((a) => `${esc(a.onde)}: ${esc(segCurto(a.caminho))}`).join('<br>')}</div>${bt('apagar', 'Limpar essas entradas', sobras.map((a) => a.id).join(','))}</details>`;
  if (per.length) h += `<p class="small" style="color:var(--bad);margin:8px 0 4px"><b>âš  ExclusÃµes perigosas no antivÃ­rus</b> â€” o Defender nÃ£o examina:</p>
      <ul class="small" style="margin:0 0 6px 18px">${per.map((x) => `<li><span class="mono">${esc(x.valor)}</span> â€” ${esc(x.motivo)}</li>`).join('')}</ul>${bt('exclusoes', 'Remover as exclusÃµes perigosas', '', 'primary')}`;
  const todas = exc ? [...(exc.caminhos || []), ...(exc.extensoes || []), ...(exc.processos || [])] : [];
  if (!exc) h += '<p class="muted small" style="margin:6px 0">ExclusÃµes do antivÃ­rus: sÃ³ dÃ¡ para ler as do Microsoft Defender (este PC usa outro antivÃ­rus ou o Defender estÃ¡ desligado).</p>';
  if (todas.length) h += `<details style="margin:6px 0"><summary class="small">ExclusÃµes do antivÃ­rus (${todas.length})</summary><div class="small mono" style="margin:6px 0">${todas.map(esc).join('<br>')}</div></details>`;
  if (q.length) {
    h += `<details style="margin:6px 0" ${sus.length ? '' : 'open'}><summary class="small">ðŸ§ª Quarentena (${q.length}) â€” apagados sozinhos depois de 30 dias</summary>
      ${q.map((x) => `<div class="seg-it"><div class="mono small" style="word-break:break-all" title="${esc(x.caminho)}">${esc(x.caminho)}</div><div class="muted small" style="margin:3px 0">${esc(x.motivo || '')} Â· ${dt(String(x.quando || '').replace('T', ' '))}</div>
        ${adm ? `<div class="btns"><button class="btn sm" data-segq="q_restaurar" data-qids="${esc(x.qid)}">â†© Restaurar</button> <button class="btn sm danger" data-segq="q_apagar" data-qids="${esc(x.qid)}">ðŸ—‘ Excluir de vez</button></div>` : ''}</div>`).join('')}
      ${q.length > 1 && adm ? `<div class="btns" style="margin:6px 0"><button class="btn sm danger" data-segq="q_apagar" data-qids="tudo">ðŸ—‘ Esvaziar a quarentena</button></div>` : ''}</details>`;
  }
  if (tec) h += `<div class="btns" style="margin-top:8px"><button class="btn sm" data-q="seguranca_verificar">ðŸ” Verificar agora</button></div>`;
  return h + '</div>';
}
function segBind(el, d) {
  const txt = {
    quarentena: ['PÃ´r em quarentena', 'Os arquivos vÃ£o para a <b>quarentena do FND</b> (renomeados, nÃ£o rodam) e saem da inicializaÃ§Ã£o. DÃ¡ para restaurar depois. Apagados sozinhos em 30 dias.', 'PÃ´r em quarentena', false],
    apagar: ['Excluir', 'O arquivo Ã© <b>apagado de vez</b> e sai da inicializaÃ§Ã£o. NÃ£o dÃ¡ para desfazer (se tiver dÃºvida, use a Quarentena).', 'Excluir', true],
    exclusoes: ['Remover exclusÃµes perigosas', 'O antivÃ­rus volta a examinar essas pastas/arquivos. Depois vale rodar uma verificaÃ§Ã£o completa.', 'Remover', false],
    q_apagar: ['Excluir de vez', 'Apaga de vez da quarentena. NÃ£o dÃ¡ para desfazer.', 'Excluir', true],
    q_restaurar: ['Restaurar', 'O arquivo volta para o lugar de onde saiu (<b>nÃ£o</b> volta para a inicializaÃ§Ã£o). SÃ³ faÃ§a isso se tiver certeza de que nÃ£o Ã© vÃ­rus.', 'Restaurar', true],
  };
  const vai = async (op, params) => {
    const [tit, corpo, ok, perigo] = txt[op];
    if (!(await confirmBox(tit, `${corpo}<br><br>Computador: <b>${esc(d.alias || d.hostname)}</b>`, ok, perigo))) return;
    quickTask(d.id, 'seguranca_acao', { op, ...params });
  };
  $$('[data-seg]', el).forEach((b) => { b.onclick = () => vai(b.dataset.seg, b.dataset.ids ? { ids: b.dataset.ids } : {}); });
  $$('[data-segq]', el).forEach((b) => { b.onclick = () => vai(b.dataset.segq, { qids: b.dataset.qids }); });
}
function segResultado(r, t) {
  const sg = r.seguranca || {};
  const ach = (sg.achados || []).filter((a) => a.nivel !== 'info'), per = (sg.exclusoes && sg.exclusoes.perigosas) || [];
  const okk = t.status === 'ok' && (r.confere !== false);
  return `<div class="card" style="margin-bottom:12px"><div style="font-size:18px;font-weight:600">${okk ? (ach.length || per.length ? (t.action === 'seguranca_verificar' ? 'âš ï¸' : 'âœ…') : 'âœ…') : 'âš ï¸'} ${esc(r.message || '')}</div>
    ${(r.falhas || []).length ? `<p class="small" style="color:var(--bad)">${r.falhas.map((f) => `${esc(f.caminho || f.valor || f.qid)}: ${esc(f.erro)}`).join('<br>')}</p>` : ''}</div>
    ${ach.length ? `<p class="small"><b>Ainda suspeito(s):</b></p><div class="small mono">${ach.map((a) => `${esc(a.caminho || a.nome)} <span class="muted" style="font-family:inherit">â€” ${esc(a.motivo)}</span>`).join('<br>')}</div>` : ''}
    ${per.length ? `<p class="small"><b>ExclusÃµes perigosas no antivÃ­rus:</b> ${per.map((x) => `<span class="mono">${esc(x.valor)}</span>`).join(', ')}</p>` : ''}
    <p class="muted small">Os detalhes e os botÃµes (quarentena, excluir, restaurar) ficam no cartÃ£o <b>SeguranÃ§a</b> da pÃ¡gina do PC.</p>`;
}

// ---------- saÃºde do disco (SMART) ----------
// nÃºmero de verdade ou null (agentes atÃ© a 0.8.1 mandavam {} quando o disco nÃ£o informava o valor)
const numDisco = (v) => (typeof v === 'number' && Number.isFinite(v) ? v : (typeof v === 'string' && v.trim() !== '' && Number.isFinite(Number(v)) ? Number(v) : null));
// SSD: os contadores de erro sÃ£o histÃ³rico (quase nunca ficam em zero); o que pesa Ã© se AUMENTAM (p.cresc, da Central)
const discoSSD = (p) => /ssd|nvme|solid/i.test(`${p.type || ''} ${p.bus || ''}`) || numDisco(p.wear) != null;
// limites de temperatura por tipo [atenÃ§Ã£o, crÃ­tico] â€” mesma regra da Central (HD 50/55, SSD SATA 60/70, NVMe 70/80)
function limTempDisco(p) { const t = `${p.type || ''} ${p.bus || ''} ${p.model || ''}`; return /nvme/i.test(t) ? [70, 80] : /\bhdd\b/i.test(String(p.type || '')) ? [50, 55] : [60, 70]; }
const discoK = (p) => String(p.serial || p.model || '').trim();
const discoNorm = (v) => String(v || '').toLowerCase().replace(/[^a-z0-9]/g, '');
// "RAID" no Windows quase sempre Ã© sÃ³ a BIOS em modo RAID/Intel RST (um disco sÃ³): mostra claro
const discoBus = (p) => (/^raid$/i.test(String(p.bus || '')) && !/nvme/i.test(`${p.type || ''} ${p.model || ''}`) ? 'SATA (BIOS em modo RAID)' : p.bus || '');
const discoSubiu = (p) => { const c = p.cresc || {}; return Math.max(0, c.ruins || 0) + Math.max(0, c.erros || 0); };
// saÃºde do disco (defeito/desgaste) â€” o calor fica de fora: disco bom e quente precisa de manutenÃ§Ã£o, nÃ£o de troca
function diskBadgeSaude(p) {
  const wear = numDisco(p.wear), errs = (numDisco(p.readErrors) || 0) + (numDisco(p.writeErrors) || 0), ruins = numDisco(p.setoresRuins) || 0;
  const ssd = discoSSD(p), subiu = discoSubiu(p);
  if (/unhealthy/i.test(p.health) || p.smartFalhou || wear >= 90 || subiu >= 50 || (!ssd && ruins >= 100)) return ['bad', 'Com problema'];
  if (/warning/i.test(p.health) || wear >= 70 || subiu >= 5 || (!ssd && (errs > 0 || ruins > 0))) return ['warn', 'AtenÃ§Ã£o'];
  if (/healthy|ok/i.test(p.health || '')) return ['ok', 'SaudÃ¡vel'];
  return ['', p.health || '?'];
}
// selo do disco: defeito manda; se o disco estÃ¡ bom mas quente, "ðŸŒ¡ Quente"/"ðŸŒ¡ Muito quente" (em amarelo)
function diskBadge(p) {
  const b = diskBadgeSaude(p);
  if (b[0] === 'bad') return b;
  const temp = numDisco(p.temperature), [tAt, tCr] = limTempDisco(p);
  if (temp != null && temp >= tAt) return ['warn', temp >= tCr ? 'ðŸŒ¡ Muito quente' : 'ðŸŒ¡ Quente'];
  return b;
}
// por que o selo ficou "AtenÃ§Ã£o"/"Com problema" (mesmas regras do diskBadge), com o que fazer
function diskMotivos(p) {
  const wear = numDisco(p.wear), temp = numDisco(p.temperature), errs = (numDisco(p.readErrors) || 0) + (numDisco(p.writeErrors) || 0), ruins = numDisco(p.setoresRuins) || 0;
  const ssd = discoSSD(p), subiu = discoSubiu(p), m = [];
  if (/unhealthy/i.test(p.health) || p.smartFalhou) m.push('âš  o prÃ³prio disco avisa que estÃ¡ com falha â€” faÃ§a backup e troque');
  else if (/warning/i.test(p.health)) m.push('âš  o Windows marcou o disco com alerta de saÃºde â€” mantenha o backup em dia');
  if (wear >= 70) m.push(`â³ jÃ¡ usou ${wear}% da vida Ãºtil â€” ${wear >= 90 ? 'troque logo' : 'planeje a troca'}`);
  const [tAt, tCr] = limTempDisco(p);
  if (temp >= tAt) m.push(`ðŸŒ¡ ${temp >= tCr ? 'muito quente' : 'quente'} (${temp} Â°C; o normal deste tipo de disco Ã© atÃ© ${tAt} Â°C) â€” calor nÃ£o Ã© defeito do disco: Ã© caso de manutenÃ§Ã£o (ventilaÃ§Ã£o, poeira, PC abafado), nÃ£o de trocar`);
  if (subiu >= 5) m.push(`ðŸ“ˆ os erros do disco aumentaram (+${subiu}) â€” faÃ§a backup${subiu >= 50 ? ' e troque' : ' e acompanhe'}`);
  if (!ssd && ruins > 0) m.push(`ðŸ§± ${ruins} setor(es) ruim(ns) â€” ${ruins >= 100 ? 'troque o disco' : 'acompanhe e mantenha o backup em dia'}`);
  else if (!ssd && errs > 0) m.push(`${errs} erro(s) de leitura/gravaÃ§Ã£o â€” acompanhe`);
  return m.length ? `<div class="small" style="color:var(--${diskBadge(p)[0] === 'bad' ? 'bad' : 'warn'});margin-top:4px">${m.map(esc).join('<br>')}</div>` : '';
}
// "SaÃºde 96%" como o CrystalDiskInfo: no SSD Ã© a vida Ãºtil que sobra; no HD (sem esse nÃºmero) vai em palavras
function diskSaude(p) {
  const wear = numDisco(p.wear), b = diskBadgeSaude(p); // a barra Ã© sÃ³ da saÃºde (calor nÃ£o deixa a barra vermelha)
  if (discoSSD(p) && wear != null && wear >= 0 && wear <= 100) {
    // mesmas faixas do alerta: atÃ© 30% de saÃºde (70% gasto) = atenÃ§Ã£o; atÃ© 10% (90% gasto) = ruim
    const s = 100 - wear, cls = b[0] === 'bad' || s <= 10 ? 'bad' : b[0] === 'warn' || s <= 30 ? 'warn' : '';
    const cor = cls === 'bad' ? 'var(--bad)' : cls === 'warn' ? 'var(--warn)' : 'var(--ok)';
    return `<div style="display:flex;align-items:center;gap:10px;margin:8px 0 4px"><b style="font-size:20px;color:${cor};white-space:nowrap" title="Vida Ãºtil que ainda sobra no SSD (igual ao CrystalDiskInfo)">SaÃºde ${s}%</b>
      <div class="bar ${cls}" style="flex:1"><i style="width:${s}%;${cls ? '' : 'background:var(--ok)'}"></i></div></div>`;
  }
  const txt = b[0] === 'bad' ? 'Ruim' : b[0] === 'warn' ? 'AtenÃ§Ã£o' : b[0] === 'ok' ? 'Bom' : '';
  return txt ? `<div style="margin:8px 0 4px"><b style="font-size:18px;color:var(--${b[0] === 'bad' ? 'bad' : b[0] === 'warn' ? 'warn' : 'ok'})">SaÃºde: ${txt}</b></div>` : '';
}
function diskSmart(p) {
  const it = [];
  const temp = numDisco(p.temperature), wear = numDisco(p.wear), horas = numDisco(p.powerOnHours);
  if (temp != null && temp > 0) { const [tAt, tCr] = limTempDisco(p); it.push(`ðŸŒ¡ <span data-dtemp="${esc(discoK(p))}" data-dmodel="${esc(p.model || '')}" data-lim="${tAt},${tCr}" style="color:${temp >= tCr ? 'var(--bad)' : temp >= tAt ? 'var(--warn)' : 'inherit'}" title="${p.tempAoVivo ? 'Leitura de agora (a cada 3 min; a cada 30 s com esta pÃ¡gina aberta)' : 'Leitura do Ãºltimo inventÃ¡rio'}">${esc(temp)} Â°C</span>`); }
  if (wear != null && !discoSSD(p)) it.push(`vida Ãºtil usada ${esc(wear)}%`);
  if (horas != null && horas > 0) it.push(horas < 48 ? `ligado ${esc(horas)} h no total` : `ligado ${esc(Math.round(horas / 24).toLocaleString('pt-BR'))} dias no total`);
  const errs = (numDisco(p.readErrors) || 0) + (numDisco(p.writeErrors) || 0);
  const ruins = numDisco(p.setoresRuins);
  const subiu = discoSubiu(p), desde = p.cresc && p.cresc.desde ? new Date(p.cresc.desde).toLocaleDateString('pt-BR') : '';
  if (discoSSD(p)) {
    // SSD: mostra como histÃ³rico; sÃ³ fica em destaque se estiver aumentando
    // com o smartctl: os dois contadores do disco separados (como no CrystalDiskInfo); sem ele: o que o Windows contou
    const trocados = numDisco(p.realocados), falhas = numDisco(p.incorrigiveis);
    const partes = trocados != null || falhas != null
      ? [trocados ? `${esc(trocados)} bloco(s) trocado(s) pela reserva` : '', falhas ? `${esc(falhas)} falha(s) antiga(s) de leitura/gravaÃ§Ã£o` : ''].filter(Boolean)
      : [errs ? `${esc(errs)} erro(s) registrado(s)` : (ruins ? `${esc(ruins)} bloco(s) trocado(s)` : '')].filter(Boolean);
    if (partes.length) it.push(`<span title="HistÃ³rico de toda a vida do SSD. SSDs quase nunca ficam com esses contadores em zero; o FND acompanha e avisa se aumentarem.">histÃ³rico: ${partes.join(' Â· ')}</span>`);
    if (subiu >= 5) it.push(`<b style="color:var(--${subiu >= 50 ? 'bad' : 'warn'})">aumentando: +${esc(subiu)} desde ${esc(desde)}</b>`);
    else if (errs || ruins) it.push(`<span style="color:var(--ok)">estÃ¡vel${desde ? ' desde ' + esc(desde) : ''}</span>`);
  } else {
    if (errs) it.push(`<b style="color:var(--warn)">${esc(errs)} erro(s) nÃ£o corrigidos</b>`);
    if (ruins) it.push(`<b style="color:var(--warn)">${esc(ruins)} setor(es) ruim(ns)</b>`);
    if (subiu >= 5) it.push(`<b style="color:var(--bad)">aumentando: +${esc(subiu)} desde ${esc(desde)}</b>`);
  }
  if (p.smartFalhou) it.push('<b style="color:var(--bad)">o prÃ³prio disco avisa que vai falhar</b>');
  if (!it.length) return '<div class="muted small">O disco nÃ£o informou temperatura nem horas ligado.</div>';
  return `<div class="muted small">${it.join(' Â· ')}</div>`;
}

// ---------- DRIVERS ----------
// Sites OFICIAIS de suporte (quando o Windows Update nÃ£o tem o driver)
const DRIVER_SITES = [
  [/dell/i, 'Dell', 'https://www.dell.com/support/home/pt-br'],
  [/lenovo/i, 'Lenovo', 'https://pcsupport.lenovo.com/br/pt'],
  [/hewlett|^hp\b/i, 'HP', 'https://support.hp.com/br-pt/drivers'],
  [/acer/i, 'Acer', 'https://www.acer.com/br-pt/support/drivers-and-manuals'],
  [/asus/i, 'ASUS', 'https://www.asus.com/br/support/download-center/'],
];
const CHIP_SITES = [
  [/VEN_8086/i, 'Intel', 'https://www.intel.com.br/content/www/br/pt/support/detect.html'],
  [/VEN_1002|VEN_1022/i, 'AMD', 'https://www.amd.com/pt/support/download/drivers.html'],
  [/VEN_10DE/i, 'NVIDIA', 'https://www.nvidia.com/pt-br/drivers/'],
];
function siteLink([, nome, url]) { return `<a href="${url}" target="_blank" rel="noopener noreferrer">${nome} (site oficial)</a>`; }
// drivers opcionais: o que resolve aparelho com problema vem marcado e em destaque; os outros sÃ£o sÃ³ versÃµes mais novas
const ehAMD = (u) => /advanced micro devices|\bAMD\b|ATI Technologies/i.test(`${u.manufacturer} ${u.title}`);
function driverResolve(u, probs) {
  const h = String(u.hwid || '').toUpperCase();
  return !!h && probs.some((p) => String(p.hardwareId || '').toUpperCase().startsWith(h));
}
function driversOpcionais(ups, probs, escondidos) {
  const tec = can('tecnico');
  const sel = tec && ups.every((u) => u.id);   // agente antigo nÃ£o manda o id: aÃ­ sÃ³ "Instalar todos"
  const normais = ups.map((u, i) => ({ u, i })).filter((x) => !x.u.insiste);
  const insiste = ups.map((u, i) => ({ u, i })).filter((x) => x.u.insiste);
  const algumResolve = normais.some((x) => driverResolve(x.u, probs));
  const linha = ({ u, i }, comCheck) => { const res = driverResolve(u, probs);
    return `<tr>${sel ? `<td>${comCheck ? `<input type="checkbox" data-drv="${i}" ${res ? 'checked' : ''}>` : ''}</td>` : ''}<td>${res ? '<span class="badge warn">âš  resolve aparelho com problema</span> ' : ''}${esc(u.title)}${ehAMD(u) ? '<div class="small muted">Se for da placa de vÃ­deo, prefira o driver do site da AMD.</div>' : ''}${u.insiste ? `<div class="small muted">Instalado em ${esc(dt(u.insiste))} e o Windows continua oferecendo.</div>` : ''}</td>
      <td class="hide-sm small">${esc(u.manufacturer || '')}</td><td class="hide-sm small nw">${esc(/1970/.test(u.date || '') ? 'sem data' : u.date || '')}</td><td class="small nw">${u.sizeMB >= 1 ? esc(u.sizeMB) + ' MB' : 'menos de 1 MB'}</td>
      ${tec ? `<td class="nw">${u.insiste ? `<button class="btn sm" data-drv-esconder="${i}">ðŸ™ˆ Esconder</button>` : ''}</td>` : ''}</tr>`; };
  const cab = (todos) => `<thead><tr>${sel ? (todos ? '<th><input type="checkbox" data-drv-todos title="Marcar todos"></th>' : '<th></th>') : ''}<th>Driver</th><th class="hide-sm">Fabricante</th><th class="hide-sm">Data</th><th>Tamanho</th>${tec ? '<th></th>' : ''}</tr></thead>`;
  return `${normais.length ? `<p class="muted small" style="margin:0 0 8px">${probs.length ? (algumResolve ? '<b style="color:var(--warn)">Os marcados com âš  resolvem um aparelho com problema: instale esses.</b> Os outros sÃ£o opcionais.' : 'Nenhum destes resolve os aparelhos com problema acima; procure o driver no site do fabricante.')
      : 'Os aparelhos jÃ¡ estÃ£o funcionando. Estes sÃ£o sÃ³ versÃµes mais novas: <b>nÃ£o precisa instalar</b>. Instale se algum aparelho der problema ou se quiser deixar tudo em dia.'}</p>
    <div class="table-wrap"><table>${cab(true)}<tbody>${normais.map((x) => linha(x, true)).join('')}</tbody></table></div>
    ${tec ? `<div class="btns" style="margin-top:10px">${sel ? '<button class="btn primary" data-drv-sel disabled>Instalar selecionados</button>' : ''}<button class="btn" data-drv-instalar-todos="${sel ? esc(normais.map((x) => x.u.id).join(',')) : ''}">Instalar todos (${normais.length})</button></div>
      <p class="muted small" style="margin:6px 0 0">Instala sem reiniciar. Depois o PC verifica de novo sozinho e a lista se atualiza.</p>` : ''}` : '<p>Nenhum driver novo para instalar. âœ”</p>'}
    ${insiste.length ? `<div class="card" style="margin-top:12px"><b>O Windows continua oferecendo (${insiste.length})</b>
      <p class="muted small" style="margin:4px 0 8px">JÃ¡ foram instalados, mas o PC tem um driver igual ou melhor, entÃ£o o Windows Update continua mostrando (defeito conhecido do Windows). <b>NÃ£o precisa fazer nada</b>: pode esconder.</p>
      <div class="table-wrap"><table>${cab(false)}<tbody>${insiste.map((x) => linha(x, false)).join('')}</tbody></table></div>
      ${tec && insiste.length > 1 ? '<div class="btns" style="margin-top:8px"><button class="btn sm" data-drv-esconder-insiste>ðŸ™ˆ Esconder todos estes</button></div>' : ''}</div>` : ''}
    ${escondidos ? `<p class="muted small" style="margin-top:8px">ðŸ™ˆ ${escondidos} driver(s) escondido(s) neste PC.${tec ? ' <a href="#" data-drv-mostrar>Voltar a mostrar</a>' : ''}</p>` : ''}`;
}
// liga os botÃµes da lista de drivers (no resultado da tarefa e na aba AtualizaÃ§Ãµes)
function bindDrivers(el, devId, ups, depois) {
  const marc = () => $$('[data-drv]:checked', el).map((c) => ups[Number(c.dataset.drv)].id);
  const bt = $('[data-drv-sel]', el);
  const atual = () => { if (!bt) return; const n = marc().length; bt.disabled = !n; bt.textContent = n ? `Instalar selecionados (${n})` : 'Instalar selecionados'; };
  $$('[data-drv]', el).forEach((c) => { c.onchange = () => { atual(); if (depois) depois(); }; });
  const todos = $('[data-drv-todos]', el);
  if (todos) todos.onchange = () => { $$('[data-drv]', el).forEach((c) => { c.checked = todos.checked; }); atual(); if (depois) depois(); };
  atual();
  if (bt) bt.onclick = () => { const ids = marc(); if (ids.length) taskDialog([devId], 'drivers_instalar', { ids: ids.join(',') }); };
  // "Instalar todos" nÃ£o reinstala os que o Windows insiste em oferecer
  const tb = $('[data-drv-instalar-todos]', el); if (tb) tb.onclick = () => (tb.dataset.drvInstalarTodos ? taskDialog([devId], 'drivers_instalar', { ids: tb.dataset.drvInstalarTodos }) : taskDialog([devId], 'drivers_instalar'));
  const esconder = async (titulos) => {
    if (depois) depois();
    try { for (const title of titulos) await POST(`/devices/${encodeURIComponent(devId)}/drivers-esconder`, { title }); toast(titulos.length > 1 ? `${titulos.length} drivers escondidos.` : 'Driver escondido.', 'ok'); atualizarTela(); } catch (e) { fail(e); }
  };
  $$('[data-drv-esconder]', el).forEach((b) => { b.onclick = () => esconder([ups[Number(b.dataset.drvEsconder)].title]); });
  const ei = $('[data-drv-esconder-insiste]', el); if (ei) ei.onclick = () => esconder(ups.filter((u) => u.insiste).map((u) => u.title));
}
function driversView(r) {
  const fab = DRIVER_SITES.find(([re]) => re.test(r.manufacturer || ''));
  const probs = r.problems || [];
  const ups = r.updates || [];
  return `${r.manufacturer || r.model ? `<p class="muted small">Computador: <b>${esc(r.manufacturer || '')} ${esc(r.model || '')}</b>${fab ? ' Â· drivers oficiais: ' + siteLink(fab) : ''}</p>` : ''}
    <h3>Aparelhos com problema</h3>${probs.length ? `<table><thead><tr><th>Aparelho</th><th>Problema</th><th class="hide-sm">CÃ³digo do aparelho</th><th class="hide-sm">Onde achar</th></tr></thead><tbody>${probs.map((p) => {
      const chip = CHIP_SITES.find(([re]) => re.test(p.hardwareId || ''));
      return `<tr><td><b>${esc(p.device)}</b><div class="muted small">${esc(p.class || '')}</div></td><td><span class="badge warn">${esc(p.problem)}</span></td><td class="hide-sm mono small">${esc(p.hardwareId || '')}</td>
        <td class="hide-sm small">${ups.length ? 'Tente primeiro o Windows Update' : ''}${chip ? (ups.length ? ' Â· ' : '') + siteLink(chip) : fab ? (ups.length ? ' Â· ' : '') + siteLink(fab) : ''}</td></tr>`; }).join('')}</tbody></table>`
      : '<p>Nenhum aparelho com problema de driver. âœ”</p>'}
    <h3 style="margin-top:14px">Drivers opcionais do Windows Update</h3>${r.updatesError ? `<p class="muted">${esc(r.updatesError)}</p>` : ups.length || r.escondidos ? driversOpcionais(ups, probs, r.escondidos) : '<p>Nenhum driver novo disponÃ­vel. âœ”</p>'}
    ${(r.main || []).length ? `<details style="margin-top:14px"><summary>Drivers principais instalados (vÃ­deo, rede, som...)</summary>${autoTable(r.main.map((m) => ({ aparelho: m.device, tipo: m.class, fabricante: m.provider, versÃ£o: m.version, data: m.date })))}</details>` : ''}
    <p class="muted small" style="margin-top:10px">Os drivers do Windows Update vÃªm dos prÃ³prios fabricantes e sÃ£o verificados pela Microsoft. Se o driver nÃ£o estiver lÃ¡, baixe sÃ³ do site oficial e envie o .zip (com os arquivos .inf) ou o instalador em <a href="#/instaladores">Meus instaladores</a>. Evite sites de "drivers grÃ¡tis".</p>`;
}

// temperatura na lista de PCs: nÃºmero em Â°C com cor (verde / amarelo / vermelho); "â€”" sem leitura recente
function tempLista(d) {
  const recente = d.tempQuando && Date.now() - new Date(d.tempQuando).getTime() < 15 * 60000;
  if (d.status !== 'online' || d.temp == null || !recente) return '<span class="muted" title="Sem leitura da temperatura do processador">â€”</span>';
  const lim = 85, t = Math.round(d.temp);
  const cor = t >= lim ? 'var(--bad)' : t >= lim - 10 ? 'var(--warn)' : 'var(--ok)';
  return `<b style="color:${cor}" title="${d.tempFonte === 'cpu' ? 'Temperatura do processador' : 'Sensor da placa-mÃ£e (aproximado)'}">${t} Â°C</b>${d.tempFonte === 'cpu' ? '' : '<span class="muted small" title="Sensor da placa-mÃ£e (aproximado)">*</span>'}`;
}

function taskTable(rows, showPc = true) {
  if (!rows.length) return '<div class="card muted">Nenhuma tarefa.</div>';
  return `<div class="table-wrap"><table><thead><tr><th>#</th><th>Tarefa</th>${showPc ? '<th>Computador</th>' : ''}<th>Status</th><th>Por</th><th>Criada</th><th class="hide-sm">Agendada</th><th class="hide-sm">ConcluÃ­da</th><th></th></tr></thead><tbody>
    ${rows.map((t) => { const p = t.params ? JSON.parse(t.params) : {}; const extra = p.id || (t.action === 'instalar_pacote' ? p.arquivo : p.nome) || p.termo || '';
      return `<tr class="click" data-task="${t.id}"><td class="muted">${t.id}</td><td>${esc(actLabel(t.action))}${extra ? ` <span class="mono small muted">${esc(extra)}</span>` : ''}</td>
      ${showPc ? `<td>${devName(t)}${t.client_name ? `<div class="muted small">${esc(t.client_name)}</div>` : ''}</td>` : ''}
      <td><span class="badge ${esc(t.status)}">${esc(statusLabel[t.status] || t.status)}</span>${waitLabel(t) ? `<div class="muted small">${esc(waitLabel(t))}</div>` : ''}${progBar(t)}</td><td class="small">${esc(t.created_by || '')}</td>
      <td class="small">${when(t.created_at)}</td><td class="small hide-sm">${t.scheduled_for ? dt(t.scheduled_for) : 'â€”'}</td><td class="small hide-sm">${when(t.finished_at)}</td>
      <td>${['pendente', 'enviada', 'executando'].includes(t.status) && can('tecnico') ? `<button class="btn sm${t.status === 'pendente' ? '' : ' danger'}" data-cancel="${t.id}" data-enc="${t.status === 'pendente' ? '' : '1'}">${t.status === 'pendente' ? 'Cancelar' : 'Encerrar'}</button>` : ''}</td></tr>`; }).join('')}</tbody></table></div>`;
}
function bindTaskTable(el) {
  $$('[data-task]', el).forEach((tr) => tr.addEventListener('click', (e) => { if (e.target.closest('button')) return; openTask(tr.dataset.task); }));
  $$('[data-cancel]', el).forEach((b) => { b.onclick = async (ev) => {
    ev.stopPropagation();
    const enc = !!b.dataset.enc;
    if (enc && !(await confirmBox('Encerrar tarefa', `Encerrar a tarefa #${b.dataset.cancel}? Se ela ainda estiver rodando no computador, o processo Ã© finalizado na hora.`, 'Encerrar', true))) return;
    try { await POST(`/tasks/${b.dataset.cancel}/cancel`); toast(enc ? 'Tarefa encerrada.' : 'Tarefa cancelada.', 'ok'); S.view.refresh(); } catch (e) { fail(e); } }; });
}

// tabela de apps desatualizados com caixinhas + "Atualizar selecionados" / "Atualizar todos"
function appsTable(apps) {
  const can2 = S.actionMap.app_atualizar && S.actionMap.app_atualizar.allowed;
  return `${can2 ? `<div class="btns" style="margin-bottom:10px"><button class="btn primary sm" data-upall>Atualizar todos (${apps.length})</button><button class="btn sm" data-upsel disabled>Atualizar selecionados</button></div>` : ''}
    <div class="table-wrap"><table><thead><tr>${can2 ? '<th><input type="checkbox" data-selall></th>' : ''}<th>Aplicativo</th><th>ID</th><th>Instalada</th><th>DisponÃ­vel</th>${can2 ? '<th></th>' : ''}</tr></thead><tbody>
    ${apps.map((a) => `<tr>${can2 ? `<td><input type="checkbox" data-app="${esc(a.id)}"></td>` : ''}<td>${esc(a.name)}</td><td class="mono small">${esc(a.id)}</td><td>${esc(a.version)}</td><td><b>${esc(a.available)}</b></td>
      ${can2 ? `<td class="nw"><button class="btn sm" data-up="${esc(a.id)}">Atualizar</button>${S.actionMap.app_ignorar && S.actionMap.app_ignorar.allowed ? ` <button class="btn sm ghost" data-app-ignorar="${esc(a.id)}" data-nome="${esc(a.name)}" title="NÃ£o mostrar mais este app como desatualizado neste PC">ðŸ™ˆ</button>` : ''}</td>` : ''}</tr>`).join('')}</tbody></table></div>`;
}
function bindAppsTable(el, deviceId, onDone) {
  const sel = () => $$('[data-app]:checked', el).map((c) => c.dataset.app);
  const sync = () => { const b = $('[data-upsel]', el); if (b) { const n = sel().length; b.disabled = !n; b.textContent = `Atualizar selecionados${n ? ` (${n})` : ''}`; } };
  $$('[data-app]', el).forEach((c) => { c.onchange = sync; });
  const all = $('[data-selall]', el); if (all) all.onchange = () => { $$('[data-app]', el).forEach((c) => { c.checked = all.checked; }); sync(); };
  $$('[data-up]', el).forEach((b) => { b.onclick = () => quickTask(deviceId, 'app_atualizar', { id: b.dataset.up }); });
  const up = $('[data-upall]', el); if (up) up.onclick = () => { if (onDone) onDone(); quickTask(deviceId, 'app_atualizar_todos'); };
  const us = $('[data-upsel]', el); if (us) us.onclick = () => { const ids = sel(); if (!ids.length) return; if (onDone) onDone(); quickTask(deviceId, 'apps_atualizar_lista', { ids: ids.join(',') }); };
  bindAppAcoes(el, deviceId, onDone);
}

// resultado detalhado de atualizaÃ§Ã£o/instalaÃ§Ã£o pelo winget (resumo, falhas, reinÃ­cio)
const APP_STATUS = { ignorado: ['', 'ðŸ™ˆ Alarme falso (escondido)'], ok: ['ok', 'âœ” Atualizado'], falhou: ['bad', 'âœ– Falhou'], reiniciar: ['warn', 'â†» Precisa reiniciar'], naopegou: ['warn', 'âš  NÃ£o pegou'], reinstalar: ['warn', 'ðŸ” Precisa reinstalar'], desconhecida: ['warn', '? VersÃ£o desconhecida'] };
// ===== RelatÃ³rios: imprimir / PDF (com a logo da FND) e mandar resumo no WhatsApp do cliente =====
// WhatsApp: abre a conversa com o resumo pronto (wa.me). Arquivo (PDF) o WhatsApp nÃ£o deixa um sistema mandar
// sozinho sem a API paga: o PDF sai pelo "Imprimir â†’ Salvar como PDF" e vocÃª anexa na conversa.
// telefone do Brasil formatado: (11) 96012-4439 / (11) 3456-7890; o que nÃ£o for do Brasil fica como foi digitado
function foneBR(t) {
  let n = String(t || '').replace(/\D/g, '');
  if ((n.length === 12 || n.length === 13) && n.startsWith('55')) n = n.slice(2);
  if (n.length === 11) return `(${n.slice(0, 2)}) ${n.slice(2, 7)}-${n.slice(7)}`;
  if (n.length === 10) return `(${n.slice(0, 2)}) ${n.slice(2, 6)}-${n.slice(6)}`;
  if (n.length === 9) return `${n.slice(0, 5)}-${n.slice(5)}`;
  if (n.length === 8) return `${n.slice(0, 4)}-${n.slice(4)}`;
  return String(t || '');
}
function zapNumero(clientId) {
  const c = S.clients.find((x) => String(x.id) === String(clientId));
  let n = String((c && c.phone) || '').replace(/\D/g, '');
  if (n.length === 10 || n.length === 11) n = '55' + n;   // nÃºmero do Brasil sem o 55
  return n.length >= 12 && n.length <= 15 ? n : '';
}
function abrirZap(texto, clientId) {
  const n = zapNumero(clientId);
  const url = `https://wa.me/${n}?text=${encodeURIComponent(texto.slice(0, 3500))}`;
  window.open(url, '_blank', 'noopener');
  if (!n) toast('Este cliente nÃ£o tem WhatsApp cadastrado: escolha o contato no WhatsApp. Para ir direto, preencha "Telefone / WhatsApp" no cadastro do cliente.', 'warn');
  else toast('WhatsApp aberto com o resumo. Para mandar o PDF: Imprimir â†’ Salvar como PDF e anexe na conversa.', 'ok');
}
// ðŸ· etiquetas para colar nos PCs (nÃºmero, nome do PC e cliente); gera o nÃºmero de quem nÃ£o tem
async function imprimirEtiquetas(ids) {
  if (!ids.length) return;
  const ets = [];
  for (const id of ids.slice(0, 60)) {
    try {
      let e = await GET(`/devices/${encodeURIComponent(id)}/etiqueta`);
      if (!e.patrimonio) { await POST(`/devices/${encodeURIComponent(id)}/etiqueta`); e = await GET(`/devices/${encodeURIComponent(id)}/etiqueta`); }
      ets.push(e);
    } catch (er) { fail(er); return; }
  }
  let box = $('#print-area');
  if (!box) { box = document.createElement('div'); box.id = 'print-area'; document.body.appendChild(box); }
  box.innerHTML = `<div class="etiquetas">${ets.map((e) => `<div class="etiqueta">
    <div><div class="etq-cod">${esc(e.patrimonio)}</div><div class="etq-nome">${esc(e.nome)}</div><div class="etq-cli">${esc(e.cliente)}</div><div class="etq-rod">Suporte: ${esc(S.me.centralName || 'FND Sistemas')}</div></div></div>`).join('')}</div>`;
  document.body.classList.add('imprimindo');
  const fim = () => { document.body.classList.remove('imprimindo'); window.removeEventListener('afterprint', fim); };
  window.addEventListener('afterprint', fim);
  setTimeout(() => window.print(), 300);
  if (VIEWS.pc && S.view === VIEWS.pc) setTimeout(() => VIEWS.pc.refresh(), 600);
}
function imprimirArea(titulo, info, corpo) {
  let box = $('#print-area');
  if (!box) { box = document.createElement('div'); box.id = 'print-area'; document.body.appendChild(box); }
  box.innerHTML = `<div class="report"><div class="head"><img src="/img/logo.png" alt=""><div><h1 style="margin:0">${esc(titulo)}</h1><div class="small">${info}</div></div></div>${corpo}
    <p class="small" style="margin-top:24px;color:#64748b">FND Sistemas Â· relatÃ³rio gerado pelo FND Remoto em ${esc(new Date().toLocaleString('pt-BR'))}</p></div>`;
  document.body.classList.add('imprimindo');
  const fim = () => { document.body.classList.remove('imprimindo'); window.removeEventListener('afterprint', fim); };
  window.addEventListener('afterprint', fim);
  setTimeout(() => window.print(), 50);
}
// resumo em texto de cada tipo de tarefa (WhatsApp)
function resumoTexto(t) {
  const r = t.result || {}, a = t.action;
  const L = [`*FND Sistemas Â· ${actLabel(a)}*`, `Computador: ${t.alias || t.hostname}`, `Data: ${dt(t.finished_at || t.created_at)}`, ''];
  const lista = (xs, n = 8) => xs.slice(0, n).map((x) => `â€¢ ${x}`).concat(xs.length > n ? [`â€¢ â€¦ e mais ${xs.length - n}`] : []);
  if (a === 'diagnostico') {
    L.push(...((r.problems || []).length ? ['*Precisa de atenÃ§Ã£o:*', ...lista(r.problems)] : ['Nenhum problema encontrado âœ”']), '', diagFrase(r), '');
    const pr = diagProgramas(r).filter((p) => p.cpu >= 1 || p.mem >= 300).slice(0, 5);
    if (pr.length) L.push('*O que estÃ¡ usando o PC:*', ...lista(pr.map((p) => `${p.nome}: ${p.cpu >= 1 ? `processador ${Math.round(p.cpu)}%, ` : ''}memÃ³ria ${memTxt(p.mem)}`)));
    L.push(`Programas abrindo com o Windows: ${r.startupCount}`);
  } else if (a === 'termico') {
    const s = termicoSituacao(r);
    L.push(termicoFrase(r));
    if (s && s.dica) L.push('', s.dica);
  } else if (a === 'espaco_disco') {
    L.push(`Disco ${r.disco || 'C:'}: ${Math.round(r.livreGB)} GB livres de ${Math.round(r.totalGB)} GB`, '', '*O que mais ocupa:*', ...lista((r.itens || []).slice().sort((x, y) => y.gb - x.gb).map((x) => `${x.nome}: ${x.gb >= 1 ? Math.round(x.gb * 10) / 10 + ' GB' : Math.round(x.gb * 1024) + ' MB'}`), 6));
  } else if (a === 'virus_segunda') {
    L.push(r.message || '', ...lista((r.achados || []).map((x) => x.nome)));
  } else if (/^virus_/.test(a)) {
    const prods = (r.produtos || []).filter((x) => x.enabled).map((x) => x.name);
    const ativas = (r.ameacas || []).filter((x) => x.ativa);
    L.push(r.message || '', `AntivÃ­rus ativo: ${prods.join(', ') || 'nenhum'}`, ativas.length ? `*AmeaÃ§as ativas (${ativas.length}):*` : 'Nenhuma ameaÃ§a ativa âœ”', ...lista(ativas.map((x) => x.nome)));
  } else if (a === 'drivers_verificar') {
    L.push((r.problems || []).length ? `Aparelhos com problema: ${r.problems.length}` : 'Nenhum aparelho com problema de driver âœ”', ...lista((r.problems || []).map((p) => `${p.device}: ${p.problem}`)), `Drivers opcionais disponÃ­veis: ${(r.updates || []).length}`);
  } else if (a === 'inicializacao_listar' || a === 'inicializacao_alterar') {
    const on = (r.itens || []).filter((x) => x.ativo);
    L.push(`${on.length} programa(s) abrindo com o Windows:`, ...lista(on.map((x) => x.descricao || x.nome), 15));
  } else if (a === 'windows_update_instalar') {
    L.push(...(r.installed || []).map((x) => `â€¢ ${x.title}: ${x.result}${/Falhou|erros/i.test(String(x.result)) && wuDica(x.hresult) ? ` (${x.hresult}: ${wuDica(x.hresult).texto})` : ''}`));
  } else if (a === 'windows_update_reparar') {
    L.push(r.message || '', ...(r.passos || []).map((p) => `â€¢ ${p}`));
  } else if (/^restauracao_/.test(a)) {
    if (r.message) L.push(r.message, '');
    L.push(`ProteÃ§Ã£o do sistema: ${r.ligado ? 'ligada' : 'desligada'}`, `Pontos guardados: ${(r.pontos || []).length}`);
    if ((r.pontos || [])[0]) L.push(`Mais recente: ${new Date(r.pontos[0].quando).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' })} (${r.pontos[0].descricao})`);
  } else if (a === 'lixeira_windows') {
    L.push(r.message || 'Lixeira esvaziada.');
  } else if (['segundo_plano_listar', 'segundo_plano_alterar', 'segundo_plano_lote'].includes(a)) {
    const Ls = r.lista || r;
    if (r.message) L.push(r.message, '');
    L.push(`Programas rodando agora: ${(Ls.processos || []).length}`, `Apps do Windows em segundo plano: ${(Ls.apps || []).filter((x) => x.ativo).length}`,
      `Tarefas agendadas ligadas: ${(Ls.tarefas || []).filter((x) => x.ativo).length}`, `ServiÃ§os que ligam com o Windows: ${(Ls.servicos || []).filter((x) => x.ativo).length}`);
  } else if (a === 'apps_verificar') {
    L.push((r.apps || []).length ? `*${r.apps.length} aplicativo(s) desatualizado(s):*` : 'Todos os aplicativos estÃ£o atualizados âœ”', ...lista((r.apps || []).map((x) => `${x.name}: ${x.version} â†’ ${x.available}`), 12));
  } else if (r.apps || r.summary) {
    L.push(r.summary || r.message || '', ...lista((r.apps || []).map((x) => `${x.name}: ${x.status === 'ok' ? 'atualizado' : x.status === 'reiniciar' ? 'precisa reiniciar' : 'nÃ£o atualizou'}`), 12));
  } else if (r.liberadoGB != null) {
    L.push(`EspaÃ§o liberado: ${r.liberadoGB >= 1 ? Math.round(r.liberadoGB * 10) / 10 + ' GB' : Math.round(r.liberadoGB * 1024) + ' MB'}`, r.livreGB != null ? `Livre agora: ${r.livreGB} GB` : '');
  } else L.push(r.message || r.summary || (t.status === 'concluida' ? 'ConcluÃ­do âœ”' : statusLabel[t.status] || t.status));
  L.push('', `TÃ©cnico: ${S.me.name || S.me.username}`);
  return L.filter((x, i, arr) => !(x === '' && arr[i - 1] === '')).join('\n');
}

// por que o PC ficou offline (o agente conta quando volta, pelo registro do Windows)
const QUEDA_ICO = { tela_azul: 'ðŸŸ¥', sem_aviso: 'âš¡', reiniciado: 'ðŸ”„', desligado: 'â»', suspensao: 'ðŸŒ™', servico: 'â›”', agente: 'â›”', internet: 'ðŸ“¶', conexao: 'ðŸŒ', atualizacao: 'â¬†', desconhecido: 'â”' };
function quedaTxt(d) {
  // sÃ³ o que importa agora: offline neste momento, ou a Ãºltima vez que ficou offline (sem lista de histÃ³rico: tela limpa)
  const l = d.quedas || [];
  if (d.status !== 'online' && !d.revoked) {
    const w = d.lastSeen ? when(d.lastSeen) : '';
    return `<dt>Agora</dt><dd>âšª <b>Offline</b>${w ? (w === 'agora' ? ' agora mesmo' : /^hÃ¡ /.test(w) ? ' ' + esc(w) : ' desde ' + esc(w)) : ''} <span class="muted small">â€” desligado, sem internet ou o agente parado. O motivo aparece aqui quando ele voltar.</span></dd>`;
  }
  if (!l.length) return '';
  const q = l[0];
  const quando = q.voltou ? `voltou ${when(q.voltou)}` : '';
  return `<dt>Ãšltima vez offline</dt><dd>${QUEDA_ICO[q.tipo] || 'â”'} ${esc(q.texto)}${q.duracao ? ` <span class="muted small">(ficou fora ${esc(q.duracao)}${quando ? ', ' + esc(quando) : ''})</span>` : ''}</dd>`;
}
// "ligado hÃ¡ 3 dias" (sÃ³ com o PC online; avisa quando passa de 7 dias sem reiniciar)
function ligadoHa(d, curto) {
  if (d.status !== 'online' || !d.ligadoDesde) return '';
  const min = (Date.now() - d.ligadoDesde) / 60000;
  if (!(min >= 0)) return '';
  const txt = duracao(min), dias = min / 1440;
  const desde = ` data-ligado="${Number(d.ligadoDesde)}"${curto ? ' data-curto' : ''}`;
  return dias >= 7 ? `<span${desde} style="color:var(--warn)" title="Ligado hÃ¡ ${esc(txt)} sem reiniciar. Reiniciar de vez em quando deixa o Windows mais rÃ¡pido e termina as atualizaÃ§Ãµes.">ligado hÃ¡ ${esc(txt)} âš </span>`
    : `<span${desde}${curto ? ' class="muted"' : ''}>ligado hÃ¡ ${esc(txt)}</span>`;
}
// "ligado hÃ¡" anda sozinho na tela (a cada 30 s troca sÃ³ o texto, sem redesenhar nada)
setInterval(() => {
  if (document.hidden) return;
  for (const el of document.querySelectorAll('[data-ligado]')) {
    const novo = ligadoHa({ status: 'online', ligadoDesde: Number(el.dataset.ligado) }, el.hasAttribute('data-curto'));
    if (!novo) continue;
    const t = document.createElement('template'); t.innerHTML = novo; const n = t.content.firstElementChild;
    if (n && n.textContent !== el.textContent) el.replaceWith(n);
  }
}, 30000);
// tempo real: "45 min", "7 h 12 min", "2 dias e 5 h" (antes aparecia "0,3 dia(s)")
function duracao(min) {
  min = Math.max(0, Math.round(Number(min) || 0));
  if (min < 60) return `${min} min`;
  const d = Math.floor(min / 1440), h = Math.floor((min % 1440) / 60), m = min % 60;
  if (!d) return m ? `${h} h ${m} min` : `${h} h`;
  return `${d} dia${d > 1 ? 's' : ''}${h ? ` e ${h} h` : ''}`;
}
// programas que iniciam com o Windows: ligar/desligar (igual ao Gerenciador de Tarefas; nÃ£o desinstala nada)
function inicioView(r) {
  const it = r.itens || [];
  const tec = can('tecnico') && S.actionMap.inicializacao_alterar;
  const lig = it.filter((x) => x.ativo).length;
  return `${r.message ? `<p><b>${esc(r.message)}</b></p>` : ''}
    <p class="muted small" style="margin:0 0 8px"><b>${lig}</b> de ${it.length} abrem sozinhos com o Windows. Desligar <b>nÃ£o desinstala</b>: o programa sÃ³ deixa de abrir sozinho (dÃ¡ para religar a qualquer hora). Os do Windows e do antivÃ­rus ficam protegidos.</p>
    <div class="table-wrap"><table><thead><tr><th>Programa</th><th class="hide-sm">Fabricante</th><th class="hide-sm">Para quem</th><th>SituaÃ§Ã£o</th>${tec ? '<th></th>' : ''}</tr></thead><tbody>
    ${it.map((x, i) => `<tr><td><b>${esc(x.descricao || x.nome)}</b>${x.descricao && x.descricao !== x.nome ? ` <span class="muted small">(${esc(x.nome)})</span>` : ''}<div class="mono small muted" style="word-break:break-all">${esc(x.comando || '')}</div></td>
      <td class="hide-sm small">${esc(x.fabricante || 'â€”')}</td><td class="hide-sm small">${esc(x.quem || '')}</td>
      <td class="nw">${x.ativo ? '<span class="badge ok">Liga junto</span>' : '<span class="badge">Desligado</span>'}${x.protegido ? ' <span class="badge" title="Windows ou antivÃ­rus">ðŸ”’</span>' : ''}</td>
      ${tec ? `<td class="nw">${x.ativo ? (x.protegido ? '' : `<button class="btn sm" data-ini="${i}" data-ligar="nao">Desligar</button>`) : `<button class="btn sm" data-ini="${i}" data-ligar="sim">Religar</button>`}</td>` : ''}</tr>`).join('')}</tbody></table></div>`;
}
function bindInicio(m, t, parar) {
  const ver = $('[data-ini-ver]', m); if (ver) ver.onclick = () => { if (parar) parar(); quickTask(t.device_id, 'inicializacao_listar'); };
  const it = (t.result && t.result.itens) || [];
  $$('[data-ini]', m).forEach((b) => { b.onclick = () => {
    const x = it[Number(b.dataset.ini)]; if (!x) return;
    if (parar) parar();
    quickTask(t.device_id, 'inicializacao_alterar', { escopo: x.escopo, tipo: x.tipo, nome: x.nome, ligar: b.dataset.ligar });
  }; });
}

// ===== segundo plano: o que fica rodando escondido (ver, fechar, desligar, religar) =====
function segundoView(r) {
  const L = r.lista || r;
  const tec = can('tecnico') && S.actionMap.segundo_plano_lote;
  const proc = L.processos || [], apps = L.apps || [], tar = L.tarefas || [], srv = L.servicos || [];
  const mant = r.mantidos || [];
  const etiqueta = (x) => (x.protegido ? '<span class="badge" title="Windows, antivÃ­rus, driver ou o FND: nÃ£o Ã© mexido por aqui">ðŸ”’ protegido</span>'
    : x.cuidado ? '<span class="badge warn" title="Pode ter trabalho aberto: fechar perde o que nÃ£o foi salvo">âš  cuidado</span>' : '<span class="badge ok">âœ… pode</span>');
  const ck = (x, grp) => (!tec || x.protegido ? '' : `<input type="checkbox" data-sp-ck="${esc(x.tipo)}|${esc(x.id)}" data-sp-grp="${grp}" data-sp-cuidado="${x.cuidado ? 1 : 0}" data-sp-nome="${esc(x.nome)}">`);
  const religar = (x) => (tec ? `<button class="btn sm" data-sp-religar="${esc(x.tipo)}|${esc(x.id)}">Religar</button>` : '');
  const todos = (grp, n) => (tec && n ? `<label class="small" style="display:inline-flex;gap:6px;align-items:center;margin:0 0 6px;color:var(--text)"><input type="checkbox" data-sp-todos="${grp}" style="width:auto;min-width:0;margin:0"> Marcar todos${grp === 'proc' ? ' (menos os âš )' : ''}</label>` : '');
  const memTot = proc.reduce((a, x) => a + (x.memMB || 0), 0);
  const appsOn = apps.filter((a) => a.ativo), tarOn = tar.filter((x) => x.ativo), srvOn = srv.filter((x) => x.ativo);
  // resultado item por item, com o que o agente CONFERIU depois (fechou mesmo? saiu da inicializaÃ§Ã£o?)
  const resultado = (r.resultados || []).length ? `<div class="card" style="margin-bottom:12px"><b>${esc(String(r.message || '').replace(/^âœ” ?Confirmado: ?/, ''))}</b>${r.verificado ? '<div class="muted small" style="margin:2px 0 6px">Conferido no computador alguns segundos depois.</div>' : ''}${r.resultados.map((x) => { const nc = x.ok && x.verificado === false; return `<div class="small" style="margin:3px 0;color:var(--${!x.ok ? 'bad' : nc ? 'warn' : 'text'})">${!x.ok ? 'âœ–' : nc ? 'âš ' : x.verificado ? 'âœ…' : 'âœ”'} <b>${esc(x.nome)}</b>: ${esc(x.ok && x.confere ? x.confere : x.msg)}</div>`; }).join('')}</div>` : (r.message ? `<p><b>${esc(r.message)}</b></p>` : '');
  return `${resultado}
    <p class="muted small" style="margin:0 0 10px">Marque o que quer fechar ou desligar e clique no botÃ£o lÃ¡ embaixo. <b>ðŸ”’ protegido</b> (Windows, antivÃ­rus, drivers, FND) nÃ£o tem caixinha. <b>âš  cuidado</b> pode ter trabalho aberto: o "Marcar todos" nÃ£o marca, marque sÃ³ se tiver certeza. O que vocÃª desliga <b>fica desligado</b>: se o programa se religar sozinho (ao se atualizar), o agente desliga de novo. SÃ³ volta quando vocÃª clicar em "Religar".</p>
    <h3>ðŸ–¥ Rodando agora <span class="muted small">(${proc.length} programa(s) de outros fabricantes Â· ${esc(memTxt(memTot))})</span></h3>
    ${proc.length ? `${todos('proc', proc.filter((x) => !x.protegido).length)}<div class="table-wrap"><table><thead><tr>${tec ? '<th></th>' : ''}<th>Programa</th><th>MemÃ³ria</th><th class="hide-sm">Abre com o Windows?</th><th></th></tr></thead><tbody>
      ${proc.map((x) => `<tr>${tec ? `<td>${ck(x, 'proc')}</td>` : ''}<td><b>${esc(x.nome)}</b>${x.n > 1 ? ` <span class="muted small">(${esc(x.n)} processos)</span>` : ''}<div class="muted small">${esc(x.fabricante || '')}</div></td>
        <td class="nw">${esc(memTxt(x.memMB || 0))}</td><td class="hide-sm small">${x.inicio ? (x.inicio.ativo ? '<span class="badge warn">Sim</span>' : 'NÃ£o (desligado)') : 'NÃ£o'}</td><td class="nw">${etiqueta(x)}</td></tr>`).join('')}</tbody></table></div>` : '<p class="muted">Nenhum programa de outro fabricante rodando agora.</p>'}
    <h3 style="margin-top:16px">ðŸ“± Apps do Windows em segundo plano <span class="muted small">(${appsOn.length} com permissÃ£o)</span></h3>
    ${apps.length ? `${todos('app', appsOn.filter((x) => !x.protegido).length)}<div class="table-wrap"><table><thead><tr>${tec ? '<th></th>' : ''}<th>App</th><th class="hide-sm">UsuÃ¡rio</th><th data-semfiltro>SituaÃ§Ã£o</th></tr></thead><tbody>
      ${apps.map((x) => `<tr>${tec ? `<td>${x.ativo ? ck(x, 'app') : ''}</td>` : ''}<td><b>${esc(x.nome)}</b></td><td class="hide-sm small">${esc(x.usuario || '')}</td><td class="nw">${x.protegido ? etiqueta(x) : x.ativo ? '<span class="badge warn">Roda em segundo plano</span>' : `<span class="badge ok">Desligado</span> ${religar(x)}`}</td></tr>`).join('')}</tbody></table></div>`
      : '<p class="muted">Nenhum app da Store com permissÃ£o de segundo plano.</p>'}
    <h3 style="margin-top:16px">â° Tarefas agendadas de outros programas <span class="muted small">(${tarOn.length} ligada(s))</span></h3>
    ${tar.length ? `${todos('tar', tarOn.filter((x) => !x.protegido).length)}<div class="table-wrap"><table><thead><tr>${tec ? '<th></th>' : ''}<th>Tarefa</th><th class="hide-sm" data-semfiltro>Quando roda</th><th data-semfiltro>SituaÃ§Ã£o</th></tr></thead><tbody>
      ${tar.map((x) => `<tr>${tec ? `<td>${x.ativo ? ck(x, 'tar') : ''}</td>` : ''}<td><b>${esc(x.descricao || x.nome)}</b>${x.descricao && x.descricao !== x.nome ? ` <span class="muted small">(${esc(x.nome)})</span>` : ''}<div class="muted small">${esc(x.fabricante || '')}</div></td><td class="hide-sm small">${esc(x.quando || 'â€”')}</td>
        <td class="nw">${x.protegido ? etiqueta(x) : x.ativo ? '<span class="badge warn">Ligada</span>' : `<span class="badge ok">Desativada</span> ${religar(x)}`}</td></tr>`).join('')}</tbody></table></div>`
      : '<p class="muted">Nenhuma tarefa agendada de outros programas.</p>'}
    <h3 style="margin-top:16px">âš™ ServiÃ§os de outros programas <span class="muted small">(${srvOn.length} ligam com o Windows)</span></h3>
    ${srv.length ? `${todos('srv', srvOn.filter((x) => !x.protegido).length)}<div class="table-wrap"><table><thead><tr>${tec ? '<th></th>' : ''}<th>ServiÃ§o</th><th data-semfiltro>SituaÃ§Ã£o</th></tr></thead><tbody>
      ${srv.map((x) => `<tr>${tec ? `<td>${x.ativo ? ck(x, 'srv') : ''}</td>` : ''}<td><b>${esc(x.nome)}</b><div class="muted small">${esc(x.fabricante || '')}</div></td>
        <td class="small nw">${x.protegido ? etiqueta(x) : x.ativo ? '<span class="badge warn">Liga com o Windows</span>' : `<span class="badge ok">Manual</span> ${religar(x)}`}${x.rodando ? ' <span class="muted">Â· rodando</span>' : ''}</td></tr>`).join('')}</tbody></table></div>`
      : '<p class="muted">Nenhum serviÃ§o de outros programas ligando com o Windows.</p>'}
    ${mant.length ? `<h3 style="margin-top:16px">ðŸ›¡ Mantidos desligados por vocÃª (${mant.length})</h3>
      <p class="muted small" style="margin:0 0 6px">O agente confere quando o PC liga e de hora em hora: se algum voltar sozinho, desliga de novo (fica no HistÃ³rico de atividades).</p>
      ${mant.map((x) => `<div class="row small" style="align-items:center;gap:8px;margin:4px 0"><div style="flex:1"><b>${esc(x.nome)}</b> <span class="muted">Â· ${esc({ inicio: 'abrir com o Windows', app: 'app em segundo plano', tarefa: 'tarefa agendada', servico: 'serviÃ§o' }[x.tipo] || x.tipo)}</span></div>${tec ? `<button class="btn sm" data-sp-religar="${esc(x.tipo)}|${esc(x.id)}">Religar</button>` : ''}</div>`).join('')}` : ''}
    ${tec ? `<div class="card no-print" style="position:sticky;bottom:0;margin-top:14px;padding:10px 12px;display:flex;flex-wrap:wrap;gap:10px;align-items:center">
      <button class="btn primary" data-sp-lote disabled>Fechar / desligar os marcados</button>
      <label class="small" style="display:inline-flex;gap:6px;align-items:center;margin:0;color:var(--text)"><input type="checkbox" data-sp-inicio checked style="width:auto;min-width:0;margin:0"> e nÃ£o abrir mais sozinho com o Windows</label></div>` : ''}`;
}
function bindSegundo(m, devId, parar) {
  const ver = $('[data-sp-ver]', m); if (ver) ver.onclick = () => { if (parar) parar(); quickTask(devId, 'segundo_plano_listar'); };
  const bt = $('[data-sp-lote]', m);
  const marcados = () => $$('[data-sp-ck]:checked', m);
  const atual = () => { if (!bt) return; const n = marcados().length; bt.disabled = !n; bt.textContent = n ? `Fechar / desligar os marcados (${n})` : 'Fechar / desligar os marcados'; };
  $$('[data-sp-ck]', m).forEach((c) => { c.onchange = () => { atual(); if (parar) parar(); }; });
  $$('[data-sp-todos]', m).forEach((t) => { t.onchange = () => {
    $$(`[data-sp-grp="${t.dataset.spTodos}"]`, m).forEach((c) => { if (c.dataset.spCuidado !== '1') c.checked = t.checked; });
    atual(); if (parar) parar();
  }; });
  atual();
  if (bt) bt.onclick = async () => {
    const l = marcados(); if (!l.length) return;
    if (l.length > 300 || l.map((c) => c.dataset.spCk).join('\n').length > 30000) return toast(`SÃ£o ${l.length} itens marcados: marque no mÃ¡ximo 300 de cada vez (desligue em duas partes).`, 'warn');
    const proc = l.filter((c) => c.dataset.spGrp === 'proc'), cuid = l.filter((c) => c.dataset.spCuidado === '1');
    const tirar = $('[data-sp-inicio]', m) && $('[data-sp-inicio]', m).checked;
    if (!(await confirmBox('Fechar / desligar', `${l.length} item(ns) marcado(s):<ul style="max-height:180px;overflow:auto">${l.map((c) => `<li>${esc(c.dataset.spNome)}</li>`).join('')}</ul>
      ${proc.length ? `Os programas abertos <b>fecham agora</b>${tirar ? ' e <b>nÃ£o abrem mais sozinhos</b> com o Windows' : ''}.` : ''}${cuid.length ? ` <b style="color:var(--warn)">âš  ${cuid.length} pode(m) ter trabalho aberto: o que nÃ£o estiver salvo se perde.</b>` : ''}<br>Tudo fica desligado atÃ© vocÃª clicar em "Religar".`, 'Fechar / desligar', !!cuid.length))) return;
    if (parar) parar();
    quickTask(devId, 'segundo_plano_lote', { itens: l.map((c) => c.dataset.spCk).join('\n'), acao: 'desligar', inicio: tirar ? 'sim' : 'nao' });
  };
  $$('[data-sp-religar]', m).forEach((b) => { b.onclick = () => {
    const v = b.dataset.spReligar, i = v.indexOf('|'), tipo = v.slice(0, i), id = v.slice(i + 1);
    if (parar) parar();
    if (tipo === 'inicio') { const [escopo, t2, ...nome] = id.split('|'); return quickTask(devId, 'inicializacao_alterar', { escopo, tipo: t2, nome: nome.join('|'), ligar: 'sim' }); }
    quickTask(devId, 'segundo_plano_lote', { itens: `${tipo}|${id}`, acao: 'ligar' });
  }; });
}

// botÃµes para quem nÃ£o atualizou: reinstalar (tipo de instalador mudou), forÃ§ar (versÃ£o desconhecida), ignorar (alarme falso)
function appAcoes(a) {
  if (!a.id || !can('tecnico')) return '';
  const ok = (k) => S.actionMap[k] && S.actionMap[k].allowed;
  const b = [];
  if (a.tipoFalha === 'reinstalar' && ok('app_reinstalar')) b.push(`<button class="btn sm primary" data-app-reinst="${esc(a.id)}" data-nome="${esc(a.name)}">ðŸ” Reinstalar na versÃ£o nova</button>`);
  if (a.tipoFalha === 'desconhecida' && ok('app_atualizar')) b.push(`<button class="btn sm primary" data-app-forcar="${esc(a.id)}">â¬† Atualizar sÃ³ este (forÃ§ando)</button>`);
  if (['naopegou', 'reinstalar', 'desconhecida', 'catalogo'].includes(a.tipoFalha) && ok('app_ignorar')) b.push(`<button class="btn sm" data-app-ignorar="${esc(a.id)}" data-nome="${esc(a.name)}">ðŸ™ˆ Ignorar este app</button>`);
  return b.length ? `<div class="btns" style="margin:4px 0 8px;gap:6px">${b.join('')}</div>` : '';
}
function bindAppAcoes(m, devId, parar) {
  $$('[data-app-reinst]', m).forEach((b) => { b.onclick = async () => {
    if (!(await confirmBox('Reinstalar na versÃ£o nova', `Desinstalar <b>${esc(b.dataset.nome)}</b> e instalar a versÃ£o nova?<br><br>Se a desinstalaÃ§Ã£o falhar, nada muda. Se desinstalar e a instalaÃ§Ã£o nova falhar, o programa fica fora do PC atÃ© instalar de novo (o resultado avisa). Feche o programa no PC antes, se puder.`, 'Reinstalar'))) return;
    if (parar) parar(); taskDialog([devId], 'app_reinstalar', { id: b.dataset.appReinst });
  }; });
  $$('[data-app-forcar]', m).forEach((b) => { b.onclick = () => { if (parar) parar(); quickTask(devId, 'app_atualizar', { id: b.dataset.appForcar }); }; });
  $$('[data-app-ignorar]', m).forEach((b) => { b.onclick = async () => {
    if (!(await confirmBox('Ignorar este app', `<b>${esc(b.dataset.nome)}</b> nÃ£o vai mais aparecer como desatualizado neste PC (nem entrar no "Atualizar todos").<br><br>DÃ¡ para desfazer na aba AtualizaÃ§Ãµes â†’ "Ignorados" â†’ Voltar a mostrar.`, 'Ignorar'))) return;
    if (parar) parar(); quickTask(devId, 'app_ignorar', { id: b.dataset.appIgnorar });
  }; });
}
function updateResult(r, t) {
  if (!r.apps && !r.summary) return `<p><b>${esc(r.message || '')}</b></p>`;
  const c = r.counts || {};
  const so = (r.apps || []).length === 1 ? r.apps[0] : null;
  const titulo = so && so.status === 'falhou' ? ({ reinstalar: `${so.name}: precisa reinstalar`, naopegou: `${so.name}: a atualizaÃ§Ã£o nÃ£o pegou`, desconhecida: `${so.name}: versÃ£o desconhecida`, catalogo: `${so.name}: catÃ¡logo do winget desatualizado` }[so.tipoFalha] || `${so.name}: nÃ£o atualizou`) : r.summary;
  const head = r.summary || titulo ? `<div class="card" style="margin-bottom:14px"><div style="font-size:18px;font-weight:600">${esc(titulo)}</div>
      <div class="muted small" style="margin-top:6px">CÃ³digo do winget: <span class="mono">${esc(r.codeHex || r.exitCode)}</span> Â· ${esc(r.message || '')}</div>
      ${r.conferido ? '<div class="small" style="margin-top:6px;color:var(--ok)">âœ” Resultado conferido no PC depois de atualizar.</div>' : ''}
      ${r.unknownVersions ? `<div class="muted small" style="margin-top:6px">${r.unknownVersions} programa(s) com versÃ£o desconhecida ficaram de fora (o winget nÃ£o atualiza esses no "Atualizar todos", por seguranÃ§a).</div>` : ''}</div>` : `<p><b>${esc(r.message || '')}</b></p>`;
  const failed = (r.apps || []).filter((a) => a.status === 'falhou');
  const reboot = (r.apps || []).filter((a) => a.status === 'reiniciar');
  let box = '';
  if (failed.length) box += `<div class="card" style="margin-bottom:12px;border-color:rgba(239,68,68,.5)"><b>${failed.every((a) => a.tipoFalha === 'naopegou') ? 'NÃ£o pegaram' : 'NÃ£o atualizaram'} (${failed.length}):</b><ul style="margin:8px 0 0">${failed.map((a) => `<li><b>${esc(a.name)}</b> <span class="muted small">${esc(a.message || '')}</span>${a.dica ? `<div class="small" style="margin:2px 0 6px;color:var(--warn)">ðŸ’¡ ${esc(a.dica)}</div>` : ''}${appAcoes(a)}</li>`).join('')}</ul>
      ${failed.some((a) => !a.dica) ? '<p class="muted small" style="margin:8px 0 0">Dica: tente de novo com o programa fechado ou agende para o horÃ¡rio de manutenÃ§Ã£o.</p>' : ''}</div>`;
  const nao = r.naoAtualizados || [];
  if (nao.length) box += `<div class="card" style="margin-bottom:12px;border-color:rgba(245,165,36,.6)"><b>Continuam desatualizados (${nao.length}):</b><ul style="margin:8px 0 0">${nao.map((a) => `<li><b>${esc(a.name)}</b> <span class="mono small muted">${esc(a.version || '')} â†’ ${esc(a.available || '')}</span><div class="muted small">${esc(a.motivo || '')}</div></li>`).join('')}</ul></div>`;
  if (r.rebootRequired) {
    const canReboot = S.actionMap.reiniciar_pc && S.actionMap.reiniciar_pc.allowed;
    box += `<div class="card" style="margin-bottom:12px;border-color:rgba(245,165,36,.6)"><b>âš  ReinÃ­cio pendente</b>${reboot.length ? ` para concluir: ${reboot.map((a) => `<b>${esc(a.name)}</b>`).join(', ')}` : ''}
      <div class="btns" style="margin-top:10px">${canReboot ? '<button class="btn danger" data-reboot>Reiniciar PC</button><span class="muted small">Segue a polÃ­tica de reinÃ­cio do cliente (pergunta ao usuÃ¡rio, se for o caso).</span>' : '<span class="muted small">PeÃ§a a um administrador para reiniciar este computador.</span>'}</div></div>`;
  }
  const table = (r.apps || []).length ? `<div class="table-wrap"><table><thead><tr><th>Aplicativo</th><th>ID</th><th>VersÃ£o</th><th>Resultado</th></tr></thead><tbody>
      ${r.apps.map((a) => `<tr><td>${esc(a.name)}</td><td class="mono small">${esc(a.id)}</td><td>${esc(a.version || '')}</td><td>${((st) => `<span class="badge ${esc(st[0])}">${esc(st[1])}</span>`)(APP_STATUS[a.status === 'falhou' && APP_STATUS[a.tipoFalha] ? a.tipoFalha : a.status] || ['', a.status])}${(a.status !== 'ok' || a.conferido) && a.message ? `<div class="muted small">${esc(a.message)}</div>` : ''}</td></tr>`).join('')}</tbody></table></div>` : '';
  return head + box + table;
}

// "O que estÃ¡ ocupando espaÃ§o": barras por pasta, o que dÃ¡ para limpar em destaque
// botÃµes de aÃ§Ã£o de cada linha (sÃ³ aparecem com agente 0.15+, que manda "acao")
const ESP_ALVO = { temp_win: 'TemporÃ¡rios do Windows', temp_usu: 'TemporÃ¡rios dos usuÃ¡rios', wu: 'AtualizaÃ§Ãµes do Windows jÃ¡ baixadas', lixeira: 'Lixeira (tambÃ©m a do Google Drive, OneDrive e pendrive de quem estÃ¡ logado)', nav: 'Cache dos navegadores (nÃ£o apaga senhas, favoritos nem histÃ³rico)', dumps: 'Despejos de erro (travamentos)', do: 'OtimizaÃ§Ã£o de Entrega (cache de atualizaÃ§Ãµes)' };
function espBotao(x) {
  const a = x.acao || '';
  if (!can('tecnico') || !a) return '';
  const ok = (k) => S.actionMap[k] && S.actionMap[k].allowed;
  if (a.startsWith('limpar:') && ok('espaco_limpar')) return `<button class="btn sm primary" data-esp-limpar="${esc(a.slice(7))}">ðŸ§¹ Limpar</button>`;
  if (a === 'mover' && ok('sobras_limpar')) return `<button class="btn sm danger" data-esp-mover="${esc(x.caminho)}">ðŸ—‘ Lixeira do FND</button>`;
  if (a === 'grandes' && ok('arquivos_grandes')) return `<button class="btn sm" data-esp-grandes="${esc(x.caminho)}">ðŸ”Ž Maiores arquivos</button>`;
  if (a === 'programas') return '<button class="btn sm" data-esp-programas>ðŸ“¦ Ver programas</button>';
  if (a === 'restauracao' && ok('restauracao_listar')) return '<button class="btn sm" data-esp-restauracao>ðŸ›Ÿ Ver pontos de restauraÃ§Ã£o</button>';
  if (a === 'windows_limpeza' && ok('windows_limpeza')) return '<button class="btn sm" data-esp-windows>ðŸ§½ Limpeza do Windows</button>';
  return '';
}
function espacoResultado(r) {
  const itens = r.itens || [];
  const maior = Math.max(1, ...itens.map((x) => x.gb || 0));
  const limpavel = itens.filter((x) => x.tipo === 'lixo').reduce((s, x) => s + x.gb, 0)
    + itens.filter((x) => x.tipo === 'usuario').reduce((s, x) => s + (x.partes || []).filter((p) => /TemporÃ¡rios/.test(p.nome)).reduce((a, p) => a + p.gb, 0), 0);
  const TIPO = { lixo: ['ok', 'pode limpar'], sobra: ['warn', 'sobra de instalaÃ§Ã£o'], sistema: ['', 'Windows'], programas: ['', 'programas'], usuario: ['info', 'usuÃ¡rio'], outros: ['', 'outra pasta'] };
  const alvos = [...new Set([...itens.map((x) => x.acao), ...itens.flatMap((x) => (x.partes || []).map((p) => p.acao))].filter((a) => /^limpar:/.test(a || '')).map((a) => a.slice(7)))];
  const gb = (v) => (v >= 1 ? (v >= 10 ? Math.round(v) : Math.round(v * 10) / 10).toLocaleString('pt-BR') + ' GB' : Math.max(1, Math.round((v || 0) * 1024)).toLocaleString('pt-BR') + ' MB');
  const linha = (x) => `<div style="margin:10px 0"><div style="display:flex;justify-content:space-between;align-items:baseline;gap:8px"><span><b>${esc(x.nome)}</b> ${TIPO[x.tipo] ? `<span class="badge ${TIPO[x.tipo][0]}">${TIPO[x.tipo][1]}</span>` : ''}</span><span class="nw" style="display:flex;gap:8px;align-items:center">${espBotao(x)}<b>${gb(x.gb)}</b></span></div>
      <div class="bar" style="margin-top:4px"><i style="width:${Math.max(1, (x.gb / maior) * 100)}%;${x.tipo === 'lixo' ? 'background:var(--ok)' : ''}"></i></div>
      <div class="muted small">${esc(x.dica || '')} <span class="mono">${esc(x.caminho || '')}</span></div>
      ${x.nuvemGB >= 0.5 ? `<div class="small" style="color:var(--blue2)">â˜ mais ${gb(x.nuvemGB)} sÃ³ na nuvem (OneDrive e parecidos): aparecem no Explorer, mas nÃ£o ocupam o disco</div>` : ''}
      ${(x.partes || []).length ? `<div style="margin:4px 0 0 14px">${x.partes.map((p) => `<div class="small" style="margin:2px 0">â€¢ ${esc(p.nome)}: <b>${gb(p.gb)}</b> <span class="muted">${esc(p.dica || '')}</span> ${espBotao(p)}</div>`).join('')}</div>` : ''}</div>`;
  const ocupado = Math.max(0, (r.totalGB || 0) - (r.livreGB || 0)), soma = itens.reduce((s2, x) => s2 + (x.gb || 0), 0);
  const nota = r.medidor !== 'disco' && soma > ocupado * 1.1
    ? '<p class="muted small" style="margin:6px 0 0">âš  A soma passou do espaÃ§o ocupado: este agente mediu pelo tamanho dos arquivos (OneDrive e arquivos "reservados" parecem maiores do que ocupam). Atualize o agente para medir o espaÃ§o real.</p>' : '';
  return `<div class="card" style="margin-bottom:12px"><b style="font-size:18px">Disco ${esc(r.disco || '')} â€” ${gb(r.livreGB)} livres de ${gb(r.totalGB)}</b>${discoBar(r.livreGB, r.totalGB)}${nota}
      ${limpavel >= 0.5 ? `<p style="margin:8px 0 0">DÃ¡ para liberar uns <b>${gb(limpavel)}</b> sÃ³ com o que Ã© marcado como <span class="badge ok">pode limpar</span> (temporÃ¡rios, atualizaÃ§Ãµes jÃ¡ baixadas, lixeira, cache dos navegadores, despejos de erro).</p>` : '<p class="muted small" style="margin:8px 0 0">Quase nada para limpar com seguranÃ§a: o espaÃ§o estÃ¡ com o Windows, os programas e os arquivos dos usuÃ¡rios.</p>'}
      ${alvos.length && can('tecnico') && S.actionMap.espaco_limpar && S.actionMap.espaco_limpar.allowed ? `<div class="btns" style="margin-top:8px"><button class="btn ${limpavel >= 0.5 ? 'primary' : ''}" data-esp-limpar="${esc(alvos.join(','))}">ðŸ§¹ Limpar tudo que pode limpar</button></div>` : ''}</div>
    ${itens.map(linha).join('')}`;
}

// ===== resultados em linguagem simples (servem para qualquer PC; vÃ£o para o PDF e o WhatsApp) =====
// nome amigÃ¡vel dos processos: [nome, Ã­cone, tipo] â€” tipo 'win' junta tudo em "Windows"
const PROC = {
  cod: ['Call of Duty', 'ðŸŽ®', 'jogo'], 'cod.exe': ['Call of Duty', 'ðŸŽ®', 'jogo'], blackops6: ['Call of Duty', 'ðŸŽ®', 'jogo'], cs2: ['Counter-Strike 2', 'ðŸŽ®', 'jogo'],
  'valorant-win64-shipping': ['Valorant', 'ðŸŽ®', 'jogo'], 'fortniteclient-win64-shipping': ['Fortnite', 'ðŸŽ®', 'jogo'], gta5: ['GTA V', 'ðŸŽ®', 'jogo'], gta5_enhanced: ['GTA V', 'ðŸŽ®', 'jogo'],
  'league of legends': ['League of Legends', 'ðŸŽ®', 'jogo'], leagueclient: ['League of Legends', 'ðŸŽ®', 'jogo'], robloxplayerbeta: ['Roblox', 'ðŸŽ®', 'jogo'], fc25: ['EA FC', 'ðŸŽ®', 'jogo'], fc26: ['EA FC', 'ðŸŽ®', 'jogo'],
  javaw: ['Java (ex.: Minecraft)', 'â˜•', ''], minecraft: ['Minecraft', 'ðŸŽ®', 'jogo'],
  'battle.net': ['Battle.net', 'ðŸŽ®', ''], steam: ['Steam', 'ðŸŽ®', ''], steamwebhelper: ['Steam', 'ðŸŽ®', ''], epicgameslauncher: ['Epic Games', 'ðŸŽ®', ''],
  eadesktop: ['EA App', 'ðŸŽ®', ''], riotclientservices: ['Riot Client', 'ðŸŽ®', ''], gameinputrawinputproxy: ['Controle de jogos do Windows', 'ðŸ•¹', 'win'], gameinputsvc: ['Controle de jogos do Windows', 'ðŸ•¹', 'win'],
  chrome: ['Google Chrome', 'ðŸŒ', ''], msedge: ['Microsoft Edge', 'ðŸŒ', ''], firefox: ['Firefox', 'ðŸŒ', ''], opera: ['Opera', 'ðŸŒ', ''], brave: ['Brave', 'ðŸŒ', ''],
  msedgewebview2: ['Componente do Edge (usado por apps)', 'ðŸ§©', ''],
  msmpeng: ['AntivÃ­rus do Windows (Defender)', 'ðŸ›¡', ''], nissrv: ['AntivÃ­rus do Windows (Defender)', 'ðŸ›¡', ''], mpdefendercoreservice: ['AntivÃ­rus do Windows (Defender)', 'ðŸ›¡', ''],
  discord: ['Discord', 'ðŸ’¬', ''], whatsapp: ['WhatsApp', 'ðŸ’¬', ''], 'whatsapp.root': ['WhatsApp', 'ðŸ’¬', ''], telegram: ['Telegram', 'ðŸ’¬', ''], teams: ['Microsoft Teams', 'ðŸ’¬', ''], 'ms-teams': ['Microsoft Teams', 'ðŸ’¬', ''],
  spotify: ['Spotify', 'ðŸŽµ', ''], outlook: ['Outlook', 'ðŸ“§', ''], olk: ['Outlook', 'ðŸ“§', ''], excel: ['Excel', 'ðŸ“Š', ''], winword: ['Word', 'ðŸ“', ''], powerpnt: ['PowerPoint', 'ðŸ“½', ''],
  onedrive: ['OneDrive', 'â˜', ''], anydesk: ['AnyDesk', 'ðŸ–¥', ''], teamviewer: ['TeamViewer', 'ðŸ–¥', ''], obs64: ['OBS Studio', 'ðŸŽ¥', ''], acrobat: ['Adobe Acrobat', 'ðŸ“„', ''], acrord32: ['Adobe Reader', 'ðŸ“„', ''],
  nvcontainer: ['Driver de vÃ­deo NVIDIA', 'ðŸŽ›', ''], 'nvdisplay.container': ['Driver de vÃ­deo NVIDIA', 'ðŸŽ›', ''], amdrsserv: ['Driver de vÃ­deo AMD', 'ðŸŽ›', ''], radeonsoftware: ['Driver de vÃ­deo AMD', 'ðŸŽ›', ''],
};
const WIN_PROC = new Set(['system', 'idle', 'registry', 'memory compression', 'dwm', 'explorer', 'svchost', 'wmiprvse', 'audiodg', 'csrss', 'lsass', 'services', 'wininit', 'winlogon', 'smss',
  'searchhost', 'searchindexer', 'searchapp', 'startmenuexperiencehost', 'shellexperiencehost', 'textinputhost', 'runtimebroker', 'sihost', 'taskhostw', 'ctfmon', 'fontdrvhost', 'spoolsv',
  'applicationframehost', 'systemsettings', 'lockapp', 'widgets', 'phoneexperiencehost', 'conhost', 'dllhost', 'smartscreen', 'securityhealthservice', 'securityhealthsystray', 'tiworker', 'trustedinstaller', 'msiexec', 'wudfhost', 'dashost', 'secure system', 'vmmem', 'vmmemwsl']);
function procInfo(nome) {
  const k = String(nome || '').toLowerCase().replace(/\.exe$/, '');
  if (PROC[k]) return { nome: PROC[k][0], ico: PROC[k][1], tipo: PROC[k][2] };
  if (WIN_PROC.has(k)) return { nome: 'Windows (sistema, tela e pastas)', ico: 'ðŸªŸ', tipo: 'win' };
  return { nome: String(nome || '?'), ico: 'â–«', tipo: '' };
}
const memTxt = (mb) => (mb >= 1000 ? `${(Math.round(mb / 102.4) / 10).toLocaleString('pt-BR')} GB` : `${Math.round(mb).toLocaleString('pt-BR')} MB`);
// junta CPU e memÃ³ria numa lista sÃ³, somando os processos do mesmo programa (Chrome com vÃ¡rias abas vira 1 linha)
function diagProgramas(r) {
  const g = new Map();
  const pega = (x) => { const i = procInfo(x.name); let o = g.get(i.nome); if (!o) { o = { ...i, cpu: 0, mem: 0, memCpu: 0, n: 0, nMem: 0 }; g.set(i.nome, o); } return o; };
  for (const x of r.topCpu || []) { const o = pega(x); o.cpu += Number(x.cpu) || 0; o.memCpu += Number(x.memMB) || 0; o.n++; }
  for (const x of r.topMem || []) { const o = pega(x); o.mem += Number(x.memMB) || 0; o.nMem++; }
  for (const o of g.values()) { if (!o.nMem) o.mem = o.memCpu; o.n = Math.max(o.n, o.nMem); }
  return [...g.values()].sort((a, b) => b.cpu - a.cpu || b.mem - a.mem);
}
function diagFrase(r) {
  const progs = diagProgramas(r);
  const top = progs.find((p) => p.tipo !== 'win' && p.cpu >= 15);
  const cpu = Number(r.cpuLoad) || 0, ram = Number(r.ramPct) || 0;
  const f = [];
  f.push(`Ligado hÃ¡ ${duracao(r.uptimeMin != null ? r.uptimeMin : (r.uptimeDays || 0) * 1440)}.`);
  if (cpu >= 50) f.push(`O processador estÃ¡ em ${cpu}%${top ? ` por causa do ${top.nome}${top.tipo === 'jogo' ? ', o que Ã© normal enquanto joga' : ''}` : ''}.`);
  else f.push(`O processador estÃ¡ ${cpu >= 20 ? 'trabalhando normalmente' : 'tranquilo'} (${cpu}%).`);
  f.push(`MemÃ³ria ${ram}% usada${r.ramGB ? ` de ${String(r.ramGB).replace('.', ',')} GB` : ''}${ram >= 90 ? ': quase cheia' : ram >= 75 ? ': bem usada' : ', sobrando bastante'}.`);
  if (r.systemFreePct != null) f.push(`Disco do sistema com ${r.systemFreePct}% livre${r.systemFreePct < 15 ? ' (pouco)' : ''}.`);
  return f.join(' ');
}
// ðŸ›  "Resolver" em cada item do "Precisa de atenÃ§Ã£o" do diagnÃ³stico (o que dÃ¡ para resolver pelo FND)
const DIAG_RESOLVER = [
  [/Pasta Temp do Windows/i, 'ðŸ§¹ Limpar temporÃ¡rios', 'espaco_limpar', { alvos: 'temp_win,temp_usu' }, 'Apaga os arquivos temporÃ¡rios do Windows e dos usuÃ¡rios (o que estiver em uso fica e sai depois de reiniciar).'],
  [/Pouco espaÃ§o livre/i, 'ðŸ’½ Ver o que ocupa espaÃ§o', 'espaco_disco', {}, ''],
  [/Muitos programas iniciando/i, 'ðŸš€ Ver e desligar', 'inicializacao_listar', {}, ''],
  [/Processador muito ocupado|MemÃ³ria RAM em \d/i, 'ðŸ§¾ Ver o que roda escondido', 'segundo_plano_listar', {}, ''],
  [/reinÃ­cio pendente|sem reiniciar/i, 'ðŸ” Reiniciar o PC', 'reiniciar_pc', {}, ''], // (o reiniciar jÃ¡ pergunta e segue a polÃ­tica do cliente)
];
const diagResolverBtn = (p) => {
  if (!can('tecnico')) return '';
  const i = DIAG_RESOLVER.findIndex(([re, , ac]) => re.test(p) && S.actionMap[ac]);
  return i < 0 ? '' : `<button class="btn sm no-print" data-diag-res="${i}" style="margin-left:6px">${DIAG_RESOLVER[i][1]}</button>`;
};
function bindDiagResolver(m, t, parar) {
  $$('[data-diag-res]', m).forEach((b) => { b.onclick = async () => {
    const [, rot, ac, params, aviso] = DIAG_RESOLVER[Number(b.dataset.diagRes)];
    if (aviso && !(await confirmBox(rot.replace(/^\S+\s/, ''), aviso, 'Fazer agora', ac === 'reiniciar_pc'))) return;
    if (parar) parar();
    quickTask(t.device_id, ac, params);
  }; });
}
function diagView(r) {
  const progs = diagProgramas(r);
  const mostrar = progs.filter((p) => p.cpu >= 1 || p.mem >= 150).slice(0, 10);
  const resto = progs.length - mostrar.length;
  const free = Number(r.systemFreePct);
  const tmp = Number(r.windowsTempGB) || 0;
  const tec = can('tecnico') && S.actionMap.inicializacao_listar;
  return `<div class="card" style="margin-bottom:14px">${r.problems && r.problems.length ? `<h3 style="color:var(--warn)">âš  Precisa de atenÃ§Ã£o</h3><ul class="diag-prob">${r.problems.map((p) => `<li>${esc(p)} ${diagResolverBtn(p, r)}</li>`).join('')}</ul>` : '<h3 style="color:var(--ok)">âœ” Nenhum problema encontrado</h3>'}
      <p style="margin:6px 0 0">${esc(diagFrase(r))}</p></div>
    <dl class="kv">
      <dt>Processador</dt><dd>${esc(r.cpuLoad)}% em uso${barNumSimples(r.cpuLoad)}</dd>
      <dt>MemÃ³ria</dt><dd>${esc(r.ramPct)}%${r.ramGB ? ` de ${esc(String(r.ramGB).replace('.', ','))} GB` : ''}${barNumSimples(r.ramPct)}</dd>
      <dt>Ligado hÃ¡</dt><dd>${esc(duracao(r.uptimeMin != null ? r.uptimeMin : (r.uptimeDays || 0) * 1440))}</dd>
      <dt>Disco do sistema</dt><dd>${isNaN(free) ? 'â€”' : `<span style="${free < 15 ? 'color:var(--warn);font-weight:600' : ''}">${free}% livre</span>`}${r.systemDiskType && r.systemDiskType !== '?' ? ` <span class="muted small">(${esc(r.systemDiskType)})</span>` : ''}</dd>
      <dt>Programas que abrem com o Windows</dt><dd>${esc(r.startupCount)}${tec ? ' <button class="btn sm no-print" data-ini-ver>Ver e desligar</button>' : ''}</dd>
      ${can('tecnico') && S.actionMap.segundo_plano_listar ? '<dt>Segundo plano</dt><dd><button class="btn sm no-print" data-sp-ver>Ver o que roda escondido</button></dd>' : ''}
      <dt>Arquivos temporÃ¡rios</dt><dd>${tmp < 0.1 ? 'quase nada' : `${esc(String(Math.round(tmp * 10) / 10).replace('.', ','))} GB (dÃ¡ para limpar)`}</dd>
      ${r.rebootPending ? '<dt>ReinÃ­cio</dt><dd><span class="badge warn">Pendente</span></dd>' : ''}</dl>
    <h3 style="margin-top:16px">O que estÃ¡ usando o PC agora</h3>
    ${mostrar.length ? `<div class="table-wrap"><table><thead><tr><th>Programa</th><th>Processador</th><th>MemÃ³ria</th></tr></thead><tbody>
      ${mostrar.map((p) => `<tr><td>${p.ico} <b>${esc(p.nome)}</b>${p.n > 1 && p.tipo !== 'win' ? ` <span class="muted small">(${p.n} janelas/processos juntos)</span>` : ''}</td><td>${p.cpu >= 1 ? `${Math.round(p.cpu)}%` : '<span class="muted">parado</span>'}</td><td>${p.mem ? memTxt(p.mem) : 'â€”'}</td></tr>`).join('')}</tbody></table></div>` : '<p class="muted">Nada pesado rodando.</p>'}
    ${resto > 0 || (r.topCpu || []).length ? `<details class="no-print" style="margin-top:8px"><summary class="muted small">Ver nomes tÃ©cnicos${resto > 0 ? ` (mais ${resto} parado${resto > 1 ? 's' : ''})` : ''}</summary>
      <div class="grid g2" style="margin-top:8px"><div><h4>Processador</h4>${autoTable(r.topCpu || [])}</div><div><h4>MemÃ³ria</h4>${autoTable(r.topMem || [])}</div></div></details>` : ''}`;
}
const barNumSimples = (v) => { const n = Math.max(0, Math.min(100, Number(v) || 0)); return `<div class="bar" style="margin-top:4px;max-width:260px"><i style="width:${n}%;${n >= 90 ? 'background:var(--bad)' : n >= 75 ? 'background:var(--warn)' : ''}"></i></div>`; };

// leitura de temperatura (tarefa "Ler a temperatura da CPU")
function termicoSituacao(r) {
  const t = r.temp != null ? Number(r.temp) : null;
  if (t == null || isNaN(t)) return null;
  const parado = r.carga != null && Number(r.carga) < 30;
  const nivel = t >= 85 ? ['bad', 'Muito quente'] : t >= 75 ? ['warn', 'Quente'] : t >= 65 ? ['warn', 'Morno'] : ['ok', 'Normal'];
  let dica = '';
  if (t >= 75 || (t >= 65 && parado)) dica = 'Vale limpar a poeira do cooler e das saÃ­das de ar e conferir a pasta tÃ©rmica (resseca em 3 a 5 anos).';
  if (r.planoNome && /alto desempenho|desempenho mÃ¡ximo|ultimate|high performance/i.test(r.planoNome) && t >= 65) dica += ' O plano "Alto desempenho" deixa o processador sempre acelerado; o plano Equilibrado esquenta menos.';
  return { t, nivel, dica: dica.trim() };
}
function termicoFrase(r) {
  const s = termicoSituacao(r);
  const c = Number(r.carga), d = Number(r.desempenho);
  const p = [];
  if (s) p.push(`Processador a ${String(Math.round(s.t * 10) / 10).replace('.', ',')} Â°C: ${s.nivel[1].toLowerCase()}${s.t >= 65 && c < 30 ? ', alto para um PC quase parado' : ''}.`);
  else p.push('Este PC nÃ£o informou a temperatura do processador.');
  if (!isNaN(c)) p.push(`Uso de ${c}%${c < 20 ? ', quase parado' : c >= 80 ? ', muito ocupado' : ''}.`);
  if (!isNaN(d)) p.push(d > 105 ? 'Rodando acelerado (turbo ligado).' : d >= 80 ? 'Velocidade normal.' : c >= 60 ? 'EstÃ¡ freando (mais lento mesmo ocupado: calor, bateria ou economia de energia).' : 'Mais devagar para economizar energia.');
  if (r.planoNome) p.push(`Plano de energia: ${r.planoNome}.`);
  return p.join(' ');
}
function termicoView(r) {
  const s = termicoSituacao(r);
  const cor = s ? `var(--${s.nivel[0]})` : '';
  const lim = r.limiteAc != null ? Number(r.limiteAc) : null;
  const real = r.real || {};
  const sensor = r.fonte === 'cpu' ? 'sensor de dentro do processador' : r.fonte ? 'sensor da placa-mÃ£e (pode ser menor que a do processador)' : '';
  return `<div class="card" style="margin-bottom:12px">
      ${s ? `<div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap"><b style="font-size:32px;color:${cor}">ðŸŒ¡ ${esc(String(Math.round(s.t * 10) / 10).replace('.', ','))} Â°C</b><b style="color:${cor};font-size:18px">${esc(s.nivel[1])}</b></div>` : '<b style="font-size:18px">Temperatura nÃ£o disponÃ­vel neste PC</b>'}
      ${sensor ? `<div class="muted small">Lido pelo ${esc(sensor)}${real.marca ? ` Â· processador ${esc(String(real.marca).toUpperCase())}` : ''}</div>` : ''}
      <p style="margin:8px 0 0">${esc(termicoFrase(r))}</p>
      ${s && s.dica ? `<p class="small" style="margin:6px 0 0;color:var(--warn)">ðŸ’¡ ${esc(s.dica)}</p>` : ''}</div>
    <dl class="kv">
      ${r.carga != null ? `<dt>Uso do processador</dt><dd>${esc(r.carga)}%</dd>` : ''}
      ${r.desempenho != null ? `<dt>Velocidade</dt><dd>${Number(r.desempenho) > 105 ? 'Acelerado (turbo)' : Number(r.desempenho) >= 80 ? 'Normal' : 'Reduzida'} <span class="muted small">(${esc(r.desempenho)}% da velocidade base)</span></dd>` : ''}
      ${r.planoNome ? `<dt>Plano de energia</dt><dd>${esc(r.planoNome)}</dd>` : ''}
      ${lim != null ? `<dt>Modo fresco</dt><dd>${lim >= 100 ? 'Desligado (processador livre, normal)' : lim === 99 ? 'Ligado: turbo desligado' : `Ligado: processador limitado a ${lim}%`}</dd>` : ''}
      ${real.nucleoMax != null ? `<dt>Parte mais quente</dt><dd>${Math.round(real.nucleoMax)} Â°C</dd>` : ''}
      ${r.tempPlaca != null && !r.placaParada ? `<dt>Placa-mÃ£e</dt><dd>${Math.round(r.tempPlaca)} Â°C</dd>` : ''}</dl>
    <p class="muted small no-print" style="margin-top:8px">O grÃ¡fico ao vivo e os botÃµes para esfriar ficam no Resumo do computador.</p>`;
}

// ===== pontos de restauraÃ§Ã£o =====
function restauracaoView(r) {
  const tec = can('tecnico') && S.actionMap.restauracao_criar, adm = can('admin') && S.actionMap.restauracao_restaurar;
  const pts = r.pontos || [];
  const quando = (q) => (q ? esc(new Date(q).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' })) : 'â€”');
  return `${r.message ? `<div class="card" style="margin-bottom:12px"><b>${esc(r.message)}</b></div>` : ''}
    <dl class="kv"><dt>ProteÃ§Ã£o do sistema (C:)</dt><dd>${r.ligado ? '<span class="badge ok">Ligada</span>' : '<span class="badge warn">Desligada</span> <span class="muted small">sem ela o Windows nÃ£o guarda pontos</span>'}</dd>
      ${r.ligado && r.reservadoGB != null ? `<dt>EspaÃ§o reservado</dt><dd>${esc(String(r.reservadoGB).replace('.', ','))} GB${r.usadoGB != null ? ` <span class="muted small">(${esc(String(r.usadoGB).replace('.', ','))} GB usados)</span>` : ''}</dd>` : ''}
      ${r.ultimoResultado ? `<dt>Ãšltima restauraÃ§Ã£o</dt><dd class="small">${esc(r.ultimoResultado)}</dd>` : ''}</dl>
    ${tec ? `<div class="btns" style="margin:10px 0">${r.ligado ? '<button class="btn primary" data-rp-criar>âž• Criar ponto agora</button>' : '<button class="btn primary" data-rp-ligar>Ligar a proteÃ§Ã£o (reserva 8% do disco)</button>'}</div>` : ''}
    <h3>Pontos guardados (${pts.length})</h3>
    ${pts.length ? `<div class="table-wrap"><table><thead><tr><th>Quando</th><th>DescriÃ§Ã£o</th><th class="hide-sm">Tipo</th>${adm ? '<th></th>' : ''}</tr></thead><tbody>${pts.map((p) => `<tr>
      <td class="nw">${quando(p.quando)}</td><td>${p.fnd ? 'ðŸ›Ÿ ' : ''}${esc(p.descricao)}</td><td class="hide-sm small">${esc(p.tipo || '')}</td>
      ${adm ? `<td class="nw">${p.antesDoAgente ? '<span class="muted small" title="De antes do agente ser instalado: o PC voltaria sem o agente">ðŸ”’ antes do agente</span>' : `<button class="btn sm danger" data-rp-restaurar="${esc(p.seq)}" data-rp-nome="${esc(p.descricao)}" data-rp-quando="${quando(p.quando)}">Restaurar</button>`}</td>` : ''}</tr>`).join('')}</tbody></table></div>`
      : `<p class="muted">${r.ligado ? 'Nenhum ponto ainda. Crie o primeiro com o botÃ£o acima.' : 'Nenhum ponto (a proteÃ§Ã£o estÃ¡ desligada).'}</p>`}
    <p class="muted small" style="margin-top:8px">Restaurar volta o Windows, os programas e os drivers para como estavam naquela data. <b>Documentos, fotos e arquivos do usuÃ¡rio nÃ£o sÃ£o mexidos.</b> Programas e drivers instalados depois somem. O PC reinicia e leva de 10 a 30 minutos; depois volta sozinho para o painel.</p>`;
}
function bindRestauracao(m, devId, parar) {
  const lig = $('[data-rp-ligar]', m); if (lig) lig.onclick = () => { if (parar) parar(); quickTask(devId, 'restauracao_ligar', { pct: '8' }); };
  const cr = $('[data-rp-criar]', m);
  if (cr) cr.onclick = async () => {
    const v = await promptBox('Criar ponto de restauraÃ§Ã£o', 'Nome do ponto (ex.: antes da formataÃ§Ã£o dos drivers)', 'FND - ');
    if (v === null) return;
    const nome = String(v).trim().replace(/[^A-Za-z0-9Ã€-Ã¿ .,:()Â·-]/g, '').slice(0, 60) || 'FND - ponto manual';
    if (parar) parar();
    quickTask(devId, 'restauracao_criar', { nome });
  };
  $$('[data-rp-restaurar]', m).forEach((b) => { b.onclick = async () => {
    if (!(await confirmBox('Restaurar o PC', `Voltar este PC para o ponto de <b>${esc(b.dataset.rpQuando)}</b> (${esc(b.dataset.rpNome)})?<br><br>â€¢ O PC <b>reinicia em 1 minuto</b> (salve o que estiver aberto) e leva de 10 a 30 minutos.<br>â€¢ Documentos e arquivos do usuÃ¡rio <b>nÃ£o</b> sÃ£o mexidos.<br>â€¢ Programas e drivers instalados depois dessa data <b>somem</b>.`, 'Restaurar e reiniciar', true))) return;
    if (parar) parar();
    quickTask(devId, 'restauracao_restaurar', { seq: b.dataset.rpRestaurar });
  }; });
}

// ===== Windows Update: o que cada cÃ³digo de erro quer dizer e o que fazer =====
// reparar: true = o botÃ£o "ðŸ”§ Reparar o Windows Update" resolve na maioria das vezes
const WU_ERROS = [
  [/^0x800F0993$|^0x80073712$|^0x800F0991$|^0x800F081F$|^0x800F0831$|^0x800F0988$|^0x80073701$/i, 'Componentes do Windows danificados (o Windows nÃ£o consegue validar a atualizaÃ§Ã£o).', true],
  [/^0x80070002$|^0x80070003$|^0x8007000D$|^0x80246007$|^0x80246008$|^0x80246002$/i, 'Arquivos da atualizaÃ§Ã£o baixados com defeito.', true],
  [/^0x800F0922$/i, 'Falhou ao terminar a instalaÃ§Ã£o (partiÃ§Ã£o reservada do sistema pequena, VPN ligada ou serviÃ§o parado).', true],
  [/^0x80070422$/i, 'O serviÃ§o do Windows Update estÃ¡ desativado neste PC.', true],
  [/^0x80070070$|^0x80070070$|^0x8007001D$/i, 'Pouco espaÃ§o no disco do sistema. Libere espaÃ§o (botÃ£o "O que estÃ¡ ocupando espaÃ§o") e tente de novo.', false],
  [/^0x80072EE2$|^0x80072EFD$|^0x80072EFE$|^0x8024402C$|^0x8024401C$|^0x80244022$|^0x80240438$/i, 'Problema de internet ao falar com a Microsoft (conexÃ£o caiu, proxy ou firewall).', false],
  [/^0x80240034$|^0x80246017$/i, 'O download nÃ£o terminou.', true],
  [/^0x8024001E$|^0x80240016$|^0x8024A105$/i, 'O Windows estava ocupado (outra instalaÃ§Ã£o ou reinÃ­cio pendente). Reinicie o PC e tente de novo.', false],
  [/^0x80070643$|^0x80070641$/i, 'O instalador da atualizaÃ§Ã£o falhou (comum em atualizaÃ§Ãµes do .NET e do Defender). Reinicie e tente de novo.', true],
  [/^0x800705B4$/i, 'Demorou demais e o Windows desistiu.', true],
  [/^0xC1900101$|^0xC1900208$/i, 'Driver ou programa incompatÃ­vel com a atualizaÃ§Ã£o (comum em atualizaÃ§Ã£o grande do Windows). Atualize os drivers.', false],
  [/^PARADO$/, 'O download ficou parado 30 minutos sem baixar nada. Confira a internet do PC; se repetir, use o Reparar.', true],
  [/^TEMPO$/, 'Passou de 2 horas e foi interrompida para nÃ£o travar o PC.', true],
  [/^SEMRESPOSTA$/, 'O Windows Update nÃ£o respondeu.', true],
];
function wuDica(hr) {
  const h = String(hr || '').trim();
  if (!h || /^0x0+$/.test(h)) return null;
  const e = WU_ERROS.find(([re]) => re.test(h));
  return e ? { texto: e[1], reparar: e[2] } : { texto: 'Erro do Windows Update. Reinicie o PC e tente de novo; se repetir, use o Reparar.', reparar: true };
}
const wuBotaoReparar = () => (can('tecnico') && S.actionMap.windows_update_reparar ? '<button class="btn sm primary" data-wu-reparar>ðŸ”§ Reparar o Windows Update</button>' : '');
function wuFalhasHtml(lista) {
  if (!(lista || []).length) return '';
  const algumReparar = lista.some((f) => (wuDica(f.hresult) || {}).reparar);
  return `<div class="card" style="margin:10px 0;border-color:rgba(239,68,68,.5)"><b>âš  AtualizaÃ§Ãµes que falharam (${lista.length})</b>
    ${lista.map((f) => { const d = wuDica(f.hresult); return `<div style="margin:8px 0"><div>${esc(f.title)}</div><div class="small"><span class="mono">${esc(f.hresult)}</span>${f.quando ? ` <span class="muted">Â· ${esc(when(f.quando))}</span>` : ''}</div>${d ? `<div class="small" style="color:var(--warn)">ðŸ’¡ ${esc(d.texto)}</div>` : ''}</div>`; }).join('')}
    ${algumReparar ? `<div class="btns" style="margin-top:8px">${wuBotaoReparar()}</div><p class="muted small" style="margin:6px 0 0">Reparar: reinicia os serviÃ§os de atualizaÃ§Ã£o, limpa os downloads de atualizaÃ§Ã£o e roda o DISM e o SFC (de 15 a 50 minutos, nÃ£o apaga nada do usuÃ¡rio). Depois reinicie e mande instalar de novo. Se ainda falhar: no PC, ConfiguraÃ§Ãµes â†’ Sistema â†’ RecuperaÃ§Ã£o â†’ "Reinstalar agora" (mantÃ©m arquivos e programas).</p>` : ''}</div>`;
}
function bindWuReparar(el, devId, parar) {
  $$('[data-wu-reparar]', el).forEach((b) => { b.onclick = async () => {
    if (!(await confirmBox('Reparar o Windows Update', 'Vai reiniciar os serviÃ§os de atualizaÃ§Ã£o, limpar os downloads de atualizaÃ§Ã£o (o Windows baixa de novo) e rodar o DISM e o SFC. Leva de 15 a 50 minutos e o PC fica um pouco mais lento enquanto isso. NÃ£o apaga nada do usuÃ¡rio. No fim, reinicie o PC.', 'Reparar'))) return;
    if (parar) parar();
    taskDialog([devId], 'windows_update_reparar');
  }; });
}
function wuInstalarView(r) {
  const it = r.installed || [];
  const falhas = it.filter((x) => /Falhou|erros/i.test(String(x.result || '')));
  return `${r.message ? `<p><b>${esc(r.message)}</b></p>` : ''}
    ${it.length ? `<div class="table-wrap"><table><thead><tr><th>AtualizaÃ§Ã£o</th><th>Resultado</th></tr></thead><tbody>${it.map((x) => { const d = /Falhou|erros/i.test(String(x.result || '')) ? wuDica(x.hresult) : null;
      return `<tr><td>${esc(x.title)}</td><td><span class="badge ${/^Instalada$/.test(x.result) ? 'ok' : 'bad'}">${esc(x.result)}</span>${d ? `<div class="small mono muted">${esc(x.hresult)}${x.etapa ? ' Â· no ' + esc(x.etapa) : ''}</div><div class="small" style="color:var(--warn)">ðŸ’¡ ${esc(d.texto)}</div>` : ''}</td></tr>`; }).join('')}</tbody></table></div>` : ''}
    ${falhas.some((x) => (wuDica(x.hresult) || {}).reparar) ? `<div class="btns" style="margin-top:10px">${wuBotaoReparar()}</div>` : ''}
    ${r.rebootRequired ? '<p><span class="badge warn">ReinÃ­cio necessÃ¡rio</span> para concluir.</p>' : ''}`;
}

function renderTaskResult(t) {
  const r = t.result;
  if (!r) return '';
  if (t.action === 'espaco_disco') return espacoResultado(r);
  if (t.action === 'app_remover') {
    const sob = r.sobras || [];
    return `<p><b>${esc(r.message || '')}</b></p>${r.precisaTela ? `${can('admin') && S.actionMap.app_abrir_tela && t.params && t.params.chave ? `<div class="btns" style="margin:8px 0"><button class="btn primary" data-abrir-tela="${esc(t.params.chave)}">ðŸ–¥ Abrir o desinstalador na tela do usuÃ¡rio</button></div><p class="muted small">Abre a janela de desinstalaÃ§Ã£o no PC; aÃ­ Ã© sÃ³ clicar em "Desinstalar" pelo Acesso remoto ou pedir para o usuÃ¡rio.</p>` : ''}<p class="muted small">Ou abra o Acesso remoto e desinstale pelo Painel de Controle do Windows.</p>${r.comando ? `<p class="small" style="margin-top:8px">Comando de desinstalaÃ§Ã£o deste programa (mande para a FND incluir no modo silencioso):</p><pre>${esc(r.comando)}</pre>` : ''}` : ''}
      ${r.removido && sob.length ? `<div class="card" style="margin-top:10px"><b>Pastas que sobraram (${sob.length})</b>
        <p class="muted small" style="margin:4px 0 8px">Marque as que quer limpar. Elas vÃ£o para a <b>lixeira do FND</b> no prÃ³prio PC por 7 dias (dÃ¡ para restaurar na aba Programas).</p>
        ${sob.map((x, i) => `<label style="display:flex;gap:8px;align-items:center;margin:4px 0"><input type="checkbox" data-sobra="${i}" checked> <span class="mono small">${esc(x.caminho)}</span> <span class="muted small">${x.mb != null ? esc(x.mb) + ' MB' : ''}</span></label>`).join('')}
        ${can('tecnico') ? '<div class="btns" style="margin-top:10px"><button class="btn danger" data-limpar-sobras>ðŸ—‘ Mover para a lixeira do FND</button></div>' : ''}</div>`
      : r.removido ? '<p class="muted small">Nenhuma pasta sobrou. âœ”</p>' : ''}`;
  }
  if (t.action === 'app_abrir_tela') return `<p><b>${esc(r.message || '')}</b></p>`;
  if (['app_reinstalar', 'app_ignorar', 'app_mostrar'].includes(t.action)) return `<p><b>${esc(r.message || '')}</b></p>${r.rebootRequired ? '<p><span class="badge warn">ReinÃ­cio necessÃ¡rio</span></p>' : ''}`;
  if (t.action === 'virus_segunda') {
    return `<p><b>${esc(r.message || '')}</b></p>${segundaResumo(r)}
      ${(r.achados || []).length && r.modo !== 'remover' && can('tecnico') ? `<div class="btns" style="margin-top:10px"><button class="btn danger" data-v2-remover="${esc(r.tipo || 'rapida')}">ðŸ§¹ Remover o que encontrou</button></div>` : ''}
      ${r.apagado === false ? '<p class="small" style="color:var(--warn)">NÃ£o consegui apagar o verificador do PC; ele Ã© apagado na prÃ³xima vez.</p>' : '<p class="muted small">O verificador jÃ¡ foi apagado do PC.</p>'}
      ${(r.log || []).length ? `<details><summary>Registro do verificador (msert.log)</summary><pre class="mono small" style="white-space:pre-wrap">${esc(r.log.join('\n'))}</pre></details>` : ''}`;
  }
  if (/^virus_/.test(t.action)) {
    const novas = r.novas || [];
    const ativas = (r.ameacas || []).filter((a) => a.ativa);
    return `<p><b>${esc(r.message || r.erro || '')}</b>${r.minutos ? ` <span class="muted small">(${esc(r.minutos)} min)</span>` : ''}</p>
      ${novas.length ? virusTabela(novas, false) : ''}
      ${ativas.length && can('tecnico') && t.action !== 'virus_remover' ? `<div class="btns" style="margin-top:10px"><button class="btn danger" data-v-remover>ðŸ§¹ Remover ${ativas.length} ameaÃ§a(s) ativa(s)</button></div>` : ''}
      ${r.defender || r.ameacas ? '<p class="muted small">O estado completo fica na aba ðŸ›¡ VÃ­rus do computador.</p>' : ''}`;
  }
  if (t.action === 'espaco_limpar' || t.action === 'windows_limpeza') {
    const lib = r.liberadoGB || 0, txt = lib >= 1 ? `${(Math.round(lib * 10) / 10).toLocaleString('pt-BR')} GB` : `${Math.round(lib * 1024)} MB`;
    return `<div class="card" style="margin-bottom:12px"><div style="font-size:18px;font-weight:600">${lib > 0.001 ? `âœ” Liberou ${txt}` : 'Quase nada para liberar'}</div>
      <div class="muted small" style="margin-top:4px">Agora o disco tem <b>${esc(r.livreGB)} GB</b> livres.${r.message && t.action === 'windows_limpeza' ? ' ' + esc(r.message) : ''}</div></div>
      ${(r.itens || []).map((x) => `<p class="small" style="margin:4px 0"><b>${esc(x.nome)}</b>: ${esc(x.apagados)} item(ns) apagado(s)${x.emUso ? ` <span class="muted">Â· ${esc(x.emUso)} em uso agora (ficaram; saem depois de reiniciar)</span>` : ''}</p>`).join('')}
      ${can('tecnico') && S.actionMap.espaco_disco ? '<div class="btns" style="margin-top:10px"><button class="btn" data-esp-medir>ðŸ’½ Medir o espaÃ§o de novo</button></div>' : ''}`;
  }
  if (t.action === 'arquivos_grandes') {
    const it = r.itens || [];
    if (!it.length) return `<p>Nenhum arquivo com mais de 20 MB em <span class="mono">${esc(r.pasta || '')}</span>.</p>`;
    const tam = (mb) => (mb >= 1024 ? `${(Math.round(mb / 102.4) / 10).toLocaleString('pt-BR')} GB` : `${Math.round(mb).toLocaleString('pt-BR')} MB`);
    return `<p class="muted small" style="margin:0 0 8px">Os ${it.length} maiores arquivos de <span class="mono">${esc(r.pasta || '')}</span> (${esc(r.vistos)} arquivos vistos). SÃ£o arquivos da pessoa: <b>confira com o usuÃ¡rio</b> antes de tirar.
      Os marcados vÃ£o para a <b>lixeira do FND</b> (dÃ¡ para restaurar por 7 dias).</p>
      <div class="table-wrap"><table><thead><tr><th></th><th>Arquivo</th><th>Tamanho</th><th class="hide-sm">Modificado</th></tr></thead><tbody>
      ${it.map((x, i) => `<tr><td><input type="checkbox" data-grande="${i}"></td><td class="mono small" style="word-break:break-all">${esc(x.caminho)}${x.programa ? '<div class="small" style="color:var(--warn)">âš  Arquivo de programa (AppData): tirar pode estragar o programa</div>' : ''}</td><td class="nw"><b>${tam(x.mb)}</b></td><td class="hide-sm small">${esc(String(x.data || '').split('-').reverse().join('/'))}</td></tr>`).join('')}</tbody></table></div>
      ${can('tecnico') ? '<div class="btns" style="margin-top:10px"><button class="btn danger" data-mover-grandes disabled>ðŸ—‘ Mover marcados para a lixeira do FND</button></div>' : ''}`;
  }
  if (t.action === 'lixeira_esvaziar') return `<p><b>${esc(r.message || r.motivo || '')}</b></p>`;
  if (t.action === 'sobras_limpar' || t.action === 'lixeira_restaurar') {
    const movidos = (r.itens || []).filter((x) => x.ok && x.id);
    return `<p><b>${esc(r.message || (r.ok ? 'Restaurado em ' + (r.original || '') : r.motivo || ''))}</b></p>${(r.itens || []).filter((x) => !x.ok).map((x) => `<p class="small"><span class="badge bad">nÃ£o movido</span> <span class="mono">${esc(x.caminho)}</span> â€” ${esc(x.motivo || '')}</p>`).join('')}
      ${movidos.length && can('tecnico') && S.actionMap.lixeira_esvaziar ? `<div class="btns" style="margin-top:10px"><button class="btn danger" data-esvaziar="${esc(movidos.map((x) => x.id).join(','))}">ðŸ”¥ Apagar de vez agora (libera o espaÃ§o jÃ¡)</button></div>` : ''}`;
  }
  if (t.action === 'apps_verificar') {
    if (!r.apps.length) return '<p>Todos os aplicativos estÃ£o atualizados. âœ”</p>';
    return appsTable(r.apps);
  }
  if (/^app_(atualizar|instalar|desinstalar)|apps_atualizar_lista|app_atualizar_todos/.test(t.action)) {
    // agentes antigos (atÃ© 0.2.1) mandavam apps com "ok" em vez de "status"
    if (r.apps && r.apps.length && r.apps[0].status === undefined) r.apps = r.apps.map((a) => ({ name: a.id, id: a.id, status: a.ok ? 'ok' : 'falhou', message: a.message }));
    return updateResult(r, t);
  }
  if (t.action === 'app_buscar') {
    if (!r.found.length) return '<p class="muted">Nada encontrado no catÃ¡logo do winget.</p>';
    return `<table><thead><tr><th>Aplicativo</th><th>ID</th><th>VersÃ£o</th><th></th></tr></thead><tbody>${r.found.map((a) => `<tr><td>${esc(a.name)}</td><td class="mono small">${esc(a.id)}</td><td>${esc(a.version)}</td>
      <td>${S.actionMap.app_instalar.allowed ? `<button class="btn sm primary" data-inst="${esc(a.id)}">Instalar</button>` : ''}</td></tr>`).join('')}</tbody></table>`;
  }
  if (t.action === 'seguranca_verificar' || t.action === 'seguranca_acao') return segResultado(r, t);
  if (t.action === 'diagnostico') return diagView(r);
  if (t.action === 'termico') return termicoView(r);
  if (t.action === 'inicializacao_listar' || t.action === 'inicializacao_alterar') return inicioView(r);
  if (['segundo_plano_listar', 'segundo_plano_alterar', 'segundo_plano_lote'].includes(t.action)) return segundoView(r);
  if (/^restauracao_/.test(t.action)) return restauracaoView(r);
  if (t.action === 'manutencao') {
    return `<div class="card" style="margin-bottom:12px"><div style="font-size:18px;font-weight:600">${r.ameacas ? 'ðŸ¦ ' : (t.status === 'ok' ? 'âœ…' : 'âš ï¸')} ${esc(r.message || '')}</div></div>
      ${(r.passos || []).map((p) => `<p style="margin:6px 0">${p.ok ? 'âœ…' : p.aviso ? 'â„¹ï¸' : 'âŒ'} <b>${esc(p.nome)}</b> <span class="muted small">â€” ${esc(p.message)}</span></p>`).join('')}
      <p class="muted small">Ponto de restauraÃ§Ã£o â†’ limpar tudo que pode limpar â†’ atualizar os aplicativos â†’ atualizar o antivÃ­rus e verificar vÃ­rus.</p>`;
  }
  if (t.action === 'backup_agora') {
    const ds = r.destinos || {};
    return `<div class="card" style="margin-bottom:12px"><div style="font-size:18px;font-weight:600">${r.ok ? 'âœ…' : 'âš ï¸'} ${esc(r.message || '')}</div>
      <div class="muted small" style="margin-top:4px">${esc(r.arquivos || 0)} arquivo(s) nas pastas Â· ${esc(r.copiados || 0)} copiado(s) agora (${esc(tamanho(r.bytes))})${r.emUso ? ` Â· ${esc(r.emUso)} em uso, copiados pela cÃ³pia de sombra` : ''}</div></div>
      ${Object.entries(ds).map(([k, v]) => `<p class="small">${k === 'local' ? 'HD/rede' : 'Central'}: ${v.ok ? '<span class="badge ok">ok</span>' : '<span class="badge bad">falhou</span>'} ${esc(v.message || '')}</p>`).join('')}
      ${(r.erros || []).length ? `<details><summary class="small">Arquivos com problema (${r.erros.length})</summary><div class="small mono">${r.erros.map(esc).join('<br>')}</div></details>` : ''}`;
  }
  if (t.action === 'backup_testar') {
    return `<div class="card"><div style="font-size:18px;font-weight:600">${r.ok ? 'âœ…' : 'âš ï¸'} ${esc(r.message || '')}</div>
      ${Object.entries(r.destinos || {}).map(([k, v]) => `<p class="small">${k === 'local' ? 'HD/rede' : 'Central'}: ${esc(v.ok)} de ${esc(v.testados)} arquivo(s) ok${(v.erros || []).length ? `<br><span class="muted mono">${v.erros.map(esc).join('<br>')}</span>` : ''}</p>`).join('')}
      <p class="muted small">Restaura alguns arquivos numa pasta temporÃ¡ria, compara byte a byte com o original e apaga a pasta. Nada do cliente Ã© mexido.</p></div>`;
  }
  if (t.action === 'backup_restaurar') return `<div class="card"><div style="font-size:18px;font-weight:600">${r.ok ? 'âœ…' : 'âš ï¸'} ${esc(r.message || '')}</div>${r.para && r.para !== 'lugar original' ? `<p class="small">Pasta: <span class="mono">${esc(r.para)}</span></p>` : ''}${(r.erros || []).length ? `<details><summary class="small">NÃ£o deu (${r.erros.length})</summary><div class="small mono">${r.erros.map(esc).join('<br>')}</div></details>` : ''}</div>`;
  if (t.action === 'lixeira_windows') {
    return `<div class="card" style="margin-bottom:12px"><div style="font-size:18px;font-weight:600">ðŸ—‘ ${esc(r.message || '')}</div>${r.livreGB != null ? `<div class="muted small" style="margin-top:4px">Agora o disco do sistema tem <b>${esc(r.livreGB)} GB</b> livres.</div>` : ''}</div>
      ${(r.usuarios || []).map((u) => `<p class="small" style="margin:4px 0"><b>${esc(u.usuario)}</b>: ${u.erro ? `<span style="color:var(--warn)">nÃ£o deu (${esc(u.erro)})</span>` : `${esc(u.itens)} item(ns), ${esc(Math.round(u.mb || 0))} MB${(u.unidades || []).length ? ` Â· unidades ${esc(u.unidades.join(', '))}` : ''}${u.resto ? ` Â· <span style="color:var(--warn)">${esc(u.resto)} ficaram (em uso)</span>` : ''}`}</p>`).join('')}
      <p class="muted small">Esvazia a lixeira de todos os discos do PC e, na sessÃ£o de quem estÃ¡ logado, tambÃ©m a das unidades que sÃ³ o usuÃ¡rio vÃª (Google Drive, OneDrive, pendrive, HD externo).</p>`;
  }
  if (t.action === 'drivers_verificar') return driversView(r);
  if (t.action === 'drivers_instalar') return wuInstalarView(r);
  if (t.action === 'windows_update_verificar') return wuFalhasHtml(r.falhas) + (r.updates.length ? autoTable(r.updates) : '<p>Nenhuma atualizaÃ§Ã£o do Windows pendente. âœ”</p>');
  if (t.action === 'windows_update_instalar') return wuInstalarView(r);
  if (t.action === 'windows_update_reparar') return `<div class="card" style="margin-bottom:12px"><div style="font-size:17px;font-weight:600">${r.ok ? 'âœ”' : 'âš '} ${esc(r.message || '')}</div></div>${(r.passos || []).map((p) => `<p class="small" style="margin:3px 0">â€¢ ${esc(p)}</p>`).join('')}${r.rebootRequired && can('admin') && S.actionMap.reiniciar_pc ? '<div class="btns" style="margin-top:10px"><button class="btn danger" data-reboot>Reiniciar PC</button></div>' : ''}`;
  if (t.action === 'disco_quem_grava') return discoQuemGravaView(r);
  if (t.action === 'atualizar_agente') return `<p><b>${esc(r.message || '')}</b></p>`;
  if (t.action === 'instalar_pacote') return `<p><b>${esc(r.message || '')}</b></p><dl class="kv"><dt>Programa</dt><dd>${esc(t.params.nome || '')} Â· ${esc(t.params.arquivo || '')}</dd><dt>CÃ³digo de saÃ­da</dt><dd>${esc(r.exitCode)}</dd><dt>Arquivo conferido</dt><dd>SHA-256 âœ”</dd>${r.rebootRequired ? '<dt>ReinÃ­cio</dt><dd><span class="badge warn">NecessÃ¡rio</span></dd>' : ''}</dl>`;
  return autoRender(r);
}

// botÃµes do "O que estÃ¡ ocupando espaÃ§o" e dos resultados de limpeza
function bindEspaco(m, t, parar) {
  const dev = t.device_id;
  const pc = S.view === VIEWS.pc && VIEWS.pc.id === dev ? VIEWS.pc.d : null;
  const nome = pc ? esc(pc.alias || pc.hostname) : 'o computador';
  $$('[data-esp-limpar]', m).forEach((b) => { b.onclick = async () => {
    const alvos = b.dataset.espLimpar.split(',');
    if (!(await confirmBox('Limpar', `Apagar de vez em <b>${nome}</b>:<ul>${alvos.map((a) => `<li>${esc(ESP_ALVO[a] || a)}</li>`).join('')}</ul>Ã‰ seguro: o Windows e os programas recriam o que precisarem. O que estiver em uso agora fica.`, 'Limpar'))) return;
    parar(); quickTask(dev, 'espaco_limpar', { alvos: alvos.join(',') });
  }; });
  $$('[data-esp-mover]', m).forEach((b) => { b.onclick = async () => {
    if (!(await confirmBox('Mover para a lixeira do FND', `Mover <span class="mono">${esc(b.dataset.espMover)}</span> para a lixeira do FND?<br><br>Fica lÃ¡ 7 dias (dÃ¡ para restaurar na aba Programas). Para liberar o espaÃ§o na hora, depois clique em "Apagar de vez agora".`, 'Mover', true))) return;
    parar(); quickTask(dev, 'sobras_limpar', { caminhos: b.dataset.espMover });
  }; });
  $$('[data-esp-grandes]', m).forEach((b) => { b.onclick = () => { parar(); quickTask(dev, 'arquivos_grandes', { pasta: b.dataset.espGrandes }); }; });
  $$('[data-esp-restauracao]', m).forEach((b) => { b.onclick = () => { parar(); quickTask(dev, 'restauracao_listar'); }; });
  $$('[data-esp-programas]', m).forEach((b) => { b.onclick = () => { m.close(); VIEWS.pc.tab = 'programas'; if (S.view === VIEWS.pc && VIEWS.pc.id === dev) VIEWS.pc.refresh(); else location.hash = '#/pc/' + dev; }; });
  $$('[data-esp-windows]', m).forEach((b) => { b.onclick = async () => {
    if (!(await confirmBox('Limpeza do Windows', `Rodar a limpeza oficial do Windows em <b>${nome}</b>? Tira componentes antigos das atualizaÃ§Ãµes (costuma liberar de 2 a 10 GB).<br><br>Leva de 10 a 60 minutos e o PC fica um pouco mais lento enquanto roda. Depois disso, as atualizaÃ§Ãµes jÃ¡ instaladas nÃ£o podem mais ser desinstaladas.`, 'Rodar limpeza'))) return;
    parar(); quickTask(dev, 'windows_limpeza');
  }; });
  const med = $('[data-esp-medir]', m); if (med) med.onclick = () => { parar(); quickTask(dev, 'espaco_disco'); };
  const mg = $('[data-mover-grandes]', m);
  if (mg) {
    const marc = () => $$('[data-grande]:checked', m).map((c) => t.result.itens[Number(c.dataset.grande)].caminho);
    $$('[data-grande]', m).forEach((c) => { c.onchange = () => { const n = marc().length; mg.disabled = !n; mg.textContent = `ðŸ—‘ Mover marcados para a lixeira do FND${n ? ` (${n})` : ''}`; parar(); }; });
    mg.onclick = async () => {
      const l = marc(); if (!l.length) return;
      if (!(await confirmBox('Mover para a lixeira do FND', `Mover ${l.length} arquivo(s) para a lixeira do FND? O usuÃ¡rio deixa de ver esses arquivos. Ficam 7 dias e dÃ¡ para restaurar.`, 'Mover', true))) return;
      quickTask(dev, 'sobras_limpar', { caminhos: l.join('\n') });
    };
  }
  $$('[data-esvaziar]', m).forEach((b) => { b.onclick = async () => {
    const ids = b.dataset.esvaziar.split(',');
    if (!(await confirmBox('Apagar de vez', `Apagar de vez ${ids.length > 1 ? `os ${ids.length} itens` : 'o item'}? Depois disso <b>nÃ£o dÃ¡ mais para restaurar</b>.`, 'Apagar de vez', true))) return;
    parar(); quickTask(dev, 'lixeira_esvaziar', { id: ids.join(',') });
  }; });
}

let openTaskModal = null;
// resultado em destaque: âœ… deu certo (e o que foi conferido) / âš  com avisos / âœ– nÃ£o deu
function veredito(status, msg, conferido) {
  const ok = status === 'concluida', av = status === 'avisos';
  const tit = ok ? (conferido ? 'âœ… ConcluÃ­do com sucesso â€” conferido no computador' : 'âœ… ConcluÃ­do com sucesso') : av ? 'âš  Terminou, mas com avisos' : status === 'cancelada' ? 'â¹ Cancelada' : 'âœ– NÃ£o deu certo';
  return { cls: ok ? 'ok' : av ? 'warn' : 'bad', tit, msg: String(msg || '').replace(/^âœ” ?Confirmado: ?/, '') };
}
function vereditoHtml(t) {
  const r = t.result && typeof t.result === 'object' ? t.result : {};
  const v = veredito(t.status, r.message || r.summary || r.error || '', r.verificado === true);
  return `<div class="veredito ${v.cls}"><b>${esc(v.tit)}</b>${v.msg ? `<div>${esc(v.msg)}</div>` : ''}<div class="muted small">${esc(when(t.finished_at))}</div></div>`;
}
// aviso no canto quando termina uma tarefa mandada daqui (se a janela dela nÃ£o estiver aberta)
function avisoResultado(data) {
  if (openTaskModal && openTaskModal.taskId === Number(data.id)) return;
  const f = data.fim, v = veredito(f.status, f.msg, f.conferido);
  const el = document.createElement('div');
  el.className = `toast ${v.cls === 'bad' ? 'err' : v.cls} res-aviso`; el.setAttribute('role', 'status');
  el.innerHTML = `<b>${esc(v.tit)}</b><div class="small">${esc(f.acao)} Â· ${esc(f.pc)}</div>${v.msg ? `<div class="small muted">${esc(v.msg)}</div>` : ''}<div class="btns" style="margin-top:6px;gap:6px"><button class="btn sm" data-ver>Ver detalhes</button><button class="btn sm ghost" data-x>Fechar</button></div>`;
  $('[data-ver]', el).onclick = () => { el.remove(); openTask(data.id); };
  $('[data-x]', el).onclick = () => el.remove();
  $('#toasts').appendChild(el);
  if (v.cls === 'ok') setTimeout(() => el.remove(), 15000); // erro/aviso fica atÃ© fechar
}
async function openTask(id) {
  if (openTaskModal) openTaskModal.close();
  const m = modal(`Tarefa #${id}`, '<p class="muted">Carregando...</p>', { wide: true, footer: '<button class="btn" data-close>Fechar</button>' });
  openTaskModal = m; m.taskId = Number(id);
  m.onclose = () => { if (openTaskModal === m) openTaskModal = null; clearInterval(m.timer); };
  const load = async () => {
    let t; try { t = await GET('/tasks/' + id); } catch (e) { $('.body', m).innerHTML = esc(e.message); return; }
    const running = ['pendente', 'enviada', 'executando'].includes(t.status);
    $('.body', m).innerHTML = `<div class="row" style="margin-bottom:14px"><div><b>${esc(actLabel(t.action))}</b><div class="muted small">${devName(t)} Â· criada por ${esc(t.created_by)} ${when(t.created_at)}</div></div>
      <div style="text-align:right"><span class="badge ${esc(t.status)}">${esc(statusLabel[t.status] || t.status)}</span>${running ? ' <span class="muted small">atualiza sozinho...</span>' : ''}</div></div>
      ${t.params && Object.keys(t.params).length ? `<pre style="margin-bottom:12px">${esc(t.params.script || (t.action === 'instalar_pacote' ? `${t.params.arquivo}  ${t.params.args || ''}\nSHA-256: ${t.params.sha256}` : t.params.ids ? 'Aplicativos: ' + t.params.ids.split(',').join(', ') : t.action === 'atualizar_agente' ? `VersÃ£o ${t.params.versao}  Â·  SHA-256 ${t.params.sha256}` : JSON.stringify(t.params)))}</pre>` : ''}
      ${t.status === 'pendente' && t.scheduled_for ? `<p>Agendada para <b>${dt(t.scheduled_for)}</b>.</p>` : ''}
      ${waitLabel(t) ? `<p class="muted">Aguardando o horÃ¡rio de manutenÃ§Ã£o do cliente (<b>${esc(t.maintenance_window)}</b>). Roda sozinha quando chegar a hora.</p>` : ''}
      ${t.status === 'pendente' && !t.scheduled_for && !waitLabel(t) ? '<p class="muted">Aguardando o computador ficar online...</p>' : ''}
      ${t.status === 'executando' ? `<div style="margin:6px 0 12px">${progBar(t, true)}</div>` : ''}
      ${['concluida', 'avisos', 'erro', 'cancelada'].includes(t.status) ? vereditoHtml(t) : ''}
      ${running && can('tecnico') ? `<div class="btns" style="margin:8px 0 4px"><button class="btn danger sm" data-stop="${t.id}">${t.status === 'pendente' ? 'Cancelar tarefa' : 'Encerrar tarefa'}</button>${t.status !== 'pendente' ? '<span class="muted small" style="align-self:center">Para o que estiver rodando no computador e tira a tarefa da fila.</span>' : ''}</div>` : ''}
      ${['concluida', 'avisos', 'erro'].includes(t.status) && t.result ? `<div class="btns no-print" style="margin:0 0 10px;gap:6px"><button class="btn sm" data-rel-print>ðŸ–¨ Imprimir / PDF</button><button class="btn sm" data-rel-zap>ðŸ’¬ WhatsApp do cliente</button></div>` : ''}
      <div id="res">${renderTaskResult(t)}</div>
      ${t.output ? `<h3 style="margin-top:16px">SaÃ­da</h3><pre>${esc(t.output)}</pre>` : ''}`;
    // ðŸ§¹ terminou a limpeza que eu vi rodando: volta sozinho para a tela do espaÃ§o, jÃ¡ medida de novo (sem clicar em "Medir")
    if (running) m.viuRodando = true;
    if (t.action === 'espaco_limpar' && m.viuRodando && !m.voltou && ['concluida', 'avisos'].includes(t.status) && S.actionMap.espaco_disco && can('tecnico')) {
      m.voltou = true;
      const aviso = document.createElement('p'); aviso.className = 'muted'; aviso.style.margin = '8px 0'; aviso.textContent = 'â†© Voltando para a tela do espaÃ§o, jÃ¡ medida de novo...'; $('#res', m).prepend(aviso);
      setTimeout(() => { if (openTaskModal === m) { clearInterval(m.timer); quickTask(t.device_id, 'espaco_disco'); } }, 2500);
    }
    if (t.action === 'apps_verificar') bindAppsTable(m, t.device_id, () => clearInterval(m.timer));
    const rb = $('[data-reboot]', m); if (rb) rb.onclick = () => { clearInterval(m.timer); quickTask(t.device_id, 'reiniciar_pc'); };
    const ls = $('[data-limpar-sobras]', m);
    if (ls) ls.onclick = () => {
      const marc = $$('[data-sobra]:checked', m).map((c) => t.result.sobras[Number(c.dataset.sobra)].caminho);
      if (!marc.length) return toast('Marque pelo menos uma pasta.', 'err');
      clearInterval(m.timer);
      quickTask(t.device_id, 'sobras_limpar', { caminhos: marc.join('\n') });
    };
    $$('[data-inst]', m).forEach((b) => { b.onclick = () => quickTask(t.device_id, 'app_instalar', { id: b.dataset.inst }); });
    bindEspaco(m, t, () => clearInterval(m.timer));
    bindAppAcoes(m, t.device_id, () => clearInterval(m.timer));
    bindInicio(m, t, () => clearInterval(m.timer));
    bindDiagResolver(m, t, () => clearInterval(m.timer));
    bindSegundo(m, t.device_id, () => clearInterval(m.timer));
    bindWuReparar(m, t.device_id, () => clearInterval(m.timer));
    bindRestauracao(m, t.device_id, () => clearInterval(m.timer));
    const at = $('[data-abrir-tela]', m); if (at) at.onclick = () => { clearInterval(m.timer); quickTask(t.device_id, 'app_abrir_tela', { chave: at.dataset.abrirTela }); };
    const rp = $('[data-rel-print]', m);
    if (rp) rp.onclick = () => {
      const cli = S.clients.find((c) => String(c.id) === String(t.client_id));
      imprimirArea(actLabel(t.action), `Computador: <b>${devName(t)}</b>${cli ? ` Â· Cliente: <b>${esc(cli.name)}</b>` : ''} Â· ${esc(dt(t.finished_at || t.created_at))} Â· TÃ©cnico: ${esc(S.me.name || S.me.username)}`, $('#res', m).innerHTML);
    };
    const rz = $('[data-rel-zap]', m); if (rz) rz.onclick = () => abrirZap(resumoTexto(t), t.client_id);
    const vr = $('[data-v-remover]', m); if (vr) vr.onclick = () => { clearInterval(m.timer); quickTask(t.device_id, 'virus_remover'); };
    const v2 = $('[data-v2-remover]', m); if (v2) v2.onclick = () => { clearInterval(m.timer); m.close(); segundaDialog({ id: t.device_id }, 'remover', v2.dataset.v2Remover); };
    if (t.action === 'drivers_verificar' && t.result) bindDrivers(m, t.device_id, t.result.updates || [], () => clearInterval(m.timer));
    const sb = $('[data-stop]', m);
    if (sb) sb.onclick = async () => {
      const enc = t.status !== 'pendente';
      if (!(await confirmBox(enc ? 'Encerrar tarefa' : 'Cancelar tarefa', enc ? `Encerrar a tarefa #${t.id}? Se ela ainda estiver rodando no computador, o processo Ã© finalizado na hora.` : `Cancelar a tarefa #${t.id}?`, enc ? 'Encerrar' : 'Cancelar tarefa', true))) return;
      try { await POST(`/tasks/${t.id}/cancel`); toast(enc ? 'Tarefa encerrada.' : 'Tarefa cancelada.', 'ok'); load(); if (S.view && S.view.refresh) S.view.refresh(); } catch (e) { fail(e); }
    };
    if (!running) clearInterval(m.timer);
  };
  await load();
  m.timer = setInterval(load, 3000);
}

VIEWS.tarefas = {
  async render(el, q = '') {
    this.el = el;
    const qs = new URLSearchParams(String(q).replace(/^\?/, ''));
    this.grupo = qs.get('grupo') || '';
    setTitle('Tarefas');
    el.innerHTML = `${this.grupo ? `<div class="filtro-ativo">Mostrando sÃ³ as tarefas de <b>${esc(this.grupo)}</b> <a href="#/tarefas">âœ• ver todas</a></div>` : ''}<div class="toolbar"><select id="ts"><option value="">Todos os status</option><option value="ativas">Em andamento (na fila, enviadas e executando)</option>${Object.entries(statusLabel).map(([k, v]) => `<option value="${k}">${v}</option>`).join('')}</select>
      <input class="grow" id="tq" placeholder="Filtrar por computador ou tarefa..."></div><div id="tl"></div>`;
    if (qs.get('status')) $('#ts').value = qs.get('status');
    $('#ts').onchange = () => this.refresh(); $('#tq').oninput = () => this.draw();
    await this.refresh();
  },
  limit: 200,
  async refresh() { this.rows = await GET(`/tasks?limit=${this.limit}` + ($('#ts').value ? '&status=' + $('#ts').value : '')); this.draw(); },
  draw() {
    const q = $('#tq').value.toLowerCase();
    const grp = (k) => ((S.actions || []).find((a) => a.key === k) || {}).group || '';
    $('#tl').innerHTML = taskTable(this.rows.filter((t) => (!this.grupo || grp(t.action) === this.grupo) && (!q || `${t.hostname} ${t.alias} ${actLabel(t.action)} ${t.client_name}`.toLowerCase().includes(q))))
      + (this.rows.length >= this.limit && this.limit < 1000 ? '<div class="btns" style="justify-content:center;margin:12px 0"><button class="btn" id="tmore">Carregar tarefas mais antigas</button></div>' : '');
    if ($('#tmore')) $('#tmore').onclick = () => { this.limit = Math.min(this.limit + 200, 1000); this.refresh(); };
    bindTaskTable(this.el);
  },
};

// ================= AGENDAMENTOS RECORRENTES =================
const DIAS = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'SÃ¡b'];
const diasLabel = (d) => { const a = d.split(',').map(Number); if (a.length === 7) return 'Todos os dias'; if (a.join() === '1,2,3,4,5') return 'Seg a Sex'; return a.map((x) => DIAS[x]).join(', '); };
VIEWS.agendamentos = {
  async render(el) {
    this.el = el;
    setTitle('Agendamentos', '<button class="btn" id="nmanut" title="Ponto de restauraÃ§Ã£o, limpeza, aplicativos e vÃ­rus toda semana, de madrugada">ðŸ§° ManutenÃ§Ã£o semanal</button><button class="btn primary" id="nsch">+ Novo agendamento</button>');
    $('#nsch').onclick = () => this.edit(null);
    $('#nmanut').onclick = () => this.manutencaoSemanal();
    await loadClients();
    await this.refresh();
  },
  // atalho: cria o agendamento da manutenÃ§Ã£o completa para um cliente (ou todos), 1 vez por semana de madrugada
  manutencaoSemanal() {
    const m = modal('ðŸ§° ManutenÃ§Ã£o semanal', `<p class="muted small" style="margin-top:0">Toda semana, em cada PC: <b>ponto de restauraÃ§Ã£o â†’ limpar tudo que pode limpar â†’ atualizar os aplicativos â†’ atualizar o antivÃ­rus e verificar vÃ­rus</b>. PC desligado faz quando ligar. Respeita o horÃ¡rio de manutenÃ§Ã£o do cliente e nÃ£o roda enquanto alguÃ©m joga.</p>
      <label>Para</label><select id="mn-alvo"><option value="todos">Todos os computadores</option>${S.clients.map((c) => `<option value="${c.id}">Cliente: ${esc(c.name)}</option>`).join('')}</select>
      <div class="grid g2" style="gap:8px"><div><label>Dia</label><select id="mn-dia">${DIAS.map((d, i) => `<option value="${i}" ${i === 0 ? 'selected' : ''}>${['Domingo', 'Segunda', 'TerÃ§a', 'Quarta', 'Quinta', 'Sexta', 'SÃ¡bado'][i]}</option>`).join('')}</select></div>
      <div><label>HorÃ¡rio</label><input id="mn-hora" type="time" value="03:00"></div></div>
      <label style="margin-top:8px">Passos</label>${[['ponto', 'Ponto de restauraÃ§Ã£o'], ['limpar', 'Limpar tudo que pode limpar <span class="muted small">(temporÃ¡rios, atualizaÃ§Ãµes baixadas, cache dos navegadores, despejos de erro, lixeira)</span>'], ['apps', 'Atualizar os aplicativos'], ['virus', 'AntivÃ­rus: atualizar e verificar']].map(([k, t]) => `<label style="color:var(--text);margin:2px 0"><input type="checkbox" data-mn="${k}" checked> ${t}</label>`).join('')}`,
      { footer: '<button class="btn ghost" data-close>Cancelar</button><button class="btn primary" data-ok>Criar</button>' });
    $('[data-ok]', m).onclick = async () => {
      const itens = $$('[data-mn]', m).filter((x) => x.checked).map((x) => x.dataset.mn);
      if (!itens.length) return toast('Escolha pelo menos um passo.', 'err');
      const alvo = $('#mn-alvo', m).value; const cli = S.clients.find((c) => String(c.id) === alvo);
      try {
        await POST('/schedules', { name: `ManutenÃ§Ã£o semanal${cli ? ' â€” ' + cli.name : ''}`, action: 'manutencao', params: itens.length === 4 ? {} : { itens: itens.join(',') },
          targetType: alvo === 'todos' ? 'todos' : 'cliente', targetId: alvo === 'todos' ? null : alvo, days: [Number($('#mn-dia', m).value)], time: $('#mn-hora', m).value || '03:00', respectWindow: true, active: true });
        m.close(); toast('ManutenÃ§Ã£o semanal criada.', 'ok'); this.refresh();
      } catch (e) { fail(e); }
    };
  },
  async refresh() {
    const rows = await GET('/schedules');
    this.rows = rows;
    this.el.innerHTML = (rows.length ? `<div class="table-wrap"><table><thead><tr><th>Agendamento</th><th>Tarefa</th><th>Computadores</th><th>Quando</th><th class="hide-sm">PrÃ³xima</th><th class="hide-sm">Ãšltima</th><th>Ativo</th><th></th></tr></thead><tbody>
      ${rows.map((r) => `<tr><td><b>${esc(r.name)}</b>${r.respectWindow ? '<div class="muted small">respeita o horÃ¡rio de manutenÃ§Ã£o</div>' : ''}<div class="muted small">${{ esperar: 'desligado: faz 15 min depois de ligar', ligar: 'desligado: faz quando ligar', pular: 'desligado: pula' }[r.quandoOff] || ''}</div></td><td>${esc(actLabel(r.action))}</td>
        <td>${esc(r.targetLabel)} <span class="muted small">(${r.devices})</span></td><td class="nw">${esc(diasLabel(r.days))} Ã s <b>${esc(r.time)}</b></td>
        <td class="hide-sm small">${r.next ? dt(r.next) : 'â€”'}</td><td class="hide-sm small">${r.lastRun ? esc(r.lastRun.split('-').reverse().join('/')) : 'â€”'}</td>
        <td><label><input type="checkbox" data-act="${r.id}" ${r.active ? 'checked' : ''}></label></td>
        <td><div class="btns"><button class="btn sm" data-run="${r.id}">Executar agora</button><button class="btn sm" data-edit="${r.id}">Editar</button><button class="btn sm danger" data-del="${r.id}">Excluir</button></div></td></tr>`).join('')}</tbody></table></div>`
      : '<div class="card"><p class="muted">Nenhum agendamento ainda.</p><p class="muted small">Exemplos: "Toda sexta 22:00 â€” Atualizar todos os aplicativos â€” Cliente Augusta", "Todo dia 12:00 â€” Atualizar inventÃ¡rio â€” Todos os computadores".</p></div>')
      + '<p class="muted small">Tarefas pesadas (atualizar, instalar, reiniciar) com "respeitar o horÃ¡rio de manutenÃ§Ã£o" ficam na fila atÃ© o horÃ¡rio permitido do cliente. Computadores desligados fazem a tarefa quando voltarem.</p>';
    $$('[data-act]', this.el).forEach((c) => { c.onchange = async () => { try { await api('PATCH', '/schedules/' + c.dataset.act, { active: c.checked }); toast(c.checked ? 'Agendamento ativado.' : 'Agendamento pausado.', 'ok'); this.refresh(); } catch (e) { fail(e); } }; });
    $$('[data-run]', this.el).forEach((b) => { b.onclick = async () => { if (!(await confirmBox('Executar agora', 'Criar as tarefas deste agendamento agora?', 'Executar'))) return; try { const r = await POST(`/schedules/${b.dataset.run}/run`); toast(`${r.count} tarefa(s) criada(s).`, 'ok'); } catch (e) { fail(e); } }; });
    $$('[data-edit]', this.el).forEach((b) => { b.onclick = () => this.edit(this.rows.find((r) => r.id === +b.dataset.edit)); });
    $$('[data-del]', this.el).forEach((b) => { b.onclick = async () => { if (await confirmBox('Excluir agendamento', 'Excluir este agendamento?', 'Excluir', true)) { try { await api('DELETE', '/schedules/' + b.dataset.del); this.refresh(); } catch (e) { fail(e); } } }; });
  },
  async edit(r) {
    r = r || { days: '1,2,3,4,5', time: '22:00', targetType: 'cliente', respectWindow: true, active: true, params: {} };
    const devices = await GET('/devices');
    let packages = []; try { packages = await GET('/packages'); } catch { /* */ }
    const acts = S.actions.filter((a) => a.allowed && (!a.tela || a.key === r.action) && !['remover_agente', 'apps_atualizar_lista', 'app_buscar'].includes(a.key));
    const groups = [...new Set(acts.map((a) => a.group))];
    const m = modal(r.id ? 'Editar agendamento' : 'Novo agendamento', `<form id="sf">
      <label>Nome</label><input name="name" value="${esc(r.name || '')}" placeholder="ex.: Atualizar apps toda sexta" required>
      <label>Tarefa</label><select name="action">${groups.map((g) => `<optgroup label="${esc(g)}">${acts.filter((a) => a.group === g).map((a) => `<option value="${a.key}" ${a.key === r.action ? 'selected' : ''}>${esc(a.label)}</option>`).join('')}</optgroup>`).join('')}</select>
      <div id="spp"></div>
      <div class="row"><div><label>Em quais computadores</label><select name="targetType">${[['todos', 'Todos os computadores'], ['cliente', 'Um cliente'], ['grupo', 'Um grupo / setor'], ['pc', 'Um computador']].map(([k, l]) => `<option value="${k}" ${r.targetType === k ? 'selected' : ''}>${l}</option>`).join('')}</select></div>
        <div id="tgt"></div></div>
      <label>Dias da semana</label><div class="btns">${DIAS.map((d, i) => `<label class="badge" style="cursor:pointer;padding:6px 10px"><input type="checkbox" name="d${i}" ${r.days.split(',').includes(String(i)) ? 'checked' : ''}> ${d}</label>`).join('')}</div>
      <div class="row"><div><label>HorÃ¡rio</label><input type="time" name="time" value="${esc(r.time)}" required></div><div></div></div>
      <label style="color:var(--text)"><input type="checkbox" name="respectWindow" ${r.respectWindow ? 'checked' : ''}> Respeitar o horÃ¡rio de manutenÃ§Ã£o do cliente (tarefas pesadas)</label>
      <label>Se o computador estiver desligado na hora</label><select name="quandoOff">
        <option value="esperar" ${(r.quandoOff || 'esperar') === 'esperar' ? 'selected' : ''}>Fazer quando ligar, depois de 15 min ligado (recomendado: nÃ£o pesa na chegada do usuÃ¡rio)</option>
        <option value="ligar" ${r.quandoOff === 'ligar' ? 'selected' : ''}>Fazer assim que ligar</option>
        <option value="pular" ${r.quandoOff === 'pular' ? 'selected' : ''}>Pular (faz sÃ³ na prÃ³xima vez que estiver ligado na hora)</option></select>
      <label style="color:var(--text)"><input type="checkbox" name="active" ${r.active ? 'checked' : ''}> Ativo</label></form>`,
    { wide: true, footer: '<button class="btn ghost" data-close>Cancelar</button><button class="btn primary" id="sv">Salvar</button>' });
    const f = $('#sf', m);
    tarefaPicker(f.action);
    const drawTarget = () => {
      const t = f.targetType.value;
      $('#tgt', m).innerHTML = t === 'cliente' ? `<label>Cliente</label><select name="targetId">${clientOptions(r.targetId, false)}</select>`
        : t === 'grupo' ? `<label>Grupo / setor</label><select name="targetId">${S.groups.map((g) => `<option value="${g.id}" ${String(r.targetId) === String(g.id) ? 'selected' : ''}>${esc(g.name)} Â· ${esc(g.client_name)}</option>`).join('') || '<option value="">(nenhum grupo cadastrado)</option>'}</select>`
          : t === 'pc' ? `<label>Computador</label><select name="targetId">${devices.filter((d) => !d.revoked).map((d) => `<option value="${esc(d.id)}" ${r.targetId === d.id ? 'selected' : ''}>${devName(d)} Â· ${esc(d.clientName || '')}</option>`).join('')}</select>` : '';
    };
    const drawParams = () => {
      const a = S.actionMap[f.action.value];
      $('#spp', m).innerHTML = (a.params.includes('alvos') ? alvosHtml(r.params.alvos, true) : '') + (a.params.includes('pacote') ? `<label>Programa</label><select name="pacote">${packages.map((k) => `<option value="${k.id}" ${String(r.params.pacote) === String(k.id) ? 'selected' : ''}>${esc(k.name)} Â· ${esc(k.filename)}</option>`).join('') || '<option value="">(biblioteca vazia)</option>'}</select>` : '')
        + (a.params.includes('id') ? `<label>ID do aplicativo no winget</label><input name="id" value="${esc(r.params.id || '')}">` : '')
        + (a.params.includes('nome') ? `<label>Nome do serviÃ§o</label><input name="nome" value="${esc(r.params.nome || '')}">` : '')
        + (a.params.includes('script') ? `<label>Script PowerShell</label><textarea name="script" spellcheck="false">${esc(r.params.script || '')}</textarea>` : '');
    };
    f.targetType.onchange = drawTarget; f.action.onchange = drawParams; drawTarget(); drawParams();
    $('#sv', m).onclick = async () => {
      const d = formData(f);
      const a = S.actionMap[d.action];
      const params = {}; for (const k of a.params) params[k] = d[k];
      if (a.params.includes('alvos')) { params.alvos = alvosDe(d); if (!params.alvos) return toast('Marque pelo menos uma coisa para limpar.', 'err'); }
      const body = { name: d.name, action: d.action, params, targetType: d.targetType, targetId: d.targetId, days: DIAS.map((_, i) => (d['d' + i] ? i : -1)).filter((i) => i >= 0), time: d.time, respectWindow: d.respectWindow, active: d.active, quandoOff: d.quandoOff };
      try { r.id ? await api('PATCH', '/schedules/' + r.id, body) : await POST('/schedules', body); m.close(); toast('Agendamento salvo.', 'ok'); this.refresh(); } catch (e) { fail(e); }
    };
  },
};

// ================= ALERTAS =================
const ALERTA_FILTRO = { 'virus,seguranca,antivirus': ['VÃ­rus e seguranÃ§a', 'VÃ­rus'], 'aviso,critico': ['Precisam de manutenÃ§Ã£o', ''] };
VIEWS.alertas = {
  async render(el, q = '') {
    this.el = el;
    const qs = new URLSearchParams(String(q).replace(/^\?/, ''));
    this.tipos = qs.get('tipo') ? qs.get('tipo').split(',') : null; this.sevs = qs.get('sev') ? qs.get('sev').split(',') : null;
    setTitle('Alertas e notificaÃ§Ãµes', '<label class="muted small"><input type="checkbox" id="allal"> Mostrar resolvidos</label>'); $('#allal').onchange = () => this.refresh(); await this.refresh();
  },
  async refresh() {
    let rows = await GET('/alerts' + ($('#allal') && $('#allal').checked ? '?all=1' : ''));
    const f = ALERTA_FILTRO[(this.tipos || this.sevs || []).join(',')] || null;
    if (this.tipos) rows = rows.filter((a) => this.tipos.includes(a.type));
    if (this.sevs) rows = rows.filter((a) => this.sevs.includes(a.severity));
    const topo = this.tipos || this.sevs ? `<div class="filtro-ativo">Mostrando sÃ³: <b>${esc(f ? f[0] : 'filtrados')}</b> <a href="#/alertas">âœ• ver todos os alertas</a>${f && f[1] ? ` Â· <a href="#/tarefas?grupo=${encodeURIComponent(f[1])}">ver as tarefas de ${esc(f[1])}</a>` : ''}</div>` : '';
    this.el.innerHTML = topo + (rows.length ? `<div class="table-wrap"><table><thead><tr><th>Gravidade</th><th>Alerta</th>${S.me.clientId ? '' : '<th>Cliente</th>'}<th>Quando</th><th>SituaÃ§Ã£o</th><th></th></tr></thead><tbody>
      ${rows.map((a) => `<tr><td><span class="badge ${a.severity}">${sevLabel[a.severity] || a.severity}</span></td><td>${a.device_id ? `<a href="#/pc/${esc(a.device_id)}">${esc(a.message)}</a>` : esc(a.message)}</td>
      ${S.me.clientId ? '' : `<td>${esc(a.client_name || 'â€”')}</td>`}<td class="small">${when(a.created_at)}</td><td class="small">${a.resolved_at ? 'Resolvido ' + when(a.resolved_at) : '<b>Aberto</b>'}</td>
      <td><div class="btns" style="gap:6px;flex-wrap:wrap">${!a.resolved_at ? acoesHtml(a) : ''}${!a.resolved_at && can('tecnico') ? `<button class="btn sm ghost" data-res="${a.id}" title="Some da lista sem fazer nada no PC">Marcar resolvido</button>` : ''}</div></td></tr>`).join('')}</tbody></table></div>`
      : `<div class="card"><p class="muted">${this.tipos || this.sevs ? 'Nenhum alerta aberto deste assunto.' : 'Nenhum alerta.'} Tudo certo! âœ”</p></div>`);
    $$('[data-res]', this.el).forEach((b) => { b.onclick = async () => { try { await POST(`/alerts/${b.dataset.res}/resolve`); this.refresh(); updateAlertBadge(); } catch (e) { fail(e); } }; });
    bindAcoes(this.el);
  },
};

// ================= CLIENTES =================
VIEWS.clientes = {
  async render(el) {
    this.el = el;
    setTitle('Clientes', can('admin') && !S.me.clientId ? '<button class="btn primary" id="newc">+ Novo cliente</button>' : '');
    if ($('#newc')) $('#newc').onclick = () => this.edit(null);
    await this.refresh();
  },
  async refresh() {
    await loadClients();
    const showCode = S.clients.some((c) => c.enrollCode);
    this.el.innerHTML = `<div class="table-wrap"><table><thead><tr><th>Cliente</th><th class="hide-sm">ResponsÃ¡vel / contato</th><th>Computadores</th><th class="hide-sm">Janela de manutenÃ§Ã£o</th>${showCode ? '<th>CÃ³digo de cadastro do agente</th>' : ''}<th></th></tr></thead><tbody>
      ${S.clients.map((c) => `<tr><td><b>${esc(c.name)}</b>${c.document ? `<div class="muted small">${esc(c.document)}</div>` : ''}</td>
        <td class="hide-sm small">${c.contactName ? `<b>${esc(c.contactName)}</b>` : ''}${c.phone ? `<div class="muted nw">ðŸ“ž ${esc(foneBR(c.phone))}</div>` : ''}${c.email ? `<div class="muted">âœ‰ ${esc(c.email)}</div>` : ''}${!c.contactName && !c.phone && !c.email ? '<span class="muted">â€”</span>' : ''}</td>
        <td><a href="#/computadores">${c.devices}</a> <span class="muted small">(${c.online} online)</span></td>
        <td class="hide-sm small">${esc(c.maintenanceWindow || 'Qualquer horÃ¡rio')}<div class="muted">ReinÃ­cio: ${esc({ perguntar: 'perguntar antes', agendar: 'sÃ³ agendado', automatico: 'automÃ¡tico' }[c.rebootPolicy] || c.rebootPolicy)}</div></td>
        ${showCode ? `<td>${c.enrollCode ? `<span class="code-box">${esc(c.enrollCode)} <button class="btn sm ghost" data-copy="${esc(c.enrollCode)}">Copiar</button></span>` : ''}</td>` : ''}
        <td><div class="btns">${can('tecnico') ? `<button class="btn sm" data-groups="${c.id}">Grupos</button>` : ''}<button class="btn sm" data-rep="${c.id}">RelatÃ³rio</button>
        ${can('admin') && !S.me.clientId ? `<button class="btn sm" data-edit="${c.id}">Editar</button><button class="btn sm" data-code="${c.id}">Novo cÃ³digo</button><button class="btn sm danger" data-del="${c.id}">Excluir</button>` : ''}</div></td></tr>`).join('')}
      </tbody></table></div>
      <p class="muted small">Cada cliente tem o prÃ³prio cÃ³digo de cadastro. O computador instalado com o cÃ³digo de um cliente fica automaticamente nesse cliente, e um cliente nunca enxerga os computadores de outro.</p>`;
    $$('[data-copy]', this.el).forEach((b) => { b.onclick = () => copy(b.dataset.copy); });
    $$('[data-edit]', this.el).forEach((b) => { b.onclick = () => this.edit(S.clients.find((c) => c.id === +b.dataset.edit)); });
    $$('[data-groups]', this.el).forEach((b) => { b.onclick = () => this.groups(S.clients.find((c) => c.id === +b.dataset.groups)); });
    $$('[data-rep]', this.el).forEach((b) => { b.onclick = () => { location.hash = '#/relatorios/' + b.dataset.rep; }; });
    $$('[data-code]', this.el).forEach((b) => { b.onclick = async () => { if (await confirmBox('Novo cÃ³digo de cadastro', 'Gerar um novo cÃ³digo? O cÃ³digo antigo deixa de funcionar para novas instalaÃ§Ãµes (os computadores jÃ¡ cadastrados continuam normais).', 'Gerar')) { try { await POST(`/clients/${b.dataset.code}/new-code`); this.refresh(); } catch (e) { fail(e); } } }; });
    $$('[data-del]', this.el).forEach((b) => { b.onclick = async () => { if (await confirmBox('Excluir cliente', 'Excluir este cliente?', 'Excluir', true)) { try { await api('DELETE', '/clients/' + b.dataset.del); this.refresh(); } catch (e) { fail(e); } } }; });
  },
  edit(c) {
    c = c || { rebootPolicy: 'perguntar' };
    const m = modal(c.id ? 'Editar cliente' : 'Novo cliente', `<form id="cf">
      <label>Nome / razÃ£o social *</label><input name="name" required value="${esc(c.name || '')}">
      <div class="row"><div><label>CNPJ / CPF</label><input name="document" value="${esc(c.document || '')}"></div><div><label>ResponsÃ¡vel</label><input name="contactName" value="${esc(c.contactName || '')}"></div></div>
      <div class="row"><div><label>Telefone / WhatsApp</label><input name="phone" value="${esc(c.phone || '')}"></div><div><label>E-mail</label><input name="email" value="${esc(c.email || '')}"></div></div>
      <div class="row"><div><label>HorÃ¡rio permitido para manutenÃ§Ã£o</label><input name="maintenanceWindow" placeholder="ex.: 22:00-06:00" value="${esc(c.maintenanceWindow || '')}"></div>
      <div><label>PolÃ­tica de reinÃ­cio</label><select name="rebootPolicy">${[['perguntar', 'Perguntar antes'], ['agendar', 'SÃ³ reinÃ­cio agendado'], ['automatico', 'AutomÃ¡tico com aviso']].map(([k, l]) => `<option value="${k}" ${c.rebootPolicy === k ? 'selected' : ''}>${l}</option>`).join('')}</select></div></div>
      <label>ObservaÃ§Ãµes / acordo com o cliente</label><textarea name="notes" style="min-height:80px;font-family:inherit">${esc(c.notes || '')}</textarea></form>`,
    { footer: '<button class="btn ghost" data-close>Cancelar</button><button class="btn primary" id="sv">Salvar</button>' });
    $('#sv', m).onclick = async () => {
      try { c.id ? await api('PATCH', '/clients/' + c.id, formData($('#cf', m))) : await POST('/clients', formData($('#cf', m))); m.close(); toast('Cliente salvo.', 'ok'); this.refresh(); } catch (e) { fail(e); }
    };
  },
  groups(c) {
    const m = modal(`Grupos do cliente ${c.name}`, `<p class="muted small" style="margin:0 0 10px">Grupos, setores e departamentos sÃ£o de cada cliente: estes sÃ³ aparecem para os computadores do cliente <b>${esc(c.name)}</b>.</p><div id="gl"></div>
      <form id="gf" class="row" style="margin-top:14px" autocomplete="off"><input name="name" list="gsug" autocomplete="off" placeholder="Nome (ex.: Financeiro) ou escolha da lista" required maxlength="60"><datalist id="gsug">${SETORES.map((x) => `<option value="${esc(x)}">`).join('')}</datalist><select name="kind"><option value="setor">Setor</option><option value="departamento">Departamento</option><option value="grupo">Grupo</option></select><button class="btn primary" style="flex:0">Adicionar</button></form>
      <div style="margin-top:12px"><div class="muted small" style="margin-bottom:6px">Adicionar rÃ¡pido (clique para incluir como setor):</div><div id="gchips" style="display:flex;flex-wrap:wrap;gap:6px"></div></div>`);
    const add = async (body) => { await POST('/groups', { ...body, clientId: c.id }); };
    const draw = async () => {
      await loadClients();
      const gs = S.groups.filter((g) => g.client_id === c.id);
      $('#gl', m).innerHTML = gs.length ? gs.map((g) => `<div class="list-item"><div class="t"><b>${esc(g.name)}</b> <span class="badge">${esc(g.kind)}</span> <span class="muted small">${g.devices} PC(s)</span></div><button class="btn sm danger" data-gdel="${g.id}">Excluir</button></div>`).join('') : '<p class="muted">Nenhum grupo ainda.</p>';
      $$('[data-gdel]', m).forEach((b) => { b.onclick = async () => { try { await api('DELETE', '/groups/' + b.dataset.gdel); draw(); } catch (e) { fail(e); } }; });
      const tem = new Set(gs.map((g) => g.name.toLowerCase()));
      const livres = SETORES.filter((x) => !tem.has(x.toLowerCase()));
      $('#gchips', m).innerHTML = livres.length ? livres.map((x) => `<button type="button" class="btn sm ghost" data-gadd="${esc(x)}">+ ${esc(x)}</button>`).join('') : '<span class="muted small">Todos os setores da lista jÃ¡ foram adicionados.</span>';
      $$('[data-gadd]', m).forEach((b) => { b.onclick = async () => { b.disabled = true; try { await add({ name: b.dataset.gadd, kind: 'setor' }); draw(); } catch (e) { b.disabled = false; fail(e); } }; });
    };
    $('#gf', m).onsubmit = async (e) => { e.preventDefault(); try { await add(formData(e.target)); e.target.reset(); draw(); } catch (er) { fail(er); } };
    draw();
  },
};

// ================= EQUIPAMENTOS =================
const EQ_ICO = { computador: 'ðŸ–¥', notebook: 'ðŸ’»', servidor: 'ðŸ—„', switch: 'ðŸ”€', roteador: 'ðŸ“¡', access_point: 'ðŸ“¶', firewall: 'ðŸ›¡', modem: 'ðŸŒ',
  impressora: 'ðŸ–¨', camera: 'ðŸ“·', nvr: 'ðŸ“¼', nobreak: 'ðŸ”‹', telefone: 'â˜Ž', monitor: 'ðŸ–µ', celular: 'ðŸ“±', relogio_ponto: 'â±', catraca: 'ðŸšª', outro: 'ðŸ”§' };
const eqStatus = (st) => ({ online: '<span class="dot online"></span>Ligado', offline: '<span class="dot" style="background:var(--bad);box-shadow:0 0 8px var(--bad)"></span><b style="color:var(--bad)">Sem resposta</b>',
  revogado: '<span class="dot offline"></span>Revogado' }[st] || '<span class="dot"></span><span class="muted">NÃ£o monitorado</span>');
// "Notebook Dell Inspiron 3442" / "PC montado Â· placa ASUS TUF B550M" â€” sem textos de fÃ¡brica
const EQ_LIXO = /^(to be filled.*|default string|system (product name|serial number|manufacturer|version)|o\.?e\.?m\.?|none|n\/a|not applicable|0+|123456789|x+)$/i;
const eqLimpo = (v) => { v = String(v || '').trim(); return v && !EQ_LIXO.test(v) ? v : ''; };
function eqModelo(e) {
  const marca = eqLimpo(e.marca), modelo = eqLimpo(e.modelo);
  const tem = modelo && marca && modelo.toLowerCase().startsWith(marca.toLowerCase().split(' ')[0]) ? modelo : [marca, modelo].filter(Boolean).join(' ');
  if (e.pc && e.montado) return tem ? 'PC montado Â· placa ' + tem : 'PC montado';
  if (!tem) return '';
  return (e.pc && e.tipo === 'notebook' && !/notebook|laptop/i.test(tem) ? 'Notebook ' : '') + tem;
}
function garantiaTxt(g) {
  if (!g) return '';
  const dias = Math.round((new Date(g + 'T12:00:00') - new Date()) / 86400000);
  const br = g.split('-').reverse().join('/');
  return dias < 0 ? `<span class="muted">vencida (${br})</span>` : dias <= 60 ? `<span style="color:var(--warn)">atÃ© ${br}</span>` : `atÃ© ${br}`;
}
VIEWS.equipamentos = {
  async render(el) {
    this.el = el;
    await loadClients();
    setTitle('Equipamentos', can('tecnico') ? '<button class="btn primary" id="eqnovo">+ Novo equipamento</button>' : '');
    el.innerHTML = `<div class="toolbar">
      <input class="grow" id="eq-q" placeholder="Pesquisar nome, IP, MAC, marca, modelo, nÂº de sÃ©rie, patrimÃ´nio, local...">
      ${S.me.clientId ? '' : `<select id="eq-c">${clientOptions('')}</select>`}
      <select id="eq-t"><option value="">Todos os tipos</option></select>
      <select id="eq-s"><option value="">Todos</option><option value="online">Ligados</option><option value="offline">Sem resposta / offline</option><option value="garantia">Garantia vencendo (60 dias)</option></select>
      <label class="muted small" style="display:flex;gap:6px;align-items:center;flex:0 0 auto;white-space:nowrap;margin:0"><input type="checkbox" id="eq-pcs" checked style="width:auto;min-width:0;flex:0 0 auto;margin:0"> PCs com agente</label>
      <button class="btn" id="eq-csv">â¬‡ Planilha</button><button class="btn" id="eq-pdf">ðŸ–¨ Imprimir / PDF</button></div>
      <div id="eq-res" class="muted small" style="margin:-4px 0 10px"></div>
      <div class="table-wrap" id="eq-tw"></div>`;
    ['eq-q', 'eq-c', 'eq-t', 'eq-s', 'eq-pcs'].forEach((id) => { const i = $('#' + id, el); if (i) i.addEventListener('input', () => { clearTimeout(this.qt); this.qt = setTimeout(() => this.draw(), id === 'eq-q' ? 180 : 0); }); });
    if ($('#eqnovo')) $('#eqnovo').onclick = () => this.editar(null);
    $('#eq-csv', el).onclick = () => this.csv();
    $('#eq-pdf', el).onclick = () => this.imprimir();
    await this.refresh();
    const t = $('#eq-t', el);
    t.innerHTML = '<option value="">Todos os tipos</option>' + Object.entries(this.data.tipos).map(([k, v]) => `<option value="${k}">${EQ_ICO[k] || ''} ${esc(v)}</option>`).join('');
  },
  async refresh(type) {
    if (type && !['equip', 'device', 'alert'].includes(type)) return;
    if (type && $('.modal-bg')) return; // nÃ£o redesenha com um formulÃ¡rio aberto
    this.data = await GET('/equipamentos');
    this.draw();
  },
  lista() {
    const d = this.data;
    const pcs = $('#eq-pcs', this.el).checked ? d.pcs.map((p) => ({ ...p, pc: true, tipo: /notebook|laptop/i.test(p.modelo || '') ? 'notebook' : 'computador', status: p.status, groupName: p.group_name })) : [];
    return [...d.itens.map((e) => ({ ...e, status: e.monitorar ? e.status : 'nao' })), ...pcs];
  },
  filtrar() {
    const q = ($('#eq-q', this.el).value || '').toLowerCase(), c = $('#eq-c', this.el) ? $('#eq-c', this.el).value : '', t = $('#eq-t', this.el).value, st = $('#eq-s', this.el).value;
    return this.lista().filter((e) => (!c || String(e.client_id) === c) && (!t || e.tipo === t)
      && (!st || (st === 'garantia' ? e.garantia && (new Date(e.garantia + 'T12:00:00') - new Date()) / 86400000 <= 60 : st === 'online' ? e.status === 'online' : ['offline', 'revogado'].includes(e.status)))
      && (!q || [e.nome, e.hostname, e.ip, e.mac, e.marca, e.modelo, e.serie, e.patrimonio, e.local, e.responsavel, e.client_name, e.group_name, e.obs].join(' ').toLowerCase().includes(q)));
  },
  draw() {
    if (!this.data) return;
    const tipos = this.data.tipos;
    const l = this.filtrar();
    const off = l.filter((e) => e.status === 'offline').length;
    const cont = {}; l.forEach((e) => { cont[e.tipo] = (cont[e.tipo] || 0) + 1; });
    $('#eq-res', this.el).innerHTML = `<b>${l.length}</b> equipamento(s)${off ? ` Â· <b style="color:var(--bad)">${off} sem resposta</b>` : ''} Â· ${Object.entries(cont).sort((a, b) => b[1] - a[1]).map(([k, n]) => `${EQ_ICO[k] || ''} ${esc(tipos[k] || k)}: ${n}`).join(' Â· ')}`;
    const tec = can('tecnico');
    const garantia = (e) => garantiaTxt(e.garantia) || (tec ? '<a class="small" data-gar="1">Cadastrar</a>' : '<span class="muted">nÃ£o informada</span>');
    $('#eq-tw', this.el).innerHTML = l.length ? `<table><thead><tr><th>Equipamento</th><th>Status</th><th class="hide-sm">Modelo</th><th class="hide-sm">NÂº de sÃ©rie</th><th class="hide-sm">Garantia</th><th class="hide-sm">IP</th></tr></thead><tbody>${l.slice(0, 1000).map((e) => `
      <tr class="click" ${e.pc ? `data-pc="${esc(e.id)}"` : `data-eq="${e.id}"`}>
        <td><b>${EQ_ICO[e.tipo] || ''} ${esc(e.nome || e.hostname || '')}</b><div class="muted small">${esc([S.me.clientId ? '' : e.client_name, e.group_name, e.local].filter(Boolean).join(' Â· ') || (tipos[e.tipo] || e.tipo))}${e.patrimonio ? ' Â· Pat. ' + esc(e.patrimonio) : ''}</div></td>
        <td class="nw">${eqStatus(e.status)}${e.status === 'online' && e.latencia != null && !e.pc ? ` <span class="muted small">${esc(e.latencia)} ms</span>` : ''}</td>
        <td class="hide-sm">${esc(eqModelo(e)) || '<span class="muted">nÃ£o informado</span>'}</td>
        <td class="hide-sm">${eqLimpo(e.serie) ? `<span class="mono">${esc(e.serie)}</span>${e.montado ? '<div class="muted small">da placa-mÃ£e</div>' : ''}` : '<span class="muted">nÃ£o informado</span>'}</td>
        <td class="hide-sm nw">${garantia(e)}</td>
        <td class="hide-sm mono nw">${esc(e.ip || 'â€”')}</td></tr>`).join('')}</tbody></table>${l.length > 1000 ? '<p class="muted small">Mostrando 1000. Use a pesquisa para achar os outros.</p>' : ''}`
      : `<div class="empty card" style="padding:28px;text-align:center"><p>Nenhum equipamento${this.data.itens.length || this.data.pcs.length ? ' com esse filtro' : ''}.</p>${can('tecnico') ? '<p class="muted">Cadastre switch, roteador, impressora, cÃ¢mera, nobreak... Os PCs com agente aparecem aqui sozinhos.</p>' : ''}</div>`;
    $$('[data-pc]', this.el).forEach((tr) => { tr.onclick = (ev) => { VIEWS.pc.tab = ev.target.closest('[data-gar]') ? 'config' : 'resumo'; location.hash = '#/pc/' + tr.dataset.pc; }; });
    $$('[data-eq]', this.el).forEach((tr) => { tr.onclick = () => this.editar(this.data.itens.find((x) => x.id === Number(tr.dataset.eq))); });
  },
  editar(e) {
    const ro = !can('tecnico');
    const tipos = this.data.tipos;
    const cid = e ? e.client_id : (($('#eq-c', this.el) && $('#eq-c', this.el).value) || (S.clients[0] && S.clients[0].id));
    const v = (k) => esc(e && e[k] != null ? e[k] : '');
    const m = modal(e ? `${EQ_ICO[e.tipo] || ''} ${e.nome}` : 'Novo equipamento', `<form id="eqf" autocomplete="off">
      <div class="row">${S.me.clientId ? '' : `<div><label>Cliente</label><select name="clientId" ${e ? 'disabled' : ''}>${clientOptions(cid, false)}</select></div>`}
        <div><label>Tipo</label><select name="tipo">${Object.entries(tipos).filter(([k]) => k !== 'computador' || (e && e.tipo === k)).map(([k, t]) => `<option value="${k}" ${e && e.tipo === k ? 'selected' : ''}>${EQ_ICO[k] || ''} ${esc(t)}</option>`).join('')}</select></div></div>
      <div class="row"><div><label>Nome *</label><input name="nome" required maxlength="80" value="${v('nome')}" placeholder="ex.: Switch do rack, Impressora da recepÃ§Ã£o"></div>
        <div><label>PatrimÃ´nio</label><div style="display:flex;gap:6px"><input name="patrimonio" style="flex:1;min-width:0" maxlength="80" value="${v('patrimonio')}" placeholder="vazio: ðŸ· Gerar" readonly title="O nÃºmero Ã© gerado pelo botÃ£o ðŸ· Gerar e nÃ£o pode ser editado (para nÃ£o repetir nem errar a etiqueta)">${ro ? '' : '<button type="button" class="btn" id="eq-gerar" style="flex:0 0 auto;min-width:0" title="PrÃ³ximo nÃºmero (iniciais da sua empresa + tipo do equipamento)">ðŸ· Gerar</button>'}</div></div></div>
      <div class="row"><div><label>Marca</label><input name="marca" maxlength="80" value="${v('marca')}" placeholder="ex.: TP-Link, Intelbras, HP"></div>
        <div><label>Modelo</label><input name="modelo" maxlength="80" value="${v('modelo')}"></div><div><label>NÂº de sÃ©rie</label><input name="serie" maxlength="80" value="${v('serie')}"></div></div>
      <div class="row"><div><label>IP ou nome na rede</label><input name="ip" maxlength="253" value="${v('ip')}" placeholder="192.168.0.1"></div>
        <div><label>MAC</label><input name="mac" maxlength="20" value="${v('mac')}" placeholder="AA:BB:CC:11:22:33"></div></div>
      <div class="row"><div><label>Setor</label><select name="groupId" id="eq-g"></select></div>
        <div><label>Local</label><input name="local" maxlength="80" value="${v('local')}" placeholder="ex.: Rack do 2Âº andar"></div><div><label>ResponsÃ¡vel</label><input name="responsavel" maxlength="80" value="${v('responsavel')}"></div></div>
      <div class="row"><div><label>Data da compra</label><input type="date" name="compra" value="${v('compra')}"></div><div><label>Garantia atÃ©</label><input type="date" name="garantia" value="${v('garantia')}"></div></div>
      <label>ObservaÃ§Ãµes</label><textarea name="obs" rows="3" maxlength="1000" placeholder="Senha de acesso NÃƒO: use o seu cofre de senhas. Aqui: portas, ramal, contrato...">${v('obs')}</textarea>
      <div class="card" style="margin-top:12px;padding:12px"><label style="color:var(--text);display:flex;gap:8px;align-items:center;margin:0"><input type="checkbox" name="monitorar" ${e && e.monitorar ? 'checked' : ''}> Avisar quando este equipamento parar de responder na rede</label>
        <div class="row" style="margin-top:8px"><div><label>Quem testa</label><select name="monitorPor" id="eq-mp"></select></div></div>
        <p class="muted small" style="margin:6px 0 0">A cada 1 minuto. Equipamento de outro lugar (cliente pela internet): escolha um PC com agente na mesma rede dele.</p>
        ${e && e.monitorar ? `<p class="small" style="margin:6px 0 0">SituaÃ§Ã£o: ${eqStatus(e.status)}${e.ultimo_online ? ` Â· respondeu por Ãºltimo em ${esc(dt(e.ultimo_online))}` : ''}</p>` : ''}</div>
    </form>`, { wide: true, footer: ro ? '<button class="btn ghost" data-close>Fechar</button>' : `${e ? '<button class="btn danger" id="eq-del" style="margin-right:auto">Excluir</button><button class="btn" id="eq-test">Testar agora</button>' : ''}<button class="btn ghost" data-close>Cancelar</button><button class="btn primary" id="eq-ok">Salvar</button>` });
    const f = $('#eqf', m);
    if ($('#eq-gerar', m)) $('#eq-gerar', m).onclick = async () => {
      if (f.patrimonio.value.trim() && !(await confirmBox('Trocar o nÃºmero?', `Este equipamento jÃ¡ tem o nÃºmero <b>${esc(f.patrimonio.value.trim())}</b>. Gerar um novo no lugar?`, 'Gerar novo'))) return;
      try { const r = await POST('/etiquetas/equipamento', { tipo: f.tipo.value }); f.patrimonio.value = r.patrimonio; toast(`NÂº ${r.patrimonio} â€” fica gravado quando vocÃª salvar.`, 'ok'); } catch (er) { fail(er); }
    };
    if (ro) $$('input,select,textarea', f).forEach((i) => { i.disabled = true; });
    const vinc = () => {
      const c = S.me.clientId || (f.clientId ? f.clientId.value : cid);
      $('#eq-g', m).innerHTML = groupOptions(c, e && e.group_id, false);
      const pcs = this.data.pcs.filter((p) => String(p.client_id) === String(c) && p.status !== 'revogado');
      $('#eq-mp', m).innerHTML = `<option value="">A Central (equipamento na rede desta Central)</option>${pcs.map((p) => `<option value="${esc(p.id)}" ${e && e.monitor_por === p.id ? 'selected' : ''}>PC ${esc(p.nome)}${p.status === 'online' ? '' : ' (desligado agora)'}</option>`).join('')}`;
    };
    vinc();
    if (f.clientId) f.clientId.onchange = vinc;
    if (ro) return;
    $('#eq-ok', m).onclick = async () => {
      if (!f.reportValidity()) return;
      const b = formData(f);
      try {
        if (e) await api('PATCH', '/equipamentos/' + e.id, b); else await POST('/equipamentos', b);
        m.close(); toast('Equipamento salvo.', 'ok'); this.refresh();
      } catch (er) { fail(er); }
    };
    if ($('#eq-test', m)) $('#eq-test', m).onclick = async (ev) => {
      const b = ev.target; b.disabled = true; b.textContent = 'Testando...';
      try { const r = await POST(`/equipamentos/${e.id}/testar`); toast(r.status === 'online' ? `Respondeu${r.latencia != null ? ` em ${r.latencia} ms` : ''}.` : 'NÃ£o respondeu.', r.status === 'online' ? 'ok' : 'err'); }
      catch (er) { fail(er); }
      b.disabled = false; b.textContent = 'Testar agora';
    };
    if ($('#eq-del', m)) $('#eq-del', m).onclick = async () => {
      if (!await confirmBox('Excluir', `Excluir "${esc(e.nome)}" do inventÃ¡rio?`, 'Excluir', true)) return;
      try { await api('DELETE', '/equipamentos/' + e.id); m.close(); toast('ExcluÃ­do.', 'ok'); this.refresh(); } catch (er) { fail(er); }
    };
  },
  // relatÃ³rio para imprimir ou "Salvar como PDF" (respeita a pesquisa e os filtros da tela)
  imprimir() {
    const tipos = this.data.tipos;
    const lista = this.filtrar().slice().sort((x, y) => String(x.client_name || '').localeCompare(String(y.client_name || ''), 'pt-BR')
      || String(tipos[x.tipo] || x.tipo).localeCompare(String(tipos[y.tipo] || y.tipo), 'pt-BR') || String(x.nome || x.hostname || '').localeCompare(String(y.nome || y.hostname || ''), 'pt-BR'));
    if (!lista.length) return toast('Nenhum equipamento na lista para imprimir.', 'err');
    const ST = { online: 'Ligado', offline: 'Sem resposta', revogado: 'Revogado' };
    const v = (x) => esc(x == null || x === '' ? 'â€”' : x);
    const dt = (x) => (x ? esc(String(x).slice(0, 10).split('-').reverse().join('/')) : 'â€”');
    const cSel = $('#eq-c', this.el), tSel = $('#eq-t', this.el), sSel = $('#eq-s', this.el), q = $('#eq-q', this.el).value.trim();
    const filtros = [
      cSel && cSel.value ? 'Cliente: ' + cSel.selectedOptions[0].textContent.trim() : (S.me.clientId ? '' : 'Todos os clientes'),
      tSel.value ? 'Tipo: ' + (tipos[tSel.value] || tSel.value) : '', sSel.value ? sSel.selectedOptions[0].textContent.trim() : '',
      q ? `Pesquisa: "${q}"` : '', $('#eq-pcs', this.el).checked ? '' : 'Sem os PCs com agente'].filter(Boolean).join(' Â· ');
    const porTipo = {};
    lista.forEach((e) => { const t = tipos[e.tipo] || e.tipo || 'Outro'; porTipo[t] = (porTipo[t] || 0) + 1; });
    const resumo = Object.entries(porTipo).sort((a, b) => b[1] - a[1]).map(([t, n]) => `<span>${esc(t)}: <b>${n}</b></span>`).join('');
    const linhas = lista.map((e) => `<tr>
      <td>${ST[e.status] ? `<span class="st ${esc(e.status)}">${ST[e.status]}</span>` : `<small>${e.monitorar ? 'Aguardando' : 'NÃ£o monitorado'}</small>`}</td>
      <td>${v(tipos[e.tipo] || e.tipo)}</td><td><b>${v(e.nome || e.hostname)}</b>${e.pc ? ' <small>(agente)</small>' : ''}</td>
      <td>${v(e.client_name)}</td><td>${v([e.group_name, e.local].filter(Boolean).join(' Â· '))}</td>
      <td class="mono">${v(e.ip)}</td><td class="mono">${v(e.mac)}</td><td>${v(eqModelo(e))}</td>
      <td class="mono">${v(eqLimpo(e.serie))}${e.montado && eqLimpo(e.serie) ? '<div class="muted small" style="font-family:inherit">placa-mÃ£e</div>' : ''}</td><td>${v(e.patrimonio)}</td><td>${v(e.responsavel)}</td><td>${dt(e.garantia)}</td></tr>`).join('');
    const agora = new Date().toLocaleString('pt-BR');
    const html = `<!DOCTYPE html><html lang="pt-BR"><head><meta charset="utf-8"><title>InventÃ¡rio de equipamentos - ${esc(agora.slice(0, 10))}</title><style>
      @page { size: A4 landscape; margin: 12mm 10mm; }
      * { box-sizing: border-box; } body { font: 10px/1.35 "Segoe UI", Arial, sans-serif; color: #111; margin: 0; }
      header { display: flex; align-items: center; gap: 14px; border-bottom: 2px solid #0b5cff; padding-bottom: 8px; margin-bottom: 8px; }
      header img { height: 46px; } h1 { font-size: 17px; margin: 0; } .sub { color: #555; margin-top: 2px; }
      .resumo { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 6px 0 10px; color: #333; }
      table { width: 100%; border-collapse: collapse; } thead { display: table-header-group; } tr { page-break-inside: avoid; }
      th { background: #eef3ff; text-align: left; font-size: 9px; text-transform: uppercase; letter-spacing: .3px; padding: 5px 4px; border-bottom: 1px solid #b9c8ee; }
      td { padding: 4px; border-bottom: 1px solid #e3e3e3; vertical-align: top; word-break: break-word; } tr:nth-child(even) td { background: #fafafa; }
      .mono { font-family: Consolas, monospace; font-size: 9px; } small { color: #666; }
      .st { padding: 1px 5px; border-radius: 8px; font-size: 9px; white-space: nowrap; border: 1px solid #ccc; }
      .st.online { background: #e6f7ec; border-color: #9bd8b0; color: #116b34; } .st.offline { background: #fdeaea; border-color: #f0a7a7; color: #a11; }
      footer { margin-top: 10px; color: #777; font-size: 9px; display: flex; justify-content: space-between; }
      </style></head><body>
      <header><img src="/img/logo.png" alt=""><div><h1>InventÃ¡rio de equipamentos</h1>
      <div class="sub">${esc(filtros || 'Todos os equipamentos')} Â· ${lista.length} ${lista.length === 1 ? 'item' : 'itens'}</div></div></header>
      <div class="resumo">${resumo}</div>
      <table><thead><tr><th>Status</th><th>Tipo</th><th>Nome</th><th>Cliente</th><th>Setor / local</th><th>IP</th><th>MAC</th><th>Marca / modelo</th><th>NÂº de sÃ©rie</th><th>PatrimÃ´nio</th><th>ResponsÃ¡vel</th><th>Garantia</th></tr></thead>
      <tbody>${linhas}</tbody></table>
      <footer><span>Gerado pelo FND Remoto Â· FND Sistemas</span><span>${esc(agora)} Â· ${esc(S.me.name || S.me.username || '')}</span></footer>
      </body></html>`;
    // iframe escondido: imprime sÃ³ o relatÃ³rio (funciona tambÃ©m na janela do programa, sem abrir pop-up)
    const old = $('#eq-print'); if (old) old.remove();
    const f = document.createElement('iframe');
    f.id = 'eq-print'; f.setAttribute('aria-hidden', 'true');
    f.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0;visibility:hidden';
    f.onload = () => { try { f.contentWindow.focus(); f.contentWindow.print(); } catch (er) { fail(er); } setTimeout(() => f.remove(), 60000); };
    f.srcdoc = html;
    document.body.appendChild(f);
    toast('Na janela de impressÃ£o, escolha a impressora ou "Salvar como PDF".', 'ok');
  },
  // planilha (abre no Excel: separador ";" e acentos certos)
  csv() {
    const tipos = this.data.tipos;
    const cols = [['Status', (e) => ({ online: 'Ligado', offline: 'Sem resposta', revogado: 'Revogado' }[e.status] || 'NÃ£o monitorado')], ['Tipo', (e) => tipos[e.tipo] || e.tipo],
      ['Nome', (e) => e.nome || e.hostname], ['Cliente', (e) => e.client_name], ['Setor', (e) => e.group_name], ['Local', (e) => e.local], ['IP', (e) => e.ip], ['MAC', (e) => e.mac],
      ['Marca', (e) => e.marca], ['Modelo', (e) => e.modelo], ['NÂº de sÃ©rie', (e) => e.serie], ['PatrimÃ´nio', (e) => e.patrimonio], ['ResponsÃ¡vel', (e) => e.responsavel],
      ['Compra', (e) => e.compra], ['Garantia atÃ©', (e) => e.garantia], ['ObservaÃ§Ãµes', (e) => e.obs], ['Com agente', (e) => (e.pc ? 'Sim' : '')]];
    const cel = (x) => { let t = String(x == null ? '' : x).replace(/\r?\n/g, ' '); if (/^[=+\-@]/.test(t)) t = "'" + t; return /[";]/.test(t) ? `"${t.replace(/"/g, '""')}"` : t; };
    const linhas = [cols.map((c) => c[0]).join(';'), ...this.filtrar().map((e) => cols.map((c) => cel(c[1](e))).join(';'))];
    const blob = new Blob(['\ufeff' + linhas.join('\r\n')], { type: 'text/csv;charset=utf-8' });
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = `equipamentos_${new Date().toISOString().slice(0, 10)}.csv`; document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 5000);
  },
};

// setores e departamentos mais comuns (sugestÃµes ao criar grupos)
const SETORES = ['Administrativo', 'Financeiro', 'Contabilidade', 'RH', 'Departamento Pessoal', 'TI', 'Comercial', 'Vendas', 'Marketing', 'Compras', 'Estoque', 'Almoxarifado', 'LogÃ­stica', 'ExpediÃ§Ã£o', 'ProduÃ§Ã£o', 'Qualidade', 'ManutenÃ§Ã£o', 'Engenharia', 'JurÃ­dico', 'Diretoria', 'GerÃªncia', 'RecepÃ§Ã£o', 'Portaria', 'SeguranÃ§a', 'Atendimento', 'SAC', 'Faturamento', 'Caixa', 'Secretaria', 'Operacional'];

// ================= RELATÃ“RIOS =================
// relatÃ³rio: frases curtas do que foi feito e do que precisa de atenÃ§Ã£o (tela, PDF e WhatsApp)
function resumoFeito(r) {
  const f = r.feito || {}; const o = [];
  if (f.manutencoes) o.push(`${f.manutencoes} manutenÃ§Ã£o(Ãµes) completa(s)`);
  if (f.apps) o.push(`${f.apps} aplicativo(s) atualizado(s)`);
  if (f.windows) o.push(`${f.windows} atualizaÃ§Ã£o(Ãµes) do Windows instalada(s)`);
  if (f.gbLimpos) o.push(`${String(f.gbLimpos).replace('.', ',')} GB de arquivos inÃºteis limpos`);
  if (f.verificacoes) o.push(`${f.verificacoes} verificaÃ§Ã£o(Ãµes) de vÃ­rus${f.ameacas ? ` (${f.ameacas} ameaÃ§a(s) encontrada(s) e tratada(s))` : ' (nada encontrado)'}`);
  if (f.restauracao) o.push(`${f.restauracao} ponto(s) de restauraÃ§Ã£o criado(s)`);
  if (f.backups) o.push(`${f.backups} backup(s) feito(s) manualmente, alÃ©m dos automÃ¡ticos`);
  return o;
}
function resumoAtencao(r) {
  const o = [];
  for (const x of r.saude || []) {
    if (x.disco === 'critico' || x.disco === 'aviso') o.push(`${x.nome}: ${x.discoMsg}`);
    if (x.backup && !x.backup.ok) o.push(`${x.nome}: backup ${x.backup.ultimoOk ? 'com problema' : 'ainda nÃ£o feito'}`);
    if (x.ameacasAtivas) o.push(`${x.nome}: ${x.ameacasAtivas} ameaÃ§a(s) de vÃ­rus ativa(s)`);
  }
  return o;
}
VIEWS.relatorios = {
  async render(el, clientId) {
    this.el = el;
    await loadClients();
    setTitle('RelatÃ³rios');
    const today = new Date().toISOString().slice(0, 10);
    const from = new Date(Date.now() - 30 * 86400000).toISOString().slice(0, 10);
    el.innerHTML = `<div class="toolbar no-print"><select id="rc">${clientOptions(clientId || (S.clients[0] && S.clients[0].id), false)}</select>
      <label class="muted small">De</label><input type="date" id="rf" value="${from}"><label class="muted small">AtÃ©</label><input type="date" id="rt" value="${today}">
      <button class="btn" id="rm0" title="Do dia 1 atÃ© hoje">Este mÃªs</button><button class="btn" id="rm1">MÃªs passado</button>
      <button class="btn primary" id="rg">Gerar relatÃ³rio</button><button class="btn" id="rp">ðŸ–¨ Imprimir / salvar PDF</button><button class="btn" id="rz">ðŸ’¬ WhatsApp do cliente</button></div><div id="rout"></div>`;
    $('#rg').onclick = () => this.gen();
    const mes = (k) => { const d = new Date(); const ini = new Date(d.getFullYear(), d.getMonth() - k, 1); const fim = k ? new Date(d.getFullYear(), d.getMonth(), 0) : d; const f = (x) => `${x.getFullYear()}-${String(x.getMonth() + 1).padStart(2, '0')}-${String(x.getDate()).padStart(2, '0')}`; $('#rf').value = f(ini); $('#rt').value = f(fim); this.gen(); };
    $('#rm0').onclick = () => mes(0); $('#rm1').onclick = () => mes(1);
    $('#rp').onclick = () => window.print();
    $('#rz').onclick = () => {
      const r = this.ultimo; if (!r) return toast('Gere o relatÃ³rio primeiro.', 'err');
      const ok = r.tasks.filter((t) => t.status === 'concluida').length;
      const txt = [`*FND Sistemas Â· RelatÃ³rio de manutenÃ§Ã£o*`, `Cliente: ${r.client.name}`, `PerÃ­odo: ${dt(r.from + ' 00:00').split(' ')[0]} a ${dt(r.to + ' 00:00').split(' ')[0]}`, '',
        `${r.devices.length} computador(es) gerenciado(s)`, `${r.tasks.length} serviÃ§o(s) realizado(s) (${ok} concluÃ­do(s))`, `${r.alerts.length} alerta(s) no perÃ­odo`, '',
        ...resumoFeito(r).map((x) => 'âœ… ' + x), ...(resumoFeito(r).length ? [''] : []),
        ...resumoAtencao(r).map((x) => 'âš ï¸ ' + x), ...(resumoAtencao(r).length ? [''] : []),
        'O relatÃ³rio completo segue em PDF.', '', `TÃ©cnico: ${S.me.name || S.me.username}`].join('\n');
      abrirZap(txt, r.client.id);
    };
    if (S.clients.length) this.gen();
  },
  async gen() {
    let r;
    try { r = await GET(`/reports/client/${$('#rc').value}?from=${$('#rf').value}&to=${$('#rt').value}`); } catch (e) { return fail(e); }
    this.ultimo = r;
    const lab = (a) => r.actions[a] || a;
    const ok = r.tasks.filter((t) => t.status === 'concluida').length;
    $('#rout').innerHTML = `<div class="report">
      <div class="head"><img src="/img/logo.png" alt=""><div><h1 style="margin:0">RelatÃ³rio de manutenÃ§Ã£o</h1><div><b>${esc(r.client.name)}</b>${r.client.document ? ' Â· ' + esc(r.client.document) : ''}</div>
      <div class="small">PerÃ­odo: ${dt(r.from + ' 00:00').split(' ')[0]} a ${dt(r.to + ' 00:00').split(' ')[0]} Â· Gerado em ${dt(r.generatedAt)} Â· FND Sistemas</div></div></div>
      <h2>Resumo</h2><p>${r.devices.length} computador(es) gerenciado(s) Â· ${r.tasks.length} tarefa(s) no perÃ­odo (${ok} concluÃ­da(s)) Â· ${r.alerts.length} alerta(s) registrado(s)</p>
      ${resumoFeito(r).length ? `<h2>O que foi feito</h2><ul>${resumoFeito(r).map((x) => `<li>${esc(x)}</li>`).join('')}</ul>` : ''}
      ${(r.saude || []).length ? `<h2>SituaÃ§Ã£o dos computadores hoje</h2><table><thead><tr><th>Computador</th><th>Discos</th><th>Backup</th><th>VÃ­rus</th><th>Desligou sem aviso</th></tr></thead><tbody>
        ${r.saude.map((x) => `<tr><td>${esc(x.nome)}</td><td>${x.disco === 'ok' ? 'âœ… Bons' : `${x.disco === 'critico' ? 'âŒ' : x.disco === 'aviso' ? 'âš ï¸' : 'â„¹ï¸'} ${esc(x.discoMsg)}`}</td>
          <td>${!x.backup ? '<span class="muted">nÃ£o contratado</span>' : x.backup.ok ? `âœ… em dia${x.backup.ultimoOk ? ' (' + dt(x.backup.ultimoOk) + ')' : ''}` : `âš ï¸ ${x.backup.ultimoOk ? 'Ãºltimo bom em ' + dt(x.backup.ultimoOk) : 'ainda nÃ£o fez'}`}${x.backup && x.backup.teste ? `<div class="small">${x.backup.teste.ok ? 'ðŸ§ª testado: os arquivos voltam certinho' : 'ðŸ§ª âš ï¸ o teste falhou'}</div>` : ''}</td>
          <td>${x.ameacasAtivas ? `âš ï¸ ${esc(x.ameacasAtivas)} ativa(s)` : 'âœ… Limpo'}</td><td>${x.quedas ? esc(x.quedas) + ' vez(es)' : 'â€”'}</td></tr>`).join('')}</tbody></table>` : ''}
      ${resumoAtencao(r).length ? `<h2>Precisa de atenÃ§Ã£o</h2><ul>${resumoAtencao(r).map((x) => `<li>${esc(x)}</li>`).join('')}</ul>` : ''}
      <h2>Computadores</h2><table><thead><tr><th>Computador</th><th>Setor</th><th>Sistema</th><th>Processador / RAM</th><th>Armazenamento</th><th>AtualizaÃ§Ãµes pendentes</th></tr></thead><tbody>
      ${r.devices.map((d) => `<tr><td>${devName(d)}</td><td>${esc(d.groupName || 'â€”')}</td><td>${esc(d.os || 'â€”')}</td><td>${esc(d.cpu || '')} ${d.ramGB ? 'Â· ' + esc(d.ramGB) + ' GB' : ''}</td><td>${esc(d.storage || '')}</td><td>${d.updates}</td></tr>`).join('')}</tbody></table>
      <h2 style="margin-top:20px">ManutenÃ§Ãµes realizadas</h2>${r.tasks.length ? `<table><thead><tr><th>Data</th><th>Computador</th><th>ServiÃ§o</th><th>TÃ©cnico</th><th>Resultado</th></tr></thead><tbody>
      ${r.tasks.map((t) => `<tr><td>${dt(t.created_at)}</td><td>${devName(t)}</td><td>${esc(lab(t.action))}</td><td>${esc(t.created_by)}</td><td>${statusLabel[t.status]}</td></tr>`).join('')}</tbody></table>` : '<p>Nenhuma tarefa no perÃ­odo.</p>'}
      <h2 style="margin-top:20px">Alertas</h2>${r.alerts.length ? `<table><thead><tr><th>Data</th><th>Alerta</th><th>SituaÃ§Ã£o</th></tr></thead><tbody>
      ${r.alerts.map((a) => `<tr><td>${dt(a.created_at)}</td><td>${esc(a.message)}</td><td>${a.resolved_at ? 'Resolvido em ' + dt(a.resolved_at) : 'Aberto'}</td></tr>`).join('')}</tbody></table>` : '<p>Nenhum alerta no perÃ­odo.</p>'}
    </div>`;
  },
};

// ================= ðŸ’½ SAÃšDE DOS DISCOS (todos os clientes) =================
VIEWS.discos = {
  async render(el) {
    this.el = el; setTitle('SaÃºde dos discos');
    let l; try { l = await GET('/discos'); } catch (e) { el.innerHTML = `<div class="card">${esc(e.message)}</div>`; return; }
    const cor = { critico: 'bad', aviso: 'warn', info: '', ok: 'ok' }, nome = { critico: 'Trocar jÃ¡', aviso: 'AtenÃ§Ã£o', info: 'Planejar troca', ok: 'Bom' };
    const conta = (n) => l.filter((x) => x.nivel === n).length;
    // horas ligado no total -> "36 dias", "9 meses", "3 anos e 2 meses"
    const anos = (h) => {
      if (h == null || !(Number(h) > 0)) return '<span class="muted">â€”</span>';
      const dias = Math.round(Number(h) / 24); let t;
      if (dias < 1) t = `${Math.round(h)} horas`; else if (dias < 60) t = `${dias} dia${dias > 1 ? 's' : ''}`;
      else { const mt = Math.round(dias / 30.4); const a = Math.floor(mt / 12), r = mt % 12; t = a ? `${a} ano${a > 1 ? 's' : ''}${r ? ` e ${r} ${r > 1 ? 'meses' : 'mÃªs'}` : ''}` : `${mt} meses`; }
      return `<span title="${Number(h).toLocaleString('pt-BR')} horas ligado desde novo">${t}</span>`;
    };
    const quando = (iso) => { const dd = Math.ceil((Date.parse(iso) - Date.now()) / 86400000); return dd <= 1 ? 'amanhÃ£' : `em ${dd} dias`; };
    // temperatura colorida pelo tipo do disco (HD 50/55, SSD 60/70, NVMe 70/80)
    const tempTxt = (x) => { if (x.temp == null) return ''; const [a, c] = x.lim || [60, 70]; const cor = x.temp >= c ? 'var(--bad)' : x.temp >= a ? 'var(--warn)' : 'inherit';
      return ` Â· <b style="color:${cor};font-weight:${cor === 'inherit' ? 400 : 700}" title="${x.tempAoVivo ? 'Lida Ã s ' + new Date(x.tempAoVivo).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) + ' (o PC manda a cada 3 min)' : 'Do Ãºltimo inventÃ¡rio (PC desligado ou sem leitura recente)'}">${esc(x.temp)} Â°C</b>`; };
    const vistos = {};
    el.innerHTML = `<div class="grid g4" style="margin-bottom:12px">${['critico', 'aviso', 'info', 'ok'].map((n) => `<div class="card"><div class="muted small">${nome[n]}</div><div style="font-size:26px;font-weight:700">${conta(n)}</div></div>`).join('')}</div>
      ${l.length ? `<div class="table-wrap"><table><thead><tr><th>SituaÃ§Ã£o</th><th>Computador</th><th>Disco</th><th>Vida usada</th><th class="hide-sm">Dura ainda (ligado)</th><th class="hide-sm">Uso total (horas ligado)</th><th>O que fazer</th></tr></thead><tbody>
      ${l.map((x) => `<tr><td><span class="badge ${cor[x.nivel]}">${nome[x.nivel]}</span>${(x.motivos || []).length ? `<div class="muted small" style="margin-top:4px">${x.motivos.map(esc).join('<br>')}</div>` : ''}</td><td><a href="#/pc/${esc(x.deviceId)}">${esc(x.pc)}</a><div class="muted small">${esc(x.cliente)}</div></td>
        <td>${esc(x.modelo)}<div class="muted small">${esc(x.tipo)}${x.tamanhoGB ? ' Â· ' + esc(x.tamanhoGB) + ' GB' : ''}<span data-dk="${esc(x.deviceId + '|' + x.modelo + '|' + (vistos[x.deviceId + '|' + x.modelo] = (vistos[x.deviceId + '|' + x.modelo] || 0) + 1))}">${tempTxt(x)}</span></div></td>
        <td>${x.desgaste != null ? `<div class="bar" style="min-width:70px"><i style="width:${Math.min(100, Number(x.desgaste) || 0)}%"></i></div><span class="small">${esc(x.desgaste)}%</span>` : '<span class="muted small">â€”</span>'}</td>
        <td class="hide-sm small">${x.vida ? (x.vida.meses >= 24 ? `~${Math.round(x.vida.meses / 12)} anos` : `~${esc(x.vida.meses)} meses`) + `<div class="muted">gasta ${esc(String(x.vida.porMes).replace('.', ','))}% por mÃªs</div>` : x.vidaHist ? `~${anos(Math.min(x.vidaHist.horas, 87600))}${x.vidaHist.horas > 87600 ? ' ou mais' : ''} de uso<div class="muted" title="Gastou ${esc(x.desgaste)}% da vida em ${esc(Number(x.horas).toLocaleString('pt-BR'))} horas ligado. No mesmo ritmo, aguenta isso a mais de tempo LIGADO. Depois de 1 mÃªs de leituras o FND usa o ritmo atual.">pelo histÃ³rico do disco</div>` : x.desgaste == null ? '<span class="muted" title="HD com prato nÃ£o informa desgaste; vale o uso total e os setores ruins">â€”</span>' : Number(x.desgaste) === 0 ? '<span title="Ainda nÃ£o gastou nada da vida Ãºtil. A previsÃ£o aparece quando ele comeÃ§ar a gastar.">âœ… quase novo</span>' : `<span class="muted" title="Precisa de 1 mÃªs de leituras para saber o ritmo de desgaste">previsÃ£o ${x.prontoEm ? quando(x.prontoEm) : 'em 1 mÃªs'}</span>`}</td>
        <td class="hide-sm small">${anos(x.horas)}</td><td class="small">${x.problemas.length ? x.problemas.map((t) => esc(t.startsWith(x.modelo + ': ') ? t.slice(x.modelo.length + 2) : t)).join('<br>') : '<span class="muted">nada</span>'}</td></tr>`).join('')}</tbody></table></div>`
        : '<div class="card muted">Nenhum disco informado ainda (chega com o inventÃ¡rio dos PCs).</div>'}
      <p class="muted small">"Dura ainda" Ã© tempo de uso (ligado): no comeÃ§o Ã© estimado pelo histÃ³rico do prÃ³prio disco (quanto gastou em quanto tempo ligado); depois de 1 mÃªs de leituras, pelo ritmo atual de desgaste. "Uso total" Ã© quanto tempo o disco jÃ¡ ficou ligado somando tudo desde novo (nÃ£o Ã© a idade). HD com mais de 4 anos de uso entra em "Planejar troca". Os alertas aparecem sozinhos quando um disco piora. A temperatura se atualiza sozinha nesta tela (os PCs mandam a cada 3 min; abrindo o PC, a cada 30 s).</p>`;
    // atualiza sÃ³ as temperaturas a cada 1 min (sem redesenhar a tabela: nÃ£o perde a pesquisa/filtro)
    clearInterval(this.timer);
    this.timer = setInterval(async () => {
      if (!document.body.contains(el)) return clearInterval(this.timer);
      if (document.hidden) return;
      let n; try { n = await GET('/discos'); } catch { return; }
      const v2 = {};
      for (const x of n) { const k = x.deviceId + '|' + x.modelo + '|' + (v2[x.deviceId + '|' + x.modelo] = (v2[x.deviceId + '|' + x.modelo] || 0) + 1); const sp = el.querySelector(`[data-dk="${CSS.escape(k)}"]`); if (sp) { const h = tempTxt(x); if (sp.innerHTML !== h) sp.innerHTML = h; } }
    }, 60000);
  },
};

// ================= HISTÃ“RICO DE ATIVIDADES =================
VIEWS.atividades = {
  async render(el) {
    this.el = el; setTitle('HistÃ³rico de atividades');
    el.innerHTML = `<div class="toolbar"><input class="grow" id="aq" placeholder="Pesquisar no histÃ³rico...">${can('admin') && !S.me.clientId ? '<button class="btn" id="aver">ðŸ”’ Verificar integridade</button>' : ''}</div><div id="avr"></div><div id="al"></div>`;
    if ($('#aver')) $('#aver').onclick = async () => {
      try {
        const r = await GET('/audit/verify');
        $('#avr').innerHTML = r.ok ? `<div class="card" style="margin-bottom:12px"><span class="badge ok">Ãntegro</span> ${esc(r.checked)} registros conferidos: nenhum foi alterado ou apagado.${r.unsealed ? ` <span class="muted small">(${esc(r.unsealed)} registros antigos, de antes da v0.5, nÃ£o tÃªm selo.)</span>` : ''}</div>`
          : `<div class="card" style="margin-bottom:12px"><span class="badge bad">HistÃ³rico adulterado</span><ul>${r.problems.map((p) => `<li>${esc(p)}</li>`).join('')}</ul></div>`;
      } catch (e) { fail(e); }
    };
    let t; $('#aq').oninput = () => { clearTimeout(t); t = setTimeout(() => this.refresh(), 300); };
    await this.refresh();
  },
  async refresh() {
    this.limit = this.limit || 200;
    const rows = await GET(`/audit?limit=${this.limit}&q=` + encodeURIComponent($('#aq').value));
    $('#al').innerHTML = rows.length ? `<div class="table-wrap"><table><thead><tr><th>Quando</th><th>Quem</th><th>AÃ§Ã£o</th><th>Alvo</th><th class="hide-sm">Detalhes</th><th class="hide-sm">IP</th></tr></thead><tbody>
      ${rows.map((a) => `<tr><td class="small">${dt(a.ts)}</td><td>${esc(a.username)}</td><td>${esc(a.action)}</td><td>${esc(a.target)}</td><td class="hide-sm small"><span class="mono">${esc(String(a.details || '').slice(0, 160))}</span></td><td class="hide-sm small">${esc(a.ip)}</td></tr>`).join('')}</tbody></table></div>
      ${rows.length >= this.limit && this.limit < 2000 ? '<div class="btns" style="justify-content:center;margin:12px 0"><button class="btn" id="amore">Carregar registros mais antigos</button></div>' : ''}`
      : '<div class="card muted">Nada encontrado.</div>';
    if ($('#amore')) $('#amore').onclick = () => { this.limit = Math.min(this.limit + 300, 2000); this.refresh(); };
  },
};

// ================= MEUS INSTALADORES =================
const PRESETS = [
  ['', 'Escolha um tipo comum...'],
  ['/VERYSILENT /SUPPRESSMSGBOXES /NORESTART', 'Inno Setup (ex.: sistemas FND, muitos instaladores)'],
  ['/S', 'NSIS (Nullsoft)'],
  ['/quiet /norestart', 'Instaladores Microsoft / WiX (.exe)'],
  ['/s /v"/qn"', 'InstallShield'],
  ['--silent', 'Electron / Squirrel'],
];
VIEWS.instaladores = {
  async render(el) {
    this.el = el;
    setTitle('Meus instaladores');
    el.innerHTML = `${can('admin') ? `<div class="card" style="margin-bottom:16px"><h2>Adicionar instalador</h2>
      <p class="muted">Escolha um <b>.exe</b> ou <b>.msi</b> do seu computador (ou um <b>.zip de driver</b>, com os arquivos .inf, baixado do site oficial do fabricante). Ele fica guardado na Central e pode ser instalado em qualquer PC com o agente, em segundo plano.</p>
      <form id="upf"><div class="row"><div><label>Arquivo do instalador</label><input type="file" name="file" accept=".exe,.msi,.zip" required></div>
        <div><label>Nome (como aparece no painel)</label><input name="name" placeholder="ex.: FND Organiza 2.5"></div></div>
        <div class="row"><div><label>ParÃ¢metros de instalaÃ§Ã£o silenciosa</label><input name="args" placeholder="ex.: /VERYSILENT /SUPPRESSMSGBOXES /NORESTART"></div>
        <div><label>Tipo de instalador (preenche os parÃ¢metros)</label><select id="preset">${PRESETS.map(([v, l]) => `<option value="${esc(v)}">${esc(l)}</option>`).join('')}</select></div></div>
        <p class="muted small">Para <b>.msi</b> os parÃ¢metros <span class="mono">/qn /norestart</span> jÃ¡ sÃ£o usados automaticamente. Sem os parÃ¢metros certos, o instalador fica esperando um clique que ninguÃ©m vÃª e a tarefa termina por tempo.</p>
        <div id="upprog" class="hidden" style="margin:10px 0"><div class="bar"><i id="upbar" style="width:0%"></i></div><span class="muted small" id="uptxt"></span></div>
        <div class="btns" style="margin-top:10px"><button class="btn primary" id="upbtn">â¬† Enviar para a Central</button></div></form></div>` : ''}
      <div id="pl"></div>`;
    if ($('#upf')) {
      const f = $('#upf');
      $('#preset').onchange = (e) => { if (e.target.value) f.args.value = e.target.value; };
      f.file.onchange = () => { const fl = f.file.files[0]; if (fl && !f.name.value) f.name.value = fl.name.replace(/\.(exe|msi|zip)$/i, ''); };
      f.onsubmit = (e) => { e.preventDefault(); this.upload(f); };
    }
    await this.refresh();
  },
  upload(f) {
    const file = f.file.files[0];
    if (!file) return toast('Escolha o arquivo.', 'err');
    if (!/\.(exe|msi|zip)$/i.test(file.name)) return toast('Envie um arquivo .exe, .msi ou .zip de driver.', 'err');
    const xhr = new XMLHttpRequest();
    xhr.open('POST', '/api/packages');
    xhr.setRequestHeader('x-fnd', '1');
    xhr.setRequestHeader('content-type', 'application/octet-stream');
    xhr.setRequestHeader('x-arquivo', encodeURIComponent(file.name));
    xhr.setRequestHeader('x-nome', encodeURIComponent(f.name.value || ''));
    xhr.setRequestHeader('x-args', encodeURIComponent(f.args.value || ''));
    $('#upprog').classList.remove('hidden'); $('#upbtn').disabled = true;
    xhr.upload.onprogress = (e) => { if (e.lengthComputable) { const p = Math.round(e.loaded / e.total * 100); $('#upbar').style.width = p + '%'; $('#uptxt').textContent = `Enviando... ${p}% (${fmtSize(e.loaded)} de ${fmtSize(e.total)})`; } };
    xhr.onload = () => {
      $('#upbtn').disabled = false; $('#upprog').classList.add('hidden');
      let data = {}; try { data = JSON.parse(xhr.responseText); } catch { /* */ }
      if (xhr.status >= 200 && xhr.status < 300) { toast('Instalador adicionado Ã  biblioteca!', 'ok'); f.reset(); this.refresh(); }
      else toast(data.error || `Erro ${xhr.status}`, 'err');
    };
    xhr.onerror = () => { $('#upbtn').disabled = false; toast('Falha no envio.', 'err'); };
    xhr.send(file);
  },
  async refresh() {
    const rows = await GET('/packages');
    $('#pl', this.el).innerHTML = rows.length ? `<div class="table-wrap"><table><thead><tr><th>Programa</th><th>Arquivo</th><th>Tamanho</th><th class="hide-sm">ParÃ¢metros silenciosos</th><th class="hide-sm">Enviado</th><th></th></tr></thead><tbody>
      ${rows.map((p) => `<tr><td><b>${esc(p.name)}</b></td><td class="small">${esc(p.filename)}<div class="muted mono small" title="SHA-256 ${esc(p.sha256)}">${esc(p.sha256.slice(0, 16))}â€¦</div></td><td class="nw">${fmtSize(p.size)}</td>
        <td class="hide-sm mono small">${/\.zip$/i.test(p.filename) ? '<span class="badge">Driver (.inf)</span>' : esc(p.args || (/\.msi$/i.test(p.filename) ? '/qn /norestart' : 'â€”'))}</td><td class="hide-sm small">${esc(p.createdBy)}<div class="muted">${when(p.createdAt)}</div></td>
        <td><div class="btns"><button class="btn sm primary" data-inst="${p.id}">Instalar em...</button>${can('admin') ? `<button class="btn sm" data-edit="${p.id}">Editar</button><button class="btn sm danger" data-del="${p.id}">Excluir</button>` : ''}</div></td></tr>`).join('')}</tbody></table></div>`
      : '<div class="card muted">Nenhum instalador na biblioteca ainda.</div>';
    $$('[data-inst]', this.el).forEach((b) => { b.onclick = () => this.pickDevices(rows.find((p) => p.id === +b.dataset.inst)); });
    $$('[data-edit]', this.el).forEach((b) => { b.onclick = () => this.edit(rows.find((p) => p.id === +b.dataset.edit)); });
    $$('[data-del]', this.el).forEach((b) => { b.onclick = async () => { if (await confirmBox('Excluir instalador', 'Excluir este instalador da biblioteca?', 'Excluir', true)) { try { await api('DELETE', '/packages/' + b.dataset.del); this.refresh(); } catch (e) { fail(e); } } }; });
  },
  edit(p) {
    const m = modal('Editar instalador', `<form id="ef"><label>Nome</label><input name="name" value="${esc(p.name)}"><label>ParÃ¢metros de instalaÃ§Ã£o silenciosa</label><input name="args" value="${esc(p.args || '')}"><label>ObservaÃ§Ãµes</label><input name="notes" value="${esc(p.notes || '')}"></form>`,
      { footer: '<button class="btn ghost" data-close>Cancelar</button><button class="btn primary" id="sv">Salvar</button>' });
    $('#sv', m).onclick = async () => { try { await api('PATCH', '/packages/' + p.id, formData($('#ef', m))); m.close(); this.refresh(); } catch (e) { fail(e); } };
  },
  async pickDevices(p) {
    const devs = (await GET('/devices')).filter((d) => !d.revoked);
    const m = modal(`Instalar ${p.name}`, `<p class="muted">Escolha os computadores. Os que estiverem desligados instalam quando voltarem a ficar online.</p>
      <div class="toolbar"><input class="grow" id="pq" placeholder="Filtrar..."><label class="muted small"><input type="checkbox" id="pall"> Todos</label></div>
      <div class="table-wrap" style="max-height:45vh"><table><tbody>${devs.map((d) => `<tr data-row="${esc([d.alias, d.hostname, d.clientName, d.groupName].join(' ').toLowerCase())}"><td><input type="checkbox" value="${esc(d.id)}"></td><td><span class="dot ${d.status}"></span><b>${devName(d)}</b></td><td class="small muted">${esc(d.clientName || '')}${d.groupName ? ' Â· ' + esc(d.groupName) : ''}</td></tr>`).join('')}</tbody></table></div>`,
    { wide: true, footer: '<button class="btn ghost" data-close>Cancelar</button><button class="btn primary" id="go">Continuar</button>' });
    $('#pq', m).oninput = (e) => { const q = e.target.value.toLowerCase(); $$('tr[data-row]', m).forEach((tr) => tr.classList.toggle('hidden', !tr.dataset.row.includes(q))); };
    $('#pall', m).onchange = (e) => $$('tr[data-row]:not(.hidden) input', m).forEach((c) => { c.checked = e.target.checked; });
    $('#go', m).onclick = () => {
      const ids = $$('tr[data-row] input:checked', m).map((c) => c.value);
      if (!ids.length) return toast('Selecione ao menos um computador.', 'err');
      m.close(); taskDialog(ids, 'instalar_pacote', { pacote: p.id });
    };
  },
};

// ================= LICENÃ‡A =================
function licFaixa() {
  const L = S.me && S.me.licenca;
  if (!L) return '';
  const adm = S.me.role === 'admin' && !S.me.clientId;
  if (!L.liberado) return `<div class="card" id="licaviso" style="margin-bottom:14px;border-color:var(--bad);padding:10px 14px">ðŸ”’ <b>SÃ³ para consulta.</b> ${esc(L.mensagem || 'A licenÃ§a estÃ¡ inativa.')} ${adm ? '<a href="#/licenca" data-licplanos>Ativar / renovar</a>' : 'Fale com o administrador.'}</div>`;
  if (L.aviso) return `<div class="card" id="licaviso" style="margin-bottom:14px;border-color:var(--warn);padding:10px 14px">ðŸ”‘ ${esc(L.aviso)} ${adm ? '<a href="#/licenca" data-licplanos>Ver planos e ativar</a>' : ''}</div>`;
  return '';
}

function whatsLink(L, plano) {
  const v = L.venda || {};
  if (!v.whatsapp) return '';
  const txt = `${v.mensagem || 'OlÃ¡! Quero comprar o FND Remoto.'}\nPlano: ${plano ? ({ mensal: 'Mensal', anual: 'Anual', vitalicio: 'VitalÃ­cio' }[plano]) : 'a escolher'}\nCÃ³digo da mÃ¡quina: ${L.codigo}`;
  return `https://wa.me/${encodeURIComponent(v.whatsapp)}?text=${encodeURIComponent(txt)}`;
}
// planos com preÃ§o publicado; sem nenhum publicado, mostra os trÃªs como "consulte"
function planosVisiveis(v) {
  const ps = ['mensal', 'anual', 'vitalicio'].filter((p) => v.planos && v.planos[p]);
  return ps.length ? ps : ['mensal', 'anual', 'vitalicio'];
}
function licencaHtml(L) {
  if (L.somenteAdmin) return `<p>${esc(L.mensagem || 'LicenÃ§a ativa.')}</p>`;
  const v = L.venda || {};
  const nomes = { mensal: 'Mensal', anual: 'Anual', vitalicio: 'VitalÃ­cio' };
  const sit = {
    teste: `<span class="badge warn">Teste grÃ¡tis</span> falta(m) <b>${esc(L.diasRestantes)}</b> dia(s) (atÃ© ${esc(L.testeFimBR)})`,
    ativa: `<span class="badge ok">Ativa</span> plano <b>${esc(L.nomePlano)}</b>${L.venceBR ? ` atÃ© <b>${esc(L.venceBR)}</b>` : ' â€” sem vencimento'}`,
    tolerancia: `<span class="badge warn">Vencida</span> plano ${esc(L.nomePlano)} venceu em ${esc(L.venceBR)} (ainda dentro da tolerÃ¢ncia)`,
    vencida: `<span class="badge bad">Vencida</span> plano ${esc(L.nomePlano)} venceu em ${esc(L.venceBR)}`,
    teste_acabou: '<span class="badge bad">Teste encerrado</span>',
    relogio: '<span class="badge bad">RelÃ³gio atrasado</span>',
  }[L.status] || esc(L.status);
  return `<p>${sit}</p>${L.mensagem ? `<p>${esc(L.mensagem)}</p>` : ''}${L.aviso && L.status !== 'teste' ? `<p class="muted">${esc(L.aviso)}</p>` : ''}
    ${L.atualizacoesAteBR ? `<p class="muted small">AtualizaÃ§Ãµes incluÃ­das atÃ© ${esc(L.atualizacoesAteBR)}.</p>` : ''}
    <h3 style="margin-top:16px">CÃ³digo desta mÃ¡quina</h3>
    <div class="code-box" style="font-size:1.3em;letter-spacing:2px">${esc(L.codigo)} <button class="btn sm ghost" type="button" data-copy="${esc(L.codigo)}">Copiar</button></div>
    <p class="muted small">Envie este cÃ³digo para a FND Sistemas para receber a sua chave de ativaÃ§Ã£o.</p>
    <h3 style="margin-top:16px" id="licplanos">Planos</h3>
    <div class="grid g3">${planosVisiveis(v).map((p) => { const x = (v.planos && v.planos[p]) || {}; return `<button type="button" class="card plano" data-plano="${p}" style="padding:14px;text-align:left;cursor:pointer;color:inherit;font:inherit">
      <b>${esc(x.titulo || nomes[p])}</b><div style="font-size:1.35em;font-weight:700;margin:6px 0">${esc(x.preco || 'consulte')}</div>
      ${x.detalhe ? `<div class="muted small">${esc(x.detalhe)}</div>` : ''}<div class="btn sm primary" style="margin-top:10px;display:inline-block">${v.whatsapp ? 'Quero este plano' : 'Como comprar'}</div></button>`; }).join('')}</div>
    ${v.observacao ? `<p class="muted small">${esc(v.observacao)}</p>` : ''}
    <h3 style="margin-top:16px">Ativar</h3>
    <form id="licf"><label>Chave de ativaÃ§Ã£o</label><textarea name="chave" rows="3" spellcheck="false" placeholder="FND3..." style="font-family:monospace;min-height:80px"></textarea>
      <div class="btns" style="margin-top:8px"><button class="btn primary">Ativar</button></div></form>`;
}
function bindLicenca(box, depois, L) {
  $$('[data-copy]', box).forEach((b) => { b.onclick = () => copy(b.dataset.copy); });
  $$('[data-plano]', box).forEach((b) => { b.onclick = () => {
    const link = L && whatsLink(L, b.dataset.plano);
    if (link) { window.open(link, '_blank', 'noopener'); return; }
    const m = modal('Como comprar', `<p>Envie o <b>cÃ³digo desta mÃ¡quina</b> para a FND Sistemas e diga o plano escolhido. VocÃª recebe a chave de ativaÃ§Ã£o para colar aqui.</p>
      <div class="code-box" style="font-size:1.2em;letter-spacing:2px">${esc(L ? L.codigo : '')} <button class="btn sm ghost" type="button" data-copy="${esc(L ? L.codigo : '')}">Copiar</button></div>`);
    $$('[data-copy]', m).forEach((x) => { x.onclick = () => copy(x.dataset.copy); });
  }; });
  const f = $('#licf', box);
  if (f) f.onsubmit = async (e) => {
    e.preventDefault();
    const b = $('button.primary', f); b.disabled = true;
    try { const r = await POST('/licenca/ativar', { chave: f.chave.value }); toast(`LicenÃ§a ativada: plano ${r.nomePlano}${r.venceBR ? ' atÃ© ' + r.venceBR : ''}.`, 'ok'); depois(); }
    catch (er) { fail(er); b.disabled = false; }
  };
}
VIEWS.licenca = {
  async render(el) {
    setTitle('LicenÃ§a');
    const L = await GET('/licenca');
    el.innerHTML = `<div class="card" style="max-width:820px">${licencaHtml(L)}</div>`;
    bindLicenca(el, () => location.reload(), L);
    if (S.irPlanos) { S.irPlanos = false; const h = $('#licplanos', el); if (h) h.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
  },
};

// ================= BIBLIOTECA DE SCRIPTS =================
// escolher computadores (usado pelos scripts)
async function pickDevicesModal(title, onPick) {
  const devs = (await GET('/devices')).filter((d) => !d.revoked);
  const m = modal(title, `<p class="muted">Escolha os computadores. Os que estiverem desligados executam quando voltarem a ficar online.</p>
    <div class="toolbar"><input class="grow" id="pq" placeholder="Filtrar..."><label class="muted small"><input type="checkbox" id="pall"> Todos</label></div>
    <div class="table-wrap" style="max-height:45vh"><table><tbody>${devs.map((d) => `<tr data-row="${esc([d.alias, d.hostname, d.clientName, d.groupName].join(' ').toLowerCase())}"><td><input type="checkbox" value="${esc(d.id)}"></td><td><span class="dot ${d.status}"></span><b>${devName(d)}</b></td><td class="small muted">${esc(d.clientName || '')}${d.groupName ? ' Â· ' + esc(d.groupName) : ''}</td></tr>`).join('')}</tbody></table></div>`,
  { wide: true, footer: '<button class="btn ghost" data-close>Cancelar</button><button class="btn primary" id="go">Continuar</button>' });
  $('#pq', m).oninput = (e) => { const q = e.target.value.toLowerCase(); $$('tr[data-row]', m).forEach((tr) => tr.classList.toggle('hidden', !tr.dataset.row.includes(q))); };
  $('#pall', m).onchange = (e) => $$('tr[data-row]:not(.hidden) input', m).forEach((c) => { c.checked = e.target.checked; });
  $('#go', m).onclick = () => {
    const ids = $$('tr[data-row] input:checked', m).map((c) => c.value);
    if (!ids.length) return toast('Selecione ao menos um computador.', 'err');
    m.close(); onPick(ids);
  };
}

VIEWS.scripts = {
  async render(el) {
    this.el = el;
    setTitle('Biblioteca de scripts', '<button class="btn primary" id="nsc">+ Novo script</button>');
    el.innerHTML = `<p class="muted">Seus comandos PowerShell mais usados, prontos para rodar em um ou vÃ¡rios computadores com um clique. Rodam como <b>SYSTEM</b>, em segundo plano, sem janela para o usuÃ¡rio, e tudo fica no histÃ³rico. Os modelos podem ser editados ou apagados.</p>
      <div class="toolbar"><input class="grow" id="sq" placeholder="Pesquisar script..."></div><div id="sl"></div>`;
    $('#nsc').onclick = () => this.edit(null);
    $('#sq').oninput = () => this.draw();
    await this.refresh();
  },
  async refresh() { this.rows = await GET('/scripts'); this.draw(); },
  draw() {
    const q = ($('#sq').value || '').toLowerCase();
    const rows = this.rows.filter((r) => !q || `${r.name} ${r.description}`.toLowerCase().includes(q));
    $('#sl').innerHTML = rows.length ? `<div class="grid g2">${rows.map((r) => `<div class="card"><div style="display:flex;justify-content:space-between;gap:8px"><h3 style="margin:0">${esc(r.name)}</h3>${/modelo/.test(r.createdBy) ? '<span class="badge">modelo</span>' : ''}</div>
        <p class="muted small" style="min-height:2.4em">${esc(r.description || '')}</p>
        <div class="btns"><button class="btn sm primary" data-run="${r.id}">â–¶ Executar em...</button><button class="btn sm" data-ed="${r.id}">Ver / editar</button><button class="btn sm danger" data-del="${r.id}">Apagar</button></div></div>`).join('')}</div>`
      : '<div class="card muted">Nenhum script.</div>';
    const find = (id) => this.rows.find((r) => r.id === Number(id));
    $$('[data-run]', this.el).forEach((b) => { b.onclick = () => { const r = find(b.dataset.run); pickDevicesModal(`Executar: ${r.name}`, (ids) => taskDialog(ids, 'powershell', { script: r.script })); }; });
    $$('[data-ed]', this.el).forEach((b) => { b.onclick = () => this.edit(find(b.dataset.ed)); });
    $$('[data-del]', this.el).forEach((b) => { b.onclick = async () => { const r = find(b.dataset.del); if (await confirmBox('Apagar script', `Apagar <b>${esc(r.name)}</b> da biblioteca?`, 'Apagar', true)) { try { await api('DELETE', '/scripts/' + r.id); this.refresh(); } catch (e) { fail(e); } } }; });
  },
  edit(r) {
    const m = modal(r ? 'Editar script' : 'Novo script', `<form id="scf"><label>Nome</label><input name="name" required maxlength="100" value="${esc(r ? r.name : '')}">
      <label>Para que serve</label><input name="description" maxlength="500" value="${esc(r ? r.description : '')}">
      <label>Script PowerShell (roda como SYSTEM, sem janela)</label><textarea name="script" required spellcheck="false" style="min-height:300px">${esc(r ? r.script : '')}</textarea></form>`,
    { wide: true, footer: '<button class="btn ghost" data-close>Cancelar</button><button class="btn primary" id="scs">Salvar</button>' });
    $('#scs', m).onclick = async () => {
      const d = formData($('#scf', m));
      try { if (r) await api('PATCH', '/scripts/' + r.id, d); else await POST('/scripts', d); m.close(); toast('Script salvo.', 'ok'); this.refresh(); } catch (e) { fail(e); }
    };
  },
};

// ================= INSTALAR AGENTE =================
VIEWS.instalar = {
  async render(el) {
    setTitle('Instalar o agente nos computadores');
    await loadClients();
    let info = { ips: [], port: location.port || 443 };
    try { info = await GET('/info'); } catch { /* */ }
    const local = /^(localhost|127\.|\[?::1)/.test(location.hostname);
    const hostOnly = local && info.ips.length ? info.ips[0].ip : location.hostname;
    const host = local && info.ips.length ? `${info.ips[0].ip}:${info.port}` : location.host;
    const staff = can('tecnico') && !S.me.clientId;
    const optCli = S.clients.map((c) => `<option value="${c.id}">${esc(c.name)}</option>`).join('');
    const optGrp = (cid) => '<option value="">(sem setor)</option>' + S.groups.filter((g) => String(g.client_id) === String(cid)).map((g) => `<option value="${g.id}">${esc(g.name)}</option>`).join('');
    const topo = staff ? `<div class="grid g2" style="margin-bottom:16px"><div class="card"><h2>â¬‡ Instalador pronto (recomendado)</h2>
      <p>Baixe o instalador <b>jÃ¡ configurado</b> para o cliente: no computador Ã© sÃ³ <b>AvanÃ§ar, AvanÃ§ar, Concluir</b>, sem digitar cÃ³digo nem endereÃ§o.</p>
      <div class="toolbar" style="margin:10px 0"><select id="ip-c">${optCli}</select><select id="ip-g"></select><button class="btn primary" id="ip-b">â¬‡ Baixar instalador</button></div>
      <p class="muted small">Ele jÃ¡ leva o cÃ³digo do cliente, o setor, o nome e os IPs desta Central (e o FND Relay, se estiver ligado) e sÃ³ aceita esta Central (certificado conferido). Pode copiar para um pendrive e usar em vÃ¡rios PCs do mesmo cliente.</p></div>
      <div class="card"><h2>ðŸ” Procurar agentes na rede</h2>
      <p>Instalou o agente <b>sem cÃ³digo</b>? Ele fica aguardando aprovaÃ§Ã£o. Clique em Procurar e aprove aqui.</p>
      <label class="small">Outras faixas de IP (opcional, separadas por vÃ­rgula)</label>
      <div class="toolbar" style="margin:4px 0 8px"><input class="grow" id="pr-f" placeholder="ex.: 172.16.1.x, 192.168.10.0/24, 10.0.0.10-80" autocomplete="off"><button class="btn primary" id="pr-b">ðŸ” Procurar agora</button></div>
      <p class="muted small" id="pr-info">Procura sempre na rede desta Central. Computadores da mesma rede tambÃ©m aparecem sozinhos em atÃ© 1 minuto.</p></div></div>
      <div class="card" id="pr-card" style="margin-bottom:16px"><h2>Aguardando aprovaÃ§Ã£o</h2><div id="pr-lista"><p class="muted">Carregando...</p></div></div>` : '';
    el.innerHTML = topo + `<div class="grid g2"><div class="card"><h2>1. Baixe o instalador</h2>
      <p>Em cada computador da rede, abra no navegador:</p><div class="code-box">https://${esc(host)}/download <button class="btn sm ghost" data-copy="https://${esc(host)}/download">Copiar</button></div>
      <p class="muted small">O navegador vai avisar sobre o certificado: Ã© o certificado prÃ³prio da Central (rede local). Pode prosseguir.</p>
      ${info.ips.length > 1 ? `<p class="muted small">Outros endereÃ§os desta Central: ${info.ips.slice(1).map((x) => `<span class="mono">${esc(x.ip)}</span>`).join(', ')}</p>` : ''}
      <h2 style="margin-top:20px">2. Instale com o cÃ³digo do cliente</h2><p>Durante a instalaÃ§Ã£o, informe o <b>cÃ³digo de cadastro</b> do cliente:</p>
      ${S.clients.map((c) => `<div class="list-item"><div class="t"><b>${esc(c.name)}</b></div>${c.enrollCode ? `<span class="code-box">${esc(c.enrollCode)} <button class="btn sm ghost" data-copy="${esc(c.enrollCode)}">Copiar</button></span>` : ''}</div>`).join('')}
      <p class="muted small">O agente encontra esta Central sozinho na rede. Se ele nÃ£o achar (rede de empresa com vÃ¡rias sub-redes, Wi-Fi separado...), informe em "EndereÃ§o da Central" o <b>nome deste computador</b>: <span class="mono"><b>${esc(info.hostname || '')}</b></span> <button class="btn sm ghost" type="button" data-copy="${esc(info.hostname || '')}">Copiar</button> â€” ou o IP <b>${esc(hostOnly)}</b>. Pelo nome Ã© melhor: continua funcionando mesmo se o IP desta Central mudar.</p></div>
      <div class="card"><h2>InstalaÃ§Ã£o silenciosa (vÃ¡rios PCs)</h2><p class="muted">Para instalar sem perguntas (por script, GPO ou PowerShell remoto):</p>
      <pre>AgenteFND_Remoto_Setup.exe /S /CODIGO=${esc((S.clients[0] || {}).enrollCode || 'FND-XXXX-XXXX-XXXX-XXXX')}</pre>
      <p class="muted small">Opcional: <span class="mono">/CENTRAL=${esc(hostOnly)}</span> para fixar o endereÃ§o Â· <span class="mono">/SEMPOWERSHELL=1</span> para bloquear comandos PowerShell livres naquele computador.</p>
      <h2 style="margin-top:20px">O que o usuÃ¡rio vÃª</h2><p class="muted">O agente roda como serviÃ§o do Windows, sem janela. Ele aparece em "Aplicativos instalados" e em "ServiÃ§os" com o nome <b>Agente FND Remoto</b>, e pode ser removido pelo administrador do computador.</p></div></div>`;
    $$('[data-copy]', el).forEach((b) => { b.onclick = () => copy(b.dataset.copy); });
    if (!staff) return;
    const ic = $('#ip-c', el), ig = $('#ip-g', el);
    ig.innerHTML = optGrp(ic.value); ic.onchange = () => { ig.innerHTML = optGrp(ic.value); };
    $('#ip-b', el).onclick = () => {
      if (!ic.value) return toast('Cadastre um cliente primeiro.', 'err');
      const a = document.createElement('a'); a.href = `/api/agente/instalador?clientId=${encodeURIComponent(ic.value)}&groupId=${encodeURIComponent(ig.value)}`;
      document.body.appendChild(a); a.click(); a.remove();
      toast('Baixando o instalador jÃ¡ configurado...', 'ok');
    };
    this.el = el; this.optCli = optCli; this.optGrp = optGrp; this.escolhas = {}; this.assin = null; this.carregouFaixas = false;
    $('#pr-b', el).onclick = () => this.procurar();
    await this.lista();
    clearInterval(this.timer);
    this.timer = setInterval(() => { if (!document.body.contains(el)) return clearInterval(this.timer); this.lista(); }, 5000);
  },
  async procurar() {
    const b = $('#pr-b', this.el); b.disabled = true; b.textContent = 'Procurando...';
    const faixas = $('#pr-f', this.el).value.split(',').map((x) => x.trim()).filter(Boolean);
    try {
      const r = await POST('/procura', { faixas });
      $('#pr-info', this.el).textContent = `Procurado em ${r.enderecos} endereÃ§o(s) (${r.faixas.join(', ')}): ${r.achados} computador(es) aguardando.`;
      this.desenhar(r.itens);
    } catch (e) { fail(e); }
    b.disabled = false; b.textContent = 'ðŸ” Procurar agora';
  },
  async lista() {
    try {
      const r = await GET('/procura');
      const f = $('#pr-f', this.el);
      if (f && !f.value && !this.carregouFaixas) { f.value = (r.faixasExtras || []).join(', '); this.carregouFaixas = true; }
      this.desenhar(r.itens);
    } catch { /* */ }
  },
  desenhar(itens) {
    const box = $('#pr-lista', this.el); if (!box) return;
    // nÃ£o redesenha com o tÃ©cnico escolhendo o cliente/setor, nem se nada mudou
    const assin = JSON.stringify(itens.map((p) => [p.id, p.status, p.ip, p.user, p.convidado]));
    if (assin === this.assin && box.contains(document.activeElement)) return;
    if (assin === this.assin && box.firstChild) return;
    this.assin = assin;
    // guarda o cliente/setor que o tÃ©cnico jÃ¡ escolheu (a lista Ã© redesenhada a cada 5 s)
    $$('[data-prc]', box).forEach((x) => { this.escolhas[x.dataset.prc] = { c: x.value, g: ($(`[data-prg="${x.dataset.prc}"]`, box) || {}).value }; });
    if (!itens.length) { box.innerHTML = '<p class="muted">Nenhum computador aguardando. Instale o agente sem cÃ³digo e clique em Procurar.</p>'; return; }
    box.innerHTML = `<div class="table-wrap"><table><thead><tr><th>Computador</th><th>IP</th><th>UsuÃ¡rio</th><th>Windows</th><th>Visto</th><th>Cliente / setor</th><th></th></tr></thead><tbody>
      ${itens.map((p) => { const e = this.escolhas[p.id] || {}; return `<tr><td><b>${esc(p.host)}</b><div class="muted small">${esc(p.mac || '')} Â· agente ${esc(p.ver)}</div></td>
      <td class="mono">${esc(p.ip)}</td><td>${esc(p.user || 'â€”')}</td><td class="small">${esc(p.os)}</td><td class="small">${esc(new Date(p.visto).toLocaleTimeString('pt-BR'))}</td>
      <td>${p.status === 'cadastrado' ? '<span class="badge ok">Cadastrado âœ“</span>' : `<div class="btns"><select data-prc="${esc(p.id)}">${this.optCli}</select><select data-prg="${esc(p.id)}"></select></div>`}</td>
      <td>${p.status === 'cadastrado' ? '' : `<div class="btns"><button class="btn sm primary" data-pra="${esc(p.id)}">${p.convidado ? 'Aprovar de novo' : 'Aprovar'}</button><button class="btn sm ghost" data-pri="${esc(p.id)}">Ignorar</button></div>${p.convidado ? '<div class="muted small">Aprovado: cadastrando...</div>' : ''}`}</td></tr>`; }).join('')}</tbody></table></div>`;
    $$('[data-prc]', box).forEach((sel) => {
      const id = sel.dataset.prc, e = this.escolhas[id] || {}, g = $(`[data-prg="${id}"]`, box);
      if (e.c) sel.value = e.c;
      g.innerHTML = this.optGrp(sel.value); if (e.g) g.value = e.g;
      sel.onchange = () => { g.innerHTML = this.optGrp(sel.value); };
    });
    $$('[data-pra]', box).forEach((b) => { b.onclick = async () => {
      const id = b.dataset.pra; b.disabled = true;
      try {
        await POST(`/procura/${encodeURIComponent(id)}/aprovar`, { clientId: $(`[data-prc="${id}"]`, box).value, groupId: $(`[data-prg="${id}"]`, box).value });
        toast('Aprovado. Em alguns segundos o computador aparece em Computadores.', 'ok');
      } catch (e) { fail(e); }
      this.lista();
    }; });
    $$('[data-pri]', box).forEach((b) => { b.onclick = async () => { try { await POST(`/procura/${encodeURIComponent(b.dataset.pri)}/ignorar`); this.lista(); } catch (e) { fail(e); } }; });
  },
};

// ================= USUÃRIOS =================
VIEWS.usuarios = {
  async render(el) { this.el = el; setTitle('UsuÃ¡rios', '<button class="btn primary" id="nu">+ Novo usuÃ¡rio</button>'); $('#nu').onclick = () => this.edit(null); await loadClients(); await this.refresh(); },
  async refresh() {
    this.rows = await GET('/users');
    this.el.innerHTML = `<div class="table-wrap"><table><thead><tr><th>UsuÃ¡rio</th><th>Perfil</th><th>Acesso</th><th>2FA</th><th>Ãšltimo login</th><th>SituaÃ§Ã£o</th><th></th></tr></thead><tbody>
      ${this.rows.map((u) => `<tr><td><b>${esc(u.username)}</b><div class="muted small">${esc(u.name || '')}</div></td><td>${role(u.role)}</td><td>${u.client_name ? 'SÃ³ ' + esc(u.client_name) : 'Todos os clientes'}</td>
      <td>${u.totp_enabled ? '<span class="badge ok">Ativo</span>' : '<span class="badge">NÃ£o</span>'}</td><td class="small">${when(u.last_login)}</td><td>${u.active ? '<span class="badge ok">Ativo</span>' : '<span class="badge bad">Bloqueado</span>'}</td>
      <td><div class="btns"><button class="btn sm" data-ue="${u.id}">Editar</button>${u.username !== S.me.username ? `<button class="btn sm danger" data-ud="${u.id}">Excluir</button>` : ''}</div></td></tr>`).join('')}</tbody></table></div>
      <p class="muted small"><b>Administrador:</b> tudo, inclusive PowerShell livre e revogar PCs. <b>TÃ©cnico:</b> tarefas de manutenÃ§Ã£o do catÃ¡logo. <b>Somente leitura:</b> sÃ³ visualiza (ideal para dar acesso ao cliente, restrito Ã  empresa dele).</p>`;
    $$('[data-ue]', this.el).forEach((b) => { b.onclick = () => this.edit(this.rows.find((u) => u.id === +b.dataset.ue)); });
    $$('[data-ud]', this.el).forEach((b) => { b.onclick = async () => { if (await confirmBox('Excluir usuÃ¡rio', 'Excluir este usuÃ¡rio?', 'Excluir', true)) { try { await api('DELETE', '/users/' + b.dataset.ud); this.refresh(); } catch (e) { fail(e); } } }; });
  },
  edit(u) {
    const isNew = !u; u = u || { role: 'tecnico', active: 1 };
    const m = modal(isNew ? 'Novo usuÃ¡rio' : `Editar ${u.username}`, `<form id="uf">
      ${isNew ? '<label>UsuÃ¡rio *</label><input name="username" required>' : ''}
      <label>Nome</label><input name="name" value="${esc(u.name || '')}">
      <div class="row"><div><label>Perfil</label><select name="role">${['admin', 'tecnico', 'leitura'].map((r) => `<option value="${r}" ${u.role === r ? 'selected' : ''}>${role(r)}</option>`).join('')}</select></div>
      <div><label>Acesso</label><select name="clientId"><option value="">Todos os clientes</option>${S.clients.map((c) => `<option value="${c.id}" ${u.client_id === c.id ? 'selected' : ''}>SÃ³ ${esc(c.name)}</option>`).join('')}</select></div></div>
      <label>${isNew ? 'Senha *' : 'Nova senha (deixe em branco para manter)'}</label><input name="password" type="password" autocomplete="new-password" ${isNew ? 'required' : ''}>
      ${isNew ? '' : `<label><input type="checkbox" name="active" ${u.active ? 'checked' : ''}> UsuÃ¡rio ativo</label>${u.totp_enabled ? '<label><input type="checkbox" name="reset2fa"> Zerar 2FA (perdeu o celular)</label>' : ''}`}</form>`,
    { footer: '<button class="btn ghost" data-close>Cancelar</button><button class="btn primary" id="sv">Salvar</button>' });
    $('#sv', m).onclick = async () => {
      const d = formData($('#uf', m)); if (!d.password) delete d.password;
      try { isNew ? await POST('/users', d) : await api('PATCH', '/users/' + u.id, d); m.close(); toast('UsuÃ¡rio salvo.', 'ok'); this.refresh(); } catch (e) { fail(e); }
    };
  },
};

// ================= MINHA CONTA =================
VIEWS.conta = {
  async render(el) {
    setTitle('Minha conta');
    S.me = await GET('/me');
    el.innerHTML = `<div class="grid g2"><div class="card"><h2>Trocar senha</h2><form id="pw">
      <label>Senha atual</label><input type="password" name="current" required autocomplete="current-password">
      <label>Nova senha</label><input type="password" name="password" required autocomplete="new-password">
      <label>Repita a nova senha</label><input type="password" name="password2" required autocomplete="new-password">
      <div class="btns" style="margin-top:14px"><button class="btn primary">Salvar senha</button></div></form></div>
      <div class="card"><h2>VerificaÃ§Ã£o em duas etapas (2FA)</h2><div id="tfa"></div></div>
      ${S.me.role === 'admin' && !S.me.clientId ? `<div class="card"><h2>Minha empresa</h2><form id="emp"><label>Nome da sua empresa</label><input name="empresaNome" maxlength="120" placeholder="ex.: FND Sistemas" id="emp-n">
        <p class="muted small" style="margin:6px 0 0">As iniciais vÃ£o na frente do nÂº de patrimÃ´nio dos PCs: <b id="emp-ex">â€¦</b></p>
        <div class="btns" style="margin-top:14px"><button class="btn primary">Salvar</button></div></form></div>` : ''}</div>`;
    if ($('#emp')) {
      const ini = (n) => { const m = new Set(['DE', 'DA', 'DO', 'DAS', 'DOS', 'E', 'A', 'O', 'AS', 'OS', 'EM', 'NA', 'NO', 'LTDA', 'ME', 'EIRELI', 'SA', 'EPP', 'MEI']); const p = String(n || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toUpperCase().split(/[^A-Z0-9]+/).filter((w) => w && !m.has(w)); return !p.length ? 'PC' : p.length === 1 ? p[0].slice(0, 3) : p.map((w) => w[0]).join('').slice(0, 4); };
      const ex = () => { const i = ini($('#emp-n').value); $('#emp-ex').textContent = $('#emp-n').value.trim() ? `${i}-PC-0001 (PC de mesa), ${i}-NB-0002 (notebook)` : 'preencha o nome'; };
      GET('/settings').then((st) => { $('#emp-n').value = st.empresaNome || ''; ex(); }).catch(() => {});
      $('#emp-n').oninput = ex;
      $('#emp').onsubmit = async (e) => { e.preventDefault(); try { await POST('/settings', { empresaNome: $('#emp-n').value }); toast(`Salvo. Os prÃ³ximos nÃºmeros saem como ${$('#emp-ex').textContent}.`, 'ok'); } catch (er) { fail(er); } };
    }
    $('#pw').onsubmit = async (e) => {
      e.preventDefault(); const d = formData(e.target);
      if (d.password !== d.password2) return toast('As senhas nÃ£o conferem.', 'err');
      try { await POST('/me/password', d); e.target.reset(); toast('Senha alterada.', 'ok'); } catch (er) { fail(er); }
    };
    this.draw2fa();
  },
  draw2fa() {
    const box = $('#tfa');
    if (S.me.totp) {
      box.innerHTML = '<p><span class="badge ok">Ativa</span> Seu login pede o cÃ³digo do aplicativo autenticador.</p><form id="dis"><label>Para desativar, digite sua senha</label><input type="password" name="password" required><div class="btns" style="margin-top:10px"><button class="btn danger">Desativar 2FA</button></div></form>';
      $('#dis').onsubmit = async (e) => { e.preventDefault(); try { await POST('/me/2fa/disable', formData(e.target)); S.me.totp = false; this.draw2fa(); } catch (er) { fail(er); } };
    } else {
      box.innerHTML = '<p class="muted">Protege o acesso mesmo se alguÃ©m descobrir sua senha. Use Google Authenticator, Microsoft Authenticator ou similar.</p><button class="btn primary" id="st">Ativar 2FA</button>';
      $('#st').onclick = async () => {
        try {
          const r = await POST('/me/2fa/start');
          box.innerHTML = `<p>1. Escaneie o QR Code no aplicativo autenticador:</p><img src="${esc(r.qr)}" alt="QR Code" style="background:#fff;padding:8px;border-radius:8px">
            <p class="muted small">Ou digite a chave: <span class="mono">${esc(r.secret)}</span></p><form id="en"><label>2. Digite o cÃ³digo de 6 dÃ­gitos</label><input name="code" inputmode="numeric" maxlength="6" required>
            <div class="btns" style="margin-top:10px"><button class="btn primary">Confirmar e ativar</button></div></form>`;
          $('#en').onsubmit = async (e) => { e.preventDefault(); try { await POST('/me/2fa/enable', formData(e.target)); S.me.totp = true; toast('2FA ativado!', 'ok'); this.draw2fa(); } catch (er) { fail(er); } };
        } catch (e) { fail(e); }
      };
    }
  },
};

// ================= CONFIGURAÃ‡Ã•ES =================
VIEWS.config = {
  async render(el) {
    setTitle('ConfiguraÃ§Ãµes');
    const s = await GET('/settings');
    el.innerHTML = `<div class="grid g2"><div class="card"><h2>Central</h2><form id="sf"><label>Nome exibido no painel</label><input name="name" value="${esc(s.name)}">
      <div class="btns" style="margin-top:12px"><button class="btn primary">Salvar</button></div></form>
      <dl class="kv" style="margin-top:18px"><dt>VersÃ£o da Central</dt><dd>${esc(s.version)}</dd><dt>VersÃ£o do agente</dt><dd>${esc(s.agentVersion)}</dd>
      <dt>Porta do painel/agentes</dt><dd>${s.port} (TCP, HTTPS)</dd><dt>Porta de descoberta</dt><dd>${s.discoveryPort} (UDP)</dd>
      <dt>Certificado (impressÃ£o digital)</dt><dd class="mono small">${esc(s.fingerprint)}</dd></dl>
      <h2 style="margin-top:22px">AtualizaÃ§Ã£o dos agentes</h2>
      <label style="color:var(--text)"><input type="checkbox" id="au" ${s.autoUpdate ? 'checked' : ''}> Atualizar os agentes automaticamente para a versÃ£o ${esc(s.agentVersion)}</label>
      <label style="color:var(--text);margin-top:12px"><input type="checkbox" id="daf" ${s.desligarAoFechar ? 'checked' : ''}> Desligar a Central quando eu fechar o painel</label>
      <p class="muted small">Ligado: fechou o painel, a Central desliga (nada fica rodando). Desligado: fica sempre ligada (alertas e agendamentos 24 h). Ao ligar, ela chama os agentes e eles voltam em segundos.</p>
      <label style="color:var(--text);margin-top:12px"><input type="checkbox" id="rpauto" ${s.restauracaoAuto ? 'checked' : ''}> ðŸ›Ÿ Criar um ponto de restauraÃ§Ã£o antes de atualizar o Windows, instalar drivers, reparar, desinstalar programa, limpar o Windows ou desligar programas (no mÃ¡ximo 1 a cada 6 horas por PC; sÃ³ nos PCs com a proteÃ§Ã£o do sistema ligada)</label>
      <h3 style="margin:16px 0 4px">ðŸ· NÂº de patrimÃ´nio dos PCs</h3>
      <label style="color:var(--text);margin:4px 0"><input type="checkbox" id="etq-auto" ${s.etiquetaAuto ? 'checked' : ''}> Gerar sozinho quando um PC novo entra</label>
      <p class="muted small" style="margin:2px 0">${s.empresaNome ? `Os nÃºmeros saem como <b>${esc(s.etiquetaPrefixo)}-PC-0001</b> (PC de mesa), <b>${esc(s.etiquetaPrefixo)}-NB-0002</b> (notebook), <b>${esc(s.etiquetaPrefixo)}-SRV-0003</b> (servidor) â€” as iniciais do nome da sua empresa (em <a href="#/conta">Minha conta</a>).` : '<b style="color:var(--warn)">Preencha o nome da sua empresa em <a href="#/conta">Minha conta</a></b>: as iniciais vÃ£o na frente do nÃºmero (ex.: FND Sistemas â†’ FS-PC-0001).'}</p>
      <div class="btns" style="margin-top:6px"><button class="btn sm" id="etq-todos" title="SÃ³ os que estÃ£o sem nÃºmero; os que jÃ¡ tÃªm nÃ£o mudam">Gerar para os PCs sem nÃºmero</button></div>
      <h3 style="margin:16px 0 4px">ðŸ¤– CorreÃ§Ã£o automÃ¡tica</h3>
      <p class="muted small" style="margin:0 0 4px">O FND resolve sozinho, sem vocÃª clicar (no mÃ¡ximo 1 vez por dia em cada PC; se nÃ£o resolver, o alerta fica para vocÃª).</p>
      ${[['limpar', 'Disco C: quase cheio â†’ limpar temporÃ¡rios, lixeira e atualizaÃ§Ãµes baixadas'], ['vacinas', 'AntivÃ­rus com vacinas velhas (3 dias ou mais) â†’ atualizar'], ['servico', 'ServiÃ§o importante do Windows parado â†’ religar']].map(([k, t]) => `<label style="color:var(--text);margin:4px 0"><input type="checkbox" data-ac="${k}" ${s.autoCorrecao && s.autoCorrecao[k] ? 'checked' : ''}> ${t}</label>`).join('')}
      <label style="margin-top:12px">Alertar quando a CPU de um PC passar de</label>
      <select id="tlim">${[75, 80, 85, 90, 95].map((v) => `<option value="${v}" ${Number(s.tempLimite) === v ? 'selected' : ''}>${v} Â°C${v === 85 ? ' (recomendado)' : ''}</option>`).join('')}</select>
      <p class="muted small">Precisa passar em 2 leituras seguidas (a cada 3 min); a partir de 95 Â°C o alerta Ã© crÃ­tico.</p>
      <label style="margin-top:12px">Uso da rede: velocidade mÃ¡xima dos envios grandes para os PCs</label>
      <select id="banda">${[[5, '5 Mbit/s (rede bem fraca)'], [10, '10 Mbit/s'], [20, '20 Mbit/s'], [40, '40 Mbit/s (recomendado)'], [100, '100 Mbit/s'], [0, 'Sem limite']].map(([v, t]) => `<option value="${v}" ${Number(s.bandaMbps) === v ? 'selected' : ''}>${t}</option>`).join('')}</select>
      <p class="muted small">Vale para atualizaÃ§Ãµes, instaladores e arquivos enviados (somando todos os PCs).</p>
      <p class="muted small">Quando um agente mais antigo se conecta, ele baixa o instalador novo desta Central, confere o SHA-256 e se atualiza sozinho (mantÃ©m o cadastro). Funciona a partir dos agentes 0.2.0; os anteriores precisam ser reinstalados uma vez.${s.agentInstaller ? '' : ' <b>AtenÃ§Ã£o: o instalador do agente nÃ£o estÃ¡ na pasta downloads.</b>'}</p></div>
      <div class="card"><h2>Backup</h2><p>O banco de dados Ã© copiado automaticamente uma vez por dia (mantÃ©m os 14 mais recentes) na pasta <span class="mono">backup</span> dos dados da Central.</p>
      <p>Ãšltimo backup: <b>${s.lastBackup ? dt(s.lastBackup) : 'ainda nÃ£o feito'}</b></p><button class="btn primary" id="bk">Fazer backup agora</button>
      <h3 style="margin-top:18px">CÃ³pia extra (recomendado)</h3>
      <p class="muted small">Se o PC da Central der problema, o backup que fica nele se perde junto. Escolha outra pasta para receber uma cÃ³pia de cada backup: pendrive, HD externo ou uma pasta sincronizada do Google Drive/OneDrive (ex.: <span class="mono">E:\\Backup FND</span>).</p>
      <form id="bcf"><div class="row"><input name="backupCopyDir" id="bcf-dir" value="${esc(s.backupCopyDir || '')}" placeholder="caminho completo da pasta (em branco = desligado)"><button class="btn" style="flex:0 0 auto">Salvar</button></div></form>
      ${s.backupCopyLast ? `<p class="small" style="margin-top:6px">${s.backupCopyLast.ok ? 'âœ”' : '<span style="color:var(--bad)">âœ–</span>'} ${esc(s.backupCopyLast.msg)} <span class="muted">(${esc(dt(s.backupCopyLast.at))})</span></p>` : ''}
      <h3 style="margin-top:18px">ðŸ’¾ Backup dos clientes (destino "Central")</h3>
      <p class="muted small">Onde ficam os arquivos dos PCs que fazem backup para a Central. Use um disco com bastante espaÃ§o (ex.: D:\\FND-Backups).</p>
      <form id="bdirf"><div class="row"><input name="backupDir" id="bdir-dir" value="${esc(s.backupDir || '')}"><button type="button" class="btn" id="bdir-proc" style="flex:0 0 auto;min-width:0">ðŸ“ Procurar</button><button class="btn" style="flex:0 0 auto">Salvar</button></div></form>
      <h2 style="margin-top:22px">Instaladores disponÃ­veis</h2>${s.downloads.length ? `<ul>${s.downloads.map((f) => `<li><a href="/download/${encodeURIComponent(f)}">${esc(f)}</a></li>`).join('')}</ul>` : '<p class="muted">Nenhum instalador na pasta downloads.</p>'}</div></div>`;
    el.insertAdjacentHTML('beforeend', '<div class="card" id="wncard" style="margin-top:16px"></div>');
    wnCard($('#wncard', el));
    if (can('admin')) {
      el.insertAdjacentHTML('beforeend', `<div class="card" id="upcard" style="margin-top:16px"></div><div class="card" id="ntcard" style="margin-top:16px"></div><div class="card" id="rlcard" style="margin-top:16px"></div>
      <details class="card" id="netavanc" style="margin-top:16px"><summary style="cursor:pointer"><b>OpÃ§Ãµes avanÃ§adas</b> <span class="muted small">â€” acesso pela internet com porta aberta no roteador</span></summary>
        <p class="muted small" style="margin:10px 0 0"><b>Para que serve:</b> Ã© outro jeito de atender PCs fora da rede, sem passar pelo FND Relay: os agentes ligam <b>direto</b> na sua Central por uma porta aberta no roteador (UPnP ou "redirecionamento de porta").
        A tela fica um pouco mais rÃ¡pida e nÃ£o gasta a cota grÃ¡tis da Cloudflare. <b>SÃ³ use se vocÃª tem acesso ao roteador</b> da rede da Central e IP pÃºblico (sem CGNAT). Se vocÃª jÃ¡ usa o FND Relay, pode deixar desligado.</p>
        <div id="netcard" style="margin-top:12px"></div></details>`);
      this.atualizacao($('#upcard', el)); this.notify($('#ntcard', el)); this.relay($('#rlcard', el)); this.internet($('#netcard', el));
    }
    $('#sf').onsubmit = async (e) => { e.preventDefault(); try { await POST('/settings', formData(e.target)); toast('Salvo. Recarregue a pÃ¡gina para ver o novo nome.', 'ok'); } catch (er) { fail(er); } };
    $('#tlim').onchange = async (e) => { try { await POST('/settings', { tempLimite: Number(e.target.value) }); toast('Limite de temperatura salvo.', 'ok'); } catch (er) { fail(er); } };
    $('#etq-auto').onchange = async (e) => { try { await POST('/settings', { etiquetaAuto: e.target.checked }); toast('Salvo.', 'ok'); } catch (er) { fail(er); } };
    $('#etq-todos').onclick = async () => { if (!(await confirmBox('Gerar nÂº de patrimÃ´nio', 'Gerar o nÃºmero para todos os PCs que ainda estÃ£o <b>sem nÃºmero</b>? (Os que jÃ¡ tÃªm nÃ£o mudam.)', 'Gerar'))) return; try { const r = await POST('/etiquetas/gerar-todos', {}); toast(r.gerados ? `${r.gerados} PC(s) ganharam nÃºmero: ${r.lista.slice(0, 5).join(', ')}${r.gerados > 5 ? 'â€¦' : ''}` : 'Todos os PCs jÃ¡ tinham nÃºmero.', 'ok'); } catch (er) { fail(er); } };
    $$('[data-ac]').forEach((c) => { c.onchange = async () => { try { await POST('/settings', { autoCorrecao: { [c.dataset.ac]: c.checked } }); toast(c.checked ? 'CorreÃ§Ã£o automÃ¡tica ligada.' : 'CorreÃ§Ã£o automÃ¡tica desligada.', 'ok'); } catch (er) { fail(er); } }; });
    $('#rpauto').onchange = async (e) => { try { await POST('/settings', { restauracaoAuto: e.target.checked }); toast(e.target.checked ? 'Ponto de restauraÃ§Ã£o automÃ¡tico ligado.' : 'Ponto de restauraÃ§Ã£o automÃ¡tico desligado.', 'ok'); } catch (er) { fail(er); } };
    $('#daf').onchange = async (e) => { try { await POST('/settings', { desligarAoFechar: e.target.checked }); toast(e.target.checked ? 'A Central desliga quando vocÃª fechar o painel.' : 'A Central fica sempre ligada.', 'ok'); } catch (er) { fail(er); } };
    $('#banda').onchange = async (e) => { try { await POST('/settings', { bandaMbps: Number(e.target.value) }); toast('Limite de banda salvo.', 'ok'); } catch (er) { fail(er); } };
    $('#au').onchange = async (e) => { try { await POST('/settings', { autoUpdate: e.target.checked }); toast(e.target.checked ? 'AtualizaÃ§Ã£o automÃ¡tica ligada.' : 'AtualizaÃ§Ã£o automÃ¡tica desligada.', 'ok'); } catch (er) { fail(er); } };
    $('#bcf').onsubmit = async (e) => { e.preventDefault(); try { await POST('/settings', formData(e.target)); toast('Pasta da cÃ³pia extra salva. Vale a partir do prÃ³ximo backup.', 'ok'); } catch (er) { fail(er); } };
    { const b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.style.cssText = 'flex:0 0 auto;min-width:0'; b.textContent = 'ðŸ“ Procurar'; const inp = $('#bcf-dir'); if (inp) { inp.insertAdjacentElement('afterend', b);
      b.onclick = async () => { const p = await escolherPasta({ central: true }, inp.value.trim(), 'Pasta da cÃ³pia extra', 'No PC da Central: pendrive, HD externo ou uma pasta do Google Drive/OneDrive.'); if (p) inp.value = p; }; } }
    $('#bdir-proc').onclick = async () => { const p = await escolherPasta({ central: true }, $('#bdir-dir').value.trim(), 'Pasta dos backups dos clientes', 'No PC da Central: escolha um disco com bastante espaÃ§o.'); if (p) $('#bdir-dir').value = p; };
    $('#bdirf').onsubmit = async (e) => { e.preventDefault(); try { await POST('/settings', { backupDir: e.target.backupDir.value }); toast('Pasta dos backups salva. Os prÃ³ximos backups vÃ£o para lÃ¡ (os antigos ficam onde estÃ£o).', 'ok'); } catch (er) { fail(er); } };
    $('#bk').onclick = async () => { try { const r = await POST('/backup'); toast('Backup criado: ' + r.name, 'ok'); VIEWS.config.render(el); } catch (e) { fail(e); } };
  },
  async atualizacao(box) {
    let st; try { st = await GET('/atualizacao'); } catch { box.remove(); return; }
    const MODO = { agora: 'instalar na hora', madrugada: 'instalar de madrugada (3h Ã s 5h)', avisar: 'sÃ³ avisar' };
    const disp = st.disponivel;
    box.innerHTML = `<div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><h2 style="margin:0">AtualizaÃ§Ã£o da Central pela internet</h2>${disp ? `<span class="badge warn">VersÃ£o ${esc(disp.versao)} disponÃ­vel</span>` : '<span class="badge ok">Em dia</span>'}</div>
      <p class="muted">A Central procura versÃ£o nova sozinha a cada 10 minutos (sÃ³ baixa â€” nada sai daqui). SÃ³ instala pacotes assinados pela FND Sistemas e nunca volta para uma versÃ£o mais velha. Na troca, o painel fica fora do ar por alguns segundos e os agentes se reconectam sozinhos. Se a versÃ£o nova nÃ£o subir, a Central volta para a anterior sozinha.</p>
      <dl class="kv"><dt>VersÃ£o instalada</dt><dd>${esc(st.versao)}</dd>
        <dt>Ãšltima verificaÃ§Ã£o</dt><dd>${st.verificado_em ? esc(dt(st.verificado_em)) : 'ainda nÃ£o verificou'}${st.erro ? ` <span style="color:var(--bad)">â€” ${esc(st.erro)}</span>` : ''}</dd>
        ${st.site ? `<dt>Publicada no site</dt><dd>${esc(st.site.versao)} <span class="muted">(${esc(MODO[st.site.modo] || st.site.modo)})</span></dd>` : ''}
        ${st.ultimaInstalacao ? `<dt>Ãšltima atualizaÃ§Ã£o</dt><dd>${esc(st.ultimaInstalacao.de)} â†’ ${esc(st.ultimaInstalacao.para)} <span class="muted">(${esc(dt(st.ultimaInstalacao.quando))}, ${esc(st.ultimaInstalacao.quem)})</span></dd>` : ''}
        ${st.voltou ? `<dt>Voltou versÃ£o</dt><dd style="color:var(--bad)">A ${esc(st.voltou.de)} nÃ£o subiu; voltou para a ${esc(st.voltou.para)} (${esc(dt(st.voltou.quando))})</dd>` : ''}</dl>
      <label>Quando tiver versÃ£o nova</label>
      <select id="uppref"><option value="auto">Seguir o que a FND escolheu ao publicar (recomendado)</option><option value="avisar">SÃ³ avisar aqui (eu clico em Instalar)</option><option value="desligado">NÃ£o procurar sozinho</option></select>
      <div class="btns" style="margin-top:12px"><button class="btn" id="upver">Procurar agora</button>${disp ? `<button class="btn primary" id="upinst">Instalar a versÃ£o ${esc(disp.versao)} agora</button>` : ''}</div>`;
    $('#uppref', box).value = st.pref;
    $('#uppref', box).onchange = async (e) => { try { await POST('/atualizacao/pref', { pref: e.target.value }); toast('PreferÃªncia salva.', 'ok'); } catch (er) { fail(er); } };
    $('#upver', box).onclick = async (e) => {
      e.target.disabled = true; e.target.textContent = 'Procurando...';
      try { const r = await POST('/atualizacao/verificar'); toast(r.erro ? r.erro : r.disponivel ? 'VersÃ£o ' + r.disponivel.versao + ' disponÃ­vel.' : 'A Central jÃ¡ estÃ¡ na versÃ£o mais nova.', r.erro ? 'err' : 'ok'); } catch (er) { fail(er); }
      this.atualizacao(box);
    };
    if (disp) $('#upinst', box).onclick = async (e) => {
      if (!confirm(`Instalar a versÃ£o ${disp.versao} da Central agora?\n\nO painel fica fora do ar por alguns segundos e volta sozinho.`)) return;
      e.target.disabled = true; e.target.textContent = 'Instalando...';
      try {
        await POST('/atualizacao/instalar'); toast('Instalada! A Central estÃ¡ reiniciando. A pÃ¡gina recarrega sozinha.', 'ok');
        const espera = async () => { try { const s = await GET('/atualizacao'); if (s.versao === disp.versao) return location.reload(); } catch { /* reiniciando */ } setTimeout(espera, 3000); };
        setTimeout(espera, 8000);
      } catch (er) { fail(er); e.target.disabled = false; e.target.textContent = 'Instalar agora'; }
    };
  },
  async notify(box) {
    let st; try { st = await GET('/notify'); } catch { box.remove(); return; }
    const on = st.channels.telegram || st.channels.email;
    const last = st.last ? Object.entries(st.last.result || {}).map(([k, v]) => `${k === 'telegram' ? 'Telegram' : 'E-mail'}: ${v === 'ok' ? 'âœ” enviado' : esc(v)}`).join(' Â· ') : '';
    box.innerHTML = `<div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><h2 style="margin:0">Avisos no Telegram e e-mail</h2>${on ? '<span class="badge ok">Ligado</span>' : '<span class="badge">Desligado</span>'}</div>
      <p class="muted">Receba no celular quando um PC ficar offline, o disco encher ou der sinal de falha, o antivÃ­rus desligar etc. VÃ¡rios alertas seguidos chegam juntos numa mensagem sÃ³ (no mÃ¡ximo 30 por hora).</p>
      <form id="ntf">
        <label>Avisar a partir de</label><select name="minLevel"><option value="critico">SÃ³ crÃ­ticos</option><option value="aviso">Avisos e crÃ­ticos (recomendado)</option><option value="info">Tudo, atÃ© informativos</option></select>
        <div class="grid g2" style="margin-top:12px"><div>
          <h3>Telegram ${st.channels.telegram ? '<span class="badge ok">configurado</span>' : ''}</h3>
          <p class="muted small">1) No Telegram, fale com <b>@BotFather</b>, envie <span class="mono">/newbot</span> e copie o token. 2) Mande um "oi" para o seu bot novo. 3) Cole o token aqui e clique em <b>Descobrir meu chat</b>.</p>
          <label>Token do bot</label><input name="tgToken" type="password" autocomplete="off" placeholder="${st.hasTgToken ? '(jÃ¡ salvo â€” deixe em branco para manter)' : '123456789:ABC...'}">
          <label>Chat</label><div class="row"><input name="tgChat" value="${esc(st.tgChat)}" placeholder="ex.: 123456789"><button class="btn" type="button" id="tgdisc" style="flex:0 0 auto">Descobrir meu chat</button></div>
          <div id="tgchats"></div>
          ${st.hasTgToken ? '<button class="btn sm ghost" type="button" id="tgclear" style="margin-top:6px">Remover Telegram</button>' : ''}
        </div><div>
          <h3>E-mail ${st.channels.email ? '<span class="badge ok">configurado</span>' : ''}</h3>
          <label style="color:var(--text)"><input type="checkbox" name="mailOn" ${st.mailOn ? 'checked' : ''}> Enviar por e-mail</label>
          <div class="row"><div><label>Servidor (SMTP)</label><input name="smtpHost" value="${esc(st.smtpHost)}" placeholder="smtp.gmail.com"></div>
            <div style="flex:0 0 90px"><label>Porta</label><input name="smtpPort" type="number" value="${esc(st.smtpPort)}"></div>
            <div style="flex:0 0 130px"><label>SeguranÃ§a</label><select name="smtpSecure"><option value="starttls">STARTTLS (587)</option><option value="tls">TLS (465)</option><option value="none">Nenhuma</option></select></div></div>
          <div class="row"><div><label>UsuÃ¡rio</label><input name="smtpUser" value="${esc(st.smtpUser)}" autocomplete="off"></div>
            <div><label>Senha</label><input name="smtpPass" type="password" autocomplete="new-password" placeholder="${st.hasSmtpPass ? '(jÃ¡ salva â€” deixe em branco para manter)' : ''}"></div></div>
          <div class="row"><div><label>Remetente</label><input name="smtpFrom" value="${esc(st.smtpFrom)}" placeholder="seuemail@gmail.com"></div>
            <div><label>Enviar para (vÃ­rgula separa)</label><input name="smtpTo" value="${esc(st.smtpTo)}"></div></div>
          <p class="muted small">Gmail: servidor <span class="mono">smtp.gmail.com</span>, porta 465 (TLS) ou 587 (STARTTLS) e uma <b>senha de app</b> (Conta Google â†’ SeguranÃ§a â†’ Senhas de app), nÃ£o a sua senha normal.</p>
        </div></div>
        <div class="btns" style="margin-top:12px"><button class="btn primary">Salvar</button><button class="btn" type="button" id="nttest">Enviar mensagem de teste</button></div>
      </form>
      ${last ? `<p class="muted small" style="margin-top:10px">Ãšltimo envio (${esc(dt(st.last.at))}): ${last}</p>` : ''}`;
    const f = $('#ntf', box);
    f.minLevel.value = st.minLevel; f.smtpSecure.value = st.smtpSecure;
    const save = async () => { const d = formData(f); d.mailOn = f.mailOn.checked; return POST('/notify', d); };
    f.onsubmit = async (e) => { e.preventDefault(); try { await save(); toast('Avisos salvos.', 'ok'); this.notify(box); } catch (er) { fail(er); } };
    $('#nttest', box).onclick = async (e) => {
      e.target.disabled = true; e.target.textContent = 'Enviando...';
      try { await save(); const r = await POST('/notify/test'); const bad = Object.entries(r).filter(([, v]) => v !== 'ok');
        if (bad.length) toast('Falhou: ' + bad.map(([k, v]) => `${k}: ${v}`).join(' | '), 'err'); else toast('Mensagem de teste enviada! Confira o celular/e-mail.', 'ok');
      } catch (er) { fail(er); }
      this.notify(box);
    };
    $('#tgdisc', box).onclick = async () => {
      try {
        const chats = await POST('/notify/chats', { tgToken: f.tgToken.value });
        $('#tgchats', box).innerHTML = chats.length ? `<p class="small">Escolha:</p>${chats.map((c) => `<button type="button" class="btn sm" data-chat="${esc(c.id)}">${esc(c.name)} (${esc(c.id)})</button>`).join(' ')}`
          : '<p class="muted small">Nenhuma conversa encontrada. Mande um "oi" para o seu bot no Telegram e tente de novo.</p>';
        $$('[data-chat]', box).forEach((b) => { b.onclick = () => { f.tgChat.value = b.dataset.chat; toast('Chat escolhido. Clique em Salvar.', 'ok'); }; });
      } catch (er) { fail(er); }
    };
    if ($('#tgclear', box)) $('#tgclear', box).onclick = async () => { try { await POST('/notify', { clearTg: true }); this.notify(box); } catch (er) { fail(er); } };
  },
  // FND Relay (Cloudflare): computadores fora da rede sem mexer em roteador
  async relay(box) {
    let st; try { st = await GET('/internet'); } catch { box.remove(); return; }
    const r = st.relay || {};
    const badge = !r.enabled ? '<span class="badge">Desligado</span>' : r.conectado ? '<span class="badge ok">Conectado</span>' : '<span class="badge erro">Sem conexÃ£o</span>';
    box.innerHTML = `<div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><h2 style="margin:0">FND Relay â€” internet sem mexer no roteador</h2>${badge}</div>
      <p class="muted">Atende computadores <b>em qualquer lugar</b> sem abrir porta em roteador nenhum: a Central e os agentes sÃ³ se ligam ao <b>seu</b> Relay na Cloudflare (grÃ¡tis, sem cartÃ£o). Tudo passa <b>criptografado de ponta a ponta</b>: nem a Cloudflare consegue ler ou mandar comandos.</p>
      <form id="rlf"><label style="color:var(--text)"><input type="checkbox" name="enabled" ${r.enabled ? 'checked' : ''}> Ligar o FND Relay</label>
        <div class="row"><div><label>EndereÃ§o do Relay</label><input name="url" value="${esc(r.url || '')}" placeholder="fnd-relay.seunome.workers.dev"></div>
        <div><label>Chave do Relay</label><input name="chave" type="password" autocomplete="off" placeholder="${r.temChave ? 'â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢ (jÃ¡ salva; preencha sÃ³ para trocar)' : 'cole a chave do PUBLICAR.bat'}"></div></div>
        <div class="btns" style="margin-top:10px"><button class="btn primary">Salvar e conectar</button></div></form>
      ${r.enabled ? `<dl class="kv" style="margin-top:14px">
        <dt>SituaÃ§Ã£o</dt><dd>${r.conectado ? 'Conectado ao Relay' + (r.desde ? ` desde ${esc(when(r.desde))}` : '') : esc(r.erro || 'Conectando...')}</dd>
        ${r.endereco ? `<dt>EndereÃ§o para os agentes</dt><dd class="mono" style="word-break:break-all">${esc(r.endereco)} <button class="btn sm ghost" data-copy="${esc(r.endereco)}">Copiar</button></dd>` : ''}
        <dt>PCs conectados pelo Relay</dt><dd>${esc(r.agentes || 0)}</dd>
        ${r.uso ? `<dt>Cota grÃ¡tis de hoje</dt><dd><span class="${r.uso.pct >= 80 ? 'erro' : ''}">${esc(r.uso.pct)}% usado</span> <span class="muted small">(${esc(r.uso.pedidos.toLocaleString('pt-BR'))} de ${esc(r.uso.cota.toLocaleString('pt-BR'))} pedidos Â· zera Ã s 21h)</span></dd>` : ''}</dl>
        <p class="muted small">PCs jÃ¡ cadastrados aprendem esse endereÃ§o sozinhos na prÃ³xima vez que conectarem (na rede ou pela internet) e passam a usar o Relay quando estiverem fora. Para um PC novo fora da rede: no instalador do agente, informe o cÃ³digo do cliente e cole o endereÃ§o acima em "EndereÃ§o da Central".</p>` : `
        <p class="muted small" style="margin-top:10px"><b>Como criar o seu Relay (uma vez sÃ³):</b> crie a conta grÃ¡tis em dash.cloudflare.com, abra a pasta <b>FND_Relay_Cloudflare</b> que veio com o FND Remoto e dÃª dois cliques em <b>PUBLICAR.bat</b>. No fim ele mostra o <b>endereÃ§o</b> e a <b>chave</b>: cole aqui e ligue.</p>`}`;
    $$('[data-copy]', box).forEach((b) => { b.onclick = () => copy(b.dataset.copy); });
    const f = $('#rlf', box);
    f.onsubmit = async (e) => {
      e.preventDefault();
      const b = $('button.primary', f); b.disabled = true; b.textContent = 'Conectando...';
      const body = { enabled: f.enabled.checked, url: f.url.value };
      if (f.chave.value.trim()) body.chave = f.chave.value.trim();
      try { await POST('/internet/relay', body); toast(body.enabled ? 'FND Relay salvo. Conectando...' : 'FND Relay desligado.', 'ok'); } catch (er) { fail(er); }
      setTimeout(() => this.relay(box), body.enabled ? 2500 : 0);
    };
  },
  async internet(box) {
    let st; try { st = await GET('/internet'); } catch { box.remove(); return; }
    if (st.enabled && $('#netavanc')) $('#netavanc').open = true; // ligado: jÃ¡ mostra aberto
    const badge = !st.enabled ? '<span class="badge">Desligado</span>' : st.error ? '<span class="badge erro">Erro</span>' : st.upnp.ok ? '<span class="badge ok">Funcionando</span>' : '<span class="badge warn">AtenÃ§Ã£o</span>';
    box.innerHTML = `<div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><h2 style="margin:0">Acesso pela internet com porta no roteador (alternativa)</h2>${badge}</div>
      <p class="muted">Para atender computadores <b>fora desta rede</b> (em outra casa ou empresa). Abre uma porta <b>sÃ³ para os agentes</b>: o painel, o login e o terminal continuam sÃ³ na rede local. O agente do cliente sÃ³ faz uma ligaÃ§Ã£o de saÃ­da: <b>nada muda no roteador do cliente</b>.</p>
      <p class="small" style="color:var(--warn)">âš  Use na Central da <b>sua</b> internet. Na rede de uma empresa, sÃ³ ligue com autorizaÃ§Ã£o do responsÃ¡vel pela rede.</p>
      <form id="netf"><label style="color:var(--text)"><input type="checkbox" name="enabled" ${st.enabled ? 'checked' : ''}> Ligar o acesso pela internet</label>
        <div class="row"><div><label>Porta (sÃ³ agentes)</label><input name="port" type="number" min="1024" max="65535" value="${esc(st.port)}"></div>
        <div><label>EndereÃ§o pÃºblico (opcional)</label><input name="manualHost" value="${esc(st.manualHost)}" placeholder="em branco = descobre sozinho pelo roteador"></div></div>
        <div class="btns" style="margin-top:10px"><button class="btn primary">Salvar e aplicar</button>${st.enabled ? '<button class="btn" type="button" id="netretry">â†» Tentar abrir a porta de novo</button>' : ''}</div></form>
      ${st.enabled ? `<dl class="kv" style="margin-top:14px">
        <dt>SituaÃ§Ã£o</dt><dd>${esc(st.error || st.upnp.message)}</dd>
        ${st.address ? `<dt>EndereÃ§o para os agentes</dt><dd class="mono">${esc(st.address)} <button class="btn sm ghost" data-copy="${esc(st.address)}">Copiar</button></dd>` : ''}
        <dt>PCs conectados pela internet</dt><dd>${esc(st.agentsViaInternet)}</dd></dl>
        <p class="muted small">Para um PC novo fora da rede: no instalador do agente, informe o cÃ³digo do cliente e, em "EndereÃ§o da Central", o endereÃ§o acima. PCs jÃ¡ cadastrados aprendem o endereÃ§o sozinhos na prÃ³xima vez que conectarem aqui na rede.</p>
        ${!st.upnp.ok && !st.error && !/CGNAT/.test(st.upnp.message) ? `<div class="card" style="margin-top:12px;padding:12px 14px"><b>Como resolver de graÃ§a (escolha um):</b>
          <ol style="margin:8px 0 0 18px;line-height:1.6">
            <li><b>Ligar o UPnP no roteador:</b> abra <span class="mono">http://${esc(st.rede && st.rede.roteador || '192.168.0.1')}</span> no navegador, entre com a senha do roteador (fica na etiqueta embaixo dele), procure <b>UPnP</b> (Ã s vezes em "Rede", "NAT" ou "AvanÃ§ado"), ligue e salve. Depois clique em <b>Tentar abrir a porta de novo</b>.</li>
            <li><b>Ou abrir a porta Ã  mÃ£o no roteador</b> ("Encaminhamento de portas", "Port Forwarding" ou "Servidor virtual"): porta externa <b>${esc(st.port)}</b>, porta interna <b>${esc(st.port)}</b>, protocolo <b>TCP</b>, IP do computador <b>${esc(st.rede && st.rede.pcs && st.rede.pcs[0] || 'deste PC')}</b>. Depois coloque o seu IP pÃºblico em "EndereÃ§o pÃºblico".</li>
          </ol>
          <p class="muted small" style="margin-top:8px">Se tiver dois aparelhos (modem da operadora + roteador Wi-Fi), a porta precisa ser aberta nos dois, ou o modem precisa estar em modo "bridge". Se o IP de internet do roteador comeÃ§ar com 100.64 a 100.127, a operadora usa CGNAT: aÃ­ Ã© preciso pedir um IP pÃºblico a ela.</p></div>` : ''}` : ''}`;
    $$('[data-copy]', box).forEach((b) => { b.onclick = () => copy(b.dataset.copy); });
    const f = $('#netf', box);
    f.onsubmit = async (e) => {
      e.preventDefault();
      const on = f.enabled.checked;
      if (on && !st.enabled && !(await confirmBox('Ligar acesso pela internet', `A Central vai pedir ao roteador desta rede para abrir a porta <b>${esc(f.port.value)}</b> sÃ³ para os agentes. O painel continua fechado para a internet.<br><br>Esta Ã© a <b>sua</b> rede (ou vocÃª tem autorizaÃ§Ã£o do responsÃ¡vel)?`, 'Sim, ligar'))) return;
      const b = $('button.primary', f); b.disabled = true; b.textContent = 'Aplicando...';
      try { await POST('/internet', { enabled: on, port: Number(f.port.value), manualHost: f.manualHost.value }); toast(on ? 'Acesso pela internet aplicado.' : 'Acesso pela internet desligado.', 'ok'); } catch (er) { fail(er); }
      this.internet(box);
    };
    if ($('#netretry', box)) $('#netretry', box).onclick = async (e) => { e.target.disabled = true; try { await POST('/internet', {}); } catch (er) { fail(er); } this.internet(box); };
  },
};

// "o painel estÃ¡ aberto" (a Central se desliga sozinha ~20 s depois que a Ãºltima janela fecha, se a opÃ§Ã£o
// estiver ligada em ConfiguraÃ§Ãµes). Vale tambÃ©m na tela de login.
(function avisarAberto() {
  const ping = () => fetch('/api/painel/vivo', { cache: 'no-store' }).catch(() => {});
  ping();
  setInterval(ping, 15000);
  window.addEventListener('pagehide', () => { try { navigator.sendBeacon('/api/painel/fechou', ''); } catch { /* */ } });
})();
boot();
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
// FND SISTEMAS â€” CADASTRO DE USUÃRIOS (tela). Kit do painel FND Sistemas v2.2.
// Mostra UMA vez (por instalaÃ§Ã£o) a janela "Bem-vindo": Nome obrigatÃ³rio; contato, e-mail, empresa e
// cidade opcionais. O servidor (fnd-cadastro-servidor.js) guarda e envia para a planilha da FND.
// Uso:  FNDCadastro.iniciar({ endpoint: '/api/fnd/cadastro', sistema: 'FND Organiza',
//                             pronto: function () { return true; } /* quando a tela principal jÃ¡ estÃ¡ visÃ­vel */ });
// Use junto com o fnd-painel.js (a logo vem do CSS dele, classe "fndp-logo").
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
(function () {
  'use strict';
  var opc = { endpoint: '/api/fnd/cadastro', sistema: 'sistema', pronto: null };
  var CSS =
    '.fndc-fundo{position:fixed;inset:0;z-index:2147483000;background:rgba(5,10,20,.72);display:flex;align-items:center;justify-content:center;padding:16px;font-family:Segoe UI,system-ui,Arial,sans-serif}' +
    '.fndc-caixa{width:100%;max-width:440px;max-height:calc(100vh - 32px);overflow:auto;background:#0f172a;color:#e5e7eb;border:1px solid #1e3a5f;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.5);padding:24px}' +
    '.fndc-claro .fndc-caixa{background:#fff;color:#0f172a;border-color:#cbd5e1}' +
    '.fndc-topo{display:flex;align-items:center;gap:12px;margin-bottom:6px}.fndc-topo .fndp-logo{width:46px;height:46px;flex:none}' +
    '.fndc-caixa h2{margin:0;font-size:19px;line-height:1.25}.fndc-sub{margin:4px 0 16px;font-size:13.5px;opacity:.8;line-height:1.45}' +
    '.fndc-caixa label{display:block;font-size:12.5px;margin:10px 0 4px;opacity:.9}.fndc-caixa label b{color:#f87171;font-weight:600}' +
    '.fndc-caixa input{width:100%;box-sizing:border-box;padding:10px 12px;border-radius:9px;border:1px solid #334155;background:#0b1220;color:inherit;font-size:14px;outline:none}' +
    '.fndc-claro .fndc-caixa input{background:#f8fafc;border-color:#cbd5e1}.fndc-caixa input:focus{border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,.25)}' +
    '.fndc-duas{display:grid;grid-template-columns:1fr 1fr;gap:0 10px}@media(max-width:480px){.fndc-duas{grid-template-columns:1fr}}' +
    '.fndc-erro{color:#f87171;font-size:13px;min-height:18px;margin-top:10px}' +
    '.fndc-btn{width:100%;margin-top:6px;padding:12px;border:0;border-radius:10px;background:#16a34a;color:#fff;font-size:15px;font-weight:600;cursor:pointer}.fndc-btn:disabled{opacity:.6;cursor:default}' +
    '.fndc-lgpd{font-size:11.5px;opacity:.65;margin:10px 0 0;line-height:1.4;text-align:center}';

  function tema() {
    try {
      var m = getComputedStyle(document.body).backgroundColor.match(/\d+(\.\d+)?/g);
      if (m && m.length >= 3 && !(m.length > 3 && +m[3] === 0)) return (0.299 * m[0] + 0.587 * m[1] + 0.114 * m[2]) > 150 ? 'claro' : 'escuro';
    } catch (e) { }
    return 'escuro';
  }
  function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }

  function mostrar() {
    if (document.querySelector('.fndc-fundo')) return;
    if (!document.getElementById('fndc-css')) { var st = document.createElement('style'); st.id = 'fndc-css'; st.textContent = CSS; document.head.appendChild(st); }
    var f = document.createElement('div');
    f.className = 'fndc-fundo' + (tema() === 'claro' ? ' fndc-claro' : '');
    f.setAttribute('role', 'dialog'); f.setAttribute('aria-modal', 'true');
    f.innerHTML =
      '<form class="fndc-caixa" autocomplete="on" novalidate>' +
      '<div class="fndc-topo"><span class="fndp-logo"></span><h2>Bem-vindo ao ' + esc(opc.sistema) + '!</h2></div>' +
      '<p class="fndc-sub">Antes de comeÃ§ar, conte pra gente quem estÃ¡ usando. SÃ³ o nome Ã© obrigatÃ³rio.</p>' +
      '<label>Nome <b>*</b></label><input name="nome" maxlength="80" autocomplete="name" required>' +
      '<div class="fndc-duas"><div><label>NÃºmero de contato</label><input name="contato" maxlength="30" inputmode="tel" autocomplete="tel" placeholder="(11) 99999-9999"></div>' +
      '<div><label>E-mail</label><input name="email" maxlength="100" type="email" autocomplete="email"></div></div>' +
      '<div class="fndc-duas"><div><label>Empresa</label><input name="empresa" maxlength="80" autocomplete="organization"></div>' +
      '<div><label>Cidade</label><input name="cidade" maxlength="60" autocomplete="address-level2"></div></div>' +
      '<div class="fndc-erro" aria-live="polite"></div>' +
      '<button class="fndc-btn" type="submit">Continuar</button>' +
      '<p class="fndc-lgpd">Ao continuar, vocÃª concorda em enviar esses dados para a FND Sistemas, para suporte e novidades.</p>' +
      '</form>';
    document.body.appendChild(f);
    var form = f.querySelector('form'), erro = f.querySelector('.fndc-erro'), btn = f.querySelector('.fndc-btn');
    setTimeout(function () { try { form.nome.focus(); } catch (e) { } }, 50);
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var corpo = { nome: form.nome.value, contato: form.contato.value, email: form.email.value, empresa: form.empresa.value, cidade: form.cidade.value };
      if (corpo.nome.trim().length < 2) { erro.textContent = 'Informe o seu nome.'; form.nome.focus(); return; }
      btn.disabled = true; erro.textContent = '';
      fetch(opc.endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(corpo) })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok || r.status === 409, j: j }; }); })
        .then(function (r) { if (r.ok) { f.remove(); } else { erro.textContent = (r.j && r.j.erro) || 'NÃ£o consegui salvar. Tente de novo.'; btn.disabled = false; } })
        .catch(function () { erro.textContent = 'NÃ£o consegui salvar. Tente de novo.'; btn.disabled = false; });
    });
  }

  function iniciar(o) {
    for (var k in (o || {})) opc[k] = o[k];
    fetch(opc.endpoint, { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (d) {
      if (!d || !d.precisa) return;
      var n = 0;
      (function esperar() {   // sÃ³ mostra quando a tela principal do sistema jÃ¡ estÃ¡ aberta (depois do login)
        var ok = true; try { ok = !opc.pronto || !!opc.pronto(); } catch (e) { ok = false; }
        if (ok) return mostrar();
        if (++n < 3600) setTimeout(esperar, 1000);
      })();
    }).catch(function () { });
  }

  window.FNDCadastro = { iniciar: iniciar, mostrar: mostrar };
})();
// ============================================================================
//  FND Sistemas - painel de links (parte da TELA)  -  sem dependencias
//
//  Uso: <script src="fnd-painel.js"></script>
//       <script>FNDPainel.iniciar({ endpoint: '/api/fnd/links', botao: 'flutuante' });</script>
//
//  Opcoes:
//    botao: 'flutuante' (canto inferior direito)  ou  um seletor CSS onde colocar o botao (ex.: '#topo')
//    tema:  'escuro' (padrao), 'claro' ou 'auto' (segue o fundo da tela do sistema)
//  Extras:  FNDPainel.abrir()  -  abre o painel (ex.: num item de menu "Sobre")
//           classe "fndp-esconder" nos seus botoes/itens de menu: somem no plano vitalicio (servidor com oculto)
//           botao: false  -  nao cria botao; use <span class="fndp-logo"></span> num botao seu (a logo vem do CSS)
// ============================================================================
(function () {
  'use strict';
  var LOGO = 'data:image/png;base64,';
  var opc = { endpoint: '/api/fnd/links', botao: 'flutuante', tema: 'escuro' };
  var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
  var ok = function (u) { return /^https:\/\//i.test(String(u || '')); };

  var CSS = '' +
    '.fndp-btn{display:inline-flex;align-items:center;gap:7px;font:600 13px "Segoe UI",system-ui,sans-serif;padding:5px 13px 5px 5px;border-radius:22px;border:1px solid #1e3a8a;background:#0f1a33;color:#e7ebf3;cursor:pointer}' +
    '.fndp-btn:hover{background:#14244a;border-color:#2563eb}.fndp-btn img{width:24px;height:24px;border-radius:50%}' +
    '.fndp-flut{position:fixed;right:18px;bottom:18px;z-index:9998;box-shadow:0 6px 20px rgba(0,0,0,.35)}' +
    '.fndp-fundo{position:fixed;inset:0;background:rgba(3,6,14,.72);display:flex;align-items:center;justify-content:center;z-index:9999;font:14px/1.45 "Segoe UI",system-ui,sans-serif}' +
    '.fndp-caixa{background:#151c2e;color:#e7ebf3;border:1px solid #26314b;border-radius:14px;padding:20px 22px;width:min(760px,94vw);max-height:90vh;overflow:auto;box-shadow:0 20px 50px rgba(0,0,0,.5)}' +
    '.fndp-claro .fndp-caixa{background:#fff;color:#1d2433;border-color:#d9dee8}.fndp-claro .fndp-card{background:#f4f7fb;border-color:#d9dee8}.fndp-claro .fndp-sub{color:#5b6478}' +
    '.fndp-topo{display:flex;gap:14px;align-items:center;margin-bottom:14px}.fndp-topo img{width:58px;height:58px;border-radius:50%;box-shadow:0 0 18px rgba(37,99,235,.45)}' +
    '.fndp-topo h3{margin:0;font-size:17px}.fndp-sub{color:#8d97ae;font-size:12.5px}' +
    '.fndp-x{margin-left:auto;background:transparent;border:1px solid #26314b;color:inherit;border-radius:8px;padding:6px 12px;cursor:pointer;font:inherit}' +
    '.fndp-grade{display:grid;grid-template-columns:1fr 1fr;gap:10px}' +
    '.fndp-card{display:flex;flex-direction:column;align-items:flex-start;gap:2px;text-align:left;padding:12px 14px;border-radius:12px;background:#1b2439;border:1px solid #26314b;color:inherit;cursor:pointer;font:inherit}' +
    '.fndp-card:hover{border-color:#2563eb}.fndp-card .ic{font-size:20px}.fndp-card span{color:#8d97ae;font-size:12px}' +
    '.fndp-dest{grid-column:1/-1;flex-direction:row;align-items:center;gap:12px;background:linear-gradient(135deg,#0f2a44,#11251a);border-color:#1f4a31;color:#e7ebf3}' +
    '.fndp-dest .seta{margin-left:auto;color:#22c55e;font-weight:700}.fndp-dest .tx{display:flex;flex-direction:column}' +
    '.fndp-h{margin:18px 0 8px;font-size:13px}.fndp-sis{cursor:default}.fndp-sis p{margin:4px 0 8px;color:#8d97ae;font-size:12.5px}' +
    '.fndp-sis button{background:#16a34a;border:0;color:#fff;border-radius:8px;padding:6px 12px;cursor:pointer;font:600 12.5px "Segoe UI",sans-serif}' +
    '.fndp-logo{display:inline-block;width:20px;height:20px;border-radius:50%;vertical-align:middle;background:center/cover no-repeat}' +
    '@media(max-width:700px){.fndp-grade{grid-template-columns:1fr}}';

  // tema 'auto': segue a cor de fundo da tela do sistema (tema claro ou escuro escolhido pelo usuario)
  function temaAtual() {
    if (opc.tema !== 'auto') return opc.tema;
    try {
      var m = getComputedStyle(document.body).backgroundColor.match(/\d+(\.\d+)?/g);
      if (m && m.length >= 3 && !(m.length > 3 && +m[3] === 0)) return (0.299 * m[0] + 0.587 * m[1] + 0.114 * m[2]) > 150 ? 'claro' : 'escuro';
    } catch (e) { }
    return 'escuro';
  }

  function abrirLink(u) { if (ok(u)) window.open(u, '_blank', 'noopener'); }

  var abrindo = false;
  function abrir() {
    if (abrindo || document.querySelector('.fndp-fundo')) return;
    abrindo = true;
    fetch(opc.endpoint, { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (d) {
      if (d && d.oculto) { esconder(); return; }   // plano vitalicio: sem painel
      var f = document.createElement('div');
      f.className = 'fndp-fundo' + (temaAtual() === 'claro' ? ' fndp-claro' : '');
      var dst = d.destaque;
      f.innerHTML = '<div class="fndp-caixa"><div class="fndp-topo"><img src="' + LOGO + '" alt=""><div><h3>ConheÃ§a a FND Sistemas</h3><span class="fndp-sub">Sistemas, tutoriais e novidades</span></div><button class="fndp-x">Fechar</button></div>' +
        '<div class="fndp-grade">' +
        (dst ? '<button class="fndp-card fndp-dest" data-u="' + esc(dst.link) + '"><span class="ic">ðŸ”—</span><span class="tx"><b>' + esc(dst.titulo) + '</b><span>' + esc(dst.descricao) + (dst.texto ? ' Â· ' + esc(dst.texto) : '') + '</span></span><span class="seta">Abrir â†’</span></button>' : '') +
        (d.links || []).map(function (l) { return '<button class="fndp-card" data-u="' + esc(l.link) + '"><span class="ic">' + esc(l.icone) + '</span><b>' + esc(l.titulo) + '</b>' + (l.texto ? '<span>' + esc(l.texto) + '</span>' : '') + '<span>' + esc(l.descricao) + '</span></button>'; }).join('') +
        '</div>' +
        ((d.sistemas || []).length ? '<h4 class="fndp-h">Outros sistemas da FND</h4><div class="fndp-grade">' + d.sistemas.map(function (s) { return '<div class="fndp-card fndp-sis"><b>' + esc(s.nome) + '</b><p>' + esc(s.descricao) + '</p>' + (s.link ? '<button data-u="' + esc(s.link) + '">' + esc(s.botao) + '</button>' : '') + '</div>'; }).join('') + '</div>' : '') +
        (d.mensagem ? '<p class="fndp-sub" style="text-align:center;margin:14px 0 0">' + esc(d.mensagem) + '</p>' : '') + '</div>';
      f.addEventListener('click', function (e) {
        if (e.target === f || e.target.classList.contains('fndp-x')) { f.remove(); return; }
        var b = e.target.closest('[data-u]'); if (b) abrirLink(b.getAttribute('data-u'));
      });
      document.addEventListener('keydown', function esc(e) { if (e.key === 'Escape') { f.remove(); document.removeEventListener('keydown', esc); } });
      document.body.appendChild(f);
    }).catch(function () { abrirLink('https://linktr.ee/fndsistemas'); }).then(function () { abrindo = false; });
  }

  // Plano vitalicio (v2.1): o servidor responde { oculto: true } e tudo que tem a classe "fndp-esconder"
  // (o botao do kit e os seus itens de menu) some. Enquanto confere (alguns ms), esses itens ficam escondidos.
  function esconder() { var h = document.documentElement; h.classList.remove('fndp-ok'); h.classList.add('fndp-oculto'); }
  function conferir() {
    fetch(opc.endpoint, { cache: 'no-store' }).then(function (r) { return r.json(); })
      .then(function (d) { if (d && d.oculto) esconder(); else document.documentElement.classList.add('fndp-ok'); })
      .catch(function () { document.documentElement.classList.add('fndp-ok'); });
  }

  function iniciar(o) {
    for (var k in (o || {})) opc[k] = o[k];
    if (!document.getElementById('fndp-css')) { var st = document.createElement('style'); st.id = 'fndp-css'; st.textContent = CSS + '.fndp-logo{background-image:url(' + LOGO + ')}html:not(.fndp-ok) .fndp-esconder{display:none!important}'; document.head.appendChild(st); }
    conferir();
    if (opc.botao === false) return;
    var b = document.createElement('button');
    b.type = 'button'; b.className = 'fndp-btn fndp-esconder'; b.title = 'ConheÃ§a a FND Sistemas';
    b.innerHTML = '<img src="' + LOGO + '" alt=""> FND Sistemas';
    b.onclick = abrir;
    var alvo = opc.botao !== 'flutuante' && document.querySelector(opc.botao);
    if (alvo) alvo.appendChild(b); else { b.classList.add('fndp-flut'); document.body.appendChild(b); }
  }

  window.FNDPainel = { iniciar: iniciar, abrir: abrir };
})();
