  dica.innerHTML = `<b>${esc(grafFmt(melhor[2], g.dataset.seg === '1'))}</b> Â· <b style="${quente}">${esc(String(melhor[3]).replace('.', ','))} Â°C</b>${melhor[4] != null ? ` <span class="muted">Â· processador ${esc(melhor[4])}%</span>` : ''}${melhor[5] ? `<div class="small">${esc(melhor[5])}</div>` : ''}`;
