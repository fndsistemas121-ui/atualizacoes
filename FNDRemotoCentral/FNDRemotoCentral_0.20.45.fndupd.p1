  }).join('');
  const total = r.discoGravaMBs;
  const conclusao = total == null ? '' : total < 1
    ? 'âœ… O disco quase nÃ£o estÃ¡ gravando: o calor vem de <b>ventilaÃ§Ã£o ou do ambiente</b> (posiÃ§Ã£o do SSD no gabinete, sem ventoinha na frente, sala quente).'
    : total < 10 ? 'âš  GravaÃ§Ã£o moderada: os programas da lista ajudam a esquentar, mas ventilaÃ§Ã£o ainda pesa bastante.'
      : 'ðŸ”¥ O disco estÃ¡ gravando muito: o calor vem principalmente dos programas da lista.';
  const mem = r.memLivrePct != null && r.memLivrePct < 15 ? `<p class="small" style="color:var(--warn)">âš  SÃ³ ${r.memLivrePct}% da memÃ³ria estÃ¡ livre: o Windows usa o disco como memÃ³ria (memÃ³ria virtual) e isso grava sem parar. Mais RAM ou menos programas abertos ajudam.</p>` : '';
  return `<div class="card" style="margin-bottom:12px"><div style="font-size:18px;font-weight:600">ðŸ”¥ ${esc(r.message || '')}</div>
      <p class="muted small" style="margin:6px 0 0">Medido por ${esc(String(r.segundos || 15))} segundos. O disco gravou <b>${mb(total)}</b> e leu ${mb(r.discoLeMBs)}.</p>
      ${conclusao ? `<p style="margin:8px 0 0">${conclusao}</p>` : ''}${mem}</div>
    ${ps.length ? `<div class="table-wrap"><table><thead><tr><th>Programa</th><th style="text-align:right">Grava</th><th style="text-align:right">LÃª</th></tr></thead><tbody>${linhas}</tbody></table></div>
    <p class="muted small">Os nÃºmeros por programa somam todo tipo de leitura e gravaÃ§Ã£o (inclusive rede); o total do disco Ã© o que foi gravado de verdade. Para ver um pico, rode de novo quando o grÃ¡fico estiver subindo.</p>` : ''}`;
}
// CartÃµes da pÃ¡gina do PC encaixados sem buraco (estilo "mural"): grade de linhas de 4 px e cada cartÃ£o ocupa
