  const cx = ((ev.clientX - rc.left) / rc.width) * W;
  let melhor = d[0]; for (const p of d) if (Math.abs(p[0] - cx) < Math.abs(melhor[0] - cx)) melhor = p;
  const cur = g.querySelector('.graf-cursor'), dica = g.querySelector('.graf-dica');
  cur.style.display = ''; cur.querySelector('line').setAttribute('x1', melhor[0]); cur.querySelector('line').setAttribute('x2', melhor[0]);
  cur.querySelector('circle').setAttribute('cx', melhor[0]); cur.querySelector('circle').setAttribute('cy', melhor[1]);
