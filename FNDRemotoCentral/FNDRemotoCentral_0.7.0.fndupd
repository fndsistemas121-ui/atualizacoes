CREATE TABLE IF NOT EXISTS settings (key TEXT PRIMARY KEY, value TEXT);

CREATE TABLE IF NOT EXISTS clients (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  document TEXT, contact_name TEXT, phone TEXT, email TEXT, notes TEXT,
  maintenance_window TEXT,          -- ex.: "22:00-06:00" (hor\xE1rio permitido p/ manuten\xE7\xE3o)
  reboot_policy TEXT DEFAULT 'perguntar', -- perguntar | agendar | automatico
  enroll_code TEXT NOT NULL UNIQUE, -- c\xF3digo de cadastro dos agentes deste cliente
  created_at TEXT DEFAULT (datetime('now','localtime'))
);

CREATE TABLE IF NOT EXISTS groups (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  client_id INTEGER NOT NULL REFERENCES clients(id) ON DELETE CASCADE,
  name TEXT NOT NULL,
  kind TEXT DEFAULT 'grupo'          -- grupo | setor | departamento
);

CREATE TABLE IF NOT EXISTS users (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  username TEXT NOT NULL UNIQUE COLLATE NOCASE,
  name TEXT,
  pass_hash TEXT NOT NULL,
  role TEXT NOT NULL DEFAULT 'tecnico', -- admin | tecnico | leitura
  client_id INTEGER REFERENCES clients(id) ON DELETE CASCADE, -- se preenchido, s\xF3 enxerga esse cliente
  totp_secret TEXT, totp_enabled INTEGER DEFAULT 0,
  active INTEGER DEFAULT 1,
  created_at TEXT DEFAULT (datetime('now','localtime')),
  last_login TEXT
);

CREATE TABLE IF NOT EXISTS sessions (
  id_hash TEXT PRIMARY KEY,
  user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  created_at INTEGER, expires_at INTEGER, ip TEXT, ua TEXT
);

CREATE TABLE IF NOT EXISTS devices (
  id TEXT PRIMARY KEY,
  token_hash TEXT NOT NULL,
  machine_guid TEXT,
  client_id INTEGER REFERENCES clients(id) ON DELETE SET NULL,
  group_id INTEGER REFERENCES groups(id) ON DELETE SET NULL,
  hostname TEXT, alias TEXT, notes TEXT,
  os TEXT, cpu TEXT, ram_gb REAL, storage TEXT, ip TEXT, win_user TEXT,
  agent_version TEXT,
  inventory TEXT,            -- JSON completo do \xFAltimo invent\xE1rio
  software TEXT,             -- JSON da lista de programas
  updates TEXT,              -- JSON da \xFAltima verifica\xE7\xE3o (apps + Windows)
  metrics TEXT,              -- JSON CPU/RAM do \xFAltimo sinal
  status TEXT DEFAULT 'offline',
  last_seen TEXT,
  enrolled_at TEXT DEFAULT (datetime('now','localtime')),
  revoked INTEGER DEFAULT 0
);
CREATE INDEX IF NOT EXISTS ix_devices_client ON devices(client_id);
CREATE INDEX IF NOT EXISTS ix_devices_guid ON devices(machine_guid);

CREATE TABLE IF NOT EXISTS tasks (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  device_id TEXT NOT NULL REFERENCES devices(id) ON DELETE CASCADE,
  action TEXT NOT NULL,
  params TEXT,
  status TEXT NOT NULL DEFAULT 'pendente', -- pendente | enviada | executando | concluida | erro | cancelada
  result TEXT, output TEXT,
  created_by TEXT,
  created_at TEXT DEFAULT (datetime('now','localtime')),
  scheduled_for TEXT,          -- data/hora local "AAAA-MM-DD HH:MM" (vazio = assim que poss\xEDvel)
  started_at TEXT, finished_at TEXT
);
CREATE INDEX IF NOT EXISTS ix_tasks_device ON tasks(device_id, id);
CREATE INDEX IF NOT EXISTS ix_tasks_status ON tasks(status);

CREATE TABLE IF NOT EXISTS alerts (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  akey TEXT NOT NULL,            -- chave de deduplica\xE7\xE3o (tipo:dispositivo:detalhe)
  device_id TEXT REFERENCES devices(id) ON DELETE CASCADE,
  client_id INTEGER,
  type TEXT, severity TEXT,      -- info | aviso | critico
  message TEXT,
  created_at TEXT DEFAULT (datetime('now','localtime')),
  resolved_at TEXT
);
CREATE INDEX IF NOT EXISTS ix_alerts_open ON alerts(akey, resolved_at);
CREATE INDEX IF NOT EXISTS ix_alerts_device ON alerts(device_id, resolved_at);

-- Biblioteca de instaladores pr\xF3prios (.exe / .msi) enviados pelo painel
CREATE TABLE IF NOT EXISTS packages (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  filename TEXT NOT NULL,       -- nome original do arquivo
  stored TEXT NOT NULL,         -- nome no disco da Central
  size INTEGER, sha256 TEXT,
  args TEXT DEFAULT '',         -- par\xE2metros de instala\xE7\xE3o silenciosa
  notes TEXT,
  created_by TEXT,
  created_at TEXT DEFAULT (datetime('now','localtime'))
);

CREATE TABLE IF NOT EXISTS scripts (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  description TEXT DEFAULT '',
