$pastas = @("$env:SystemRoot\Temp") + @(Get-ChildItem 'C:\Users' -Directory -ErrorAction SilentlyContinue | ForEach-Object { Join-Path $_.FullName 'AppData\Local\Temp' })
foreach ($p in $pastas) {
  if (Test-Path $p) { Get-ChildItem $p -Recurse -Force -ErrorAction SilentlyContinue | Where-Object { $_.LastWriteTime -lt (Get-Date).AddDays(-1) } | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue }
}
$liberado = [math]::Round(((Get-PSDrive C).Free - $antes) / 1MB, 0)
"Limpeza concluÃ­da. EspaÃ§o liberado: $liberado MB"`},{name:"Destravar impress\xE3o (spooler)",description:"Para o spooler de impress\xE3o, limpa a fila travada e inicia de novo.",script:String.raw`Stop-Service -Name Spooler -Force
Start-Sleep -Seconds 2
$n = @(Get-ChildItem "$env:SystemRoot\System32\spool\PRINTERS" -File -ErrorAction SilentlyContinue).Count
Remove-Item "$env:SystemRoot\System32\spool\PRINTERS\*" -Force -ErrorAction SilentlyContinue
Start-Service -Name Spooler
"Spooler reiniciado. Trabalhos removidos da fila: $n"
Get-Printer -ErrorAction SilentlyContinue | Select-Object Name, PrinterStatus | Format-Table -AutoSize | Out-String`},{name:"Testar internet e DNS",description:'Testa o gateway, a internet (8.8.8.8) e a resolu\xE7\xE3o de nomes. Bom para "a internet n\xE3o funciona".',script:String.raw`$gw = (Get-NetIPConfiguration | Where-Object { $_.IPv4DefaultGateway } | Select-Object -First 1).IPv4DefaultGateway.NextHop
"Gateway: $gw"
foreach ($alvo in @($gw, '8.8.8.8', '1.1.1.1')) { if ($alvo) { $ok = Test-Connection -ComputerName $alvo -Count 2 -Quiet; "Ping $alvo : $(if ($ok) { 'OK' } else { 'FALHOU' })" } }
foreach ($nome in @('google.com', 'microsoft.com')) { try { $ip = (Resolve-DnsName $nome -ErrorAction Stop | Where-Object IPAddress | Select-Object -First 1).IPAddress; "DNS $nome : OK ($ip)" } catch { "DNS $nome : FALHOU" } }
"Servidores DNS: " + ((Get-DnsClientServerAddress -AddressFamily IPv4 | ForEach-Object { $_.ServerAddresses }) -join ', ')`},{name:"Limpar cache de DNS",description:'Limpa o cache de nomes (resolve sites que "n\xE3o abrem" depois de mudan\xE7a de DNS).',script:String.raw`Clear-DnsClientCache
ipconfig /registerdns | Out-Null
"Cache de DNS limpo."`},{name:"Reparar arquivos do Windows (DISM + SFC)",description:"Verifica e repara a imagem e os arquivos do sistema. Demora (at\xE9 30 min). Rode fora do hor\xE1rio de uso.",script:String.raw`"== DISM (imagem do Windows) =="
DISM /Online /Cleanup-Image /RestoreHealth /Quiet | Out-String
"CÃ³digo DISM: $LASTEXITCODE"
"== SFC (arquivos do sistema) =="
$s = sfc /scannow | Out-String
($s -replace [string][char]0, '') -split "\r?\n" | Where-Object { $_ -match '\S' } | Select-Object -Last 4`},{name:"Liberar espa\xE7o do Windows Update",description:"Apaga os downloads antigos do Windows Update (pasta SoftwareDistribution\\Download).",script:String.raw`$antes = (Get-PSDrive C).Free
Stop-Service -Name wuauserv, bits -Force -ErrorAction SilentlyContinue
Remove-Item "$env:SystemRoot\SoftwareDistribution\Download\*" -Recurse -Force -ErrorAction SilentlyContinue
Start-Service -Name bits, wuauserv -ErrorAction SilentlyContinue
"EspaÃ§o liberado: $([math]::Round(((Get-PSDrive C).Free - $antes) / 1MB, 0)) MB"`},{name:"Esvaziar lixeira de todos os usu\xE1rios",description:"Esvazia a lixeira de todos os discos.",script:String.raw`$antes = (Get-PSDrive C).Free
Clear-RecycleBin -Force -ErrorAction SilentlyContinue
Get-PSDrive -PSProvider FileSystem | ForEach-Object { Remove-Item (Join-Path $_.Root '$Recycle.Bin\*') -Recurse -Force -ErrorAction SilentlyContinue }
"Lixeira esvaziada. Liberado no C: $([math]::Round(((Get-PSDrive C).Free - $antes) / 1MB, 0)) MB"`},{name:"Sa\xFAde da bateria (notebook)",description:"Mostra a capacidade atual da bateria comparada com a original (desgaste).",script:String.raw`$b = Get-CimInstance Win32_Battery -ErrorAction SilentlyContinue
if (-not $b) { 'Este computador nÃ£o tem bateria (nÃ£o Ã© notebook).'; exit 0 }
$full = (Get-CimInstance -Namespace root\wmi -ClassName BatteryFullChargedCapacity -ErrorAction SilentlyContinue | Select-Object -First 1).FullChargedCapacity
$design = (Get-CimInstance -Namespace root\wmi -ClassName BatteryStaticData -ErrorAction SilentlyContinue | Select-Object -First 1).DesignedCapacity
"Carga agora: $($b.EstimatedChargeRemaining)%"
if ($full -and $design) { $saude = [math]::Round($full / $design * 100, 0); "Capacidade: $full mWh de $design mWh originais"; "SaÃºde da bateria: $saude% $(if ($saude -lt 60) { '(fraca â€” considere trocar)' } elseif ($saude -lt 80) { '(desgastada)' } else { '(boa)' })" }
else { 'O Windows nÃ£o informou a capacidade original desta bateria.' }`},{name:"Pastas que mais ocupam espa\xE7o nos usu\xE1rios",description:"Lista as 15 maiores pastas dentro de C:\\Users (pode demorar alguns minutos).",script:String.raw`Get-ChildItem 'C:\Users' -Directory -ErrorAction SilentlyContinue | ForEach-Object {
  $u = $_
  Get-ChildItem $u.FullName -Directory -Force -ErrorAction SilentlyContinue | ForEach-Object {
    $t = (Get-ChildItem $_.FullName -Recurse -File -Force -ErrorAction SilentlyContinue | Measure-Object Length -Sum).Sum
    [pscustomobject]@{ Pasta = $_.FullName; GB = [math]::Round($t / 1GB, 2) }
  }
} | Sort-Object GB -Descending | Select-Object -First 15 | Format-Table -AutoSize | Out-String -Width 200`},{name:"Usu\xE1rios e administradores do PC",description:"Lista as contas locais e quem \xE9 administrador.",script:String.raw`"== Contas locais =="
Get-LocalUser | Select-Object Name, Enabled, LastLogon | Format-Table -AutoSize | Out-String
"== Administradores =="
